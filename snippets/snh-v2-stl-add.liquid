{%- comment -%}
  Add button for Shop the Look. Single-variant products add in one tap through the theme cart (data-v2-add);
  multi-variant products open the SNH quick-buy sheet (assets/snh-quick.js; Round 14, Impact's drawer failed on our product template).
  product, cls, label. The quick-buy drawers are printed once per product at the end of the section.
{%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
{%- if product.available == false -%}
  <button class="{{ cls }}" type="button" disabled><span>Sold out</span></button>
{%- elsif product.has_only_default_variant -%}
  <button class="{{ cls }}" type="button" data-v2-add="{{ v.id }}" aria-label="{{ label }}: {{ product.title | escape }}"><span>{{ label }}</span><i class="v-tick" aria-hidden="true">{% render 'snh-v2-icon', name: 'check' %}</i></button>
{%- else -%}
  <button class="{{ cls }}" type="button" data-v2-pick="{{ product.handle }}" aria-haspopup="dialog" aria-label="Choose options for {{ product.title | escape }}"><span>{{ label }}</span></button>
{%- endif -%}
