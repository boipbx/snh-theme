{%- comment -%} Account sub-navigation (Round 7; Round 8 points it at the member app's views). active: overview / rewards / orders / goals / profile. {%- endcomment -%}
<nav class="anav" aria-label="Account">
  <a href="{{ routes.account_url }}#overview"{% if active == 'dashboard' or active == 'overview' %} aria-current="page"{% endif %}>Overview</a>
  <a href="{{ routes.account_url }}#rewards"{% if active == 'rewards' %} aria-current="page"{% endif %}>Rewards</a>
  <a href="{{ routes.account_url }}#orders"{% if active == 'orders' %} aria-current="page"{% endif %}>Orders</a>
  <a href="{{ routes.account_url }}#goals"{% if active == 'goals' %} aria-current="page"{% endif %}>Goals</a>
  <a href="{{ routes.account_url }}#profile"{% if active == 'addresses' or active == 'profile' %} aria-current="page"{% endif %}>Profile &amp; addresses</a>
  <a class="anav__out" href="{{ routes.account_logout_url }}" data-no-instant>Sign out</a>
</nav>
