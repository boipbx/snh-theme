{%- comment -%}
  SNH Elite beside the sign-in / register / password forms (Round 7; Round 15: the sample Elite card + three perks + a
  social-proof line, on the full-bleed photo background of snippets/snh-auth-bg).
  heading (a *word* goes serif), lead, proof. Figures from Theme settings → SNH Elite.
{%- endcomment -%}
{%- liquid
  assign welcome = settings.snh_welcome_points | default: 500
  assign redeem_from = settings.snh_redeem_from | default: 2500
  assign r_b = settings.snh_rate_bronze | default: 3
  assign r_g = settings.snh_rate_gold | default: 10
  assign parts = heading | split: '*'
-%}
<aside class="auth__aside" aria-label="SNH Elite">
  <div class="auth__pitch">
    <h2 class="auth__h">{%- for p in parts -%}{%- if forloop.index0 == 1 -%}<em>{{ p | escape }}</em>{%- else -%}{{ p | escape }}{%- endif -%}{%- endfor -%}</h2>
    {%- if lead != blank -%}<p class="auth__lead">{{ lead | escape }}</p>{%- endif -%}
    <div class="auth__ecard">{%- render 'snh-elite-card', sample: true, size: 'full', side: 'both' -%}</div>
    <ul class="auth__perks" role="list">
      <li><b>{% render 'snh-num', n: welcome %}</b><span>welcome points</span></li>
      <li><b>{{ r_b }}–{{ r_g }}%</b><span>back on every order</span></li>
      <li><b>{% render 'snh-num', n: redeem_from %}</b><span>points to redeem</span></li>
    </ul>
    {%- if proof != blank -%}<p class="auth__proof"><span aria-hidden="true">★</span> {{ proof | escape }}</p>{%- endif -%}
  </div>
</aside>
