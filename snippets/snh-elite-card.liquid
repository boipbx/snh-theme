{%- comment -%}
  SNH Elite membership card (Round 15: one static design everywhere; based on the approved header-panel credit card).
  No tilt / rotation / 3D / pointer-follow. Desktop hover: a subtle sheen; reduced motion: none.
  FRONT (1.586:1, radius 16px): SNH logo (theme logo file, recoloured per tier) + "Elite" in the serif italic · tier in
  caps · EMV chip · member number "0000 0934" · MEMBER + name · POINTS + Rs value · progress line to the next tier.
  BACK: magnetic stripe, then label / value rows: earn rate, spend this year, next tier + "Rs X to go" + bar, redeem at,
  points value, "View rewards".
  Tier surfaces: bronze (white text), silver steel (ink text), gold (ink text): every text ≥ 4.5:1 on the lightest stop.
  Text scales with the card width (container units, never under 12px), so only the size changes between placements.

  m: split snippets/snh-elite-calc output (optional with sample) · name · no: member number
  size: full (default) | compact (header panel) | small (account sidebar)
  side: both (default: the flip card: click / tap / Enter / Space turns it over in 3D, "Tap to flip" hint; reduced
  motion = an instant crossfade) | front | back
  sample: true = a guest's example card (Gold, sample figures, "Sample" on the tier) · h: tag for the name (p)
  Styles: assets/snh-v2.css (.elc) · behaviour: assets/snh-v2.js ([data-elc-flip]).
{%- endcomment -%}
{%- liquid
  assign size = size | default: 'full'
  assign side = side | default: 'both'
  assign tag = h | default: 'p'
  assign redeem_from = settings.snh_redeem_from | default: 2500
  if sample
    capture mm
      render 'snh-elite-calc', mock: true, tier: 'gold', points: 3240, spend: 312000
    endcapture
    assign m = mm | strip | split: '|'
    assign name = name | default: 'Your name'
    assign no = no | default: 934
  endif
  assign no_s = no | prepend: '0000' | slice: -4, 4
  assign uid = 'ec-' | append: m[0] | append: '-' | append: no | append: '-' | append: size | append: '-' | append: side
  capture rewards_url
    if sample
      render 'snh-elite-url'
    else
      echo routes.account_url | append: '#rewards'
    endif
  endcapture
  assign rail_label = 'Progress to ' | append: m[8]
  if m[12] == '1'
    assign rail_label = 'Top tier reached'
  endif
-%}
<div class="elc-wrap elc-wrap--{{ size }}">
<div class="elc elc--{{ size }}{% if sample %} elc--sample{% endif %}" data-tier="{{ m[0] }}" data-side="{{ side }}"{% if side == 'both' %} data-elc-card tabindex="0" role="button" aria-pressed="false" aria-label="SNH Elite card. Flip to see your earn rate and progress" aria-describedby="{{ uid }}-hint"{% endif %}>
  <div class="elc__in">
  {%- unless side == 'back' -%}
  <div class="elc__face elc__front" id="{{ uid }}-f">
    <i class="elc__sheen" aria-hidden="true"></i>
    <div class="elc__top">
      <span class="elc__brand"><i class="elc__logo" role="img" aria-label="SNH"></i><em>Elite</em></span>
      <span class="elc__tier">{% if sample %}Sample · {% endif %}{{ m[1] | upcase }}</span>
    </div>
    <svg class="elc__chip" viewBox="0 0 48 36" aria-hidden="true"><rect x=".75" y=".75" width="46.5" height="34.5" rx="6"/><path d="M16 .75v10M32 .75v10M16 25.25v10M32 25.25v10M.75 12h15.25a8 8 0 0 1 16 0h15.25M.75 24h15.25a8 8 0 0 0 16 0h15.25"/></svg>
    <p class="elc__no"><span class="v-sr">Member number </span>0000 {{ no_s }}</p>
    <div class="elc__foot">
      <div class="elc__who">
        <span class="elc__lbl">Member</span>
        <{{ tag }} class="elc__name" title="{{ name | escape }}">{{ name | escape }}</{{ tag }}>
      </div>
      <p class="elc__pts">
        {%- if m[3] == 'x' -%}<strong>0</strong> <span class="elc__lbl">Points</span><span class="elc__dot" aria-hidden="true">·</span><span class="elc__val">after your first order</span>
        {%- else -%}<strong>{% render 'snh-num', n: m[3] %}</strong> <span class="elc__lbl">Points</span><span class="elc__dot" aria-hidden="true">·</span><span class="elc__val">{{ m[4] | times: 100 | money_without_trailing_zeros }}</span>{%- endif -%}
      </p>
    </div>
    <div class="elc__rail" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ m[11] }}" aria-label="{{ rail_label }}"><i style="width: {{ m[11] }}%"></i></div>
  </div>
  {%- endunless -%}
  {%- unless side == 'front' -%}
  <div class="elc__face elc__back" id="{{ uid }}-b"{% if side == 'both' %} aria-hidden="true"{% endif %}>
    <i class="elc__stripe" aria-hidden="true"></i>
    <dl class="elc__rows">
      <div><dt>Earn rate</dt><dd>{{ m[7] }}% back</dd></div>
      <div><dt>Spend this year</dt><dd>{{ m[5] | times: 100 | money_without_trailing_zeros }}{% if m[6] == '1' %} est.{% endif %}</dd></div>
      <div class="elc__next">
        <dt>{% if m[12] == '1' %}Tier{% else %}Next tier · {{ m[8] }}{% endif %}</dt>
        <dd>{% if m[12] == '1' %}Top tier{% elsif m[10] == '0' %}Reached{% else %}{{ m[10] | times: 100 | money_without_trailing_zeros }} to go{% endif %}</dd>
        <span class="elc__bar" aria-hidden="true"><i style="width: {{ m[11] }}%"></i></span>
      </div>
      <div><dt>Redeem at</dt><dd>{% render 'snh-num', n: redeem_from %} points</dd></div>
      <div><dt>Points value</dt><dd>{% if m[3] == 'x' %}—{% else %}{{ m[4] | times: 100 | money_without_trailing_zeros }}{% endif %}</dd></div>
    </dl>
    <a class="elc__link" href="{{ rewards_url | strip }}"{% if side == 'both' %} tabindex="-1"{% endif %}>{% if sample %}How SNH Elite works{% else %}View rewards{% endif %} →</a>
  </div>
  {%- endunless -%}
  </div>
</div>
{%- if side == 'both' -%}
  <p class="elc-hint" id="{{ uid }}-hint" data-elc-hint><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 13.66-5.66L20 8.7M20 4v4.7h-4.7M20 12a8 8 0 0 1-13.66 5.66L4 15.3M4 20v-4.7h4.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Tap to flip</span></p>
{%- endif -%}
</div>
