{%- comment -%}
  Bestseller mini list: the first products of a collection, in the collection's own sort order.
  collection, limit (default 3), class (extra list class)
{%- endcomment -%}
{%- if collection != blank -%}
  <ul class="minis{% if class %} {{ class }}{% endif %}">
    {%- for p in collection.products limit: limit -%}
      <li><a class="mini" href="{{ p.url }}">
        {%- if p.featured_image -%}
          {{- p.featured_image | image_url: width: 480 | image_tag: width: 240, height: 240, loading: 'lazy', alt: '', widths: '240,360,480', sizes: '(max-width: 749px) 40vw, 200px', data-v2-lift: '' -}}
        {%- else -%}<span class="mini__ph"></span>{%- endif -%}
        <span class="mini__t">{% render 'snh-v2-title', product: p %}</span>
        {%- comment -%} 11 Nov: was-price + saving made visible (same retail rule as the product cards) {%- endcomment -%}
        {%- capture m_retail -%}{% render 'snh-v2-retail', product: p %}{%- endcapture -%}{%- assign m_retail = m_retail | strip | plus: 0 -%}
        <span class="mini__p">{{ p.price | money_without_trailing_zeros }}{% if m_retail > p.price %} <s>{{ m_retail | money_without_trailing_zeros }}</s> <b class="mini__save">Save {{ m_retail | minus: p.price | money_without_trailing_zeros }}</b>{% endif %}</span>
      </a></li>
    {%- endfor -%}
  </ul>
{%- endif -%}
