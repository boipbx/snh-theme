{%- comment -%}
  Outputs the "was" price in cents for a product card, or nothing: the variant's or product's compare-at price, else
  SNH's bundle sheet (sum of each bundle's contents at shelf prices, keyed by the handleized title), else the
  custom.retail_price metafield (rupees). A bundle missing from the sheet simply shows no saving. product
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign retail = 0
  if v.compare_at_price > v.price
    assign retail = v.compare_at_price
  elsif product.compare_at_price > product.price
    assign retail = product.compare_at_price
  elsif product.compare_at_price_max > product.price
    assign retail = product.compare_at_price_max
  endif
  if retail == 0
    assign sheet = 'testosterone-support=1649800,testosterone-support-max=2239800,gut-metabolic-support=1429800,bone-strength=1319800,scar-tissue-recovery-repair=2369700,daily-foundation=2209700,stress-recovery=1649800,main-mineral-trio=2099700,immunity-daily=1989700,everyday-essentials=1439800,revive-daily=1729800,deep-sleep=2309800,couples-bedroom-bundle=1799800,endurance-trial-pack=539500,race-day-pack-1-0=999300,race-day-pack-2-0=1059300,strength-foundation=2499700,strength-skin=1799800,creatine-starter=1099800,whey-pre-stack=3099800,whey-training-stack=3099700,isolate-pre-stack=3399800,isolate-training-stack=3599700,raw-loaded-stack=3049700,raw-training-stack=1849800' | split: ','
    # 11 Nov: the sheet is keyed by product handle (the title fallback is kept for older keys); totals of
    # multi-flavour bundles updated to today's shelf prices
    assign tkey = product.title | handleize
    for pair in sheet
      assign kv = pair | split: '='
      if kv[0] == product.handle or kv[0] == tkey
        assign retail = kv[1] | times: 1
        break
      endif
    endfor
  endif
  if retail == 0
    assign meta_retail = product.metafields.custom.retail_price.value | default: product.metafields.custom.retail_price
    if meta_retail != blank
      assign retail = meta_retail | times: 100 | round
    endif
  endif
  if retail > product.price
    echo retail
  endif
-%}
