{%- comment -%}
  Header account panel (Round 7): right-side glass sheet, full height on phones. Opened by any [data-acp-open]
  (assets/snh-v2.js, header init). Logged out: sign in / create account + the Elite pitch. Logged in: name, tier,
  points + Rs value, progress to the next tier, account links. Figures from snippets/snh-elite-calc (display only).
  id: element id. note: signed-out lead ([bronze]/[silver]/[gold] print the rates). mock (QA, page.elite-mock only): static, with first_name, tier, points, spend; signed_out: true for
  the logged-out state.
{%- endcomment -%}
{%- liquid
  assign signed_in = false
  if mock
    unless signed_out
      assign signed_in = true
    endunless
    assign who = first_name | default: 'there'
  elsif customer
    assign signed_in = true
    assign who = customer.first_name | default: customer.email | split: '@' | first
  endif
  capture elite_url
    render 'snh-elite-url'
  endcapture
  assign r_lo = settings.snh_rate_bronze | default: 3
  assign r_hi = settings.snh_rate_gold | default: 10
  assign r_b = r_lo | append: '%'
  assign r_s = settings.snh_rate_silver | default: 7 | append: '%'
  assign r_g = r_hi | append: '%'
  assign welcome = settings.snh_welcome_points | default: 500
  assign redeem_from = settings.snh_redeem_from | default: 2500
  if signed_in
    if mock
      capture m
        render 'snh-elite-calc', mock: true, tier: tier, points: points, spend: spend
      endcapture
    else
      capture m
        render 'snh-elite-calc', customer: customer
      endcapture
    endif
    assign m = m | strip | split: '|'
  endif
-%}
<div class="v2 acp{% if mock %} acp--static{% endif %}" id="{{ id }}" role="dialog" aria-modal="{% if mock %}false{% else %}true{% endif %}" aria-labelledby="{{ id }}-t"{% unless mock %} hidden{% endunless %} data-acp>
  <div class="acp__sheet">
    <div class="acp__top">
      <span class="acp__brand">SNH <em>Elite</em></span>
      <button class="icon-btn acp__close" type="button" aria-label="Close account panel" data-acp-close>{% render 'snh-v2-icon', name: 'close' %}</button>
    </div>
    <div class="acp__body">
      {%- if signed_in -%}
        <div class="acp__who">
          <span class="acp__av" data-tier="{{ m[0] }}">{{ who | slice: 0 | upcase }}</span>
          <div class="acp__id">
            <p class="acp__name" id="{{ id }}-t">Hi, {{ who | escape }}</p>
            <span class="tierb tierb--{{ m[0] }}">{{ m[1] }} member</span>
            {%- if m[2] == '1' -%}<span class="acp__est">Tier estimated from your orders</span>{%- endif -%}
          </div>
        </div>

        {%- liquid
          if mock
            assign card_name = who
            assign card_no = 427
          else
            assign card_name = customer.name | default: who
            assign card_no = customer.id | modulo: 900 | plus: 100
          endif
        -%}
        {%- comment -%} Round 11: the points block is a membership credit card (1.586:1), tier metal as on the dashboard {%- endcomment -%}
        <div class="ccard" data-tier="{{ m[0] }}" data-ccard>
          <div class="ccard__face">
            <i class="ccard__sheen" aria-hidden="true"></i>
            <div class="ccard__top">
              <span class="ccard__brand">SNH <em>Elite</em></span>
              <span class="ccard__tier">{{ m[1] | upcase }}</span>
            </div>
            <svg class="ccard__chip" viewBox="0 0 48 36" aria-hidden="true"><rect x=".75" y=".75" width="46.5" height="34.5" rx="6"/><path d="M16 .75v10M32 .75v10M16 25.25v10M32 25.25v10M.75 12h15.25a8 8 0 0 1 16 0h15.25M.75 24h15.25a8 8 0 0 0 16 0h15.25M16 12v12M32 12v12"/></svg>
            <p class="ccard__no">No. {{ card_no | prepend: '0000 ' }}</p>
            <div class="ccard__foot">
              <div class="ccard__who">
                <span class="ccard__lbl">Member</span>
                <span class="ccard__name" title="{{ card_name | escape }}">{{ card_name | escape }}</span>
              </div>
              <div class="ccard__pts">
                <span class="ccard__lbl">Points</span>
                {%- if m[3] == 'x' -%}<strong>—</strong>{%- else -%}<strong>{% render 'snh-num', n: m[3] %}</strong><span class="ccard__val">{{ m[4] | times: 100 | money_without_trailing_zeros }}</span>{%- endif -%}
              </div>
            </div>
            <div class="ccard__rail" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ m[11] }}" aria-label="Progress to {{ m[8] | default: 'the top tier' }}"><i style="width: {{ m[11] }}%"></i></div>
          </div>
        </div>
        <div class="acp__prog">
          <p class="acp__next">
            {%- if m[3] == 'x' -%}Your balance appears after your first paid order syncs.{% elsif m[14] == '1' %}Your reward is ready to redeem.{% else %}{% render 'snh-num', n: m[15] %} points to your first reward.{% endif %}
            {% if m[12] == '1' %}Top tier · {{ m[7] }}% back on every order.{%- elsif m[10] == '0' -%}{{ m[8] }} unlocks when your tier updates.{%- else -%}Spend <b>{{ m[10] | times: 100 | money_without_trailing_zeros }}</b> more to reach {{ m[8] }}.{%- endif -%}
          </p>
          {%- if m[6] == '1' -%}<p class="acp__est">Estimated from your orders. Your Elite balance updates after each paid order.</p>{%- endif -%}
        </div>

        <nav class="acp__links" aria-label="Account">
          <a href="{{ routes.account_url }}#overview">{% render 'snh-v2-icon', name: 'home' %}<span>Overview</span></a>
          <a href="{{ routes.account_url }}#rewards">{% render 'snh-v2-icon', name: 'gift' %}<span>Rewards</span></a>
          <a href="{{ routes.account_url }}#orders">{% render 'snh-v2-icon', name: 'bag' %}<span>Orders</span></a>
          <a href="{{ routes.account_url }}#goals">{% render 'snh-v2-icon', name: 'target' %}<span>Goals</span></a>
          <a href="{{ routes.account_url }}#profile">{% render 'snh-v2-icon', name: 'pin' %}<span>Profile &amp; addresses</span></a>
          <a href="{{ elite_url | strip }}">{% render 'snh-v2-icon', name: 'badge' %}<span>How SNH Elite works</span></a>
        </nav>
        <a class="v-btn v-btn--line acp__out" href="{{ routes.account_logout_url }}" data-no-instant><span>Sign out</span></a>
      {%- else -%}
        <h2 class="acp__h" id="{{ id }}-t">Earn on <em>every</em> order</h2>
        <p class="acp__lead">
          {%- if note != blank -%}
            {{- note | escape | replace: '[bronze]', r_b | replace: '[silver]', r_s | replace: '[gold]', r_g -}}
          {%- else -%}Join SNH Elite free and every order earns points back, from {{ r_lo }}% up to {{ r_hi }}%.{%- endif -%}
        </p>
        <ul class="acp__perks">
          <li><b>{% render 'snh-num', n: welcome %}</b><span>welcome points when you join</span></li>
          <li><b>{{ r_lo }}–{{ r_hi }}%</b><span>back in points, by tier</span></li>
          <li><b>{% render 'snh-num', n: redeem_from %}</b><span>points and you can redeem</span></li>
        </ul>
        <div class="acp__ctas">
          <a class="v-btn v-btn--accent" href="{{ routes.account_login_url }}"><span>Sign in</span></a>
          <a class="v-btn v-btn--line" href="{{ routes.account_register_url }}"><span>Create account</span></a>
        </div>
        <a class="acp__more" href="{{ elite_url | strip }}">How SNH Elite works {% render 'snh-v2-icon', name: 'next' %}</a>
      {%- endif -%}
    </div>
  </div>
</div>
