{%- comment -%}
  SNH product card (Round 11: your old card's structure, OLD-COMPONENTS.md §1, in v2 type and spacing). The one card
  used everywhere (home, collections, search, related, recently viewed, cart suggestions, account; the theme's
  product-card snippet renders this too).
  Round 13 (compact): bordered card → image tile (one saving/note pill top-left, status top-right, flavour count
  bottom-left, a round "+" quick add bottom-right) → brand · ★ rating (count) → name (2 lines) → "13 flavours ·
  Rs 525/serving" → price (bold) + compare-at, "or 3 × Rs X with Koko" under it → points line on desktop hover only.
  Every text row has a fixed height, so rows line up.
  Tile: one cream backdrop, the pack contained with even padding. Packshots with SNH's baked-in orange frame
  (file name contains "SportsNutritionHub" or "snh-frame") are cropped inside the frame; assets/snh-v2.js
  (data-v2-lift) lifts grey studio backgrounds to white so every pack blends into the tile (mix-blend multiply).
  R19: no hover image swap (it flipped the tile to a different backdrop); hover is a shadow + 3 px lift only.
  Tile is a neutral #F7F7F7 (was warm cream, which multiply-blended packs yellow).
  Body: brand · name (2 lines, whole words) · Judge.me stars (reviews.rating metafields, hidden when none) ·
  one key fact (custom.key_benefits, whole words) · price, compare-at · Koko.
  Quick add: single variant adds in one tap (data-v2-add); multi-variant opens the theme's quick-buy drawer.
  Round 11 adds per-serving price (custom.servings or "N servings" in the title) and the tier-aware earn line
  (rates from Theme settings → SNH Elite, tier from custom.loyalty_tier; guests see the Bronze rate and a sign-in link).
  product, sizes (optional), eager (optional)
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign img_sizes = sizes | default: '(max-width: 767px) 60vw, (max-width: 1199px) 33vw, 25vw'
  assign title_full = product.title | escape
  # Choose (quick buy) only when there is a real choice; a single named variant adds in one tap
  assign multi = false
  if product.variants.size > 1
    assign multi = true
  endif
  assign third = product.price | divided_by: 300.0 | round | times: 100
  capture retail
    render 'snh-v2-retail', product: product
  endcapture
  assign retail = retail | strip | plus: 0

  assign tags = product.tags | join: '|' | downcase
  assign badges = ''
  if product.available == false
    assign badges = ',Sold out'
  else
    if retail > product.price
      assign badges = ',Sale'
    endif
    assign custom_badges = product.metafields.custom.badges.value
    for cb in custom_badges
      assign badges = badges | append: ',' | append: cb
    endfor
    if tags contains 'bestseller' or tags contains 'best seller' or tags contains 'best-seller'
      unless badges contains 'Bestseller'
        assign badges = badges | append: ',Bestseller'
      endunless
    endif
    if tags contains 'informed sport' or tags contains 'informed-sport'
      assign badges = badges | append: ',Informed Sport'
    endif
    assign now_s = 'now' | date: '%s' | plus: 0
    assign made_s = product.created_at | date: '%s' | plus: 0
    assign age = now_s | minus: made_s
    if age < 3888000
      assign badges = badges | append: ',New'
    endif
  endif
  assign badge_list = badges | remove_first: ',' | split: ','

  assign img1 = product.featured_media.preview_image | default: product.featured_image
  assign f1 = img1.src | split: '?' | first | downcase
  assign framed1 = false
  if f1 contains 'sportsnutritionhub' or f1 contains 'snh-frame'
    assign framed1 = true
  endif
  assign chip = ''
  if multi
    for option in product.options_with_values
      assign oname = option.name | downcase
      if option.values.size < 2
        continue
      endif
      if oname contains 'flavo'
        assign chip = option.values.size | append: ' flavours'
        break
      elsif oname contains 'size' and chip == ''
        assign chip = option.values.size | append: ' sizes'
      endif
    endfor
  endif

  assign facts = product.metafields.custom.key_benefits.value
  unless product.metafields.custom.key_benefits.type contains 'list'
    assign facts = facts | newline_to_br | split: '<br />'
  endunless
  assign fact = ''
  for f in facts
    assign t = f | strip_html | split: ':' | first | remove: '•' | remove: '✔' | remove: '✓' | strip
    for i in (1..3)
      assign c1 = t | slice: 0
      if c1 == "'" or c1 == '-' or c1 == '–' or c1 == '—' or c1 == '*' or c1 == '"'
        assign t = t | slice: 1, 400 | strip
      endif
    endfor
    if t != blank
      assign fact = t
      break
    endif
  endfor

  assign r_count = product.metafields.reviews.rating_count.value | plus: 0
  assign r_value = product.metafields.reviews.rating.value.rating | default: 0 | round: 1

  # saving pill (old card: "Save Rs X", else a note), status badges top-right
  assign saving = 0
  if retail > product.price
    assign saving = retail | minus: product.price
  endif
  assign note = ''
  assign status = ''
  assign is_inf = false
  for b in badge_list
    case b
      when 'Sale'
      when 'Sold out'
        assign status = status | append: ',Sold out'
      when 'Informed Sport'
        assign is_inf = true
      when 'New', 'Bestseller'
        if note == ''
          assign note = b
        endif
      else
        assign status = status | append: ',' | append: b
    endcase
  endfor
  assign status_list = status | remove_first: ',' | split: ','

  # options line: flavours / sizes / options, else the product type; then price per serving when we know servings
  assign sub = chip
  if sub == blank and multi
    assign sub = product.variants.size | append: ' options'
  endif
  if sub == blank
    assign sub = product.type
    assign up_t = sub | upcase
    if up_t == sub
      assign sub = sub | downcase | capitalize
    endif
  endif
  capture txt
    echo product.title | append: ' ' | append: v.title
  endcapture
  capture sv
    render 'snh-servings', product: product, text: txt
  endcapture
  assign sv = sv | strip | plus: 0
  assign per = 0
  if sv > 1
    assign per = v.price | divided_by: sv | divided_by: 100.0 | round | times: 100
  endif

  # SNH Elite earn line: the member's tier rate, guests the entry rate
  assign rate = settings.snh_rate_bronze | default: 3
  assign t = customer.metafields.custom.loyalty_tier.value | downcase
  if t == 'silver'
    assign rate = settings.snh_rate_silver | default: 7
  elsif t == 'gold' or t == 'maxed out'
    assign rate = settings.snh_rate_gold | default: 10
  endif
  assign pv = settings.snh_point_value | default: 1
  assign earn = product.price | times: rate | divided_by: 100 | times: pv | divided_by: 100.0 | round | times: 100
-%}

{%- liquid
  # 14 Nov: bundle cards carry the green "BUNDLE" ribbon inside their own photo (top right), so the Informed Sport badge moves
  assign pc_bundle = false
  assign pc_pt = product.type | downcase
  assign pc_tg = product.tags | join: ',' | downcase
  if pc_pt contains 'bundle' or pc_tg contains 'bundle' or product.variants.first.requires_components
    assign pc_bundle = true
  endif
-%}
<product-card class="card pc{% if pc_bundle %} pc--bundle{% endif %}{% unless product.available %} pc--out card--out{% endunless %}" handle="{{ product.handle }}"{% if position %} style="--o: {{ position | times: 10 }}"{% endif %}>
  <div class="pc__frame">
    <a class="card__tile pc__shot" href="{{ product.url }}" aria-label="{{ title_full }}" tabindex="-1">
      {%- capture clean1 -%}{% render 'snh-clean-img', product: product %}{%- endcapture -%}{%- assign clean1 = clean1 | strip -%}
      {%- if clean1 != blank -%}
        <span class="card__img is-clean"><img src="{{ clean1 }}" alt="" width="700" height="700" {% if eager %}loading="eager" fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %} data-no-lift></span>
      {%- elsif img1 -%}
        <span class="card__img{% if framed1 %} is-framed{% endif %}">
          {%- if eager -%}
            {{- img1 | image_url: width: 800 | image_tag: width: 600, height: 600, loading: 'eager', fetchpriority: 'high', sizes: img_sizes, widths: '300,400,600,800', alt: '', data-v2-lift: '' -}}
          {%- else -%}
            {{- img1 | image_url: width: 800 | image_tag: width: 600, height: 600, loading: 'lazy', decoding: 'async', sizes: img_sizes, widths: '300,400,600,800', alt: '', data-v2-lift: '' -}}
          {%- endif -%}
        </span>
      {%- else -%}
        <span class="card__img">{{ 'product-1' | placeholder_svg_tag: 'card__ph' }}</span>
      {%- endif -%}
    </a>
    {%- if saving > 0 and product.available -%}
      <span class="pc__badge">Save {{ saving | money_without_trailing_zeros }}</span>
    {%- elsif note != blank -%}
      <span class="pc__badge pc__badge--note">{{ note | escape }}</span>
    {%- endif -%}
    {%- if status_list.size > 0 -%}
      <ul class="pc__status" role="list">{%- for b in status_list limit: 2 -%}<li class="pc__st pc__st--{{ b | handleize }}">{{ b | escape }}</li>{%- endfor -%}</ul>
    {%- endif -%}
    {%- if chip != blank -%}<span class="pc__chip">{{ chip }}</span>{%- endif -%}
    {%- if is_inf -%}<span class="pc__inf" title="Informed Sport certified"><img src="{{ 'snh-informed-sport-white.png' | asset_url }}" alt="Informed Sport certified" width="34" height="34" loading="lazy" data-no-lift></span>{%- endif -%}
    {%- capture qb -%}v2-qb-{{ section.id }}-{{ product.id }}{%- endcapture -%}
    {%- if product.available and price_note == blank -%}
      {%- comment -%} Round 13: one round "+" on the image: single variant adds in one tap, several open the SNH quick-buy sheet (assets/snh-quick.js) {%- endcomment -%}
      {%- if multi -%}
        <button class="pc__plus" type="button" data-v2-pick="{{ product.handle }}" aria-haspopup="dialog" aria-label="Choose options for {{ title_full }}">{% render 'snh-v2-icon', name: 'plus' %}</button>
      {%- else -%}
        <button class="pc__plus" type="button" data-v2-add="{{ v.id }}" aria-label="Add {{ title_full }} to basket">{% render 'snh-v2-icon', name: 'plus' %}</button>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="pc__body">
    <div class="pc__top">
      {%- comment -%} 11 Nov: no brand line on bundles (they're all "Sports Nutrition Hub") {%- endcomment -%}
      {%- assign is_bundle = false -%}{%- assign pt = product.type | downcase -%}{%- assign tg = product.tags | join: ',' | downcase -%}
      {%- if pt contains 'bundle' or tg contains 'bundle' or product.variants.first.requires_components -%}{%- assign is_bundle = true -%}{%- endif -%}
      {%- unless is_bundle -%}<p class="pc__brand">{{ product.vendor | escape }}</p>{%- endunless -%}
      {%- if r_count > 0 -%}
        <p class="pc__rating" role="img" aria-label="Rated {{ r_value }} out of 5 from {{ r_count }} reviews"><span class="pc__star" aria-hidden="true">★</span><span aria-hidden="true">{{ r_value }} <span class="pc__count">({{ r_count }})</span></span></p>
      {%- endif -%}
    </div>
    {%- capture short -%}{% render 'snh-v2-title', product: product, short: true %}{%- endcapture -%}
    <h3 class="pc__name"><a href="{{ product.url }}" title="{{ title_full }}">{{ short | strip }}</a></h3>
    <p class="pc__sub">{{ sub | escape }}{% if per > 0 %} · <span class="pc__per">{{ per | money_without_trailing_zeros }}/serving</span>{% endif %}</p>
    {%- if price_note != blank -%}
    {%- comment -%} Round 17: wholesale grids show a note instead of the retail price, Koko line, quick-add and earn line {%- endcomment -%}
    <div class="pc__foot pc__foot--req"><p class="pc__req">{{ price_note | escape }}</p></div>
    {%- else -%}
    <div class="pc__foot">
      <p class="pc__price{% if saving > 0 %} pc__price--sale{% endif %}">
        <span class="pc__now">{% if product.price_varies %}<span class="pc__from">From </span>{% endif %}{{ product.price | money_without_trailing_zeros }}</span>
        {%- if saving > 0 -%}<s class="pc__was"><span class="v-sr">Was </span>{{ retail | money_without_trailing_zeros }}</s><span class="pc__save">Save {{ saving | money_without_trailing_zeros }}</span>{%- endif -%}
      </p>
      {%- if product.available -%}
        <p class="pc__koko">or 3 × {{ third | money_without_trailing_zeros }} <span class="pc__with">with </span>{% render 'snh-koko-logo', h: 14, class: 'pc__kk' %}</p>
      {%- else -%}
        <p class="pc__koko pc__koko--out">Sold out</p>
      {%- endif -%}
    </div>
    {%- comment -%} points: desktop hover only (hidden on touch / phones) {%- endcomment -%}
    {%- endif -%}
    {%- if price_note != blank -%}{%- elsif customer -%}
      <p class="pc__earn">Earn <strong>{{ earn | money_without_trailing_zeros }}</strong> back in points</p>
    {%- else -%}
      <a class="pc__earn" href="{{ routes.account_login_url }}" tabindex="-1">Sign in to earn <strong>{{ earn | money_without_trailing_zeros }}</strong> back</a>
    {%- endif -%}
  </div>
</product-card>
