{%- comment -%}
  SNH v2 product card (prototype card anatomy): packshot tile, badge, quick add, brand, name, two key facts,
  price + compare-at, Koko line. Facts come from product.metafields.custom.key_benefits (first two lines).
  product, sizes (optional), eager (optional)
  Single-variant products add in one tap (assets/snh-v2.js, data-v2-add); multi-variant products open the
  theme's quick-buy drawer.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign img_sizes = sizes | default: '(max-width: 899px) 50vw, 25vw'
  assign img_alt = product.featured_image.alt | default: product.title
  assign third = product.price | divided_by: 300.0 | round | times: 100
  assign multi = false
  if product.has_only_default_variant == false
    assign multi = true
  endif
  assign badge = ''
  if product.available == false
    assign badge = 'Sold out'
  elsif product.compare_at_price > product.price
    assign badge = 'Sale'
  endif
  assign custom_badges = product.metafields.custom.badges.value
  if badge == blank and custom_badges != blank
    assign badge = custom_badges | first
  endif
  assign facts = product.metafields.custom.key_benefits.value | default: product.metafields.custom.key_benefits
  if facts != blank and facts.first == nil
    assign facts = facts | newline_to_br | split: '<br />'
  endif
-%}
<article class="card{% unless product.available %} card--out{% endunless %}">
  <div class="card__media">
    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
      {%- if badge != blank -%}<span class="v-badge{% if badge == 'Sale' or badge == 'Bestseller' %} v-badge--accent{% endif %}">{{ badge | escape }}</span>{%- endif -%}
      <div class="shot">
        {%- if product.featured_image -%}
          {{- product.featured_image | image_url: width: 800 | image_tag: width: 600, height: 600, loading: 'lazy', decoding: 'async', sizes: img_sizes, widths: '400,600,800', alt: img_alt -}}
        {%- endif -%}
      </div>
    </a>
    {%- if product.available -%}
      {%- if multi -%}
        {%- capture qb -%}v2-qb-{{ section.id }}-{{ product.id }}{%- endcapture -%}
        <button class="quick" type="button" aria-controls="{{ qb }}" aria-expanded="false" aria-label="Choose options for {{ product.title | escape }}">{% render 'snh-v2-icon', name: 'plus' %}</button>
        <quick-buy-drawer id="{{ qb }}" header-bordered open-from="bottom" handle="{{ product.handle }}?variant={{ v.id }}" role="region" aria-live="polite" class="quick-buy-drawer drawer"></quick-buy-drawer>
      {%- else -%}
        <button class="quick" type="button" data-v2-add="{{ v.id }}" aria-label="Add {{ product.title | escape }} to basket">{% render 'snh-v2-icon', name: 'plus' %}<span class="quick__tick">{% render 'snh-v2-icon', name: 'check' %}</span></button>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="card__body">
    {%- if product.vendor != blank -%}<p class="card__brand eyebrow">{{ product.vendor | escape }}</p>{%- endif -%}
    <a href="{{ product.url }}" class="card__name">{% render 'snh-v2-title', product: product, short: true %}</a>
    {%- liquid
      assign fact1 = ''
      for fact in facts
        assign f = fact | strip_html | split: ':' | first | remove: '•' | remove: '✔' | remove: '✓' | strip
        if f != blank
          assign fact1 = f
          break
        endif
      endfor
      assign fact2 = ''
      if multi
        for option in product.options_with_values
          assign oname = option.name | downcase
          if option.values.size < 2
            continue
          endif
          if oname contains 'flavo'
            assign fact2 = option.values.size | append: ' flavours'
          elsif oname contains 'size' and fact2 == ''
            assign fact2 = option.values.size | append: ' sizes'
          endif
        endfor
        if fact2 == '' and product.variants.size > 1
          assign fact2 = product.variants.size | append: ' options'
        endif
      endif
    -%}
    {%- if fact1 != blank or fact2 != blank -%}
      <ul class="card__stats">
        {%- if fact1 != blank -%}<li><span>{{ fact1 | escape }}</span></li>{%- endif -%}
        {%- if fact2 != blank -%}<li><span>{{ fact2 }}</span></li>{%- endif -%}
      </ul>
    {%- endif -%}
    <p class="card__price"><span class="card__now">{% if product.price_varies %}From {% endif %}{{ product.price | money_without_trailing_zeros }}</span>
      {%- if product.compare_at_price > product.price -%}<s class="card__per">{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}</p>
    <p class="card__koko">or 3 × <b>{{ third | money_without_trailing_zeros }}</b> with Koko</p>
  </div>
</article>
