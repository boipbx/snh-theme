{% comment %}
  SNH checkout router v2 — Koko branded UI
  Render this snippet once, immediately before </body> in layout/theme.liquid:
  {% render 'koko-checkout-modal' %}

  It catches:
  - cart page Checkout buttons
  - dynamically rendered cart-drawer / mini-cart Checkout buttons
  - Shopify's unbranded product-page "Buy it now" button

  Add to Cart is intentionally left untouched.

  v2.1 — UI refresh only. The <script> block below is byte-identical to v2:
  Round 12: v2 restyle + the order summary / points / last add-on / delivery layer (assets/snh-precheckout.js).
  The script block is still byte-identical:
  no worker URL, payload, interception, focus-trap or redirect logic was touched.
{% endcomment %}

<style>
  /* Round 12: v2 restyle (Inter, the 12–96 scale, 4px grid, 12/16/20 radii). Phones: a bottom sheet. */
  #snh-pay-router { --pr-ink: #0C0C0D; --pr-grey: #55524E; --pr-grey2: #6B6762; --pr-line: #E6E1D8; --pr-cream: #F6F3EE; --pr-accent: #E0521C; --pr-green: #1E7A43; --pr-koko: #021FA3; --pr-sans: var(--sans, Inter, system-ui, sans-serif); }
  html.snh-pay-lock, html.snh-pay-lock body { overflow: hidden !important; }
  #snh-pay-router[hidden] { display: none !important; }
  #snh-pay-router { position: fixed; inset: 0; z-index: 2147483646; display: grid; place-items: center; padding: 24px; background: rgba(12, 12, 13, .56); }
  .snh-pay-dialog { position: relative; display: grid; gap: 16px; width: min(600px, 100%); max-height: calc(100dvh - 48px); overflow: auto; padding: 24px; border-radius: 20px; background: #fff; color: var(--pr-ink); box-shadow: 0 24px 64px rgba(12, 12, 13, .28); font: 400 15px/1.5 var(--pr-sans); }
  .snh-pay-dialog *, .snh-pay-dialog *::before, .snh-pay-dialog *::after { box-sizing: border-box; }
  .snh-pay-brand-rail { display: none; }
  .snh-pay-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .snh-pay-title { margin: 0; font: 600 24px/1.1 var(--pr-sans); letter-spacing: -.02em; color: var(--pr-ink); }
  .snh-pay-close { display: grid; place-items: center; width: 44px; height: 44px; margin: -10px -10px -10px 0; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--pr-ink); cursor: pointer; }
  .snh-pay-close:hover { background: var(--pr-cream); }
  .snh-pay-close:focus-visible, .snh-pay-option:focus-visible, .spc button:focus-visible, .spc a:focus-visible { outline: 2px solid var(--pr-accent); outline-offset: 2px; }
  .snh-pay-close svg { width: 22px; height: 22px; }
  .snh-pay-content { display: grid; gap: 16px; }
  /* the summary: items, total, savings, points, delivery, one last add-on */
  .spc { display: grid; gap: 12px; }
  .spc[hidden] { display: none; }
  .spc__card { display: grid; gap: 4px; padding: 16px; border-radius: 12px; background: var(--pr-cream); }
  .spc__row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font-size: 14px; color: var(--pr-grey); }
  .spc__row b { font: 600 20px/1.1 var(--pr-sans); letter-spacing: -.02em; color: var(--pr-ink); font-variant-numeric: tabular-nums; }
  .spc__save { font: 600 13px/1.5 var(--pr-sans); color: var(--pr-green); }
  .spc__line { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 13px; color: var(--pr-grey); }
  .spc__line svg { width: 16px; height: 16px; flex: none; color: var(--pr-accent); }
  .spc__line b { color: var(--pr-ink); font-weight: 600; }
  .spc__line button { padding: 0; border: 0; background: none; font: 600 13px/1.5 var(--pr-sans); color: var(--pr-ink); text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .spc__add { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 8px 8px 8px 8px; border: 1px solid var(--pr-line); border-radius: 12px; }
  .spc__add[hidden] { display: none; }
  .spc__add img { width: 48px; height: 48px; border-radius: 8px; background: var(--pr-cream); object-fit: contain; mix-blend-mode: multiply; }
  .spc__add p { margin: 0; min-width: 0; font-size: 13px; color: var(--pr-grey); }
  .spc__add p b { display: block; overflow: hidden; font-weight: 500; color: var(--pr-ink); white-space: nowrap; text-overflow: ellipsis; }
  .spc__add button { display: inline-flex; align-items: center; gap: 4px; height: 36px; padding: 0 16px; border: 0; border-radius: 999px; background: var(--pr-ink); color: #fff; font: 600 13px/1.1 var(--pr-sans); cursor: pointer; }
  .spc__add button:hover { background: var(--pr-accent); }
  .spc__add button[aria-busy="true"] { opacity: .5; }
  .spc__add.is-added { border-color: rgba(30, 122, 67, .4); background: #EEF8F1; }
  /* the two payment cards */
  .snh-pay-options { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .snh-pay-option { display: grid; grid-template-rows: auto auto 1fr auto; align-content: start; gap: 4px; width: 100%; min-height: 200px; padding: 16px; border: 1px solid var(--pr-line); border-radius: 16px; background: #fff; color: var(--pr-ink); text-align: left; font: inherit; cursor: pointer; transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease; }
  .snh-pay-option:hover { border-color: var(--pr-ink); box-shadow: 0 12px 32px -16px rgba(12, 12, 13, .3); transform: translateY(-2px); }
  .snh-pay-option--koko { border-color: rgba(2, 31, 163, .25); background: #F5F7FF; }
  .snh-pay-option--koko:hover { border-color: var(--pr-koko); }
  .snh-pay-option:disabled { opacity: .55; cursor: progress; transform: none; }
  .snh-pay-mark { display: flex; align-items: center; gap: 4px; height: 28px; margin-bottom: 8px; }
  .snh-pay-mark svg, .snh-pay-mark .spc-pay { width: 36px; height: 24px; }
  .snh-pay-card-icon { display: none; }
  .snh-koko-logo { width: auto; height: 22px; }
  .snh-pay-option-title { font: 600 16px/1.5 var(--pr-sans); }
  .snh-pay-option-copy { font-size: 13px; color: var(--pr-grey); }
  .snh-pay-koko-pill { justify-self: start; display: inline-flex; align-items: center; height: 28px; margin-top: 8px; padding: 0 12px; border-radius: 999px; background: var(--pr-koko); color: #fff; font: 600 13px/1.1 var(--pr-sans); font-variant-numeric: tabular-nums; }
  .snh-pay-option-action { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; font: 600 14px/1.5 var(--pr-sans); color: var(--pr-accent); }
  .snh-pay-option--koko .snh-pay-option-action { color: var(--pr-koko); }
  .snh-pay-option-action svg { width: 18px; height: 18px; transition: transform 160ms ease; }
  .snh-pay-option:hover .snh-pay-option-action svg { transform: translateX(4px); }
  .snh-pay-feedback { display: grid; gap: 8px; }
  .snh-pay-status { display: none; align-items: center; gap: 8px; font-size: 13px; color: var(--pr-grey); }
  .snh-pay-status[data-active="true"] { display: flex; }
  .snh-pay-spinner { width: 16px; height: 16px; border: 2px solid var(--pr-line); border-top-color: var(--pr-koko); border-radius: 50%; animation: snh-pay-spin .8s linear infinite; }
  .snh-pay-error { display: none; padding: 12px 16px; border-radius: 12px; background: #FDECEA; color: #A3271D; font-size: 13px; }
  .snh-pay-error:not(:empty) { display: block; }
  .spc__secure { display: flex; align-items: center; justify-content: center; gap: 4px; margin: 0; font-size: 12px; color: var(--pr-grey2); }
  .spc__secure svg { width: 14px; height: 14px; }
  @keyframes snh-pay-spin { to { transform: rotate(360deg); } }
  @media (max-width: 640px) {
    #snh-pay-router { place-items: end stretch; padding: 0; }
    .snh-pay-dialog { width: 100%; max-height: 92dvh; padding: 20px 20px calc(20px + env(safe-area-inset-bottom)); border-radius: 20px 20px 0 0; }
    .snh-pay-title { font-size: 20px; }
    .snh-pay-options { grid-template-columns: 1fr; gap: 8px; }
    .snh-pay-option { grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto auto; gap: 4px 12px; min-height: 0; padding: 12px 16px; align-items: center; }
    .snh-pay-mark { grid-column: 1; height: 20px; margin: 0 0 4px; }
    .snh-pay-mark svg { width: 30px; height: 20px; }
    .snh-koko-logo { height: 16px; }
    .snh-pay-option-title { grid-column: 1; font-size: 15px; }
    .snh-pay-option-copy { grid-column: 1; font-size: 12px; }
    .snh-pay-koko-pill { grid-column: 2; grid-row: 1 / 4; margin: 0; }
    .snh-pay-option-action { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .snh-pay-option, .snh-pay-option-action svg { transition: none; } .snh-pay-option:hover { transform: none; } .snh-pay-spinner { animation-duration: 2.4s; } }
</style>

<div id="snh-pay-router" hidden aria-hidden="true">
  <section
    class="snh-pay-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="snh-pay-title"
  >
    <div class="snh-pay-brand-rail" aria-hidden="true">
      <span></span><span></span>
    </div>

    <header class="snh-pay-header">
      <h2 id="snh-pay-title" class="snh-pay-title">How would you like to pay?</h2>

      <button type="button" class="snh-pay-close" data-snh-pay-close aria-label="Close payment options">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div class="snh-pay-content">
      {%- comment -%} Round 12: filled by assets/snh-precheckout.js when the router opens (Koko's script below is untouched) {%- endcomment -%}
      <div class="spc" data-spc hidden>
        <div class="spc__card">
          <p class="spc__row"><span data-spc-items></span><b data-spc-total></b></p>
          <p class="spc__save" data-spc-save hidden></p>
        </div>
        <p class="spc__line" data-spc-points hidden></p>
        <div class="spc__add" data-spc-add hidden></div>
        <p class="spc__line" data-spc-eta hidden></p>
      </div>
      <div class="snh-pay-options">
        <button type="button" class="snh-pay-option snh-pay-option--regular" data-snh-pay-regular>
          <span class="snh-pay-mark" aria-hidden="true">
            {%- assign pr_types = 'visa,master,american_express' | split: ',' -%}{%- for t in pr_types -%}{{ t | payment_type_svg_tag }}{%- endfor -%}
            <span class="snh-pay-card-icon">
              <svg viewBox="0 0 32 24" fill="none">
                <rect x="1" y="2" width="30" height="20" rx="2.5" fill="currentColor"/>
                <path d="M1 7.5h30v4.5H1z" fill="#fff8f4"/>
                <rect x="5" y="15.5" width="9" height="2.6" rx="1.3" fill="#fff8f4"/>
              </svg>
            </span>
          </span>
          <span class="snh-pay-option-title">Card, COD &amp; more</span>
          <span class="snh-pay-option-copy">Visa, Mastercard, Amex, cash on delivery, bank transfer or a gift voucher.</span>
          <span class="snh-pay-option-action">
            Continue
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>

        <button type="button" class="snh-pay-option snh-pay-option--koko" data-snh-pay-koko>
          <span class="snh-pay-mark" aria-hidden="true">
            <img
              class="snh-koko-logo"
              src="https://paykoko.com/img/logo1.7ff549c0.png"
              width="215"
              height="98"
              alt=""
              decoding="async"
            >
          </span>
          <span class="snh-pay-option-title">Koko - Pay in 3</span>
          <span class="snh-pay-option-copy">Split it into 3 interest-free payments. Koko's fee is shown at checkout.</span>
          <span class="snh-pay-koko-pill" data-spc-koko>Pay in 3</span>
          <span class="snh-pay-option-action">
            Continue with Koko
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
      </div>

      <div class="snh-pay-feedback">
        <div class="snh-pay-status" data-snh-pay-status role="status" aria-live="polite">
          <span class="snh-pay-spinner" aria-hidden="true"></span>
          <span data-snh-pay-status-text>Preparing your Koko checkout…</span>
        </div>

        <div class="snh-pay-error" data-snh-pay-error role="alert"></div>
      </div>
      <p class="spc__secure"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4.5" y="10" width="15" height="10.5" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" stroke="currentColor" stroke-width="1.8"/></svg>Secure checkout by Shopify</p>
    </div>
  </section>
</div>

<script>
  (function () {
    'use strict';

    if (window.__snhPayRouterV2Installed) return;
    window.__snhPayRouterV2Installed = true;

    var WORKER_URL = 'https://koko-fee-snh.raspy-wind-fe2d.workers.dev/';
    var root = document.getElementById('snh-pay-router');
    if (!root) return;

    var dialog = root.querySelector('.snh-pay-dialog');
    var closeButton = root.querySelector('[data-snh-pay-close]');
    var regularButton = root.querySelector('[data-snh-pay-regular]');
    var kokoButton = root.querySelector('[data-snh-pay-koko]');
    var statusBox = root.querySelector('[data-snh-pay-status]');
    var statusText = root.querySelector('[data-snh-pay-status-text]');
    var errorBox = root.querySelector('[data-snh-pay-error]');

    var pending = null;
    var previousFocus = null;
    var requestController = null;
    var requestNumber = 0;
    var bypassInterception = false;

    function routeRoot() {
      return window.Shopify && window.Shopify.routes && window.Shopify.routes.root
        ? window.Shopify.routes.root
        : '/';
    }

    function cartJsonUrl() {
      return routeRoot().replace(/\/?$/, '/') + 'cart.js';
    }

    function elementLabel(element) {
      var value = element && element.value ? element.value : '';
      var text = element && element.textContent ? element.textContent : '';
      return String(value || text).replace(/\s+/g, ' ').trim().toLowerCase();
    }

    function checkoutHref(element) {
      if (!element || element.tagName !== 'A') return false;
      var href = element.getAttribute('href');
      if (!href) return false;

      try {
        var url = new URL(href, window.location.origin);
        return url.origin === window.location.origin && /\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?checkout\/?$/i.test(url.pathname);
      } catch (error) {
        return false;
      }
    }

    function classifyControl(element) {
      if (!element || !(element instanceof Element)) return null;
      if (root.contains(element)) return null;

      var isClickable = element.matches('button, input[type="submit"], input[type="button"], a, [role="button"]');
      if (!isClickable) return null;

      if (element.matches('[data-snh-checkout-trigger]')) {
        return element.matches('[data-snh-product-buy-now]') ? 'product' : 'cart';
      }

      if (element.matches('.shopify-payment-button__button--unbranded')) return 'product';

      var label = elementLabel(element);
      if (label === 'buy it now' || label === 'buy now') return 'product';

      if (
        element.matches('button[name="checkout"], input[name="checkout"]') ||
        checkoutHref(element) ||
        label === 'checkout' ||
        label === 'secure checkout'
      ) {
        return 'cart';
      }

      return null;
    }

    function controlFromEvent(event) {
      var path = typeof event.composedPath === 'function' ? event.composedPath() : [];
      for (var index = 0; index < path.length; index += 1) {
        var kind = classifyControl(path[index]);
        if (kind) return { control: path[index], kind: kind, path: path };
      }

      var node = event.target;
      while (node && node !== document) {
        var fallbackKind = classifyControl(node);
        if (fallbackKind) return { control: node, kind: fallbackKind, path: [] };
        node = node.parentElement;
      }
      return null;
    }

    function setBusy(value, message) {
      regularButton.disabled = Boolean(value);
      kokoButton.disabled = Boolean(value);
      statusBox.dataset.active = value ? 'true' : 'false';
      if (message) statusText.textContent = message;
    }

    function showError(message) {
      errorBox.textContent = message || '';
    }

    function cancelRequest() {
      requestNumber += 1;
      if (requestController) requestController.abort();
      requestController = null;
      setBusy(false);
    }

    function openRouter(action) {
      cancelRequest();
      pending = action;
      previousFocus = document.activeElement;
      showError('');
      root.hidden = false;
      root.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('snh-pay-lock');
      window.requestAnimationFrame(function () {
        regularButton.focus();
      });
    }

    function closeRouter(options) {
      var settings = options || {};
      if (settings.abort !== false) cancelRequest();
      root.hidden = true;
      root.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('snh-pay-lock');
      showError('');

      if (settings.restoreFocus !== false && previousFocus && previousFocus.isConnected) {
        previousFocus.focus();
      }

      if (settings.clearPending !== false) pending = null;
    }

    function hardReset() {
      cancelRequest();
      root.hidden = true;
      root.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('snh-pay-lock');
      showError('');
      pending = null;
      previousFocus = null;
    }

    function interceptClick(event) {
      if (bypassInterception || root.contains(event.target)) return;

      var action = controlFromEvent(event);
      if (!action) return;

      event.preventDefault();
      event.stopImmediatePropagation();
      openRouter(action);
    }

    function interceptSubmit(event) {
      if (bypassInterception || root.contains(event.target)) return;

      var submitter = event.submitter;
      var kind = submitter ? classifyControl(submitter) : null;
      if (!kind && event.target && /\/cart\/?$/i.test(event.target.action || '')) kind = 'cart';
      if (!kind) return;

      event.preventDefault();
      event.stopImmediatePropagation();
      openRouter({ control: submitter || null, form: event.target, kind: kind, path: [] });
    }

    document.addEventListener('click', interceptClick, true);
    document.addEventListener('submit', interceptSubmit, true);

    function resumeNativeCheckout() {
      if (!pending) {
        window.location.assign(routeRoot() + 'checkout');
        return;
      }

      var action = pending;
      closeRouter({ abort: true, restoreFocus: false, clearPending: false });
      bypassInterception = true;

      try {
        if (action.control && action.control.isConnected && typeof action.control.click === 'function') {
          action.control.click();
        } else if (action.form && action.form.isConnected) {
          if (typeof action.form.requestSubmit === 'function') action.form.requestSubmit();
          else action.form.submit();
        } else {
          window.location.assign(routeRoot() + 'checkout');
        }
      } finally {
        window.setTimeout(function () {
          bypassInterception = false;
          pending = null;
        }, 0);
      }
    }

    function productFormForAction(action) {
      if (!action) return null;

      if (action.form && /\/cart\/add/i.test(action.form.action || '')) return action.form;

      if (Array.isArray(action.path)) {
        for (var index = 0; index < action.path.length; index += 1) {
          var item = action.path[index];
          if (item instanceof HTMLFormElement && /\/cart\/add/i.test(item.action || '')) return item;
        }
      }

      if (action.control) {
        if (action.control.form && /\/cart\/add/i.test(action.control.form.action || '')) return action.control.form;
        var closestForm = action.control.closest && action.control.closest('form[action*="/cart/add"]');
        if (closestForm) return closestForm;
      }

      return null;
    }

    function productLine(action) {
      var form = productFormForAction(action);
      if (!form) throw new Error('The selected product could not be read. Please use Add to Cart, then checkout.');

      var data = new FormData(form);
      var variantId = String(data.get('id') || '').trim();
      if (!/^\d+$/.test(variantId)) {
        var idInput = form.querySelector('[name="id"]');
        variantId = idInput ? String(idInput.value || '').trim() : '';
      }
      if (!/^\d+$/.test(variantId)) throw new Error('Please select a product option before checkout.');

      var quantityValue = data.get('quantity');
      if (!quantityValue) {
        var productArea = form.closest('product-info, .shopify-section, [data-section-type*="product"], main');
        var quantityInput = productArea && productArea.querySelector('[name="quantity"]');
        quantityValue = quantityInput ? quantityInput.value : '1';
      }

      var quantity = Number.parseInt(String(quantityValue || '1'), 10);
      if (!Number.isInteger(quantity) || quantity < 1) quantity = 1;

      var properties = {};
      data.forEach(function (value, key) {
        var match = String(key).match(/^properties\[(.+)\]$/);
        if (match && typeof value === 'string' && value !== '') properties[match[1]] = value;
      });

      var sellingPlan = data.get('selling_plan');
      return {
        id: variantId,
        quantity: quantity,
        properties: properties,
        selling_plan: sellingPlan ? String(sellingPlan) : null
      };
    }

    async function readCart() {
      var response = await fetch(cartJsonUrl(), {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      });
      if (!response.ok) throw new Error('Your basket could not be read. Refresh the page and try again.');
      return response.json();
    }

    async function payloadForAction(action) {
      if (action && action.kind === 'product') {
        var line = productLine(action);
        var token = '';
        try {
          var currentCart = await readCart();
          token = currentCart && currentCart.token ? String(currentCart.token) : '';
        } catch (error) {
          token = '';
        }

        return {
          cartToken: 'buy-now:' + (token || window.location.pathname),
          items: [line]
        };
      }

      var cart = await readCart();
      if (!Array.isArray(cart.items) || cart.items.length === 0) throw new Error('Your basket is empty.');

      return {
        cartToken: cart.token || '',
        items: cart.items.map(function (item) {
          return {
            id: String(item.variant_id || item.id),
            quantity: item.quantity,
            properties: item.properties || {},
            selling_plan_allocation: item.selling_plan_allocation || null
          };
        })
      };
    }

    function friendlyWorkerError(code) {
      var messages = {
        origin_not_allowed: 'This storefront address is not yet allowed by the checkout service.',
        variant_not_found: 'One product is no longer available. Refresh your basket and try again.',
        fee_variant_not_found: 'The Koko fee product could not be found. Please contact us.',
        duplicate_fee_variant: 'The Koko fee product needs an administrator check.',
        subscriptions_not_supported: 'Koko checkout is not available for subscription products.',
        bad_cart: 'Your basket could not be prepared for Koko checkout.',
        draft_failed: 'Shopify could not prepare the Koko checkout. Please try again.'
      };
      return messages[code] || 'Koko checkout could not be prepared. Please try again.';
    }

    async function beginKokoCheckout() {
      if (!pending) return;

      var action = pending;
      var currentRequest = requestNumber + 1;
      requestNumber = currentRequest;
      requestController = new AbortController();
      setBusy(true, 'Preparing your Koko checkout…');
      showError('');

      try {
        var payload = await payloadForAction(action);
        if (currentRequest !== requestNumber) return;

        var response = await fetch(WORKER_URL, {
          method: 'POST',
          mode: 'cors',
          credentials: 'omit',
          signal: requestController.signal,
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        var result = await response.json().catch(function () { return {}; });
        if (currentRequest !== requestNumber) return;
        if (!response.ok || !result.url) throw new Error(friendlyWorkerError(result.error));

        setBusy(true, 'Opening Shopify checkout…');
        document.documentElement.classList.remove('snh-pay-lock');
        window.location.assign(result.url);
      } catch (error) {
        if (error && error.name === 'AbortError') return;
        if (currentRequest !== requestNumber) return;
        console.error('SNH Koko checkout:', error);
        showError(error && error.message ? error.message : friendlyWorkerError());
        setBusy(false);
        requestController = null;
      }
    }

    regularButton.addEventListener('click', resumeNativeCheckout);
    kokoButton.addEventListener('click', beginKokoCheckout);

    closeButton.addEventListener('click', function () {
      closeRouter({ abort: true });
    });

    root.addEventListener('click', function (event) {
      if (event.target === root) closeRouter({ abort: true });
    });

    document.addEventListener('keydown', function (event) {
      if (root.hidden) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeRouter({ abort: true });
        return;
      }

      if (event.key !== 'Tab') return;
      var focusable = Array.prototype.slice.call(
        dialog.querySelectorAll('button:not(:disabled), a[href], input:not(:disabled), [tabindex]:not([tabindex="-1"])')
      );
      if (!focusable.length) return;

      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('pageshow', hardReset);
    window.addEventListener('pagehide', function () {
      document.documentElement.classList.remove('snh-pay-lock');
    });
  })();
</script>
<script src="{{ 'snh-precheckout.js' | asset_url }}" defer></script>
