{%- liquid
  assign here = collection.handle | default: ''
  assign goal_rows = goal_map | strip | split: ';'
  assign goal_line = ''
  for row in goal_rows
    assign parts = row | strip | split: '>'
    assign key = parts[0] | strip
    if key == here and goal_line == ''
      assign goal_line = parts[1]
    endif
  endfor
  if goal_line == ''
    for row in goal_rows
      assign parts = row | strip | split: '>'
      assign key = parts[0] | strip
      if key == 'default'
        assign goal_line = parts[1]
      endif
    endfor
  endif
  assign goal_items = goal_line | strip | split: ','
-%}

{%- comment -%}
  Paste this same file into BOTH snippets/facets-vertical.liquid and
  snippets/facets-horizontal.liquid — the theme picks a different one per
  layout setting, and these guards let one file serve either slot.
{%- endcomment -%}
{%- if show_filters == nil -%}{%- assign show_filters = true -%}{%- endif -%}
{%- if show_sort_by == nil -%}{%- assign show_sort_by = true -%}{%- endif -%}
{%- if update_on_change == nil -%}{%- assign update_on_change = true -%}{%- endif -%}

{%- assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ',' -%}
{%- capture id_prefix -%}snhbar-{{ section.id }}{%- endcapture -%}

{%- comment -%} which groups are worth showing, and which one is the brand {%- endcomment -%}
{%- assign brand_param = '' -%}
{%- assign useful_params = '' -%}
{%- assign active_total = 0 -%}
{%- for filter in results.filters -%}
  {%- assign lbl = filter.label | downcase -%}
  {%- assign active_total = active_total | plus: filter.active_values.size -%}
  {%- if filter.type == 'boolean' or filter.param_name == 'filter.v.availability' -%}
    {%- assign useful_params = useful_params | append: filter.param_name | append: ',' -%}
  {%- elsif filter.type == 'price_range' -%}
    {%- if filter.range_max > 0 -%}
      {%- assign useful_params = useful_params | append: filter.param_name | append: ',' -%}
    {%- endif -%}
  {%- else -%}
    {%- assign pickable = 0 -%}
    {%- for v in filter.values -%}
      {%- if v.count > 0 or v.active -%}{%- assign pickable = pickable | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if pickable > 1 -%}
      {%- assign useful_params = useful_params | append: filter.param_name | append: ',' -%}
      {%- if brand_param == '' -%}
        {%- if lbl contains 'brand' or lbl contains 'vendor' -%}
          {%- assign brand_param = filter.param_name -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign useful_list = useful_params | split: ',' -%}

<form id="facet-form" is="facet-form" section-id="{{ section.id }}" {% if update_on_change %}update-on-change{% endif %} method="GET" action="{{ request.path }}" class="snh-bar-form">
  <input type="hidden" name="page" value="">
  <input type="hidden" name="section_id" value="{{ section.id }}" disabled>

  {%- if results.current_type != blank or results.current_vendor != blank -%}
    <input type="hidden" name="q" value="{{ results.current_vendor | default: results.current_type | escape }}">
  {%- endif -%}
  {%- if request.page_type == 'search' -%}
    <input type="hidden" name="q" value="{{ results.terms | escape }}">
    <input type="hidden" name="type" value="product">
  {%- endif -%}
  {%- unless show_sort_by -%}
    {%- if results.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ results.sort_by }}">{%- endif -%}
  {%- endunless -%}

  <div class="snh-bar" data-snh-bar>

    {%- comment -%} ── quick find: narrows the rails below, or searches the store ── {%- endcomment -%}
    <div class="snh-find" data-snh-find-wrap>
      <svg class="snh-find__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.7"/><path d="m20 20-3.4-3.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      <input class="snh-find__input" type="text" data-snh-quick autocomplete="off"
             placeholder="{% if collection.title != blank %}Narrow {{ collection.title | downcase | escape }} &mdash; brand, goal or product{% else %}Find a brand, goal or product{% endif %}"
             aria-label="Narrow this collection">
      <button type="button" class="snh-find__clear" data-snh-quick-clear aria-label="Clear" hidden>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </button>
      <span class="snh-find__count" data-snh-quick-count hidden></span>
      <a class="snh-find__all" href="{{ routes.search_url }}?q=" data-snh-quick-search hidden>
        Search all products <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    {%- comment -%} ── goals: real collections, so they work without JS ── {%- endcomment -%}
    {%- capture goal_chips -%}
      {%- for item in goal_items -%}
        {%- liquid
          assign bits = item | strip | split: '|'
          assign gh = bits[0] | strip
          assign gl = bits[1] | strip | default: gh
          assign gc = collections[gh]
        -%}
        {%- if gc != blank and gc.all_products_count > 0 -%}
          <a class="snh-goal{% if gh == here %} is-on{% endif %}" href="{{ gc.url }}" data-snh-tag data-snh-label="{{ gl | downcase | escape }} {{ gh }}">{{ gl }}</a>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if goal_chips != blank -%}
      <div class="snh-goals{% if here contains 'bundle' %} snh-goals--keep{% endif %}" data-snh-goals>
        <span class="snh-goals__label">{% if here != '' and goal_line != '' %}Refine{% else %}Shop by goal{% endif %}</span>
        <div class="snh-goals__rail">{{ goal_chips }}</div>
      </div>
    {%- endif -%}

    {%- comment -%} ── brands ── {%- endcomment -%}
    {%- if show_filters and brand_param != '' -%}
      {%- for filter in results.filters -%}
        {%- if filter.param_name != brand_param -%}{%- continue -%}{%- endif -%}
        <div class="snh-brands">
          <button type="button" class="snh-brands__nudge is-prev" data-snh-scroll="-1" aria-label="Scroll brands left" tabindex="-1">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <div class="snh-brands__rail" data-snh-rail>
            {%- for fv in filter.values -%}
              {%- if fv.count == 0 and fv.active == false -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign bh = fv.label | handleize
                # Round 13: the logo is looked up in Files on the server (no guessed URLs, so no 404s in the console):
                # <brand>-logo.webp, else .png, else the brand collection's image, else the name as text
                assign webp = bh | append: '-logo.webp'
                assign png = bh | append: '-logo.png'
                assign logo_src = ''
                if images[webp] != blank
                  assign logo_src = images[webp] | image_url: width: 240
                elsif images[png] != blank
                  assign logo_src = images[png] | image_url: width: 240
                else
                  assign bcol = collections[bh]
                  if bcol.image != blank
                    assign logo_src = bcol.image | image_url: width: 320
                  endif
                endif
              -%}
              <label class="snh-brand{% if fv.active %} is-on{% endif %}" data-snh-tag data-snh-label="{{ fv.label | downcase | escape }}">
                <input class="snh-brand__input" type="checkbox" name="{{ fv.param_name }}" value="{{ fv.value }}" {% if fv.active %}checked{% endif %}>
                <span class="snh-brand__face">
                  <span class="snh-brand__plate{% if logo_src == blank %} is-text{% endif %}">
                    {%- if logo_src != blank -%}
                    <img src="{{ logo_src }}" alt="{{ fv.label | escape }}" loading="lazy" decoding="async" width="120" height="40"
                         onerror="window.__snhLogoFallback &amp;&amp; window.__snhLogoFallback(this)">
                    {%- endif -%}
                    <em>{{ fv.label }}</em>
                  </span>
                </span>
              </label>
            {%- endfor -%}
          </div>

          <button type="button" class="snh-brands__nudge is-next" data-snh-scroll="1" aria-label="Scroll brands right" tabindex="-1">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endfor -%}
    {%- endif -%}

    <p class="snh-nomatch" data-snh-nomatch hidden>No brand or goal matches that &mdash; try searching all products.</p>
    <div class="snh-recs" data-snh-recs hidden>
      <span class="snh-recs__label">SNH recommends</span>
      <div class="snh-recs__rail" data-snh-recs-rail></div>
    </div>

    {%- comment -%} ── controls ── (Round 11: on phones a "Filters" button opens them as a full-screen sheet) {%- endcomment -%}
    <div class="snh-mtrig">
      <button type="button" class="snh-mtrig__btn" data-snh-sheet-open aria-controls="snh-sheet-{{ section.id }}" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="16" cy="7" r="2" stroke="currentColor" stroke-width="1.8"/><circle cx="10" cy="17" r="2" stroke="currentColor" stroke-width="1.8"/></svg>
        <span>Filter &amp; sort</span>{%- if active_total > 0 -%}<b>{{ active_total }}</b>{%- endif -%}
      </button>
      <span class="snh-mtrig__n">{{ results.products_count }} product{% if results.products_count != 1 %}s{% endif %}</span>
    </div>
    <div class="snh-bar__row" id="snh-sheet-{{ section.id }}" data-snh-sheet role="group" aria-label="Filter and sort">
      <div class="snh-sheet__head"><p class="snh-sheet__t">Filter &amp; sort</p><button type="button" class="snh-sheet__x" data-snh-sheet-close aria-label="Close filters"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></div>
      {%- comment -%} Round 14: desktop, condensed bar: re-show the brand logo rail (hidden to keep the sticky bar slim) {%- endcomment -%}
      <button type="button" class="snh-drop__pill snh-brandtog" data-snh-brandtog aria-expanded="false">Brand</button>
      {%- if show_filters -%}
        {%- for filter in results.filters -%}
          {%- unless useful_list contains filter.param_name -%}{%- continue -%}{%- endunless -%}
          {%- if filter.param_name == brand_param -%}{%- continue -%}{%- endif -%}

          {%- if filter.type == 'boolean' or filter.param_name == 'filter.v.availability' -%}
            <label class="snh-switch">
              <input type="checkbox" name="{{ filter.param_name }}" value="1" {% if filter.param_name == 'filter.v.availability' %}{% if filter.active_values.size > 0 %}checked{% endif %}{% else %}{% if filter.true_value.active %}checked{% endif %}{% endif %}>
              <span class="snh-switch__track"><span class="snh-switch__knob"></span></span>
              <span class="snh-switch__text">{% if filter.param_name == 'filter.v.availability' %}In stock{% else %}{{ filter.label }}{% endif %}</span>
            </label>

          {%- else -%}
            {%- assign downcase_label = filter.label | downcase -%}
            {%- assign active_count = filter.active_values.size -%}
            {%- assign pickable = 0 -%}
            {%- for v in filter.values -%}
              {%- if v.count > 0 or v.active -%}{%- assign pickable = pickable | plus: 1 -%}{%- endif -%}
            {%- endfor -%}

            <details class="snh-drop" data-snh-drop>
              <summary class="snh-drop__pill">
                <span>{{ filter.label }}</span>
                {%- if active_count > 0 -%}<b>{{ active_count }}</b>{%- endif -%}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <div class="snh-drop__panel">
                <div class="snh-drop__head"><p class="snh-drop__title">{{ filter.label }}</p><button type="button" class="snh-drop__done" data-snh-done>Done</button></div>
                {%- case filter.type -%}
                  {%- when 'list' -%}
                    {%- if filter.presentation == 'swatch' or color_label_list contains downcase_label -%}
                      <div class="snh-drop__swatches">
                        {%- for filter_value in filter.values -%}
                          {%- render 'option-value', type: 'swatch', filter_value: filter_value, show_tooltip: true, id_prefix: id_prefix -%}
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      {%- if pickable > 10 -%}
                        <input type="search" class="snh-drop__find" data-snh-listfind placeholder="Search {{ filter.label | downcase | escape }}" aria-label="Search {{ filter.label | escape }}" autocomplete="off">
                      {%- endif -%}
                      <div class="snh-drop__list{% if pickable > 8 %} is-scroll{% endif %}">
                        {%- for filter_value in filter.values -%}
                          {%- if filter_value.count == 0 and filter_value.active == false -%}{%- continue -%}{%- endif -%}
                          <label class="snh-opt" data-snh-row data-snh-label="{{ filter_value.label | downcase | escape }}">
                            <input type="checkbox" name="{{ filter_value.param_name }}" value="{{ filter_value.value }}" {% if filter_value.active %}checked{% endif %}>
                            <span>{{ filter_value.label }}</span>
                            <span class="snh-opt__n">{{ filter_value.count }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  {%- when 'price_range' -%}
                    {%- render 'price-range', filter: filter -%}
                {%- endcase -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if show_sort_by -%}
        {%- assign selected_sort_by = results.sort_by | default: results.default_sort_by -%}
        <label class="snh-sort">
          <select name="sort_by" aria-label="Sort by">
            {%- for option in results.sort_options -%}
              {%- if option.name != blank -%}
                <option value="{{ option.value }}" {% if option.value == selected_sort_by %}selected{% endif %}>{{ option.name }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </label>
      {%- endif -%}
      <div class="snh-sheet__foot">
        {%- if active_total > 0 -%}<a class="snh-sheet__clear" href="{{ results.url | default: request.path }}">Clear all</a>{%- endif -%}
        <button type="button" class="snh-sheet__go" data-snh-sheet-close>Show {{ results.products_count }} product{% if results.products_count != 1 %}s{% endif %}</button>
      </div>
    </div>

    {%- if show_filters and active_total > 0 -%}
      <div class="snh-active">
        <div class="snh-active__chips">
          {%- for filter in results.filters -%}
            {%- for av in filter.active_values -%}
              <a class="snh-chip" href="{{ av.url_to_remove }}">
                {{ av.label }}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </a>
            {%- endfor -%}
          {%- endfor -%}
        </div>
        <a class="snh-active__clear" href="{{ results.url | default: request.path }}">Clear all</a>
      </div>
    {%- endif -%}
  </div>

  {%- unless update_on_change -%}
    <noscript style="display:block;margin-top:12px">
      {%- assign button_content = 'collection.faceting.apply_filters' | t -%}
      {%- render 'button', type: 'submit', content: button_content, size: 'lg', stretch: true -%}
    </noscript>
  {%- endunless -%}
</form>

<style>
  /* Round 11: your filter bar (OLD-COMPONENTS.md §2) in v2: Inter, the 12–96 scale, v2 colours, 4px spacing.
     Same bands and behaviour. Phones: the controls row becomes a full-screen "Filter & sort" sheet. */
  .snh-bar-form { --snh-o: var(--v-accent, #E0521C); --snh-ink: var(--ink, #0C0C0D); --snh-line: var(--line, rgba(12, 12, 13, .1)); --snh-ease: var(--ease, cubic-bezier(.22, 1, .36, 1)); font-family: var(--sans); }
  [is="facet-drawer-opener"], [class*="facets-drawer"], [class*="filter-and-sort"], [class*="mobile-filter"], [class*="filters-toggle"], facets-horizontal, .facets-horizontal, .facets-vertical { display: none !important; }
  .snh-bar-form { position: sticky; top: var(--header-height, var(--v-hdr, 0px)); z-index: 12; background: var(--white, #fff); }
  /* Round 13: pinned directly under the SNH header by its live height (assets/snh-v2.js keeps --header-height current) */
  facet-floating-filter, .facets__floating-filter { display: none !important; }
  /* Round 13: Impact's grid kept a 48px top margin + a 32px row for its hidden toolbar under our bar: the bar's own 24px is the only gap */
  .collection { margin-top: 0 !important; row-gap: 0 !important; }
  .snh-bar { display: grid; margin-block-end: 0; background: var(--white, #fff); }
  /* Round 13: the 24px under the bar sits outside the sticky form, so the pinned bar has no white band */
  .snh-bar-form { margin-block-end: 24px; }
  .snh-bar > * { padding-inline: var(--snh-pad-l, 0px) var(--snh-pad-r, 0px); }
  .snh-brands { padding-inline: 0; }
  .snh-brands__rail { padding-inline: var(--snh-pad-l, 0px) var(--snh-pad-r, 0px); }

  /* quick find */
  .snh-find { position: relative; display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; padding-block: 12px; border-block-end: 1px solid var(--snh-line); }
  .snh-find__icon { width: 20px; height: 20px; color: var(--grey-2); }
  .snh-find__input { flex: 1 1 240px; min-width: 0; height: 28px; border: 0; background: none; font: 500 15px/1.5 var(--sans); color: var(--snh-ink); }
  .snh-find__input::placeholder { color: var(--grey-2); font-weight: 400; }
  .snh-find__input:focus { outline: none; }
  .snh-find__clear { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 50%; background: var(--cream); color: var(--snh-ink); cursor: pointer; }
  .snh-find__clear svg { width: 12px; height: 12px; }
  .snh-find__count { font: 600 12px/1.5 var(--sans); color: var(--grey-2); white-space: nowrap; }
