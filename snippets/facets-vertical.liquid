      var tags = bar.querySelectorAll('[data-snh-tag]');

      function cards() {
        var grid = document.querySelector('#product-grid, .product-list, [class*="product-grid" i]');
        return grid ? Array.prototype.slice.call(grid.children) : [];
      }

      var recs = bar.querySelector('[data-snh-recs]');
      var recsRail = bar.querySelector('[data-snh-recs-rail]');
      var lookupTimer = null;
      var lookupFor = '';
      var lookupHits = null;

      function handleOf(card) {
        var a = card.querySelector('a[href*="/products/"]');
        if (!a) return '';
        return (a.getAttribute('href') || '').split('/products/')[1].split('?')[0].split('#')[0];
      }

      /* Card text is only the title, so "fat loss" matched nothing even though
         the description says exactly that. The store's search index does cover
         descriptions, tags and type — so it is asked, and its verdict is merged
         with the instant local match. */
      var SYN = {
        'fat loss': ['fat', 'lean', 'diet', 'cutting', 'burner', 'thermogenic', 'shred'],
        'fat': ['fat', 'lean', 'diet', 'burner', 'shred'],
        'weight loss': ['fat', 'lean', 'diet', 'burner', 'shred'],
        'bulking': ['mass', 'gainer', 'bulk', 'weight gain', 'calorie'],
        'bulk': ['mass', 'gainer', 'bulk', 'calorie'],
        'maintain': ['whey', 'isolate', 'daily', 'maintenance'],
        'muscle': ['whey', 'isolate', 'creatine', 'mass', 'strength'],
        'strength': ['creatine', 'pre-workout', 'strength', 'power'],
        'recovery': ['bcaa', 'eaa', 'glutamine', 'recovery', 'repair'],
        'endurance': ['electrolyte', 'carb', 'energy', 'gel', 'hydration'],
        'energy': ['pre-workout', 'caffeine', 'energy', 'gel'],
        'sleep': ['sleep', 'magnesium', 'zma', 'ashwagandha'],
        'immunity': ['vitamin c', 'zinc', 'immune', 'multivitamin'],
        'joints': ['collagen', 'glucosamine', 'joint', 'omega'],
        'skin': ['collagen', 'biotin', 'skin', 'hair']
      };

      function terms(q) {
        var list = [q];
        if (SYN[q]) list = list.concat(SYN[q]);
        q.split(/\s+/).forEach(function (w) {
          if (w.length < 3) return;
          if (list.indexOf(w) === -1) list.push(w);
          if (SYN[w]) SYN[w].forEach(function (x) { if (list.indexOf(x) === -1) list.push(x); });
        });
        return list.slice(0, 5);
      }

      function lookup(q) {
        if (!q || q.length < 3 || lookupFor === q) return;
        lookupFor = q;
        var base = '/search/suggest.json?resources[type]=product&resources[limit]=8' +
                   '&resources[options][fields]=title,product_type,variants.title,vendor,tag,body&q=';
        Promise.all(terms(q).map(function (t) {
          return fetch(base + encodeURIComponent(t), { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) { return (d.resources && d.resources.results && d.resources.results.products) || []; })
            .catch(function () { return []; });
        })).then(function (sets) {
          if (input.value.trim().toLowerCase() !== q) return;
          lookupHits = {};
          var found = [];
          sets.forEach(function (set) {
            set.forEach(function (p) {
              var h = (p.url || '').split('/products/')[1];
              if (!h) return;
              h = h.split('?')[0];
              if (lookupHits[h]) return;
              lookupHits[h] = p;
              found.push(p);
            });
          });
          render(q, found);
        });
      }

      function render(q, found) {
        var shown = 0;
        cards().forEach(function (card) {
          var byText = card.dataset.snhText && card.dataset.snhText.indexOf(q) !== -1;
          var byIndex = lookupHits && lookupHits[handleOf(card)];
          var match = q === '' || byText || byIndex;
          card.style.display = match ? '' : 'none';
          if (match) shown++;
        });
        if (count) {
          /* no query, no tally — it described a search that is over */
          count.hidden = q === '';
          count.textContent = shown + (shown === 1 ? ' match' : ' matches');
        }
        /* cards hidden by a previous query are released when it is cleared */
        if (q === '') {
          cards().forEach(function (card) { card.style.display = ''; });
        }
        /* nothing here fits, but the store has something that does */
        var offsite = (found || []).filter(function (p) {
          return !document.querySelector('[data-snh-bar]') ? false : true;
        }).slice(0, 8);
        if (recs && recsRail) {
          if (shown === 0 && offsite.length) {
            recsRail.innerHTML = offsite.map(function (p) {
              var img = p.image ? '<img src="' + p.image + '" alt="" loading="lazy">' : '<span class="snh-rec__ph"></span>';
              return '<a class="snh-rec" href="' + p.url + '">' + img +
                     '<span class="snh-rec__copy"><span class="snh-rec__title">' + p.title +
                     '</span><span class="snh-rec__price">' + (p.price ? 'Rs ' + p.price : '') + '</span></span></a>';
            }).join('');
            recs.hidden = false;
          } else {
            recs.hidden = true;
          }
        }
        if (none) {
          var empty = q !== '' && shown === 0 && !(offsite && offsite.length);
          none.hidden = !empty;
          if (empty) none.textContent = 'Nothing matches that.';
        }
      }

      function quickState() {
        var q = input.value.trim();
        if (clear) clear.hidden = q === '';
        if (all) {
          all.hidden = q === '';
          all.href = SEARCH + '?q=' + encodeURIComponent(q) + '&type=product';
        }
      }

      function run() {
        var q = input.value.trim().toLowerCase();

        if (q === '') { lookupHits = null; lookupFor = ''; }

        var tagHits = 0;
        var goalHits = 0;
        var brandHits = 0;
        tags.forEach(function (t) {
          var match = q === '' || (t.dataset.snhLabel || '').indexOf(q) !== -1;
          t.hidden = !match;
          if (!match) return;
          tagHits++;
          if (t.classList.contains('snh-goal')) goalHits++; else brandHits++;
        });
        /* an emptied rail collapses rather than leaving a blank band */
        var goalsRow = bar.querySelector('[data-snh-goals]');
        var brandsRow = bar.querySelector('.snh-brands');
        if (goalsRow) goalsRow.hidden = goalHits === 0;
        if (brandsRow) brandsRow.hidden = brandHits === 0;

        cards().forEach(function (card) {
          if (!card.dataset.snhText) {
            card.dataset.snhText = (card.textContent || '').replace(/\s+/g, ' ').toLowerCase();
          }
        });

        if (clear) clear.hidden = q === '';
        if (all) {
          all.hidden = q === '';
          all.href = SEARCH + '?q=' + encodeURIComponent(input.value.trim()) + '&type=product';
        }

        render(q, null);

        clearTimeout(lookupTimer);
        if (q.length >= 3) {
          lookupTimer = setTimeout(function () { lookup(q); }, 220);
        } else if (recs) {
          recs.hidden = true;
        }
      }

      /* the facet form submits on change, so these events must not reach it */
      bar.__snhRerun = run;
      var runTimer = null;
      function schedule(e) {
        if (e) e.stopPropagation();
        quickState();
        clearTimeout(runTimer);
        runTimer = setTimeout(run, 200);
      }
      ['input', 'change', 'keyup'].forEach(function (type) {
        input.addEventListener(type, schedule, true);
      });
      input.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        /* stay here — the grid is already filtered as they typed */
        e.preventDefault();
        e.stopPropagation();
        input.blur();
      }, true);
      if (clear) {
        clear.addEventListener('click', function () { input.value = ''; run(); input.focus(); });
      }
      run();
    }

    /* brand rail arrows, hidden when there is nothing further that way */
    function wireRail(rail) {
      if (!rail || rail.dataset.snhWired) return;
      rail.dataset.snhWired = '1';
      var wrap = rail.parentElement;
      var prev = wrap.querySelector('[data-snh-scroll="-1"]');
      var next = wrap.querySelector('[data-snh-scroll="1"]');
      function sync() {
        var over = rail.scrollWidth - rail.clientWidth;
        if (prev) prev.hidden = over < 8 || rail.scrollLeft < 8;
        if (next) next.hidden = over < 8 || rail.scrollLeft > over - 8;
      }
      [prev, next].forEach(function (btn) {
        if (!btn) return;
        btn.addEventListener('click', function () {
          rail.scrollBy({ left: Number(btn.dataset.snhScroll) * Math.max(220, rail.clientWidth * 0.7), behavior: 'smooth' });
        });
      });
      var frame = 0;
      function onScroll() {
        if (frame) return;
        frame = requestAnimationFrame(function () { frame = 0; sync(); });
      }
      rail.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      sync();

      /* keep the chosen brand in view after the grid re-renders */
      var on = rail.querySelector('.snh-brand__input:checked');
      if (on && on.parentElement) {
        var box = on.parentElement.getBoundingClientRect();
        var rbox = rail.getBoundingClientRect();
        if (box.left < rbox.left || box.right > rbox.right) rail.scrollLeft += box.left - rbox.left - 40;
      }
    }

    /* pin below whatever sticky header the theme has, and condense on scroll */
    function wireSticky(bar) {
      if (bar.dataset.snhSticky) return;
      bar.dataset.snhSticky = '1';

      /* position:sticky is cancelled by ANY ancestor with a clipping overflow,
         which is why the bar scrolled away. The offenders are opened up. */
      var node = (bar.closest('form') || bar).parentElement;
      while (node && node !== document.body) {
        var cs = getComputedStyle(node);
        if (/(auto|hidden|scroll|clip)/.test(cs.overflowX + cs.overflowY)) {
          node.style.setProperty('overflow-x', 'clip', 'important');
          node.style.setProperty('overflow-y', 'visible', 'important');
        }
        node = node.parentElement;
      }
      var host = bar.closest('form') || bar;
      function offset() {
        // Round 12: the SNH header (.hdr, sticky) first; pinning at 0 hid the bar under it
        var head = document.querySelector('.hdr, [id*="header" i] .header, header.header, #shopify-section-header, sticky-header, .header-wrapper');
        var h = 0;
        if (head) {
          var pos = getComputedStyle(head).position;
          // the SNH header's sticky wrapper is its section (negative top), so .hdr itself reads "relative"
          if (pos === 'sticky' || pos === 'fixed' || head.matches('.hdr')) h = head.offsetHeight || 0;
        }
        host.style.setProperty('--snh-bar-top', h + 'px');
      }
      /* nothing listens to scroll any more — a pinned bar that resizes itself
         forces a reflow on every frame, which is what made scrolling stutter */
      // Round 13: the top comes from --header-height (live, set by the header); only non-SNH headers still need this
      if (!document.querySelector('.hdr')) { offset(); window.addEventListener('resize', offset); }
    }

    /* With the theme's filter layout set to Drawer, this bar is rendered inside
       that drawer — invisible until the customer opens it. It belongs in the
       page, between the collection banner and the grid, so it is moved there
       and the now-pointless drawer trigger is hidden. */
    function dock() {
      var bars = Array.prototype.slice.call(document.querySelectorAll('[data-snh-bar]'));
      if (!bars.length) return;
      var inPage = bars.filter(function (b) { return !inDrawer(b); });
      bars.forEach(function (bar) {
        if (!inDrawer(bar)) return;
        /* an in-page copy already exists — leave the drawer one alone */
        if (inPage.length) return;
        var host = bar.closest('form') || bar;
        if (host.dataset.snhDocked) return;
        var grid = document.querySelector('#product-grid, .product-list, [class*="product-grid" i]');
        if (!grid) return;
        var anchor = grid;
        while (anchor.parentElement && anchor.parentElement.tagName !== 'MAIN' && !/section/i.test(anchor.parentElement.className || '')) {
          anchor = anchor.parentElement;
          if (anchor === document.body) return;
        }
        if (!anchor.parentElement) return;
        host.dataset.snhDocked = '1';
        anchor.parentElement.insertBefore(host, anchor);
        host.style.display = 'block';
        document.querySelectorAll('[is="facet-drawer-opener"], [class*="facets-drawer__opener" i], [class*="mobile-filter" i]').forEach(function (btn) {
          btn.style.setProperty('display', 'none', 'important');
        });
      });
    }
    function inDrawer(el) {
      return !!el.closest('dialog, facets-drawer, [class*="drawer" i], [class*="modal" i], [id*="facets-drawer" i]');
    }

    /* The theme renders its own filter row from a different snippet, so with
       this bar in place there were two. The theme's is removed, along with the
       floating "Filter and sort" trigger it pairs with. */
    var purged = false;
    function purgeThemeFilters() {
      if (purged) return;
      var mine = document.querySelector('[data-snh-bar]');
      if (!mine) return;
      purged = true;
      var mineHost = mine.closest('form') || mine;
      var sel = 'form#facet-form, form[is="facet-form"], facets-horizontal, facets-vertical,' +
                '[class*="facets-horizontal" i], [class*="facets__form" i], [class*="collection__facets" i]';
      document.querySelectorAll(sel).forEach(function (el) {
        if (el === mineHost || el.contains(mine) || mineHost.contains(el)) return;
        el.style.setProperty('display', 'none', 'important');
      });
      document.querySelectorAll('[class*="facet" i], [is="facet-drawer-opener"], [class*="mobile-filter" i], [class*="filter-and-sort" i], [class*="filters-toggle" i], [class*="applied-filters" i], [class*="selected-filters" i]').forEach(function (el) {
        if (mineHost.contains(el) || el.contains(mineHost)) return;
        el.style.setProperty('display', 'none', 'important');
      });
      document.querySelectorAll('button, a').forEach(function (b) {
        var t = (b.textContent || '').trim().toLowerCase();
        if (t !== 'filter and sort' && t !== 'filter & sort' && t !== 'filters') return;
        if (mineHost.contains(b)) return;
        var host = b.closest('[class*="sticky" i], [class*="float" i], [class*="toolbar" i]') || b;
        host.style.setProperty('display', 'none', 'important');
      });
    }

    /* match the grid's gutters exactly, whatever container the bar lands in */
    function alignToGrid(bar) {
      var grid = document.querySelector('#product-grid, .product-list, [class*="product-grid" i]');
      if (!grid) return;
      var gb = grid.getBoundingClientRect();
      var bb = bar.getBoundingClientRect();
      if (!bb.width || !gb.width) return;
      bar.style.setProperty('--snh-pad-l', Math.max(0, Math.round(gb.left - bb.left)) + 'px');
      bar.style.setProperty('--snh-pad-r', Math.max(0, Math.round(bb.right - gb.right)) + 'px');
    }

    /* measure the visible option and size the control to it */
    function fitSort(bar) {
      var sel = bar.querySelector('.snh-sort select');
      if (!sel) return;
      var probe = document.getElementById('snh-sort-probe');
      if (!probe) {
        probe = document.createElement('span');
        probe.id = 'snh-sort-probe';
        probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;pointer-events:none;left:-9999px';
        document.body.appendChild(probe);
      }
      var cs = getComputedStyle(sel);
      probe.style.font = cs.fontWeight + ' ' + cs.fontSize + '/' + cs.lineHeight + ' ' + cs.fontFamily;
      probe.style.letterSpacing = cs.letterSpacing;
      probe.textContent = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].text : '';
      sel.style.setProperty('--snh-sort-w', Math.ceil(probe.getBoundingClientRect().width) + 38 + 'px');
      if (!sel.dataset.snhFit) {
        sel.dataset.snhFit = '1';
        sel.addEventListener('change', function () { fitSort(bar); });
      }
    }

    function wireApply(bar) {
      if (bar.dataset.snhApply) return;
      bar.dataset.snhApply = '1';
      var form = bar.closest('form');
      if (!form) return;

      function apply() {
        var params = [];
        Array.prototype.forEach.call(form.elements, function (el) {
          if (!el.name || el.disabled) return;
          if (el.name === 'page' || el.name === 'section_id') return;
          if (el.hasAttribute('data-snh-quick')) return;
          if ((el.type === 'checkbox' || el.type === 'radio') && !el.checked) return;
          if (el.value === '' || el.value == null) return;
          params.push(encodeURIComponent(el.name) + '=' + encodeURIComponent(el.value));
        });
        var base = form.getAttribute('action') || window.location.pathname;
        go(params.length ? base + '?' + params.join('&') : base);
      }

      var GRID = '#product-grid, .product-list, [class*="product-grid" i]';
      /* Only the grid changes, so only the grid is fetched and swapped. The
         bar keeps its rail scroll position and the page does not jump. */
      function go(url) {
        bar.classList.add('is-busy');
        var fetchUrl = url + (url.indexOf('?') === -1 ? '?' : '&') + 'section_id={{ section.id }}';
        fetch(fetchUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function (r) { return r.text(); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var fresh = doc.querySelector(GRID);
            var current = document.querySelector(GRID);
            if (!fresh || !current) { window.location.href = url; return; }
            current.replaceWith(fresh);

            /* mirror the new state onto the bar without rebuilding it */
            var nb = doc.querySelector('[data-snh-bar]');
            if (nb) {
              var newChips = nb.querySelector('.snh-active');
              var oldChips = bar.querySelector('.snh-active');
              if (newChips && oldChips) oldChips.replaceWith(newChips);
              else if (newChips && !oldChips) bar.appendChild(newChips);
              else if (!newChips && oldChips) oldChips.remove();

              nb.querySelectorAll('.snh-brand__input').forEach(function (src, i) {
                var mineBox = bar.querySelectorAll('.snh-brand__input')[i];
                if (mineBox) mineBox.checked = src.checked;
              });
              nb.querySelectorAll('.snh-goal').forEach(function (src, i) {
                var g = bar.querySelectorAll('.snh-goal')[i];
                if (g) g.classList.toggle('is-on', src.classList.contains('is-on'));
              });
            }

            /* the theme prints its own tally outside the grid, so it has to
               be refreshed too or it contradicts what is on screen */
            var countSel = '[class*="product-count" i], [id*="product-count" i], [class*="results-count" i], [class*="collection__count" i]';
            var freshCounts = doc.querySelectorAll(countSel);
            var liveCounts = document.querySelectorAll(countSel);
            for (var ci = 0; ci < liveCounts.length; ci++) {
              if (freshCounts[ci]) liveCounts[ci].innerHTML = freshCounts[ci].innerHTML;
            }

            history.pushState({ snh: 1 }, '', url);
            bar.classList.remove('is-busy');
            boot();

            /* a query typed before the filter was applied must be re-run
               against the cards that just arrived */
            if (typeof bar.__snhRerun === 'function') bar.__snhRerun();
          })
          .catch(function () { window.location.href = url; });
      }

      /* back button returns to the previous filter state */
      if (!window.__snhPop) {
        window.__snhPop = true;
        window.addEventListener('popstate', function () { window.location.reload(); });
      }

      bar.addEventListener('change', function (e) {
        var el = e.target;
        if (!el.name || el.hasAttribute('data-snh-quick') || el.hasAttribute('data-snh-listfind')) return;
        apply();
      });
      /* a label wrapping a checkbox fires change, but Safari needs the click
         on the plate to register before the navigation is queued */
      bar.addEventListener('click', function (e) {
        var link = e.target.closest('.snh-active__clear, .snh-chip');
        if (link && link.getAttribute('href')) {
          e.preventDefault();
          go(link.getAttribute('href'));
          return;
        }
        var plate = e.target.closest('.snh-brand');
        if (!plate) return;
        var box = plate.querySelector('input[type="checkbox"]');
        if (!box) return;
        setTimeout(apply, 0);
      });
    }

    function boot() {
      /* the theme may render both slots; a hidden duplicate would double the
         sticky bar and the event wiring, so it is dropped */
      var all = document.querySelectorAll('[data-snh-bar]');
      if (all.length > 1) {
        var keeper = null;
        all.forEach(function (b) {
          if (!keeper && b.offsetParent !== null && !inDrawer(b)) keeper = b;
        });
        if (keeper) {
          all.forEach(function (b) {
            if (b === keeper) return;
            var host = b.closest('form') || b;
            host.remove();
          });
        }
      }
      dock();
      purgeThemeFilters();
      wirePanels();
      document.querySelectorAll('[data-snh-bar]').forEach(function (bar) {
        wireQuickFind(bar);
        wireApply(bar);
        wireSticky(bar);
        fitSort(bar);
        alignToGrid(bar);
        if (!bar.dataset.snhAligned) {
          bar.dataset.snhAligned = '1';
          window.addEventListener('resize', function () { alignToGrid(bar); });
        }
      });
      document.querySelectorAll('[data-snh-rail]').forEach(wireRail);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
    document.addEventListener('shopify:section:load', boot);
    if (window.MutationObserver) {
      var t;
      var mo = new MutationObserver(function () { clearTimeout(t); t = setTimeout(boot, 400); });
      /* watch only where products live, not the entire document */
      var watch = document.querySelector('#product-grid, .product-list, [class*="product-grid" i]');
      var scope = watch && watch.parentElement ? watch.parentElement : null;
      if (scope) mo.observe(scope, { childList: true });
    }
  })();
</script>
<script>
  /* Round 11: phones/tablets open the controls row as a full-screen "Filter & sort" sheet. The facet form still
     updates on every change (Impact re-renders the section), so "Show N products" just closes the sheet. */
  (function () {
    if (window.__snhSheet) return;
    window.__snhSheet = true;
    function sheet() { return document.querySelector('[data-snh-sheet]'); }
    function set(on) {
      var s = sheet(), b = document.querySelector('[data-snh-sheet-open]');
      if (!s) return;
      s.classList.toggle('is-open', on);
      document.body.classList.toggle('snh-sheet-open', on);
      // Round 14: the brand logo rail lives above the bar (it hides once the bar condenses on scroll), so on phones it
      // moves into the sheet while it's open: same inputs, same form, so a second brand is one tap away.
      var rail = document.querySelector('form.snh-bar-form .snh-brands'), head = s.querySelector('.snh-sheet__head');
      if (rail && head) {
        if (on && matchMedia('(max-width: 999px)').matches && rail.parentNode !== s) {
          if (!rail.__home) { rail.__home = document.createComment('snh-brands'); rail.parentNode.insertBefore(rail.__home, rail); }
          head.insertAdjacentElement('afterend', rail); rail.classList.add('is-in-sheet');
        } else if (!on && rail.__home && rail.__home.parentNode) {
          rail.__home.parentNode.insertBefore(rail, rail.__home); rail.classList.remove('is-in-sheet');
        }
      }
      if (b) b.setAttribute('aria-expanded', String(on));
      if (on) { var x = s.querySelector('[data-snh-sheet-close]'); if (x) x.focus({ preventScroll: true }); }
      try { sessionStorage.setItem('snh_sheet_open', on ? '1' : ''); } catch (e) {}
    }
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-snh-sheet-open]')) { e.preventDefault(); set(true); }
      else if (e.target.closest('[data-snh-sheet-close]')) { e.preventDefault(); set(false); }
      // tap on the blurred page behind the bottom sheet closes it
      else if (document.body.classList.contains('snh-sheet-open') && (e.target === document.body || e.target === document.documentElement)) set(false);
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && sheet() && sheet().classList.contains('is-open')) set(false); });
    // the section re-renders after each change: keep the sheet open while the shopper is still filtering
    function restore() { var keep = false; try { keep = sessionStorage.getItem('snh_sheet_open') === '1'; } catch (e) {} if (keep && matchMedia('(max-width: 999px)').matches) set(true); }
    document.addEventListener('facet:update', function () { setTimeout(restore, 30); });
    new MutationObserver(function () { var s = sheet(); if (s && !s.__seen) { s.__seen = true; restore(); } }).observe(document.body, { childList: true, subtree: true });
    window.addEventListener('pageshow', function () { try { sessionStorage.removeItem('snh_sheet_open'); } catch (e) {} });
  })();
</script>
