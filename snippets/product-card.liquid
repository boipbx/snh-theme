{%- comment -%}
  SNH product card (DESIGN.md → Product card). Styles live in assets/snh-design-system.css
  and the add handler in assets/snh-design-system.js, both loaded once from layout/theme.liquid.
  Accepts (and ignores) the theme's params: product, stacked, position, show_badges, with_css…
{%- endcomment -%}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign third = product.price | divided_by: 300.0 | round | times: 100
  assign multi = false
  if product.variants.size > 1
    assign multi = true
  endif

  assign now_s = 'now' | date: '%s' | times: 1
  assign made_s = product.created_at | date: '%s' | times: 1
  assign age = now_s | minus: made_s

  assign retail = 0
  assign retail_from_meta = false
  if v.compare_at_price > v.price
    assign retail = v.compare_at_price
  elsif product.compare_at_price > product.price
    assign retail = product.compare_at_price
  elsif product.compare_at_price_max > product.price
    # multi-variant bundles: the shown variant may carry no compare-at while others do
    assign retail = product.compare_at_price_max
  endif

  # No compare-at set on the bundle. Retail totals below are the sum of each
  # bundle's contents at their own shelf prices, taken from the SNH bundle
  # sheet. Keys are the handleized product title; edit a value here if a
  # component's retail price changes. A bundle absent from this list simply
  # shows no saving rather than an invented one.
  if retail == 0
    assign bundle_retail = 'testosterone-support=1649800,testosterone-support-max=2239800,gut-metabolic-support=1429800,bone-strength=1319800,scar-tissue-recovery-repair=2369700,daily-foundation=2209700,stress-recovery=1649800,main-mineral-trio=2099700,immunity-daily=1989700,everyday-essentials=1439800,revive-daily=1729800,deep-sleep=2309800,couples-bedroom-bundle=1799800,endurance-trial-pack=509500,race-day-pack-1-0=939300,race-day-pack-2-0=999300,strength-foundation=2499700,strength-skin=1799800,creatine-starter=1099800,whey-pre-stack=3099800,whey-training-stack=3099700,isolate-pre-stack=3399800,isolate-training-stack=3399700,raw-loaded-stack=3049700,raw-training-stack=1849800' | split: ','
    assign title_key = product.title | handleize
    for pair in bundle_retail
      assign kv = pair | split: '='
      if kv[0] == title_key
        assign candidate = kv[1] | times: 1
        if candidate > product.price
          assign retail = candidate
          assign retail_from_meta = true
        endif
      endif
    endfor
  endif

  # manual per-product override, in rupees, for anything not in the list
  if retail == 0
    assign meta_retail = product.metafields.custom.retail_price.value | default: product.metafields.custom.retail_price
    if meta_retail != blank
      assign meta_cents = meta_retail | times: 100 | round
      if meta_cents > product.price
        assign retail = meta_cents
        assign retail_from_meta = true
      endif
    endif
  endif

  assign on_sale = false
  if retail > product.price
    assign on_sale = true
    assign saved = retail | minus: product.price
  endif

  # one primary badge, top-left: Sold out (muted) > Sale (accent) > New (ink)
  assign badge = ''
  assign badge_mod = ''
  if product.available == false
    assign badge = 'Sold out'
    assign badge_mod = 'soldout'
  elsif on_sale
    assign badge = 'Sale'
    assign badge_mod = 'sale'
  elsif age < 3888000
    assign badge = 'New'
  endif

  # flavour count chip: count the Flavour/Flavor option, else total options
  assign chip = ''
  if multi
    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name contains 'flavo'
        assign chip = option.values.size | append: ' flavours'
      endif
    endfor
    if chip == ''
      assign chip = product.variants.size | append: ' options'
    endif
  endif
-%}

<product-card class="snh-pc{% unless product.available %} snh-pc--out{% endunless %}" handle="{{ product.handle }}">
  <a class="snh-pc__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
    {%- if product.featured_image -%}
      {{- product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', decoding: 'async', width: 320, height: 320, sizes: '(max-width: 699px) 50vw, 320px', widths: '320,480,640', alt: product.featured_image.alt | default: product.title -}}
    {%- endif -%}
    {%- assign custom_badges = product.metafields.custom.badges.value -%}
    {%- if badge != blank or custom_badges != blank -%}
      <span class="snh-pc__badges">
        {%- if badge != blank -%}<span class="snh-pc__badge{% if badge_mod != blank %} snh-pc__badge--{{ badge_mod }}{% endif %}">{{ badge }}</span>{%- endif -%}
        {%- for custom_badge in custom_badges -%}<span class="snh-pc__badge">{{ custom_badge }}</span>{%- endfor -%}
      </span>
    {%- endif -%}
  </a>

  {%- if product.available -%}
    {%- if multi -%}
      {%- capture snh_qb_id -%}snh-qb-{{ section.id }}-{{ product.id }}{%- endcapture -%}
      <button type="button" class="snh-pc__add" aria-controls="{{ snh_qb_id }}" aria-expanded="false" aria-label="Choose options for {{ product.title | escape }}">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <quick-buy-drawer id="{{ snh_qb_id }}" header-bordered open-from="bottom" handle="{{ product.handle }}?variant={{ v.id }}" role="region" aria-live="polite" class="quick-buy-drawer drawer"></quick-buy-drawer>
    {%- else -%}
      <button type="button" class="snh-pc__add" data-snh-add="{{ v.id }}" aria-label="Add {{ product.title | escape }} to basket">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    {%- endif -%}
  {%- endif -%}

  <div class="snh-pc__body">
    {%- if product.vendor != blank -%}<p class="snh-pc__brand snh-eyebrow">{{ product.vendor }}</p>{%- endif -%}
    <a class="snh-pc__link" href="{{ product.url }}"><h3 class="snh-pc__title">{{ product.title }}</h3></a>
    <div class="snh-pc__meta">
      <span class="snh-pc__price{% if on_sale %} snh-pc__price--sale{% endif %}">{% if multi and product.price_varies %}From {% endif %}{{ product.price | money_without_trailing_zeros }}</span>
      {%- if on_sale -%}<s class="snh-pc__was">{{ retail | money_without_trailing_zeros }}</s>{%- endif -%}
      {%- if chip != blank -%}<span class="snh-pc__chip">{{ chip }}</span>{%- endif -%}
    </div>
    <p class="snh-pc__koko">or 3 &times; {{ third | money_without_trailing_zeros }} with Koko</p>
  </div>
</product-card>
