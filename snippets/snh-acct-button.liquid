{%- comment -%}
  Header account button (Round 7). Opens the account panel (#acp, snippets/snh-acct-panel). Logged in: the member's
  initial with a tier dot. Without JS it's a link to the account page. cls: hide-s (desktop/tablet) or show-s (phones).
  mock (QA page only): first_name, tier, points, spend.
{%- endcomment -%}
{%- liquid
  assign signed_in = false
  if mock
    assign signed_in = true
    capture m
      render 'snh-elite-calc', mock: true, tier: tier, points: points, spend: spend
    endcapture
    assign who = first_name
  elsif customer
    assign signed_in = true
    capture m
      render 'snh-elite-calc', customer: customer
    endcapture
    assign who = customer.first_name | default: customer.email
  endif
  if signed_in
    assign tier_key = m | strip | split: '|' | first
  endif
-%}
<a class="icon-btn acct-btn {{ cls }}" href="{{ routes.account_url }}" data-acp-open aria-controls="acp" aria-haspopup="dialog" aria-label="{% if signed_in %}Account: {{ who | escape }}{% else %}Sign in or join SNH Elite{% endif %}">
  {%- if signed_in -%}
    <span class="acct-ini" aria-hidden="true">{{ who | slice: 0 | upcase }}<i class="tdot" data-tier="{{ tier_key }}"></i></span>
  {%- else -%}
    {%- render 'snh-v2-icon', name: 'user' -%}
  {%- endif -%}
</a>
