{%- comment -%}
  SNH Elite member app shell (Round 8). Rendered by sections/snh-account-app (real member) and sections/snh-app-mock
  (QA personas), so both show the same thing.
  m: split snh-elite-calc output · me: split member fields (0 first name · 1 name · 2 email · 3 phone · 4 member no. ·
  5 initials · 6 accepts marketing 1/0 · 7 birthday · 8 joined (unix) · 9 orders count · 10 addresses count · 11 tags,
  comma separated) · recent: latest orders (snh-app-order-data records) · page_orders + pagination_html + page_no: the
  Orders view page · s: section settings · blocks: section blocks (goal, quiz, faq) · sid · mock: true on the QA page.
  Views: #overview #rewards #orders #goals #profile (assets/snh-app.js; the inline script picks the view before paint).
{%- endcomment -%}
{{ 'snh-account.css' | asset_url | stylesheet_tag }}
{{ 'snh-app.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snh-account.js' | asset_url }}" defer></script>
<script src="{{ 'snh-app.js' | asset_url }}" defer></script>
{%- liquid
  assign goal = ''
  assign goal2 = ''
  assign diet = ''
  assign budget = ''
  assign take = ''
  assign freq = ''
  assign sport = ''
  assign t_bday = ''
  assign t_mobile = ''
  assign t_joined = ''
  assign pending = false
  assign tag_list = me[11] | split: ','
  for t in tag_list
    assign tl = t | strip | downcase
    assign k = tl | split: ':' | first
    assign v = tl | remove_first: k | remove_first: ':' | strip
    case k
      when 'goal'
        if goal == ''
          assign goal = v
        endif
      when 'goal2'
        if goal2 == ''
          assign goal2 = v
        endif
      when 'diet'
        if diet == ''
          assign diet = v
        endif
      when 'budget'
        if budget == ''
          assign budget = v
        endif
      when 'take'
        assign take = take | append: v | append: ','
      when 'freq'
        if freq == ''
          assign freq = v
        endif
      when 'sport'
        if sport == ''
          assign sport = v
        endif
      when 'bday'
        assign t_bday = v
      when 'mobile'
        assign t_mobile = t | strip | remove_first: 'mobile:' | remove_first: 'Mobile:'
      when 'joined'
        assign t_joined = v | date: '%s'
      when 'trigger_redeem_2500'
        assign pending = true
    endcase
  endfor
  assign phone = me[3] | default: t_mobile
  assign bday = me[7] | default: t_bday
  assign joined = me[8] | default: t_joined

  capture bundles
    render 'snh-app-bundles', recent: recent, handles: s.bundle_handles
  endcapture
  assign bundles = bundles | strip | split: '@@'

  assign views = 'overview,rewards,orders,goals,profile' | split: ','
  assign pts_label = 'No points yet'
  if m[3] != 'x'
    capture pts_label
      render 'snh-num', n: m[3]
      echo ' points'
    endcapture
  endif
-%}
<div class="v2 app" data-app data-tier="{{ m[0] }}"{% if mock %} data-mock{% endif %} data-email="{{ me[2] | escape }}" data-first="{{ me[0] | escape }}" data-goal="{{ goal | escape }}">
  <script>
    (function (a) {
      var v = (location.hash || '').slice(1).split(/[?&]/)[0], ok = /^(overview|rewards|orders|goals|profile)$/;
      if (!ok.test(v)) { try { v = localStorage.getItem('snh_app_view') || ''; } catch (e) { v = ''; } }
      if (!ok.test(v)) v = 'overview';
      a.classList.add('is-js');
      a.setAttribute('data-view', v);
    })(document.currentScript.parentNode);
  </script>
  <div class="v-wrap app__in">
    <aside class="app__side" aria-label="Your SNH Elite account">
      <div class="app__me" data-tier="{{ m[0] }}">
        <span class="app__av" data-avatar-slot data-initials="{{ me[5] | escape }}" aria-hidden="true"><span>{{ me[5] | escape }}</span></span>
        <div class="app__who">
          {%- assign full_name = me[1] | default: me[2] -%}
          <p class="app__name{% if full_name.size > 20 %} app__name--long{% endif %}" title="{{ full_name | escape }}">{{ full_name | escape }}</p>
          <p class="app__tier"><i class="app__dot" aria-hidden="true"></i>{{ m[1] }} member</p>
          <p class="app__pts">{{ pts_label }}</p>
        </div>
      </div>
      <nav class="app__nav" aria-label="Account">
        {%- for v in views -%}
          {%- case v -%}
            {%- when 'overview' -%}{%- assign ic = 'home' -%}{%- assign lb = 'Overview' -%}
            {%- when 'rewards' -%}{%- assign ic = 'gift' -%}{%- assign lb = 'Rewards' -%}
            {%- when 'orders' -%}{%- assign ic = 'bag' -%}{%- assign lb = 'Orders' -%}
            {%- when 'goals' -%}{%- assign ic = 'target' -%}{%- assign lb = 'Goals' -%}
            {%- else -%}{%- assign ic = 'user' -%}{%- assign lb = 'Profile & addresses' -%}
          {%- endcase -%}
          <a class="app__link" href="#{{ v }}" data-go="{{ v }}">{% render 'snh-v2-icon', name: ic %}<span>{{ lb }}</span>{% if v == 'orders' and me[9] != '0' %}<b class="app__badge">{{ me[9] }}</b>{% endif %}</a>
        {%- endfor -%}
        <a class="app__link app__link--out" href="{% if mock %}#profile{% else %}{{ routes.account_logout_url }}{% endif %}" data-no-instant data-signout-open aria-haspopup="dialog">{% render 'snh-v2-icon', name: 'out' %}<span>Sign out</span></a>
      </nav>
    </aside>

    <div class="app__main">
      {%- liquid
        assign per_point = settings.snh_point_value | default: 1
        assign redeem_rs = settings.snh_redeem_from | default: 2500 | times: per_point
      -%}
      <div class="app__flash" data-flash hidden role="status" tabindex="-1"
        data-msg-redeem="Request sent. Your {{ redeem_rs | times: 100 | money_without_trailing_zeros }} reward arrives by email, usually within a working day."
        data-msg-goals="Your plan is saved. Picks, tips and guides now follow your answers."
        data-msg-news="You're subscribed. Look out for member offers and new drops.">
        <span class="app__flash-ic" aria-hidden="true">{% render 'snh-v2-icon', name: 'check' %}</span>
        <p data-flash-msg></p>
        <button class="app__x" type="button" data-flash-close aria-label="Dismiss">{% render 'snh-v2-icon', name: 'close' %}</button>
      </div>
      <section class="app__view" data-pane="overview" aria-labelledby="{{ sid }}-overview-h">
        {%- render 'snh-app-overview', m: m, me: me, recent: recent, s: s, blocks: blocks, sid: sid, mock: mock, goal: goal, pending: pending, phone: phone, bday: bday, joined: joined, bundles: bundles, goal2: goal2, diet: diet, budget: budget, take: take, sport: sport -%}
      </section>
      <section class="app__view" data-pane="rewards" aria-labelledby="{{ sid }}-rewards-h">
        {%- render 'snh-app-rewards', m: m, me: me, blocks: blocks, sid: sid, mock: mock, pending: pending -%}
      </section>
      <section class="app__view" data-pane="orders" aria-labelledby="{{ sid }}-orders-h">
        {%- render 'snh-app-orders', m: m, me: me, page_orders: page_orders, pagination_html: pagination_html, page_no: page_no, sid: sid, mock: mock, bundles: bundles -%}
      </section>
      <section class="app__view" data-pane="goals" aria-labelledby="{{ sid }}-goals-h">
        {%- render 'snh-app-goals', me: me, blocks: blocks, sid: sid, mock: mock, goal: goal, freq: freq, sport: sport, phone: phone, bday: bday, stack_map: s.stack_map, bundle_handles: s.bundle_handles -%}
      </section>
      <section class="app__view" data-pane="profile" aria-labelledby="{{ sid }}-profile-h">
        {%- render 'snh-app-profile', m: m, me: me, s: s, sid: sid, mock: mock, mock_address: mock_address, phone: phone, bday: bday -%}
      </section>
    </div>
  </div>

  <nav class="app__tabs" aria-label="Account sections">
    {%- for v in views -%}
      {%- case v -%}
        {%- when 'overview' -%}{%- assign ic = 'home' -%}{%- assign lb = 'Overview' -%}
        {%- when 'rewards' -%}{%- assign ic = 'gift' -%}{%- assign lb = 'Rewards' -%}
        {%- when 'orders' -%}{%- assign ic = 'bag' -%}{%- assign lb = 'Orders' -%}
        {%- when 'goals' -%}{%- assign ic = 'target' -%}{%- assign lb = 'Goals' -%}
        {%- else -%}{%- assign ic = 'user' -%}{%- assign lb = 'Profile' -%}
      {%- endcase -%}
      <a class="app__tab" href="#{{ v }}" data-go="{{ v }}">{% render 'snh-v2-icon', name: ic %}<span>{{ lb }}</span></a>
    {%- endfor -%}
  </nav>
  <p class="v-sr" aria-live="polite" data-app-live></p>

  {%- comment -%} Re-order preview (Round 10): filled from the order's <template> (snippets/snh-app-reorder) {%- endcomment -%}
  <dialog class="out rep" data-reorder-dlg aria-label="Re-order">
    <div class="out__in rep__in">
      <button class="app__x rep__x" type="button" data-reorder-close aria-label="Close">{% render 'snh-v2-icon', name: 'close' %}</button>
      <div class="rep__body" data-reorder-body></div>
    </div>
  </dialog>

  {%- comment -%} Sign out (Round 10): a confirm sheet; the links still sign out directly without JS {%- endcomment -%}
  <dialog class="out" data-signout aria-labelledby="{{ sid }}-out-h">
    <div class="out__in">
      <div class="app__me out__me" data-tier="{{ m[0] }}">
        <span class="app__av" data-avatar-slot data-initials="{{ me[5] | escape }}" aria-hidden="true"><span>{{ me[5] | escape }}</span></span>
        <div class="app__who">
          <p class="app__name" title="{{ full_name | escape }}">{{ full_name | escape }}</p>
          <p class="app__tier"><i class="app__dot" aria-hidden="true"></i>{{ m[1] }} member</p>
          <p class="app__pts">{{ pts_label }}</p>
        </div>
      </div>
      <h2 class="out__h" id="{{ sid }}-out-h">Sign out of SNH <em>Elite</em>?</h2>
      <p class="app__muted">Your points, tier and orders stay safe. Sign back in any time with {{ me[2] | escape }}.</p>
      <div class="out__btns">
        <button class="v-btn v-btn--ink" type="button" data-signout-close><span>Stay signed in</span></button>
        <a class="v-btn v-btn--line" href="{% if mock %}#profile{% else %}{{ routes.account_logout_url }}{% endif %}" data-no-instant{% if mock %} data-signout-close{% endif %}>{% render 'snh-v2-icon', name: 'out' %}<span>Sign out</span></a>
      </div>
    </div>
  </dialog>
</div>
