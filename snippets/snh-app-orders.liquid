{%- comment -%}
  Member app · Orders (Round 8; Round 10 redesign): "Active order" pinned on top (snh-app-active), then order cards
  (snh-app-order-card: lines with clean pack shots, one human status, total, est. points, Track & details with the
  status timeline, Re-order with a preview, "Now in a bundle"). Search (order no., product, flavour/size, brand; every
  word, any case) and the status filter work on the current page, as in V8; 16 per page.
  page_orders: snh-app-order-data records · pagination_html · page_no · bundles: snh-app-bundles records
{%- endcomment -%}
{%- assign rate = m[7] | plus: 0 -%}
<header class="app__head app__head--row">
  <div>
    <p class="eyebrow">Purchase history</p>
    <h1 class="app__h" id="{{ sid }}-orders-h">Your <em>orders</em></h1>
  </div>
  {%- if me[9] != '0' -%}<span class="app__count">{{ me[9] }} order{% if me[9] != '1' %}s{% endif %}</span>{%- endif -%}
</header>

{%- if page_orders.size == 0 or page_orders[0] == blank -%}
  <div class="acc__empty">
    <p class="acc__empty-h">No orders yet</p>
    <p>Shop while signed in and every paid order earns {{ m[7] }}% back in points.</p>
    <a class="v-btn v-btn--ink" href="{{ routes.all_products_collection_url }}"><span>Start shopping</span></a>
  </div>
{%- else -%}
  {%- if page_no == 1 or page_no == blank -%}{%- render 'snh-app-active', orders: page_orders, sid: sid -%}{%- endif -%}
  <div class="ofilter" role="search">
    <label class="fld ofilter__q"><span class="v-sr">Search orders</span><span class="ofilter__ic" aria-hidden="true">{% render 'snh-v2-icon', name: 'search' %}</span><input type="search" placeholder="Order number or product" data-order-q autocomplete="off" enterkeyhint="search"></label>
    <label class="fld ofilter__s"><span class="v-sr">Status</span><select data-order-s>
      <option value="all">All statuses</option>
      <option value="processing">Processing</option>
      <option value="packed">Packed</option>
      <option value="shipped">Shipped</option>
      <option value="delivered">Delivered</option>
      <option value="refunded">Refunded</option>
      <option value="partially_refunded">Partly refunded</option>
      <option value="cancelled">Cancelled</option>
      <option value="pending">Payment pending</option>
    </select></label>
  </div>
  <p class="app__muted ofilter__none" data-order-none hidden>No orders on this page match. Clear the search or try another status.</p>

  <ul class="olist" role="list">
    {%- assign b_shown = ',' -%}
    {%- for r in page_orders -%}
      {%- liquid
        assign o = r | split: '|'
        assign did = sid | append: '-od-' | append: forloop.index
        # "Now in a bundle" under the newest order with that product only
        assign bm = ''
        assign lis = o[14] | split: ';;'
        for b in bundles
          assign bf = b | split: '~'
          assign bk = ',' | append: bf[0] | append: ','
          if bf[0] == blank or b_shown contains bk
            continue
          endif
          for li in lis
            assign it = li | split: '~'
            if it[0] == bf[0]
              assign bm = b
              break
            endif
          endfor
          if bm != ''
            assign b_shown = b_shown | append: bf[0] | append: ','
            break
          endif
        endfor
      -%}
      {%- render 'snh-app-order-card', o: o, rate: rate, did: did, bundle: bm, mock: mock -%}
    {%- endfor -%}
  </ul>
  {{ pagination_html }}
  <p class="app__note">Paid orders earn points at your {{ m[1] }} rate ({{ m[7] }}%). "Est." figures settle once the order syncs; refunds reverse them.</p>
{%- endif -%}
