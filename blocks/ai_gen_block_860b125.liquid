{% doc %}
  @prompt
    Create a small, mobile-friendly collapsible two-question FAQ block for the REVIVE Magnesium Glycinate product page, to sit beside or below the existing Magnesium FAQ block. Heading: 'Is this magnesium supplement right for me?' Question 1: 'How can this product help me?' Answer: 'Magnesium is an essential mineral involved in normal muscle and nerve function. A supplement may help you meet your magnesium intake if your diet falls short. Whether this product is right for you depends on your diet and health needs. It is not a treatment for cramps, poor sleep, or any medical condition.' Question 2: 'Who might consider taking it?' Answer: 'Adults considering a magnesium supplement can check their dietary intake and the product label first. If you have kidney disease, are pregnant or breastfeeding, take medicines, or are unsure whether you need magnesium, ask a qualified healthcare professional before use. Follow the label directions.' Include a short visible note: 'General information only, not medical advice. Review the product label and consult a healthcare professional for individual advice.' Use restrained wording without promising sleep, relaxation, recovery, or treatment outcomes. Keep this block limited to the REVIVE Magnesium Glycinate product page, not every product. Make accordion tap targets comfortable on mobile. Leave unpublished for merchant and compliance review, including checking the final wording and mobile preview.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if block.settings.target_product != blank and product.id == block.settings.target_product.id %}
  {% style %}
    .ai-magnesium-faq-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      padding: 18px;
      color: var(--snh-ink);
      background: #f0f0f0;
      border-radius: 12px;
      box-sizing: border-box;
    }

    .ai-magnesium-faq-{{ ai_gen_id }}__heading {
      margin: 0 0 12px;
      color: var(--snh-ink);
      font-size: 20px;
      line-height: 1.3;
    }

    .ai-magnesium-faq-{{ ai_gen_id }}__item {
      border-top: 1px solid #777;
    }

    .ai-magnesium-faq-{{ ai_gen_id }}__question {
      display: flex;
      min-height: 52px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 12px 2px;
      color: var(--snh-ink);
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      cursor: pointer;
      list-style: none;
    }

    .ai-magnesium-faq-{{ ai_gen_id }}__question::-webkit-details-marker {
      display: none;
    }

    .ai-magnesium-faq-{{ ai_gen_id }}__question::after {
      content: '+';
      flex: 0 0 auto;
      font-size: 22px;
      font-weight: 400;
      line-height: 1;
    }

    .ai-magnesium-faq-{{ ai_gen_id }}__item[open] > .ai-magnesium-faq-{{ ai_gen_id }}__question::after {
      content: '−';
    }

    .ai-magnesium-faq-{{ ai_gen_id }}__question:focus-visible {
      outline: 2px solid var(--snh-ink);
      outline-offset: 2px;
    }

    .ai-magnesium-faq-{{ ai_gen_id }}__answer {
      padding: 0 2px 14px;
      color: var(--snh-ink);
      font-size: 14px;
      line-height: 1.6;
    }

    .ai-magnesium-faq-{{ ai_gen_id }}__note {
      margin: 12px 0 0;
      color: var(--snh-ink);
      font-size: 12px;
      line-height: 1.5;
    }

    @media screen and (max-width: 749px) {
      .ai-magnesium-faq-{{ ai_gen_id }} {
        width: 100%;
        padding: 16px;
      }

      .ai-magnesium-faq-{{ ai_gen_id }}__heading {
        font-size: 18px;
      }
    }
  {% endstyle %}

  <div class="ai-magnesium-faq-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <h2 class="ai-magnesium-faq-{{ ai_gen_id }}__heading">Is this magnesium supplement right for me?</h2>
    <details class="ai-magnesium-faq-{{ ai_gen_id }}__item">
      <summary class="ai-magnesium-faq-{{ ai_gen_id }}__question">How can this product help me?</summary>
      <div class="ai-magnesium-faq-{{ ai_gen_id }}__answer">Magnesium is an essential mineral involved in normal muscle and nerve function. A supplement may help you meet your magnesium intake if your diet falls short. Whether this product is right for you depends on your diet and health needs. It is not a treatment for cramps, poor sleep, or any medical condition.</div>
    </details>
    <details class="ai-magnesium-faq-{{ ai_gen_id }}__item">
      <summary class="ai-magnesium-faq-{{ ai_gen_id }}__question">Who might consider taking it?</summary>
      <div class="ai-magnesium-faq-{{ ai_gen_id }}__answer">Adults considering a magnesium supplement can check their dietary intake and the product label first. If you have kidney disease, are pregnant or breastfeeding, take medicines, or are unsure whether you need magnesium, ask a qualified healthcare professional before use. Follow the label directions.</div>
    </details>
    <p class="ai-magnesium-faq-{{ ai_gen_id }}__note">General information only, not medical advice. Review the product label and consult a healthcare professional for individual advice.</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Magnesium FAQ",
  "settings": [
    {
      "type": "product",
      "id": "target_product",
      "label": "Show on product"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Magnesium FAQ"
    }
  ],
  "tag": null,
  "class": "magnesium-faq-block"
}
{% endschema %}