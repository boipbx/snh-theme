{%- comment -%}
  SNH bestsellers (prototype #shop): heading, pill tabs, product card grid (a swipe rail on mobile).
  Each Tab block shows its hand-picked products, or its collection when no products are picked.
{%- endcomment -%}
{%- assign hid = 'best-' | append: section.id -%}
<section class="v2 v-section v-section--cream" aria-labelledby="{{ hid }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="v-wrap">
    {%- render 'snh-v2-head', s: section.settings, id: hid -%}
    {%- if section.blocks.size > 1 -%}
      <div class="v-tabs" role="tablist" data-v2="tabs">
        {%- for b in section.blocks -%}
          <button class="tab" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="{{ hid }}-{{ forloop.index }}" id="{{ hid }}-tab{{ forloop.index }}" {{ b.shopify_attributes }}>{{ b.settings.label | escape }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- for b in section.blocks -%}
      <div class="grid grid--rail" id="{{ hid }}-{{ forloop.index }}" role="tabpanel" aria-labelledby="{{ hid }}-tab{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}>
        {%- if b.settings.products != blank -%}
          {%- for p in b.settings.products limit: section.settings.limit -%}{% render 'snh-v2-card', product: p %}{%- endfor -%}
        {%- elsif b.settings.collection != blank -%}
          {%- for p in b.settings.collection.products limit: section.settings.limit -%}{% render 'snh-v2-card', product: p %}{%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "SNH bestsellers",
  "class": "snh-sec",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's new at SNH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop our *bestsellers*" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "link_url", "label": "Button link" },
    { "type": "select", "id": "link_style", "label": "Button style", "options": [{ "value": "button", "label": "Ink button" }, { "value": "link", "label": "Underlined link" }], "default": "button" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "shop", "info": "Links to /#shop jump here." }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "label", "label": "Tab label", "default": "All" },
      { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
      { "type": "collection", "id": "collection", "label": "Or a collection", "info": "Used when no products are picked; its first products in the collection's sort order." }
    ] }
  ],
  "presets": [{ "name": "SNH bestsellers", "blocks": [{ "type": "tab" }] }]
}
{% endschema %}
