{%- comment -%}
  SNH register (Round 7, Round 8): Elite welcome pitch beside Shopify's create_customer form. Step 1 login, step 2 the
  old fields (mobile, address, city, birthday → customer[note][Phone|Address|City|Birthday]; the birthday drives
  birthday rewards). Mobile is required and must be a Sri Lankan mobile; it's saved as +94XXXXXXXXX (assets/snh-app.js).
  Step 3 (optional) "Personalise your SNH": the onboarding quiz. Round 10: answers go straight onto the new customer as
  customer[tags] (goal:, freq:, …, plus mobile: and bday: from step 2) in this one create_customer POST, so nothing is
  saved later in the background and Shopify's hCaptcha covers it. Steps and the password check: assets/snh-account.js. Errors return to step 1.
{%- endcomment -%}
{{ 'snh-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snh-account.js' | asset_url }}" defer></script>
{{ 'snh-app.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snh-app.js' | asset_url }}" defer></script>
{%- liquid
  assign welcome = settings.snh_welcome_points | default: 500
  assign r_b = settings.snh_rate_bronze | default: 3
  assign r_g = settings.snh_rate_gold | default: 10
-%}
<div class="v2 acc-page auth auth--bg">
  {%- render 'snh-auth-bg', s: section.settings -%}
  <div class="v-wrap auth__grid">
    {%- render 'snh-auth-aside', heading: section.settings.heading, lead: section.settings.lead, proof: section.settings.proof -%}
    <div class="auth__main auth__card">
      <p class="eyebrow">Join SNH Elite, it's free</p>
      <h1 class="auth__title">Create your account</h1>
      <p class="auth__sub">{% render 'snh-num', n: welcome %} welcome points, then {{ r_b }}–{{ r_g }}% back on everything you buy.</p>
      {%- form 'create_customer', class: 'aform reg', id: 'snh-register' -%}
        {%- if form.errors -%}<div class="aform__err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <input type="hidden" name="return_to" value="{{ routes.account_url }}#overview">
        <input type="hidden" name="customer[tags]" value="" data-reg-tags>
        <ol class="reg__steps" aria-label="Steps">
          <li class="is-on" data-reg-dot="1"><span>1</span>Your login</li>
          <li data-reg-dot="2"><span>2</span>Delivery and birthday</li>
          <li data-reg-dot="3"><span>3</span>Personalise</li>
        </ol>
        <fieldset class="reg__step" data-reg-step="1">
          <legend class="v-sr">Your login</legend>
          <div class="aform__grid">
            <label class="fld"><span>First name</span><input type="text" name="customer[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name" required></label>
            <label class="fld"><span>Last name</span><input type="text" name="customer[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name" required></label>
            <label class="fld fld--full"><span>Email</span><input type="email" name="customer[email]" value="{{ form.email | escape }}" autocomplete="email" autocapitalize="off" spellcheck="false" required></label>
            <label class="fld"><span>Password</span><input type="password" name="customer[password]" autocomplete="new-password" minlength="5" required data-pwd></label>
            <label class="fld"><span>Repeat password</span><input type="password" autocomplete="new-password" minlength="5" required data-pwd2 aria-describedby="reg-pwd-err"></label>
            <p class="fld__err fld--full" id="reg-pwd-err" hidden data-pwd-err>Passwords don't match.</p>
          </div>
          <button class="v-btn v-btn--accent auth__btn" type="button" data-reg-next><span>Continue</span></button>
        </fieldset>
        <fieldset class="reg__step" data-reg-step="2" hidden>
          <legend class="v-sr">Delivery and birthday</legend>
          <div class="aform__grid">
            <label class="fld fld--full"><span>Mobile number</span><input type="tel" name="customer[note][Phone]" inputmode="tel" autocomplete="tel" placeholder="77 123 4567" pattern="\+?[0-9 ]{9,16}" required data-sl-mobile data-tel94 aria-describedby="reg-mob-err reg-mob-help"></label>
            <p class="fld__err fld--full" id="reg-mob-err" hidden data-sl-err>Enter a Sri Lankan mobile number, like 077 123 4567 or +94 77 123 4567.</p>
            <p class="fld__help fld--full" id="reg-mob-help">For delivery updates and your points. Saved as +94XXXXXXXXX.</p>
            <label class="fld"><span>Street address</span><input type="text" name="customer[note][Address]" autocomplete="address-line1" required></label>
            <label class="fld"><span>City</span><input type="text" name="customer[note][City]" autocomplete="address-level2" placeholder="Colombo" required></label>
            <label class="fld fld--full"><span>Birthday</span><input type="date" name="customer[note][Birthday]" min="1930-01-01" max="{{ 'now' | date: '%Y-%m-%d' }}" autocomplete="bday" required aria-describedby="reg-bday-help"></label>
            <p class="fld__help fld--full" id="reg-bday-help">Only used for your birthday reward.</p>
          </div>
          <div class="reg__acts">
            <button class="v-btn v-btn--line" type="button" data-reg-back><span>Back</span></button>
            <button class="v-btn v-btn--accent" type="button" data-reg-next><span>Continue</span></button>
          </div>
        </fieldset>
        <fieldset class="reg__step reg__step--quiz" data-reg-step="3" hidden>
          <legend class="auth__step-h">Build your SNH plan <span>(optional)</span></legend>
          <p class="fld__help">Quick taps so your dashboard, picks and tips fit your training. Skip whenever you like.</p>
          {%- render 'snh-onboarding-quiz', blocks: section.blocks, id: 'reg-quiz', mode: 'register' -%}
          <div class="reg__acts">
            <button class="v-btn v-btn--line" type="button" data-reg-back><span>Edit details</span></button>
            <button class="v-btn v-btn--accent" type="submit"><span>Create account</span></button>
          </div>
          <p class="fld__help">Free forever. No card needed.</p>
        </fieldset>
      {%- endform -%}
      <p class="auth__alt">Already a member? <a class="v-link" href="{{ routes.account_login_url }}">Sign in</a></p>

      {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
      {%- if faqs.size > 0 -%}
        <div class="auth__faq">
          <h2 class="acc__h3">Questions</h2>
          {%- for b in section.blocks -%}{%- if b.type != 'faq' -%}{%- continue -%}{%- endif -%}
            <details class="qa" {{ b.shopify_attributes }}><summary>{{ b.settings.q | escape }}</summary><div class="qa__a">{{ b.settings.a }}</div></details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SNH register",
  "class": "shopify-section--snh-account",
  "settings": [
    { "type": "header", "content": "Background (Round 15)" },
    { "type": "image_picker", "id": "bg_1", "label": "Photo 1", "info": "Full-bleed photos crossfade slowly behind the form, under an orange → black tint. Athletes and stores read best." },
    { "type": "image_picker", "id": "bg_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "bg_3", "label": "Photo 3" },
    { "type": "video", "id": "bg_video", "label": "Background video (optional)", "info": "Plays muted and looped instead of the photos. Visitors who prefer reduced motion see photo 1." },
    { "type": "text", "id": "proof", "label": "Social-proof line", "default": "Sri Lanka's 1st premium VIP club for sport nutrition" },
    { "type": "text", "id": "heading", "label": "Pitch heading", "info": "Wrap a word in *asterisks* for the serif.", "default": "Fuel your goals. *Earn* your rewards." },
    { "type": "text", "id": "lead", "label": "Pitch text", "default": "Create your free account, claim your welcome points and earn back on every order." },
    { "type": "image_picker", "id": "image", "label": "Pitch image" }
  ],
  "blocks": [
    { "type": "quiz", "name": "Quiz question", "settings": [
      { "type": "select", "id": "step", "label": "Step", "options": [
        { "value": "goal", "label": "Primary goal" }, { "value": "goal2", "label": "Secondary goal" }, { "value": "lvl", "label": "Experience level" }, { "value": "freq", "label": "Training days" }, { "value": "sess", "label": "Session type" }, { "value": "sport", "label": "Sport" }, { "value": "diet", "label": "Diet" }, { "value": "budget", "label": "Budget" }, { "value": "exp", "label": "Supplement experience" }, { "value": "take", "label": "Already taking (multi-select)" }, { "value": "challenge", "label": "Biggest challenge" }, { "value": "flavour", "label": "Flavour" }, { "value": "age", "label": "Age range" }
      ], "default": "goal" },
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "text", "id": "help", "label": "Help text" },
      { "type": "textarea", "id": "answers", "label": "Answers", "info": "One per line: tag value | label | icon. The value is saved as a tag (goal:value …, see ELITE-ROADMAP.md). Keep goal values matching the Goal blocks. Icons: dumbbell flame run drop heart trophy sparkle bolt clock refresh ball bat racket bike wave leaf smile wallet pill shaker cup moon target star." }
    ] },
    { "type": "faq", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer" }
    ] }
  ]
}
{% endschema %}
