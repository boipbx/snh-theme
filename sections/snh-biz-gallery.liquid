{%- comment -%} Round 17: store photo gallery (franchise: Dehiwala, Wattala, Nugegoda). Photos with a caption and alt text. {%- endcomment -%}
{{ 'snh-biz.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign parts = s.heading | split: '*'
-%}
<section class="v2 biz-sec biz-sec--{{ s.style }}" aria-labelledby="bg-{{ section.id }}">
  <div class="v-wrap">
    <header class="biz-head">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="biz-h" id="bg-{{ section.id }}">{%- for p in parts -%}{%- if forloop.index0 == 1 -%}<em>{{ p | escape }}</em>{%- else -%}{{ p | escape }}{%- endif -%}{%- endfor -%}</h2>
      {%- if s.intro != blank -%}<div class="biz-rte">{{ s.intro }}</div>{%- endif -%}
    </header>
    <ul class="biz-gallery" role="list">
      {%- for b in section.blocks -%}
        <li class="biz-photo" {{ b.shopify_attributes }}>
          {%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 1024px) 33vw, 90vw', alt: b.settings.alt | default: b.settings.caption }}{%- endif -%}
          {%- if b.settings.caption != blank -%}<p class="biz-photo__cap">{% render 'snh-v2-icon', name: 'pin' %}<span>{{ b.settings.caption | escape }}</span></p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{ "name": "SNH business gallery", "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Proven *stores*" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "select", "id": "style", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" } ], "default": "white" }
  ],
  "blocks": [ { "type": "photo", "name": "Photo", "settings": [ { "type": "image_picker", "id": "image", "label": "Photo" }, { "type": "text", "id": "caption", "label": "Caption" }, { "type": "text", "id": "alt", "label": "Description (alt text)" } ] } ],
  "presets": [ { "name": "SNH business gallery" } ] }
{% endschema %}
