{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --snh-bg: {{ section.settings.page_background | default: '#F4F5F7' }};
    --snh-surface: {{ section.settings.card_background | default: '#FFFFFF' }};
    --snh-ink: {{ section.settings.text_color | default: '#111318' }};
    --snh-muted: {{ section.settings.muted_text_color | default: '#626874' }};
    --snh-orange: {{ section.settings.accent_color | default: '#BF4512' }};
    --snh-border: rgba(17, 19, 24, 0.10);
    --snh-border-strong: rgba(17, 19, 24, 0.16);
    --snh-shadow: 0 18px 55px rgba(17, 19, 24, 0.08);
    --snh-shadow-hover: 0 28px 80px rgba(17, 19, 24, 0.16);
    --snh-radius-xl: 34px;
    --snh-radius-lg: 26px;
    --snh-radius-md: 18px;

    background: var(--snh-bg);
  }

  #shopify-section-{{ section.id }} .blog {
    min-height: 70vh;
    background:
      radial-gradient(circle at 10% 6%, rgba(255, 106, 0, 0.14), transparent 28rem),
      radial-gradient(circle at 92% 0%, rgba(17, 19, 24, 0.06), transparent 26rem),
      linear-gradient(180deg, #f7f8fa 0%, var(--snh-bg) 42%, var(--snh-bg) 100%);
    color: var(--snh-ink);
  }

  #shopify-section-{{ section.id }} .snh-journal {
    padding-block: clamp(34px, 5.4vw, 76px) clamp(58px, 7vw, 106px);
  }

  #shopify-section-{{ section.id }} .snh-journal-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.72fr);
    gap: clamp(22px, 4.6vw, 70px);
    align-items: end;
    margin-bottom: clamp(26px, 4vw, 50px);
    overflow: hidden;
    border: 1px solid var(--snh-border);
    border-radius: var(--snh-radius-xl);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.60)),
      radial-gradient(circle at 12% 14%, rgba(255, 106, 0, 0.13), transparent 22rem);
    box-shadow: 0 20px 70px rgba(17, 19, 24, 0.07);
    padding: clamp(30px, 5vw, 66px);
    isolation: isolate;
    animation: snhFadeUp 0.7s cubic-bezier(.2,.8,.2,1) both;
  }

  #shopify-section-{{ section.id }} .snh-journal-hero::before {
    content: "";
    position: absolute;
    left: clamp(30px, 5vw, 66px);
    right: clamp(30px, 5vw, 66px);
    top: 0;
    height: 4px;
    border-radius: 0 0 999px 999px;
    background: linear-gradient(90deg, var(--snh-orange), rgba(255, 106, 0, 0.18));
    opacity: 0.85;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .snh-journal-hero::after {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    right: -180px;
    bottom: -220px;
    border-radius: 999px;
    background: rgba(255, 106, 0, 0.075);
    pointer-events: none;
    z-index: -1;
  }

  #shopify-section-{{ section.id }} .snh-journal-title {
    max-width: 880px;
    margin: 0;
    color: var(--snh-ink);
    font-size: var(--t-h1, 36px);   /* Round 13: on the v2 type scale */
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 850;
    text-wrap: balance;
    animation: snhFadeUp 0.8s 0.08s cubic-bezier(.2,.8,.2,1) both;
  }

  #shopify-section-{{ section.id }} .snh-journal-copy {
    max-width: 545px;
    color: var(--snh-muted);
    font-size: 16px;
    line-height: 1.5;
    font-weight: 560;
    animation: snhFadeUp 0.8s 0.16s cubic-bezier(.2,.8,.2,1) both;
  }

  #shopify-section-{{ section.id }} .snh-journal-copy p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .snh-filter-wrap {
    margin-bottom: clamp(22px, 3.2vw, 38px);
    animation: snhFadeUp 0.8s 0.22s cubic-bezier(.2,.8,.2,1) both;
  }

  #shopify-section-{{ section.id }} .snh-filter {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 3px 2px 9px;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .snh-filter::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .snh-filter ul {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .snh-filter a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    white-space: nowrap;
    border: 1px solid var(--snh-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.74);
    color: var(--snh-ink);
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 780;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .snh-filter a:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 106, 0, 0.36);
    background: rgba(255, 106, 0, 0.09);
  }

  #shopify-section-{{ section.id }} .snh-filter li[aria-current="page"] a,
  #shopify-section-{{ section.id }} .snh-filter a.is-selected {
    border-color: var(--snh-orange);
    background: var(--snh-orange);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .snh-articles-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  #shopify-section-{{ section.id }} .snh-article {
    grid-column: span 4;
    min-width: 0;
    animation: snhCardIn 0.74s cubic-bezier(.2,.8,.2,1) both;
    animation-delay: calc(var(--snh-card-index, 0) * 70ms);
  }

  #shopify-section-{{ section.id }} .snh-article--featured {
    grid-column: span 8;
  }

  #shopify-section-{{ section.id }} .snh-article-link {
    position: relative;
    display: grid;
    height: 100%;
    min-height: 390px;
    overflow: hidden;
    border: 1px solid var(--snh-border);
    border-radius: var(--snh-radius-xl);
    background: var(--snh-surface);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--snh-shadow);
    transition:
      transform 0.38s cubic-bezier(.2,.8,.2,1),
      box-shadow 0.38s cubic-bezier(.2,.8,.2,1),
      border-color 0.38s cubic-bezier(.2,.8,.2,1);
  }

  #shopify-section-{{ section.id }} .snh-article-link:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 106, 0, 0.32);
    box-shadow: var(--snh-shadow-hover);
  }

  #shopify-section-{{ section.id }} .snh-article-link::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(255, 106, 0, 0.0);
    border-radius: calc(var(--snh-radius-xl) - 12px);
    transition: border-color 0.38s ease, inset 0.38s ease;
    pointer-events: none;
    z-index: 4;
  }

  #shopify-section-{{ section.id }} .snh-article-link:hover::before {
    inset: 14px;
    border-color: rgba(255, 106, 0, 0.24);
  }

  #shopify-section-{{ section.id }} .snh-article-media {
    position: relative;
    min-height: 228px;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 106, 0, 0.22), transparent 16rem),
      linear-gradient(135deg, #eceff3, #dfe3e9);
  }

  #shopify-section-{{ section.id }} .snh-article-media::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 44%;
    background: linear-gradient(180deg, rgba(17, 19, 24, 0), rgba(17, 19, 24, 0.38));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .snh-article-image {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    transform: scale(1.015);
    transition: transform 0.65s cubic-bezier(.2,.8,.2,1), filter 0.65s ease;
  }

  #shopify-section-{{ section.id }} .snh-article-link:hover .snh-article-image {
    transform: scale(1.075);
    filter: saturate(1.08) contrast(1.03);
  }

  #shopify-section-{{ section.id }} .snh-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 26% 24%, rgba(255, 106, 0, 0.24), transparent 17rem),
      linear-gradient(135deg, #f0f2f5, #dfe3e8);
  }

  #shopify-section-{{ section.id }} .snh-placeholder span {
    color: rgba(17, 19, 24, 0.11);
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.08em;
  }

  #shopify-section-{{ section.id }} .snh-article-category {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 3;
    max-width: calc(100% - 36px);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    border: 1px solid rgba(255, 255, 255, 0.30);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.88);
    color: var(--snh-ink);
    padding: 8px 12px;
    backdrop-filter: blur(12px);
    font-size: 12px;
    font-weight: 820;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .snh-article-link:hover .snh-article-category {
    transform: translateY(-3px);
  }

  #shopify-section-{{ section.id }} .snh-article-body {
    display: flex;
    flex-direction: column;
    padding: clamp(21px, 2.2vw, 30px);
  }

  #shopify-section-{{ section.id }} .snh-article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 14px;
    color: var(--snh-muted);
    font-size: 12px;
    font-weight: 740;
  }

  #shopify-section-{{ section.id }} .snh-article-meta span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .snh-article-meta span:not(:last-child)::after {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: rgba(17, 19, 24, 0.24);
  }

  #shopify-section-{{ section.id }} .snh-article-title {
    margin: 0;
    color: var(--snh-ink);
    font-size: var(--t-h4, 20px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 820;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .snh-article-excerpt {
    display: -webkit-box;
    margin: 14px 0 0;
    overflow: hidden;
    color: var(--snh-muted);
    font-size: 15px;
    line-height: 1.5;
    font-weight: 480;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  #shopify-section-{{ section.id }} .snh-article-line {
    width: 100%;
    height: 1px;
    margin-top: auto;
    padding-top: 24px;
    border-bottom: 1px solid rgba(17, 19, 24, 0.09);
    transition: border-color 0.28s ease;
  }

  #shopify-section-{{ section.id }} .snh-article-link:hover .snh-article-line {
    border-color: rgba(255, 106, 0, 0.42);
  }

  #shopify-section-{{ section.id }} .snh-article--featured .snh-article-link {
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    min-height: 536px;
  }

  #shopify-section-{{ section.id }} .snh-article--featured .snh-article-media {
    min-height: 100%;
  }

  #shopify-section-{{ section.id }} .snh-article--featured .snh-article-body {
    justify-content: center;
    padding: clamp(30px, 4vw, 52px);
  }

  #shopify-section-{{ section.id }} .snh-article--featured .snh-article-title {
    font-size: var(--t-h2, 28px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 840;
  }

  #shopify-section-{{ section.id }} .snh-article--featured .snh-article-excerpt {
    max-width: 590px;
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.5;
    -webkit-line-clamp: 4;
  }

  #shopify-section-{{ section.id }} .snh-empty-state {
    display: grid;
    min-height: 420px;
    place-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .snh-empty-box {
    max-width: 560px;
    border: 1px solid var(--snh-border);
    border-radius: var(--snh-radius-xl);
    background: #fff;
    box-shadow: var(--snh-shadow);
    padding: clamp(32px, 5vw, 56px);
  }

  #shopify-section-{{ section.id }} .snh-empty-icon {
    display: grid;
    width: 60px;
    height: 60px;
    place-items: center;
    margin: 0 auto 18px;
    border-radius: 20px;
    background: rgba(255, 106, 0, 0.1);
    color: var(--snh-orange);
  }

  #shopify-section-{{ section.id }} .pagination {
    margin-top: clamp(34px, 5vw, 64px);
  }

  @keyframes snhFadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes snhCardIn {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .snh-article {
      grid-column: span 6;
    }

    #shopify-section-{{ section.id }} .snh-article--featured {
      grid-column: span 12;
    }
  }

  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .snh-journal-hero {
      grid-template-columns: 1fr;
      align-items: start;
    }

    #shopify-section-{{ section.id }} .snh-journal-copy {
      max-width: 720px;
    }

    #shopify-section-{{ section.id }} .snh-article--featured .snh-article-link {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .snh-article--featured .snh-article-media {
      min-height: 280px;
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .snh-journal {
      padding-block: 26px 70px;
    }

    #shopify-section-{{ section.id }} .snh-journal-hero {
      border-radius: 26px;
      padding: 24px;
    }

    #shopify-section-{{ section.id }} .snh-journal-title {
      font-size: var(--t-h1, 36px);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    #shopify-section-{{ section.id }} .snh-filter-wrap {
      margin-inline: calc(-1 * var(--container-gutter, 20px));
      padding-inline: var(--container-gutter, 20px);
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .snh-articles-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .snh-article,
    #shopify-section-{{ section.id }} .snh-article--featured {
      grid-column: span 1;
    }

    #shopify-section-{{ section.id }} .snh-article-link {
      min-height: 0;
      border-radius: 24px;
    }

    #shopify-section-{{ section.id }} .snh-article-media {
      min-height: 235px;
    }

    #shopify-section-{{ section.id }} .snh-article-body,
    #shopify-section-{{ section.id }} .snh-article--featured .snh-article-body {
      padding: 22px;
    }

    #shopify-section-{{ section.id }} .snh-article--featured .snh-article-title {
      font-size: var(--t-h3, 24px);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} *,
    #shopify-section-{{ section.id }} *::before,
    #shopify-section-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }

    #shopify-section-{{ section.id }} .snh-article-link:hover,
    #shopify-section-{{ section.id }} .snh-filter a:hover {
      transform: none;
    }
  }
</style>

<div class="blog">
  <div class="container snh-journal">
    {%- if blog.articles_count == 0 -%}
      <div class="snh-empty-state">
        <div class="snh-empty-box">
          <div class="snh-empty-icon">
            {%- render 'icon' with 'picto-comment', width: 30, height: 30, stroke_width: 1.4 -%}
          </div>

          <div class="prose">
            <h1 class="h4">{{ 'blog.general.empty_blog' | t }}</h1>

            {%- assign button_content = 'blog.general.back_to_home' | t -%}
            {%- render 'button', size: 'xl', content: button_content, href: routes.root_url -%}
          </div>
        </div>
      </div>
    {%- else -%}
      {%- if section.settings.show_intro -%}
        <header class="snh-journal-hero">
          <div>
            {%- if section.settings.hero_title != blank -%}
              <h1 class="snh-journal-title">{{ section.settings.hero_title }}</h1>
            {%- endif -%}
          </div>

          <div>
            {%- if section.settings.hero_text != blank -%}
              <div class="snh-journal-copy">
                {{ section.settings.hero_text }}
              </div>
            {%- endif -%}
          </div>
        </header>
      {%- endif -%}

      {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
        <div class="snh-filter-wrap">
          <nav class="snh-filter" aria-label="Blog categories">
            <ul>
              <li{% if current_tags == blank %} aria-current="page"{% endif %}>
                <a href="{{ blog.url }}" class="{% if current_tags == blank %}is-selected{% endif %}">
                  All posts
                </a>
              </li>

              {%- for tag in blog.all_tags -%}
                <li{% if current_tags contains tag %} aria-current="page"{% endif %}>
                  {%- if current_tags contains tag -%}
                    {{- tag | link_to_remove_tag: tag -}}
                  {%- else -%}
                    {{- tag | link_to_tag: tag -}}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </div>
      {%- endif -%}

      {%- paginate blog.articles by section.settings.articles_per_page -%}
        <div class="snh-articles-grid">
          {%- for article in blog.articles -%}
            {%- assign is_featured = false -%}

            {%- if section.settings.feature_first_article and forloop.first -%}
              {%- assign is_featured = true -%}
            {%- endif -%}

            {%- assign words = article.content | strip_html | split: ' ' | size -%}
            {%- assign reading_time = words | divided_by: 180 | plus: 1 -%}

            {%- assign loading_attr = 'lazy' -%}
            {%- assign fetch_priority = 'auto' -%}

            {%- if forloop.first -%}
              {%- assign loading_attr = 'eager' -%}
              {%- assign fetch_priority = 'high' -%}
            {%- endif -%}

            {%- if is_featured -%}
              {%- capture image_sizes -%}(max-width: 899px) 100vw, calc(min(100vw, {{ settings.page_width }}px) * 0.48){%- endcapture -%}
            {%- else -%}
              {%- capture image_sizes -%}(max-width: 699px) 100vw, (max-width: 1199px) calc(50vw - 36px), calc(min(100vw, {{ settings.page_width }}px) / 3 - 38px){%- endcapture -%}
            {%- endif -%}

            <article class="snh-article{% if is_featured %} snh-article--featured{% endif %}" style="--snh-card-index: {{ forloop.index0 }};">
              <a href="{{ article.url }}" class="snh-article-link" aria-label="{{ article.title | escape }}">
                <div class="snh-article-media">
                  {%- if article.image != blank -%}
                    {%- assign image_alt = article.image.alt | default: article.title | escape -%}
                    {{ article.image | image_url: width: 1500 | image_tag: widths: '375, 550, 750, 900, 1100, 1300, 1500', sizes: image_sizes, class: 'snh-article-image', loading: loading_attr, fetchpriority: fetch_priority, alt: image_alt }}
                  {%- else -%}
                    <div class="snh-placeholder">
                      <span>SNH</span>
                    </div>
                  {%- endif -%}

                  {%- if section.settings.show_category and article.tags.size > 0 -%}
                    <span class="snh-article-category">{{ article.tags.first }}</span>
                  {%- endif -%}
                </div>

                <div class="snh-article-body">
                  {%- if section.settings.show_date or section.settings.show_author or section.settings.show_reading_time -%}
                    <div class="snh-article-meta">
                      {%- if section.settings.show_date -%}
                        <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                      {%- endif -%}

                      {%- if section.settings.show_author and article.author != blank -%}
                        <span>{{ article.author }}</span>
                      {%- endif -%}

                      {%- if section.settings.show_reading_time -%}
                        <span>{{ reading_time }} min read</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <h2 class="snh-article-title">{{ article.title }}</h2>

                  {%- if section.settings.show_excerpt -%}
                    <p class="snh-article-excerpt">
                      {{ article.excerpt_or_content | strip_html | truncatewords: 32 }}
                    </p>
                  {%- endif -%}

                  <div class="snh-article-line" aria-hidden="true"></div>
                </div>
              </a>
            </article>
          {%- endfor -%}
        </div>

        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "class": "shopify-section--main-blog",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "Show hero",
      "default": true
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Heading",
      "default": "Train smarter. Fuel better."
    },
    {
      "type": "richtext",
      "id": "hero_text",
      "label": "Description",
