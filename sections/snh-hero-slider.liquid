{%- comment -%}
  SNH hero: full-screen slider (prototype section.hero). Slides are blocks:
  "overlay" = clean photo with our copy on it, "banner" = artwork with baked-in text, full bleed, the whole slide links.
  Story-style progress segments double as the autoplay timer (assets/snh-v2.js data-v2="carousel").
{%- endcomment -%}
{%- assign n = section.blocks.size -%}
<section class="v2 hero" data-v2="carousel" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}" style="--hero-interval: {{ section.settings.interval }}s">
  {%- comment -%} Audit fix: an image-only first slide on a page leaves the page without an H1; name it for screen readers and search {%- endcomment -%}
  {%- if template.name == 'page' and section.index == 1 and section.blocks.first.settings.heading == blank -%}<h1 class="v-sr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap">{{ page.title | escape }}</h1>{%- endif -%}
  <div class="hero__stage">
    {%- for b in section.blocks -%}
      {%- liquid
        assign on = forloop.first
        assign d = b.settings.image_desktop
        assign m = b.settings.image_mobile | default: d
        assign alt = b.settings.alt | default: b.settings.label
      -%}
      {%- capture pic -%}
        <picture class="hero__pic">
          {%- comment -%} Round 12: slides after the first carry data-src / data-srcset; assets/snh-v2.js attaches them just before the
            slide shows. Stacked on screen, loading="lazy" didn't hold them back (~270 KB at page load on phones). {%- endcomment -%}
          {%- if on -%}{%- assign sa = 'srcset' -%}{%- assign ia = 'src' -%}{%- else -%}{%- assign sa = 'data-srcset' -%}{%- assign ia = 'data-src' -%}{%- endif -%}
          {%- if m != blank -%}<source media="(max-width: 767px)" {{ sa }}="{{ m | image_url: width: 800 }} 800w, {{ m | image_url: width: 1200 }} 1200w" sizes="100vw" width="{{ m.width }}" height="{{ m.height }}">{%- endif -%}
          {%- if d != blank -%}
            <img {{ ia }}="{{ d | image_url: width: 1800 }}" {{ sa }}="{{ d | image_url: width: 1200 }} 1200w, {{ d | image_url: width: 1800 }} 1800w, {{ d | image_url: width: 2800 }} 2800w" sizes="100vw" width="{{ d.width }}" height="{{ d.height }}" alt="{{ alt | escape }}" style="--pos:{{ b.settings.pos }};--mpos:{{ b.settings.mpos }}" loading="{% if on %}eager{% else %}lazy{% endif %}"{% if on %} fetchpriority="high"{% endif %} decoding="async">
          {%- endif -%}
        </picture>
      {%- endcapture -%}
      {%- capture attrs -%}class="hero__slide hero__slide--{{ b.settings.kind }}{% if on %} is-on{% endif %}" data-i="{{ forloop.index0 }}" data-block="{{ b.id }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ n }}: {{ b.settings.label | escape }}"{% unless on %} aria-hidden="true" inert{% endunless %} {{ b.shopify_attributes }}{%- endcapture -%}
      {%- if b.settings.kind == 'banner' -%}
        <a {{ attrs }} href="{{ b.settings.link | default: '#' }}">{{ pic }}</a>
      {%- else -%}
        <div {{ attrs }}>{{ pic }}<div class="hero__shade"></div>
          <div class="hero__copy v-wrap">
            {%- if b.settings.eyebrow != blank -%}<p class="eyebrow">{{ b.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- if on -%}<h1 class="display">{% render 'snh-v2-heading', text: b.settings.heading %}</h1>{%- else -%}<h2 class="display">{% render 'snh-v2-heading', text: b.settings.heading %}</h2>{%- endif -%}
            {%- if b.settings.sub != blank -%}<p class="hero__sub">{{ b.settings.sub | escape }}</p>{%- endif -%}
            <div class="hero__cta">
              {%- if b.settings.cta != blank -%}<a class="v-btn v-btn--accent" href="{{ b.settings.link | default: '#' }}"><span>{{ b.settings.cta | escape }}</span></a>{%- endif -%}
              {%- if b.settings.cta2 != blank -%}<a class="v-btn v-btn--line v-btn--on-dark" href="{{ b.settings.link2 | default: '#' }}"><span>{{ b.settings.cta2 | escape }}</span></a>{%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if n > 1 -%}
    <div class="hero__controls v-wrap">
      <div class="hero__progress" role="group" aria-label="Choose slide">
        {%- for b in section.blocks -%}<button class="seg{% if forloop.first %} is-on{% endif %}" type="button" aria-label="Go to slide {{ forloop.index }}: {{ b.settings.label | escape }}"{% if forloop.first %} aria-current="true"{% endif %}><span></span></button>{%- endfor -%}
      </div>
      <div class="hero__arrows">
        <button class="hero__arrow" type="button" data-dir="-1" aria-label="Previous slide">{% render 'snh-v2-icon', name: 'arrow' %}</button>
        <button class="hero__arrow" type="button" data-dir="1" aria-label="Next slide">{% render 'snh-v2-icon', name: 'arrow' %}</button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "SNH hero slider",
  "class": "snh-sec",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible name", "default": "Featured" },
    { "type": "range", "id": "interval", "label": "Time per slide", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "select", "id": "kind", "label": "Type", "options": [{ "value": "overlay", "label": "Photo + our text" }, { "value": "banner", "label": "Banner (text in the artwork)" }], "default": "overlay" },
        { "type": "text", "id": "label", "label": "Slide name", "default": "Slide", "info": "Read out by screen readers and shown on the progress buttons." },
        { "type": "image_picker", "id": "image_desktop", "label": "Desktop image", "info": "Landscape, 2800px wide or more." },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Portrait. Falls back to the desktop image." },
        { "type": "text", "id": "pos", "label": "Desktop focal point", "default": "50% 50%", "info": "x% y%: which part of the photo stays in view." },
        { "type": "text", "id": "mpos", "label": "Mobile focal point", "default": "50% 30%" },
        { "type": "text", "id": "alt", "label": "Image description (banner slides)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Serious fuel for *serious* training.", "info": "Wrap a word in *asterisks* to set it in the serif italic." },
        { "type": "text", "id": "sub", "label": "Sub line" },
        { "type": "text", "id": "cta", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Button link (banner: slide link)" },
        { "type": "text", "id": "cta2", "label": "Second button label" },
        { "type": "url", "id": "link2", "label": "Second button link" }
      ]
    }
  ],
  "presets": [{ "name": "SNH hero slider", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
