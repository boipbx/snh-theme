{%- comment -%}
  SNH set password (Round 7): customers/activate_account (activate_customer_password, with Decline) and
  customers/reset_password (reset_customer_password). Mode follows the template.
{%- endcomment -%}
{{ 'snh-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snh-account.js' | asset_url }}" defer></script>
{%- liquid
  if template.name == 'activate_account'
    assign kind = 'activate_customer_password'
    assign title = 'Activate your account'
    assign sub = 'Choose a password to finish setting up your SNH account and start earning points.'
    assign cta = 'Activate account'
  else
    assign kind = 'reset_customer_password'
    assign title = 'Set a new password'
    assign sub = 'Choose a new password for your SNH account.'
    assign cta = 'Save password'
  endif
-%}
<div class="v2 acc-page auth auth--bg">
  {%- render 'snh-auth-bg', s: section.settings -%}
  <div class="v-wrap auth__grid">
    {%- render 'snh-auth-aside', heading: section.settings.heading, lead: section.settings.lead, proof: section.settings.proof -%}
    <div class="auth__main auth__card">
      <p class="eyebrow">SNH account</p>
      <h1 class="auth__title">{{ title }}</h1>
      <p class="auth__sub">{{ sub }}</p>
      {%- if kind == 'activate_customer_password' -%}
        {%- form 'activate_customer_password', class: 'aform' -%}
          {%- if form.errors -%}<div class="aform__err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <label class="fld"><span>Password</span><input type="password" name="customer[password]" autocomplete="new-password" minlength="5" required data-pwd></label>
          <label class="fld"><span>Repeat password</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" minlength="5" required data-pwd2 aria-describedby="pw-err"></label>
          <p class="fld__err" id="pw-err" hidden data-pwd-err>Passwords don't match.</p>
          <button class="v-btn v-btn--accent auth__btn" type="submit"><span>{{ cta }}</span></button>
          <button class="v-btn v-btn--line auth__btn" type="submit" name="decline" value="1" formnovalidate><span>Decline invitation</span></button>
        {%- endform -%}
      {%- else -%}
        {%- form 'reset_customer_password', class: 'aform' -%}
          {%- if form.errors -%}<div class="aform__err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <label class="fld"><span>Password</span><input type="password" name="customer[password]" autocomplete="new-password" minlength="5" required data-pwd></label>
          <label class="fld"><span>Repeat password</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" minlength="5" required data-pwd2 aria-describedby="pw-err"></label>
          <p class="fld__err" id="pw-err" hidden data-pwd-err>Passwords don't match.</p>
          <button class="v-btn v-btn--accent auth__btn" type="submit"><span>{{ cta }}</span></button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SNH set password",
  "class": "shopify-section--snh-account",
  "settings": [
    { "type": "header", "content": "Background (Round 15)" },
    { "type": "image_picker", "id": "bg_1", "label": "Photo 1", "info": "Full-bleed photos crossfade slowly behind the form, under an orange → black tint. Athletes and stores read best." },
    { "type": "image_picker", "id": "bg_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "bg_3", "label": "Photo 3" },
    { "type": "video", "id": "bg_video", "label": "Background video (optional)", "info": "Plays muted and looped instead of the photos. Visitors who prefer reduced motion see photo 1." },
    { "type": "text", "id": "proof", "label": "Social-proof line", "default": "Sri Lanka's 1st premium VIP club for sport nutrition" },
    { "type": "text", "id": "heading", "label": "Pitch heading", "default": "Welcome to *SNH Elite*" },
    { "type": "text", "id": "lead", "label": "Pitch text", "default": "Points on every order, a birthday reward and perks that grow with you." }
  ]
}
{% endschema %}
