{%- comment -%}
  SNH — "What's new" (self-contained)

  No collection dependency. The section finds products itself:
    • Newest        → every product in the store, sorted by creation date
    • Deals         → anything with a compare-at price above its price
    • Bundles       → anything tagged / titled as a bundle
    • Newest + deals→ new first, deals filling the rest
  Optional tag filter narrows any mode without touching a collection.

  Cards come from snippets/product-card.liquid — the single SNH card used by the
  collection grid, search and related products. This section holds no card CSS
  of its own, so every card change lands here automatically.
{%- endcomment -%}


{%- liquid
  assign mode = section.settings.mode | default: 'new'
  assign want = section.settings.products_count | default: 8
  assign tag_filter = section.settings.tag_filter | strip | downcase
  assign new_window = section.settings.new_days | default: 30 | times: 86400
  assign now_s = 'now' | date: '%s' | times: 1
-%}

{%- comment -%} pull the whole catalogue, newest first {%- endcomment -%}
{%- paginate collections.all.products by 250 -%}
  {%- assign pool = collections.all.products | sort: 'created_at' | reverse -%}
{%- endpaginate -%}

{%- capture card_rows -%}
  {%- assign shown = 0 -%}
  {%- for product in pool -%}
    {%- if shown >= want -%}{%- break -%}{%- endif -%}
    {%- unless product.available -%}{%- continue -%}{%- endunless -%}

    {%- liquid
      assign made_s = product.created_at | date: '%s' | times: 1
      assign age = now_s | minus: made_s
      assign is_new = false
      if age < new_window
        assign is_new = true
      endif

      assign is_deal = false
      if product.compare_at_price > product.price
        assign is_deal = true
      endif

      assign hay = product.title | append: ' ' | append: product.tags | join: ' ' | downcase
      assign is_bundle = false
      if hay contains 'bundle' or hay contains 'stack' or hay contains 'combo'
        assign is_bundle = true
      endif

      assign keep = false
      case mode
        when 'new'
          assign keep = is_new
        when 'deals'
          assign keep = is_deal
        when 'bundles'
          assign keep = is_bundle
        when 'new_deals'
          if is_new or is_deal
            assign keep = true
          endif
        else
          assign keep = true
      endcase

      if tag_filter != blank
        unless hay contains tag_filter
          assign keep = false
        endunless
      endif
    -%}

    {%- if keep -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- comment -%} card CSS ships with the first card only {%- endcomment -%}
      {%- if shown == 1 -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        {%- render 'product-card', product: product, with_css: false -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section id="snh-wn-{{ section.id }}" class="snh-wn">
  <div class="snh-wn__inner">
    <header class="snh-wn__head">
      <div>
        {%- if section.settings.subheading != blank -%}
          <p class="snh-wn__eyebrow">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <h2 class="snh-wn__title">{{ section.settings.title | default: "What's new at SNH?" }}</h2>
      </div>
      {%- if section.settings.link_url != blank -%}
        <a class="snh-wn__all" href="{{ section.settings.link_url }}">{{ section.settings.link_text | default: 'View all' }}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </header>

    {%- if card_rows == blank -%}
      <p class="snh-wn__empty">Nothing matches this filter yet &mdash; widen &ldquo;Counts as new for&rdquo;, or switch &ldquo;Show&rdquo; to <em>Newest + deals</em>.</p>
    {%- else -%}
      <div class="snh-wn__rail" data-wn-rail>{{ card_rows }}</div>
      <div class="snh-wn__nav">
        <button type="button" class="snh-wn__arrow" data-wn-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="snh-wn__arrow" data-wn-next aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #snh-wn-{{ section.id }}, #snh-wn-{{ section.id }} * { box-sizing: border-box; }
  #snh-wn-{{ section.id }} {
    --wn-orange: var(--snh-accent);
    --wn-ink: var(--snh-ink);
    --wn-muted: var(--snh-muted);
    --wn-line: #e7e0d6;
    display: block;
    overflow-x: clip;
    background: {{ section.settings.background | default: '#ffffff' }};
    font-family: var(--snh-font-body);
    color: var(--wn-ink);
  }
  #snh-wn-{{ section.id }} .snh-wn__inner {
    max-width: 1500px;
    margin-inline: auto;
    padding: clamp(28px, 3.4vw, 52px) clamp(18px, 4vw, 64px) clamp(32px, 3.6vw, 56px);
  }

  #snh-wn-{{ section.id }} .snh-wn__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(18px, 2vw, 28px);
  }
  #snh-wn-{{ section.id }} .snh-wn__eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--wn-orange);
  }
  #snh-wn-{{ section.id }} .snh-wn__title {
    margin: 0;
    font-family: var(--snh-font-display);
    font-size: clamp(30px, 4.2vw, 58px);
    font-weight: 800;
    letter-spacing: -.035em;
    line-height: .95;
    text-transform: uppercase;
  }
  #snh-wn-{{ section.id }} .snh-wn__all {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--wn-line);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .02em;
    color: var(--wn-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color .2s ease, border-color .2s ease;
  }
  #snh-wn-{{ section.id }} .snh-wn__all svg { width: 14px; height: 14px; }
  #snh-wn-{{ section.id }} .snh-wn__all:hover { color: var(--wn-orange); border-bottom-color: var(--wn-orange); }
  #snh-wn-{{ section.id }} .snh-wn__empty { margin: 0; font-size: 14px; color: var(--wn-muted); }

  #snh-wn-{{ section.id }} .snh-wn__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(280px, 23vw, 340px);
    gap: 18px;
    /* soft fade instead of a hard cut where the rail runs off-screen */
    -webkit-mask-image: linear-gradient(90deg, #000 0, #000 calc(100% - 90px), transparent 100%);
    mask-image: linear-gradient(90deg, #000 0, #000 calc(100% - 90px), transparent 100%);
    overflow-x: auto;
    padding-bottom: 16px;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: rgba(224, 82, 28, .38) transparent;
  }
  #snh-wn-{{ section.id }} .snh-wn__rail::-webkit-scrollbar { height: 5px; }
  #snh-wn-{{ section.id }} .snh-wn__rail::-webkit-scrollbar-thumb { background: rgba(224, 82, 28, .38); border-radius: 3px; }
  /* the cards themselves are styled by snippets/product-card.liquid — the rail
     only positions them */
  #snh-wn-{{ section.id }} .snh-wn__rail > .snh-pc { scroll-snap-align: start; min-width: 0; }

  #snh-wn-{{ section.id }} .snh-wn__nav { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }
  #snh-wn-{{ section.id }} .snh-wn__arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--wn-line);
    border-radius: 999px;
    background: #fff;
    color: var(--wn-ink);
    cursor: pointer;
    transition: border-color .2s ease, background .2s ease, color .2s ease, opacity .2s ease;
  }
  #snh-wn-{{ section.id }} .snh-wn__arrow svg { width: 17px; height: 17px; }
  #snh-wn-{{ section.id }} .snh-wn__arrow:hover { background: var(--wn-ink); border-color: var(--wn-ink); color: #fff; }
  #snh-wn-{{ section.id }} .snh-wn__arrow[disabled] { opacity: .3; pointer-events: none; }

  @media screen and (max-width: 749px) {
    #snh-wn-{{ section.id }} .snh-wn__rail { grid-auto-columns: 84vw; gap: 12px; -webkit-mask-image: none; mask-image: none; }
    #snh-wn-{{ section.id }} .snh-wn__head { align-items: flex-start; flex-direction: column; gap: 12px; }
    #snh-wn-{{ section.id }} .snh-wn__nav { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #snh-wn-{{ section.id }} *, #snh-wn-{{ section.id }} *::before { transition: none !important; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('snh-wn-{{ section.id }}');
    if (!root || root.dataset.wnInit) return;
    root.dataset.wnInit = '1';
    /* add-to-cart, quick view and the loyalty line all live in the card
       snippet now — this only drives the rail arrows */
    var rail = root.querySelector('[data-wn-rail]');
    var prev = root.querySelector('[data-wn-prev]');
    var next = root.querySelector('[data-wn-next]');
    if (!rail || !prev || !next) return;

    function step() {
      var card = rail.firstElementChild;
      return card ? card.getBoundingClientRect().width + 18 : 320;
    }
    function sync() {
      prev.disabled = rail.scrollLeft < 6;
      next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 6;
    }
    prev.addEventListener('click', function () { rail.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { rail.scrollBy({ left: step(), behavior: 'smooth' }); });
    rail.addEventListener('scroll', sync, { passive: true });
    sync();
  })();
</script>

{% schema %}
{
  "name": "What's new (SNH)",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "No collection needed — this section reads your whole catalogue and keeps itself current. Cards use the shared SNH product card, so any card change applies here too."
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Show",
      "options": [
        { "value": "new", "label": "Newest products" },
        { "value": "new_deals", "label": "Newest + deals" },
        { "value": "deals", "label": "Deals only (compare-at price set)" },
        { "value": "bundles", "label": "Bundles only" },
        { "value": "all", "label": "Everything, newest first" }
      ],
      "default": "new_deals"
    },
    {
      "type": "range",
      "id": "new_days",
      "min": 5,
      "max": 180,
      "step": 5,
      "unit": "d",
      "label": "Counts as new for",
      "default": 45
    },
    {
      "type": "text",
      "id": "tag_filter",
      "label": "Only products matching",
      "info": "Optional. A tag or word, e.g. creatine. Leave blank for the whole store."
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 4,
      "max": 50,
      "step": 2,
      "label": "Products to show",
      "default": 10
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subheading", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Heading", "default": "What's new at SNH?" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "What's new (SNH)" }]
}
{% endschema %}
