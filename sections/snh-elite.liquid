{%- comment -%}
  SNH Elite band (Round 11, simplified like the SiS section): a full-bleed background (Background image, else the
  athlete photo; Background video when set, muted and looping, poster = the image) under an orange → black gradient,
  and a minimal foreground: eyebrow, headline, one sentence, one row of three tier chips (Bronze · Silver · Gold with
  the rates from Theme settings → SNH Elite), two buttons. The old tier boxes and the floating card collage are gone.
{%- endcomment -%}
{%- liquid
  assign hid = 'elite-' | append: section.id
  assign r_b = settings.snh_rate_bronze | default: 3 | append: '%'
  assign r_s = settings.snh_rate_silver | default: 7 | append: '%'
  assign r_g = settings.snh_rate_gold | default: 10 | append: '%'
  assign lead = section.settings.lead | escape | replace: '[bronze]', r_b | replace: '[silver]', r_s | replace: '[gold]', r_g
  assign bg = section.settings.bg_image | default: section.settings.person
  assign focal = section.settings.bg_focal | default: '70% 25%' | prepend: 'object-position: '
-%}
<section class="v2 eband" aria-labelledby="{{ hid }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="eband__bg" aria-hidden="true">
    {%- if section.settings.bg_video != blank -%}
      {%- assign poster = bg | image_url: width: 1920 -%}
      {{ section.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', poster: poster, class: 'eband__vid' }}
    {%- elsif bg != blank -%}
      {{ bg | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800,1200,1600,2000', sizes: '100vw', alt: '', class: 'eband__img', style: focal }}
    {%- endif -%}
  </div>
  <div class="v-wrap eband__in">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="v-h1 eband__h" id="{{ hid }}">{% render 'snh-v2-heading', text: section.settings.heading %}</h2>
    {%- if lead != blank -%}<p class="eband__lead">{{ lead }}</p>{%- endif -%}
    <ul class="eband__tiers" role="list" aria-label="Tiers">
      <li class="eband__chip eband__chip--bronze"><i aria-hidden="true"></i>Bronze <b>{{ r_b }}</b></li>
      <li class="eband__chip eband__chip--silver"><i aria-hidden="true"></i>Silver <b>{{ r_s }}</b></li>
      <li class="eband__chip eband__chip--gold"><i aria-hidden="true"></i>Gold <b>{{ r_g }}</b></li>
    </ul>
    <div class="eband__cta">
      {%- if customer -%}
        <a class="v-btn v-btn--accent" href="{{ routes.account_url }}#rewards"><span>{{ section.settings.cta_member | default: 'See my points' | escape }}</span></a>
        <a class="v-btn v-btn--white" href="{% render 'snh-elite-url' %}"><span>{{ section.settings.cta2_member | default: 'How SNH Elite works' | escape }}</span></a>
      {%- else -%}
        {%- if section.settings.cta != blank -%}<a class="v-btn v-btn--accent" href="{{ section.settings.cta_link | default: routes.account_register_url }}"><span>{{ section.settings.cta | escape }}</span></a>{%- endif -%}
        {%- if section.settings.cta2 != blank -%}<a class="v-btn v-btn--white" href="{{ section.settings.cta2_link | default: routes.account_login_url }}"><span>{{ section.settings.cta2 | escape }}</span></a>{%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SNH Elite band",
  "class": "snh-sec",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "info": "Empty = the athlete photo below. Also the video's poster."
    },
    {
      "type": "video",
      "id": "bg_video",
      "label": "Background video",
      "info": "Plays muted and looping behind the band."
    },
    {
      "type": "text",
      "id": "bg_focal",
      "label": "Focal point",
      "default": "70% 25%",
      "info": "x% y%: the part of the photo that stays in view."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "elite"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SNH Elite · Sri Lanka's 1st premium VIP club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fuel your goals. Earn your *rewards*."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "info": "[bronze], [silver] and [gold] show the earn rates from Theme settings → SNH Elite."
    },
    {
      "type": "textarea",
      "id": "chips",
      "label": "Chips",
      "info": "One per line."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button label",
      "default": "Join SNH Elite, it's free"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Defaults to the register page."
    },
    {
      "type": "text",
      "id": "cta2",
      "label": "Second button label",
      "default": "Sign in"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Second button link",
      "info": "Defaults to the sign-in page."
    },
    {
      "type": "text",
      "id": "cta_member",
      "label": "Button for signed-in members",
      "default": "See my points",
      "info": "Signed-in members see this (to their account) and the second one (to the SNH Elite page) instead."
    },
    {
      "type": "text",
      "id": "cta2_member",
      "label": "Second button for signed-in members",
      "default": "How SNH Elite works"
    },
    {
      "type": "paragraph",
      "content": "Tier rates, thresholds and ladder marks come from Theme settings → SNH Elite."
    },
    {
      "type": "header",
      "content": "Visual"
    },
    {
      "type": "image_picker",
      "id": "person",
      "label": "Athlete photo",
      "info": "A real SNH athlete photo (portrait). Use Cutout for a transparent PNG."
    },
    {
      "type": "select",
      "id": "person_style",
      "label": "Photo style",
      "options": [
        {
          "value": "photo",
          "label": "Framed photo"
        },
        {
          "value": "cutout",
          "label": "Cutout (transparent PNG)"
        }
      ],
      "default": "photo"
    },
    {
      "type": "text",
      "id": "person_focal",
      "label": "Photo focal point",
      "default": "50% 30%",
      "info": "x% y%, keeps the face in view."
    },
    {
      "type": "image_picker",
      "id": "gift",
      "label": "Floating gift"
    },
    {
      "type": "image_picker",
      "id": "coins",
      "label": "Floating coins"
    },
    {
      "type": "image_picker",
      "id": "card_logo",
      "label": "Membership card logo"
    },
    {
      "type": "text",
      "id": "card_points",
      "label": "Card points",
      "default": "2,860"
    },
    {
      "type": "text",
      "id": "card_tier",
      "label": "Card tier",
      "default": "Gold member"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "paragraph",
          "content": "The earn rate and threshold line come from Theme settings → SNH Elite, by colour."
        },
        {
          "type": "select",
          "id": "metal",
          "label": "Colour",
          "options": [
            {
              "value": "bronze",
              "label": "Bronze"
            },
            {
              "value": "silver",
              "label": "Silver"
            },
            {
              "value": "gold",
              "label": "Gold"
            }
          ],
          "default": "bronze"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Bronze"
        },
        {
          "type": "text",
          "id": "perk",
          "label": "Perk",
          "default": "500 welcome points"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNH Elite band",
      "blocks": [
        {
          "type": "tier"
        }
      ]
    }
  ]
}
{% endschema %}
