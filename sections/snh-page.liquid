{%- comment -%}
  SNH page (Round 11, v2): the page title and its content from admin, in the v2 reading column. Used by page.json and
  the policy/FAQ/list pages. On the default page template the page with the handle "snh-elite" shows the Elite
  landing instead (sections/snh-elite-page in the same template renders only there), so that page needs no template
  assignment and never shows a contact form.
{%- endcomment -%}
{%- liquid
  assign skip = false
  if section.settings.hide_on_elite and page.handle == 'snh-elite'
    assign skip = true
  endif
  assign hid = 'pg-' | append: section.id
  assign title = section.settings.heading | default: page.title
-%}
{%- unless skip -%}
  <section class="v2 v-section spage{% if section.settings.cream %} v-section--cream{% endif %}" aria-labelledby="{{ hid }}">
    <div class="v-wrap spage__in">
      <header class="spage__head">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="v-h1" id="{{ hid }}">{% render 'snh-v2-heading', text: title %}</h1>
        {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead | escape }}</p>{%- endif -%}
      </header>
      {%- assign body = section.settings.content | default: page.content -%}
      {%- if body != blank -%}<div class="v-prose spage__body">{{ body }}</div>{%- endif -%}
      {%- liquid
        # Audit fix: the old theme's default page template had a contact form, and some pages rely on it
        # ("CONTACT US" = /pages/delivery-and-shipping, the footer's Contact link). Show one on a page titled or
        # handled "contact", and on any page with no content, so no page is ever blank.
        assign t_low = page.title | downcase
        assign want_form = false
        if t_low contains 'contact' or page.handle contains 'contact' or page.handle == 'what-s-holding-your-performance-back'
          assign want_form = true
        endif
      -%}
      {%- if body == blank and want_form == false and page and section.settings.contact_fallback -%}
        {%- comment -%} an empty page that isn't a contact page (e.g. a landing page whose template isn't assigned): a short note, never a blank page {%- endcomment -%}
        <div class="spage__empty"><p class="lead">This page is being updated. In the meantime, browse the shop or message us on WhatsApp.</p>
          <div class="spage__cta"><a class="v-btn v-btn--accent" href="{{ routes.all_products_collection_url }}"><span>Shop all</span></a><a class="v-btn v-btn--line" href="https://wa.me/{{ settings.snh_whatsapp | default: '94779773359' }}" target="_blank" rel="noopener"><span>WhatsApp us</span></a></div></div>
      {%- endif -%}
      {%- if want_form and page and section.settings.contact_fallback -%}
        {%- assign wa = settings.snh_whatsapp | default: '94779773359' | remove: '+' | remove: ' ' -%}
        <div class="spage__empty">
          {%- if body == blank -%}<p class="lead">Questions about a product, an order or what suits your goal? Send us a message and we'll reply within a working day, or chat to us on WhatsApp now.</p>{%- endif -%}
          {{ 'snh-account.css' | asset_url | stylesheet_tag }}
          {%- assign fid = 'spage-contact-' | append: section.id -%}
          {%- form 'contact', id: fid, class: 'aform spage__form', data-shopify-captcha: 'true' -%}
            {%- if form.posted_successfully? -%}
              <p class="cf__ok" role="status">{% render 'snh-v2-icon', name: 'check' %}Thanks! We'll get back to you within a working day.</p>
            {%- else -%}
              {%- if form.errors -%}<div class="aform__err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
              <input type="hidden" name="contact[Form]" value="{{ page.title | escape }}">
              <div class="aform__grid">
                <label class="fld"><span>Name</span><input type="text" name="contact[name]" autocomplete="name" required value="{{ form.name | default: customer.name | escape }}"></label>
                <label class="fld"><span>Phone</span><input type="tel" name="contact[phone]" autocomplete="tel" inputmode="tel" value="{{ form.phone | escape }}"></label>
                <label class="fld fld--full"><span>Email</span><input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | default: customer.email | escape }}"></label>
                <label class="fld fld--full"><span>Message</span><textarea name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea></label>
              </div>
              <button class="v-btn v-btn--accent" type="submit"><span>Send message</span></button>
            {%- endif -%}
          {%- endform -%}
          <div class="spage__cta">
            <a class="v-btn v-btn--line" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{% render 'snh-v2-icon', name: 'whatsapp' %}<span>WhatsApp us</span></a>
            <a class="v-btn v-btn--line" href="/?snh-quiz=open"><span>Not sure what to buy? Take the quiz</span></a>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endunless -%}

<style>
  .spage__empty { margin-top: 12px; max-width: 640px; }
  .spage__form { margin-top: 20px; display: grid; gap: 16px; }
  .spage__form .v-btn { justify-self: start; }
  .spage__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line, #E3DCD0); }
  .spage__cta .v-btn svg { width: 18px; height: 18px; }
  @media (max-width: 479px) { .spage__cta .v-btn { flex: 1 1 100%; justify-content: center; } }
</style>

{% schema %}
{
  "name": "SNH page",
  "class": "snh-sec",
  "settings": [
    { "type": "paragraph", "content": "Shows the page title and the content written in Online Store → Pages." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Empty = the page title. Wrap a word in *asterisks* for the serif." },
    { "type": "text", "id": "lead", "label": "Lead" },
    { "type": "richtext", "id": "content", "label": "Content", "info": "Empty = the page's own content." },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": false },
    { "type": "checkbox", "id": "contact_fallback", "label": "Contact form on contact pages and empty pages", "default": false, "info": "On for the default page template: a page titled Contact, or with no content, shows a contact form, WhatsApp and the quiz." },
    { "type": "checkbox", "id": "hide_on_elite", "label": "Hide on the SNH Elite page (handle snh-elite)", "default": true }
  ],
  "presets": [{ "name": "SNH page" }]
}
{% endschema %}
