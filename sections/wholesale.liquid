{%- render 'section-spacing-collapsing' -%}

{% comment %}
  SNH WHOLESALE HUB, clean B2B range showcase (concept: no inquiry form yet)
  No eyebrow kickers, flat cards, real product cards from live collections.
  Save as sections/snh-wholesale-hub.liquid → add to the wholesale page template.
  Add "Category" blocks in the theme editor and pick collections to show the live range.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<section id="snh-ws-{{ section.id }}" style="--ws-accent: {{ section.settings.accent | default: '#E0521C' }};">

  <!-- HERO -->
  <div class="ws-hero">
    <div class="ws-hero__inner">
      <div class="ws-hero__copy" data-rv="0">
        <h1 class="ws-hero__title">{{ section.settings.heading | default: 'Stock the strongest <span>shelf.</span>' }}</h1>
        <p class="ws-hero__sub">{{ section.settings.subheading | default: "Buy directly from the official distributor of 12+ global sports nutrition brands. Genuine, batch-coded stock at real trade margins, supplied island-wide to gyms, pharmacies, retailers and online sellers." }}</p>
        <div class="ws-btn-row">
          <a class="ws-btn" href="#snh-ws-range-{{ section.id }}">Browse the range
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 4v11M5 10l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="ws-btn ws-btn--ghost" href="https://wa.me/{{ section.settings.whatsapp | default: '94764863359' }}" target="_blank" rel="noopener">Talk to our B2B team</a>
        </div>
        <div class="ws-hero__badges">
          <span class="ws-badge">Gyms &amp; studios</span>
          <span class="ws-badge">Pharmacies</span>
          <span class="ws-badge">Retail stores</span>
          <span class="ws-badge">Online sellers</span>
        </div>
      </div>

      <div class="ws-hero__visual" data-rv="140" aria-hidden="true">
        <img class="ws-solo" src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/2nd_crd.png?v=1784028499" alt="" loading="eager" fetchpriority="high">
      </div>
    </div>

    <div class="ws-hero__stats" data-rv="240">
      <div class="ws-stat"><span class="ws-stat__num">12+</span><span class="ws-stat__label">Brands distributed</span></div>
      <div class="ws-stat"><span class="ws-stat__num">300+</span><span class="ws-stat__label">SKUs ready to ship</span></div>
      <div class="ws-stat"><span class="ws-stat__num">48h</span><span class="ws-stat__label">Island-wide dispatch</span></div>
      <div class="ws-stat"><span class="ws-stat__num">03</span><span class="ws-stat__label">Flagship stores</span></div>
    </div>
  </div>

  <!-- BRAND STRIP -->
  {% assign ws_logos = section.blocks | where: 'type', 'logo' %}
  {% assign ws_default = 'brand_logos_1.png?v=1763121073,brand_logos_2.png?v=1763121073,brand_logos_3.png?v=1763121073,brand_logos_4.png?v=1763121073,brand_logos_5.png?v=1763121073,brand_logos_6.png?v=1763121073,brand_logos_7.png?v=1763121073,brand_logos_8.png?v=1763121073,brand_logos_9.png?v=1763121073,brand_logos_12.png?v=1763121072' | split: ',' %}
  <div class="ws-brands" aria-hidden="true">
    <div class="ws-brands__track">
      {% for repeat in (1..2) %}
        {% if ws_logos.size > 0 %}
          {% for block in ws_logos %}{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 320 }}" alt="{{ block.settings.alt | escape }}" loading="lazy">{% endif %}{% endfor %}
        {% else %}
          {% for f in ws_default %}<img src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/{{ f }}" alt="" loading="lazy">{% endfor %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- WHY DIRECT -->
  <div class="ws-why">
    <div class="ws-why__head" data-rv="0">
      <h2 class="ws-h2 ws-h2--ink">Why buy direct</h2>
      <p class="ws-lead">No middlemen, no grey imports, no guesswork. You buy from the same warehouse that supplies our own three stores, and you keep the margin the importers used to take.</p>
    </div>
    <div class="ws-why__grid">
      <article class="ws-card" data-rv="0"><h3>Real trade margins</h3><p>Tiered wholesale pricing with honest room for your retail markup.</p></article>
      <article class="ws-card" data-rv="70"><h3>100% genuine stock</h3><p>Batch-coded, date-checked and sourced only from authorised channels.</p></article>
      <article class="ws-card" data-rv="140"><h3>48h dispatch</h3><p>Island-wide delivery from Colombo, restocks land before you run dry.</p></article>
      <article class="ws-card" data-rv="210"><h3>A real human</h3><p>One dedicated account manager for orders, advice and launches.</p></article>
    </div>
  </div>

  <!-- THE RANGE -->
  <div class="ws-range" id="snh-ws-range-{{ section.id }}">
    <div class="ws-range__head" data-rv="0">
      <h2 class="ws-h2 ws-h2--ink">Available for wholesale now</h2>
      <p class="ws-lead">Every SKU ships from our own warehouse. Retail prices shown for reference, wholesale tiers are shared when your account is approved.</p>
    </div>

    {% assign ws_rowcount = 0 %}
    {% for b in section.blocks %}{% unless b.type == 'logo' %}{% assign ws_rowcount = ws_rowcount | plus: 1 %}{% endunless %}{% endfor %}
    {% if ws_rowcount > 0 %}
      <nav class="ws-chipnav" data-rv="60" aria-label="Categories">
        {% for block in section.blocks %}{% unless block.type == 'logo' %}{% assign ctitle = block.settings.title | default: block.settings.collection.title | default: 'Products' %}<a class="ws-chipnav__chip" href="#ws-cat-{{ section.id }}-{{ forloop.index }}">{{ ctitle }}</a>{% endunless %}{% endfor %}
      </nav>
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          {% assign col = block.settings.collection %}
          <div class="ws-cat" id="ws-cat-{{ section.id }}-{{ forloop.index }}" data-rv="0" {{ block.shopify_attributes }}>
            <header class="ws-cat__head">
              <h3 class="ws-cat__title">{{ block.settings.title | default: col.title }}</h3>
              {% if col %}<span class="ws-cat__count">{{ col.products_count }} products</span>{% endif %}
              {% if block.settings.note != blank %}<span class="ws-cat__note">{{ block.settings.note }}</span>{% endif %}
            </header>
            <div class="ws-rail">
              {% for product in col.products limit: 12 %}
                <a class="ws-item" href="{{ product.url }}">
                  <div class="ws-item__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 520 | image_tag: loading: 'lazy', class: 'ws-item__img', alt: product.title }}{% endif %}</div>
                  <div class="ws-item__body"><span class="ws-item__vendor">{{ product.vendor }}</span><h4 class="ws-item__name">{{ product.title }}</h4><div class="ws-item__foot"><s class="ws-item__retail">{{ product.price | money }}</s><span class="ws-item__chip">Trade price on request</span></div></div>
                </a>
              {% endfor %}
            </div>
          </div>
        {% elsif block.type == 'manual' %}
          <div class="ws-cat" id="ws-cat-{{ section.id }}-{{ forloop.index }}" data-rv="0" {{ block.shopify_attributes }}>
            <header class="ws-cat__head">
              <h3 class="ws-cat__title">{{ block.settings.title | default: 'Featured range' }}</h3>
              {% if block.settings.note != blank %}<span class="ws-cat__note">{{ block.settings.note }}</span>{% endif %}
            </header>
            <div class="ws-rail">
              {% for i in (1..8) %}
                {% assign pk = 'product_' | append: i %}
                {% assign product = block.settings[pk] %}
                {% if product != blank %}
                  <a class="ws-item" href="{{ product.url }}">
                    <div class="ws-item__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 520 | image_tag: loading: 'lazy', class: 'ws-item__img', alt: product.title }}{% endif %}</div>
                    <div class="ws-item__body"><span class="ws-item__vendor">{{ product.vendor }}</span><h4 class="ws-item__name">{{ product.title }}</h4><div class="ws-item__foot"><s class="ws-item__retail">{{ product.price | money }}</s><span class="ws-item__chip">Trade price on request</span></div></div>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <nav class="ws-chipnav" data-rv="60" aria-label="Categories">
        <a class="ws-chipnav__chip" href="#ws-demo-1-{{ section.id }}">Proteins &amp; gainers</a>
        <a class="ws-chipnav__chip" href="#ws-demo-2-{{ section.id }}">Performance &amp; pre-workout</a>
        <a class="ws-chipnav__chip" href="#ws-demo-3-{{ section.id }}">Endurance &amp; wellness</a>
      </nav>

      <div class="ws-cat" id="ws-demo-1-{{ section.id }}" data-rv="0">
        <header class="ws-cat__head"><h3 class="ws-cat__title">Proteins &amp; gainers</h3><span class="ws-cat__count">Best sellers</span><span class="ws-cat__note">MOQ 6 units</span></header>
        <div class="ws-rail">
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">ISO-XP</span></div><div class="ws-item__body"><span class="ws-item__vendor">Applied Nutrition</span><h4 class="ws-item__name">ISO-XP Whey Isolate &middot; 1.8kg</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 38,500</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">NITRO</span></div><div class="ws-item__body"><span class="ws-item__vendor">MuscleTech</span><h4 class="ws-item__name">NitroTech Whey &middot; 4lb</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 32,000</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">MASS</span></div><div class="ws-item__body"><span class="ws-item__vendor">Applied Nutrition</span><h4 class="ws-item__name">Critical Mass Gainer &middot; 6kg</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 29,500</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">LOADED</span></div><div class="ws-item__body"><span class="ws-item__vendor">RYSE</span><h4 class="ws-item__name">Loaded Protein &middot; 2lb</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 21,500</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
        </div>
      </div>

      <div class="ws-cat" id="ws-demo-2-{{ section.id }}" data-rv="0">
        <header class="ws-cat__head"><h3 class="ws-cat__title">Performance &amp; pre-workout</h3><span class="ws-cat__count">High velocity</span><span class="ws-cat__note">MOQ 6 units</span></header>
        <div class="ws-rail">
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">PRE</span></div><div class="ws-item__body"><span class="ws-item__vendor">RYSE</span><h4 class="ws-item__name">Loaded Pre-Workout &middot; 30 srv</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 15,500</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">ABE</span></div><div class="ws-item__body"><span class="ws-item__vendor">Applied Nutrition</span><h4 class="ws-item__name">ABE Ultimate Pre &middot; 30 srv</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 13,900</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">CR-250</span></div><div class="ws-item__body"><span class="ws-item__vendor">Applied Nutrition</span><h4 class="ws-item__name">Creatine Monohydrate &middot; 250g</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 8,900</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">CARN</span></div><div class="ws-item__body"><span class="ws-item__vendor">Applied Nutrition</span><h4 class="ws-item__name">L-Carnitine 3000 &middot; 480ml</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 9,800</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
        </div>
      </div>

      <div class="ws-cat" id="ws-demo-3-{{ section.id }}" data-rv="0">
        <header class="ws-cat__head"><h3 class="ws-cat__title">Endurance &amp; wellness</h3><span class="ws-cat__count">Clinic &amp; club favourites</span><span class="ws-cat__note">MOQ 12 units</span></header>
        <div class="ws-rail">
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">GO-GEL</span></div><div class="ws-item__body"><span class="ws-item__vendor">Science in Sport</span><h4 class="ws-item__name">GO Isotonic Gels &middot; box of 30</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 18,000</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">REGO</span></div><div class="ws-item__body"><span class="ws-item__vendor">Science in Sport</span><h4 class="ws-item__name">REGO Rapid Recovery &middot; 1.6kg</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 22,500</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">D3</span></div><div class="ws-item__body"><span class="ws-item__vendor">Healthspan Elite</span><h4 class="ws-item__name">Vitamin D3 4000iu &middot; 120 tabs</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 6,500</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
          <div class="ws-item"><div class="ws-item__media ws-item__media--demo"><span class="ws-mono">OMEGA</span></div><div class="ws-item__body"><span class="ws-item__vendor">Healthspan Elite</span><h4 class="ws-item__name">Elite Omega-3 &middot; 90 caps</h4><div class="ws-item__foot"><s class="ws-item__retail">Rs 7,900</s><span class="ws-item__chip">Trade price on request</span></div></div></div>
        </div>
      </div>
      <p class="ws-range__demo-note" data-rv="0">Demo range shown, link your live collections to this section in the theme editor.</p>
    {% endif %}
  </div>

  <!-- HOW IT WORKS -->
  <div class="ws-flow">
    <h2 class="ws-h2 ws-h2--ink ws-h2--sm" data-rv="0">How ordering works</h2>
    <ol class="ws-flow__steps">
      <li data-rv="0"><span class="ws-flow__num">01</span><h3>Browse &amp; shortlist</h3><p>Pick the brands and SKUs that fit your customers.</p></li>
      <li data-rv="90"><span class="ws-flow__num">02</span><h3>Request access</h3><p>Tell us about your business, gym, pharmacy, store or online.</p></li>
      <li data-rv="180"><span class="ws-flow__num">03</span><h3>Get tier pricing</h3><p>Approved accounts receive the full wholesale price sheet.</p></li>
      <li data-rv="270"><span class="ws-flow__num">04</span><h3>Restock in 48h</h3><p>Order by WhatsApp or phone, dispatch island-wide within 48 hours.</p></li>
    </ol>
  </div>

  <!-- ACCESS CTA -->
  <div class="ws-cta">
    <div class="ws-cta__panel" data-rv="0">
      <div class="ws-cta__copy">
        <h2 class="ws-h2">Ready to stock SNH brands?</h2>
        <p class="ws-lead ws-lead--light">Talk to our B2B team today, the online inquiry portal is on its way, and orders are currently handled directly, person to person.</p>
        <div class="ws-cta__chips">
          <a class="ws-chip" href="https://wa.me/{{ section.settings.whatsapp | default: '94764863359' }}" target="_blank" rel="noopener">WhatsApp +94 76 486 3359</a>
          <a class="ws-chip" href="mailto:{{ section.settings.email | default: 'info@sportsnutritionhub.lk' }}">{{ section.settings.email | default: 'info@sportsnutritionhub.lk' }}</a>
        </div>
      </div>
      <div class="ws-cta__action">
        <a class="ws-btn ws-btn--big" href="https://wa.me/{{ section.settings.whatsapp | default: '94764863359' }}" target="_blank" rel="noopener">Request wholesale access
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <p class="ws-cta__note">Replies within one business day &middot; Everyday 10am to 7pm</p>
      </div>
    </div>
  </div>
</section>

<style>
  #snh-ws-{{ section.id }}, #snh-ws-{{ section.id }} * { box-sizing: border-box; }
  #snh-ws-{{ section.id }} {
    --ws-ink: #17130F; --ws-cream: #FAF7F2; --ws-paper-muted: rgba(69,59,50,.78);
    --ws-light: #fdf6ef; --ws-light-muted: rgba(253,246,239,.66);
    display: block; background: var(--ws-cream);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; overflow-x: clip;
  }
  #snh-ws-{{ section.id }} .ws-h2 { margin: 0; color: var(--ws-light); font-family: 'Archivo', Arial, sans-serif; font-size: clamp(34px,3.6vw,54px); font-weight: 900; line-height: .98; letter-spacing: -.03em; text-transform: uppercase; text-wrap: balance; }
  #snh-ws-{{ section.id }} .ws-h2--ink { color: var(--ws-ink); }
  #snh-ws-{{ section.id }} .ws-h2--sm { font-size: clamp(26px,2.6vw,38px); }
  #snh-ws-{{ section.id }} .ws-lead { max-width: 640px; margin: 18px 0 0; color: var(--ws-paper-muted); font-size: clamp(14px,1.02vw,16px); font-weight: 500; line-height: 1.62; }
  #snh-ws-{{ section.id }} .ws-lead--light { color: var(--ws-light-muted); }
  #snh-ws-{{ section.id }} .ws-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 26px; border: 1px solid var(--ws-accent); border-radius: 9px; background: var(--ws-accent); color: #fff; font-family: 'Archivo', Arial, sans-serif; font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: background-color 200ms ease, border-color 200ms ease, transform 200ms ease; }
  #snh-ws-{{ section.id }} .ws-btn svg { width: 15px; height: 15px; }
  #snh-ws-{{ section.id }} .ws-btn:hover { background: #b23c11; border-color: #b23c11; transform: translateY(-2px); color: #fff; }
  #snh-ws-{{ section.id }} .ws-btn--ghost { background: transparent; border-color: rgba(253,246,239,.3); color: var(--ws-light); }
  #snh-ws-{{ section.id }} .ws-btn--ghost:hover { background: rgba(253,246,239,.07); border-color: var(--ws-accent); }
  #snh-ws-{{ section.id }} .ws-btn--big { min-height: 60px; padding: 0 34px; font-size: 13px; }
  #snh-ws-{{ section.id }} .ws-btn-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  #snh-ws-{{ section.id }} .ws-hero { position: relative; padding: clamp(52px,6vw,96px) clamp(18px,4vw,64px) clamp(36px,4vw,56px); background: linear-gradient(115deg, #100b07 0%, #1c0f08 48%, #341509 82%, #46190a 100%); }
  #snh-ws-{{ section.id }} .ws-hero__inner { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(320px,.95fr); gap: clamp(30px,4vw,70px); align-items: center; width: min(100%,1500px); margin-inline: auto; }
  #snh-ws-{{ section.id }} .ws-hero__title { margin: 0; color: var(--ws-light); font-family: 'Archivo', Arial, sans-serif; font-size: clamp(44px,5.6vw,88px); font-weight: 900; line-height: .93; letter-spacing: -.035em; text-transform: uppercase; }
  #snh-ws-{{ section.id }} .ws-hero__title span { color: var(--ws-accent); }
  #snh-ws-{{ section.id }} .ws-hero__sub { max-width: 560px; margin: 24px 0 0; color: var(--ws-light-muted); font-size: clamp(14px,1.05vw,16px); font-weight: 500; line-height: 1.65; }
  #snh-ws-{{ section.id }} .ws-hero__badges { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  #snh-ws-{{ section.id }} .ws-badge { padding: 8px 14px; border: 1px solid rgba(253,246,239,.2); border-radius: 8px; background: rgba(253,246,239,.05); color: rgba(253,246,239,.82); font-family: 'Archivo', Arial, sans-serif; font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  #snh-ws-{{ section.id }} .ws-hero__visual { position: relative; display: flex; justify-content: center; align-items: flex-end; min-height: clamp(360px,34vw,520px); }
  #snh-ws-{{ section.id }} .ws-hero__visual::before { content: ""; position: absolute; left: 50%; top: 45%; width: min(94%, 480px); aspect-ratio: 1; transform: translate(-50%,-50%); background: radial-gradient(circle, rgba(224,82,28,.4), rgba(224,82,28,.12) 45%, transparent 70%); filter: blur(52px); z-index: 0; }
  #snh-ws-{{ section.id }} .ws-hero__visual::after { content: ""; position: absolute; left: 50%; bottom: 5%; width: 56%; height: 26px; transform: translateX(-50%); background: radial-gradient(ellipse, rgba(0,0,0,.5), transparent 72%); filter: blur(12px); z-index: 0; }
  #snh-ws-{{ section.id }} .ws-solo { position: relative; z-index: 1; display: block; height: 100%; max-height: clamp(360px,34vw,520px); width: auto; filter: drop-shadow(0 26px 48px rgba(0,0,0,.5)); }
  #snh-ws-{{ section.id }} .ws-hero__stats { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 18px; width: min(100%,1500px); margin: clamp(36px,4vw,60px) auto 0; padding-top: clamp(22px,2.4vw,32px); border-top: 1px solid rgba(253,246,239,.14); }
  #snh-ws-{{ section.id }} .ws-stat { display: grid; gap: 6px; }
  #snh-ws-{{ section.id }} .ws-stat__num { color: var(--ws-light); font-family: 'Archivo', Arial, sans-serif; font-size: clamp(32px,3vw,50px); font-weight: 900; line-height: 1; letter-spacing: -.02em; }
  #snh-ws-{{ section.id }} .ws-stat__label { color: var(--ws-light-muted); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }

  #snh-ws-{{ section.id }} .ws-brands { overflow: hidden; background: #fff; border-block: 1px solid rgba(23,19,15,.1); padding: clamp(18px,2vw,26px) 0; }
