  }
  @media (prefers-reduced-motion: reduce) {
    #snh-ws-{{ section.id }} .ws-brands__track { animation: none; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('snh-ws-{{ section.id }}');
    if (!root || root.dataset.motionBound) return;
    root.dataset.motionBound = 'true';
    const els = root.querySelectorAll('[data-rv]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    root.classList.add('ws-motion-ready');
    els.forEach((el) => { el.style.transitionDelay = (parseInt(el.getAttribute('data-rv'), 10) || 0) + 'ms'; });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add('is-in'); io.unobserve(entry.target); });
    }, { threshold: .15, rootMargin: '0px 0px -6% 0px' });
    els.forEach((el) => io.observe(el));
  })();
</script>

