      { "type": "text", "id": "title", "label": "Row title", "default": "Featured range" },
      { "type": "text", "id": "note", "label": "Note chip (optional)" },
      { "type": "product", "id": "product_1", "label": "Product 1" },
      { "type": "product", "id": "product_2", "label": "Product 2" },
      { "type": "product", "id": "product_3", "label": "Product 3" },
      { "type": "product", "id": "product_4", "label": "Product 4" },
      { "type": "product", "id": "product_5", "label": "Product 5" },
      { "type": "product", "id": "product_6", "label": "Product 6" },
      { "type": "product", "id": "product_7", "label": "Product 7" },
      { "type": "product", "id": "product_8", "label": "Product 8" }
    ]},
    { "type": "category", "name": "Row (whole collection)", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Custom title (optional)" },
      { "type": "text", "id": "note", "label": "Note chip (optional)", "default": "MOQ 6 units" }
    ]},
    { "type": "logo", "name": "Brand logo (strip)", "settings": [
      { "type": "image_picker", "id": "image", "label": "Logo image" },
      { "type": "text", "id": "alt", "label": "Brand name / alt" }
    ]}
  ],
  "max_blocks": 24,
  "presets": [{ "name": "SNH Wholesale Hub" }]
}
