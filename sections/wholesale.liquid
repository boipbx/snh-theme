    { "type": "color", "id": "accent", "label": "Accent color", "default": "#E0521C" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (digits only)", "default": "94764863359" },
    { "type": "text", "id": "email", "label": "B2B email", "default": "info@sportsnutritionhub.lk" }
  ],
  "blocks": [
