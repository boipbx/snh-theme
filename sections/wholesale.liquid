  #snh-ws-{{ section.id }}.ws-motion-ready [data-rv] { opacity: 0; transform: translateY(20px); transition: opacity 720ms cubic-bezier(.22,1,.36,1), transform 720ms cubic-bezier(.22,1,.36,1); }
  #snh-ws-{{ section.id }}.ws-motion-ready [data-rv].is-in { opacity: 1; transform: translateY(0); }

  @media (max-width: 1024px) {
    #snh-ws-{{ section.id }} .ws-hero__inner { grid-template-columns: 1fr; }
