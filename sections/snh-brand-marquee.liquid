{%- comment -%}
  SNH brand marquee: "Authorised distributors of leading brands" on an ink band with a deep-orange glow. Big heading
  and brand count on the left, white monochrome logos running on the right (below on phones).
  One block per logo (image + link to the brand collection). Logo files are opaque squares, so the white mark is made
  with filters + screen blending: logos on white are thresholded and inverted, logos drawn on a dark square
  ("Logo on a dark background") are thresholded only; the black that's left disappears into the band.
  assets/snh-v2.js data-v2="marquee" (one per row): seamless loop at a constant px/s, hover pauses, drag/swipe
  scrubs, and each logo is trimmed to its mark so every logo reads at the same height. Optional second row runs the
  other way. Reduced motion: a static horizontal scroller.
{%- endcomment -%}
{%- liquid
  assign hid = 'mq-' | append: section.id
  assign two = section.settings.two_rows
  if section.blocks.size < 6
    assign two = false
  endif
  assign count = section.settings.count
  if count == blank
    assign count = section.blocks.size | append: ' brands'
  endif
-%}
{%- capture row_a -%}
  {%- for b in section.blocks -%}
    {%- assign odd = forloop.index0 | modulo: 2 -%}
    {%- if two and odd == 1 -%}{%- continue -%}{%- endif -%}
    <a class="logo{% if b.settings.dark %} logo--dark{% endif %}" href="{{ b.settings.link | default: '#' }}" title="{{ b.settings.name | escape }}" draggable="false" style="--ls: {{ b.settings.scale | divided_by: 100.0 }}" {{ b.shopify_attributes }}>
      {%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 360 | image_tag: width: 180, height: 180, loading: 'lazy', alt: b.settings.name, draggable: 'false', data-mq-logo: '' }}{%- else -%}<span class="brand__word">{{ b.settings.name | escape }}</span>{%- endif -%}
    </a>
  {%- endfor -%}
{%- endcapture -%}
{%- capture row_b -%}
  {%- for b in section.blocks -%}
    {%- assign odd = forloop.index0 | modulo: 2 -%}
    {%- if odd == 0 -%}{%- continue -%}{%- endif -%}
    <a class="logo{% if b.settings.dark %} logo--dark{% endif %}" href="{{ b.settings.link | default: '#' }}" title="{{ b.settings.name | escape }}" draggable="false" style="--ls: {{ b.settings.scale | divided_by: 100.0 }}">
      {%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 360 | image_tag: width: 180, height: 180, loading: 'lazy', alt: b.settings.name, draggable: 'false', data-mq-logo: '' }}{%- else -%}<span class="brand__word">{{ b.settings.name | escape }}</span>{%- endif -%}
    </a>
  {%- endfor -%}
{%- endcapture -%}
<section class="v2 mqd mq{% if two %} mqd--two{% endif %}" aria-labelledby="{{ hid }}" style="--mq-logo-h: {{ section.settings.logo_height }}px">
  <div class="v-wrap mqd__in">
    <div class="mqd__head">
      <h2 class="mqd__title" id="{{ hid }}">{% render 'snh-v2-heading', text: section.settings.heading %}</h2>
      {%- if section.settings.show_count -%}<p class="mqd__count">{{ count | escape }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}<a class="mqd__link" href="{{ section.settings.link_url | default: '/collections/all' }}">{{ section.settings.link_label | escape }}<span aria-hidden="true">→</span></a>{%- endif -%}
    </div>
    <div class="mqd__rows">
      <div class="mqd__row{% if section.settings.direction == 'right' %} mq--right{% endif %}" data-v2="marquee" data-speed="{{ section.settings.speed }}">
        <div class="mq__track"><div class="mq__rail"><div class="logos__run">{{ row_a }}</div><div class="logos__run" aria-hidden="true" inert>{{ row_a }}</div></div></div>
      </div>
      {%- if two -%}
        <div class="mqd__row{% unless section.settings.direction == 'right' %} mq--right{% endunless %}" data-v2="marquee" data-speed="{{ section.settings.speed }}">
          <div class="mq__track"><div class="mq__rail"><div class="logos__run">{{ row_b }}</div><div class="logos__run" aria-hidden="true" inert>{{ row_b }}</div></div></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SNH brand marquee",
  "class": "snh-sec",
  "max_blocks": 40,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Authorised distributors of *leading* brands", "info": "Wrap a word in *asterisks* for the serif italic." },
    { "type": "checkbox", "id": "show_count", "label": "Show brand count", "default": true },
    { "type": "text", "id": "count", "label": "Brand count text", "info": "Leave empty to count the logos below (e.g. \"13 brands\")." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All brands" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "speed", "label": "Speed", "min": 10, "max": 120, "step": 5, "unit": "px", "default": 40, "info": "Pixels per second, the same whatever the number of logos." },
    { "type": "select", "id": "direction", "label": "Direction", "options": [{ "value": "left", "label": "Right to left" }, { "value": "right", "label": "Left to right" }], "default": "left" },
    { "type": "checkbox", "id": "two_rows", "label": "Second row, opposite direction", "default": true, "info": "Splits the logos over two rows (needs 6 or more)." },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40, "info": "Every logo is trimmed to its mark and shown at this height (wide marks are capped)." }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "default": "Brand" },
        { "type": "image_picker", "id": "image", "label": "Logo", "info": "Any logo file: shown as a white mark on the band." },
        { "type": "checkbox", "id": "dark", "label": "Logo on a dark background", "default": false, "info": "Tick when the file is a light logo on a black or coloured square (e.g. SiS, RYSE, Myprotein)." },
        { "type": "range", "id": "scale", "label": "Logo scale", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Fine-tunes one logo after automatic sizing." },
        { "type": "url", "id": "link", "label": "Link", "info": "The brand collection." }
      ]
    }
  ],
  "presets": [{ "name": "SNH brand marquee", "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }] }]
}
{% endschema %}
