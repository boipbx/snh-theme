{%- comment -%}
  SNH brand marquee: "Authorised distributors of leading brands" (prototype section.logos).
  One block per logo (image + link to the brand collection). The run is printed twice so the loop is seamless.
{%- endcomment -%}
{%- capture run -%}
  {%- for b in section.blocks -%}
    <a class="logo" href="{{ b.settings.link | default: '#' }}" title="{{ b.settings.name | escape }}" {{ b.shopify_attributes }}>
      {%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 320 | image_tag: width: 160, height: 160, loading: 'lazy', alt: b.settings.name }}{%- else -%}<span class="brand__word">{{ b.settings.name | escape }}</span>{%- endif -%}
    </a>
  {%- endfor -%}
{%- endcapture -%}
<section class="v2 logos" aria-label="{{ section.settings.label | escape }}" style="--logos-speed: {{ section.settings.speed }}s">
  <div class="v-wrap logos__in">
    {%- if section.settings.label != blank -%}<p class="eyebrow">{{ section.settings.label | escape }}</p>{%- endif -%}
    <div class="logos__track"><div class="logos__run">{{ run }}</div><div class="logos__run" aria-hidden="true">{{ run }}</div></div>
  </div>
</section>

{% schema %}
{
  "name": "SNH brand marquee",
  "class": "snh-sec",
  "max_blocks": 40,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Authorised distributors of leading brands" },
    { "type": "range", "id": "speed", "label": "Loop time", "min": 16, "max": 120, "step": 4, "unit": "s", "default": 48 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "default": "Brand" },
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "url", "id": "link", "label": "Link", "info": "The brand collection." }
      ]
    }
  ],
  "presets": [{ "name": "SNH brand marquee", "blocks": [{ "type": "logo" }, { "type": "logo" }] }]
}
{% endschema %}
