    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#17130F"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop trusted brands backed by our expert guidance, secure checkout, and fast delivery across Sri Lanka."
