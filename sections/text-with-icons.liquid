            "text": "Practical help from people who know the products."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Secure Payments",
            "text": "Protected checkout across every supported payment method."
          }
        }
      ]
    }
  ]
}
{% endschema %}
