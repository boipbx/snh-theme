{%- comment -%}SNH "Bundle & save" offer tiles (prototype .promos--wide). One block per offer: image, badge, title, link.{%- endcomment -%}
{%- assign hid = 'bundle-' | append: section.id -%}
<section class="v2 v-section" aria-labelledby="{{ hid }}">
  <div class="v-wrap">
    {%- render 'snh-v2-head', s: section.settings, id: hid -%}
    <div class="promos promos--wide">
      {%- for b in section.blocks -%}
        <a class="promo" href="{{ b.settings.link | default: '#' }}" {{ b.shopify_attributes }}>
          <div class="promo__media">{%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 900 | image_tag: width: 1672, height: 941, loading: 'lazy', alt: '', sizes: '(max-width: 899px) 82vw, 33vw', widths: '450,600,900,1200' }}{%- endif -%}</div>
          <div class="promo__shade"></div>
          <div class="promo__body">{%- if b.settings.badge != blank -%}<span class="v-badge v-badge--accent promo__badge">{{ b.settings.badge | escape }}</span>{%- endif -%}<p class="promo__title">{{ b.settings.title | escape }}</p></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SNH bundle & save",
  "class": "snh-sec",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Offers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle & *save*" },
    { "type": "textarea", "id": "lead", "label": "Lead" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All bundles" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "select", "id": "link_style", "label": "Link style", "options": [{ "value": "link", "label": "Underlined link" }, { "value": "button", "label": "Ink button" }], "default": "link" }
  ],
  "blocks": [
    { "type": "offer", "name": "Offer", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape 16:10." },
      { "type": "text", "id": "badge", "label": "Badge", "default": "Save more" },
      { "type": "text", "id": "title", "label": "Title", "default": "Endurance bundles" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "SNH bundle & save", "blocks": [{ "type": "offer" }, { "type": "offer" }, { "type": "offer" }] }]
}
{% endschema %}
