{%- comment -%}
  App band (Round 6): app blocks (e.g. the Judge.me review widget) in the v2 container, with an optional section head.
  The anchor id (default "reviews") is what the buy box's rating link scrolls to.
{%- endcomment -%}
{{ 'snh-product.css' | asset_url | stylesheet_tag }}
{%- assign hid = 'app-' | append: section.id -%}
<section class="v2 sp-sec{% if section.settings.cream %} sp-sec--cream{% endif %}" id="{{ section.settings.anchor | default: section.id | handle }}"{% if section.settings.heading != blank %} aria-labelledby="{{ hid }}"{% endif %}>
  <div class="sp-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="sp-head">
        {%- if section.settings.eyebrow != blank -%}<p class="sp-head__k">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="sp-head__t" id="{{ hid }}">{% render 'snh-v2-heading', text: section.settings.heading %}</h2>
      </div>
    {%- endif -%}
    <div class="sp-app">
      {%- for block in section.blocks -%}<div {{ block.shopify_attributes }}>{% render block %}</div>{%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SNH app band",
  "class": "snh-sec",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers *say*", "info": "Wrap a word in *asterisks* for the serif italic." },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "reviews" },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": false }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "SNH app band" }]
}
{% endschema %}
