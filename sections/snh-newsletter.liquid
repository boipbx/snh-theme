{%- comment -%}
  SNH newsletter (prototype "First to know"). Shopify customer form with marketing consent + tags; Klaviyo picks the
  subscriber up through its Shopify integration (same route as the live newsletter popup).
{%- endcomment -%}
{%- assign hid = 'news-' | append: section.id -%}
{%- assign fid = 'news-form-' | append: section.id -%}
<section class="v2 v-section v-section--cream" aria-labelledby="{{ hid }}">
  <div class="v-wrap news">
    <div class="head__text">
      <h2 class="v-h1" id="{{ hid }}">{% render 'snh-v2-heading', text: section.settings.heading %}</h2>
      {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead | escape }}</p>{%- endif -%}
    </div>
    {%- form 'customer', id: fid, class: 'news__form' -%}
      <input type="hidden" name="contact[tags]" value="{{ section.settings.tags | escape }}">
      <input type="hidden" name="contact[accepts_marketing]" value="true">
      {%- if form.posted_successfully? -%}
        <p class="news__msg" role="status">{{ section.settings.success | escape }}</p>
      {%- else -%}
        <label for="{{ fid }}-email" hidden>Email</label>
        <input class="v-input" id="{{ fid }}-email" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="email" required>
        <button class="v-btn v-btn--accent" type="submit"><span>{{ section.settings.button | escape }}</span></button>
        {%- if form.errors -%}<p class="news__msg news__msg--err" role="alert">{{ form.errors.translated_fields.email | default: 'Email' }} {{ form.errors.messages.email | default: form.errors.messages.form }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "SNH newsletter",
  "class": "snh-sec",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "First to *know*" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "New drops, restocks and member offers. No spam, only discount codes and product news." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Email address" },
    { "type": "text", "id": "button", "label": "Button", "default": "Subscribe" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thanks, you're on the list." },
    { "type": "text", "id": "tags", "label": "Customer tags", "default": "newsletter,homepage", "info": "Klaviyo receives these through its Shopify sync; use them to start a welcome flow." }
  ],
  "presets": [{ "name": "SNH newsletter" }]
}
{% endschema %}
