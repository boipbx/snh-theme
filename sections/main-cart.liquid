{%- comment -%} ── SNH Elite: loyalty rate from customer tier (Bronze 3 / Silver 7 / Gold 10) ── {%- endcomment -%}
{%- assign snh_tier = customer.metafields.custom.loyalty_tier.value | default: 'Bronze' -%}
{%- assign snh_rate = settings.snh_rate_bronze | default: 3 -%}
{%- if snh_tier == 'Silver' -%}{%- assign snh_rate = settings.snh_rate_silver | default: 7 -%}{%- endif -%}
{%- if snh_tier == 'Gold' or snh_tier == 'MAXED OUT' -%}{%- assign snh_rate = settings.snh_rate_gold | default: 10 -%}{%- endif -%}
{%- assign snh_points = cart.total_price | divided_by: 100 | times: snh_rate | divided_by: 100 -%}
{%- assign snh_threshold = settings.cart_free_shipping_threshold | default: 17000 -%}
{%- assign snh_threshold_cents = snh_threshold | times: 100 -%}
{%- assign snh_gap = snh_threshold_cents | minus: cart.total_price | at_least: 0 -%}
{%- assign snh_delivery_progress = cart.total_price | times: 100 | divided_by: snh_threshold_cents | at_most: 100 -%}


<style>
  /* ══ SNH Elite cart page — scoped, additive (no theme logic touched) ══ */
  .snh-cart-page {
    --snh-orange: #e0521c;
    --snh-orange-deep: #b23c11;
    --snh-orange-tint: #fbeee7;
    --snh-ink: #17130f;
    --snh-ink-soft: #453b32;
    --snh-muted: #736657;
    --snh-line: #e7e0d6;
    --snh-paper: #faf7f2;
    --snh-white: #ffffff;
    --snh-display: var(--heading-font-family), system-ui, sans-serif;
    --snh-sans: var(--text-font-family), system-ui, sans-serif;
    font-family: var(--snh-sans);
    color: var(--snh-ink);
  }

  /* CART heading — big bold loyalty letters */
  .snh-cart-page .cart-header h1,
  .snh-cart-page .empty-state .h4 {
    font-family: var(--snh-display) !important;
    font-weight: 900 !important;
    font-size: clamp(38px, 5vw, 60px) !important;
    letter-spacing: -1.8px !important;
    text-transform: uppercase !important;
    line-height: 1 !important;
    color: var(--snh-ink) !important;
    text-align: left !important;
  }
  .snh-cart-page .cart-header { text-align: left !important; }

  /* Summary panel */
  .snh-cart-page .cart-order__summary {
    background: var(--snh-white);
    border: 1px solid var(--snh-line);
    border-radius: 18px;
    padding: clamp(20px, 2.5vw, 28px);
  }
  .snh-cart-page .cart-order__summary .h5 {
    font-family: var(--snh-display) !important;
    font-weight: 800 !important;
    letter-spacing: -.4px !important;
    color: var(--snh-ink) !important;
  }

  /* Checkout button → flat SNH orange */
  .snh-cart-page button[name="checkout"] {
    background: var(--snh-orange) !important;
    border-color: var(--snh-orange) !important;
    color: #fff !important;
    border-radius: 14px !important;
    font-family: var(--snh-sans) !important;
    font-weight: 600 !important;
    box-shadow: 0 8px 20px rgba(224,82,28,.22) !important;
    transition: background .2s ease, transform .15s ease !important;
  }
  .snh-cart-page button[name="checkout"]:hover {
    background: var(--snh-orange-deep) !important; transform: translateY(-1px);
  }
  .snh-cart-page .empty-state .button {
    background: var(--snh-orange) !important; border-color: var(--snh-orange) !important;
    color: #fff !important; border-radius: 14px !important; font-weight: 600 !important;
  }

  /* Shipping estimator button (was theme yellow) → SNH orange */
  .snh-cart-page shipping-estimator button,
  .snh-cart-page .shipping-estimator button,
  .snh-cart-page button[name="estimate"],
  .snh-cart-page .cart-form__shipping-estimator button {
    background: var(--snh-orange) !important;
    border-color: var(--snh-orange) !important;
    color: #fff !important;
    border-radius: 12px !important;
    font-family: var(--snh-sans) !important;
    font-weight: 600 !important;
    transition: background .2s ease !important;
  }
  .snh-cart-page shipping-estimator button:hover,
  .snh-cart-page button[name="estimate"]:hover {
    background: var(--snh-orange-deep) !important;
  }

  /* Catch-all: any submit/primary button inside the cart that isn't checkout
     (covers the theme's shipping-estimator snippet markup) */
  .snh-cart-page .cart-form button:not([name="checkout"]):not([is="close-button"]):not(.snh-addons__btn),
  .snh-cart-page accordion-disclosure button.button,
  .snh-cart-page .accordion button.button {
    background: var(--snh-orange) !important;
    border-color: var(--snh-orange) !important;
    color: #fff !important;
    border-radius: 12px !important;
    font-weight: 600 !important;
  }
  /* keep quantity +/- and remove links neutral */
  .snh-cart-page quantity-selector button,
  .snh-cart-page .quantity-selector button,
  .snh-cart-page a.link,
  .snh-cart-page .cart-form button.link {
    background: transparent !important;
    color: var(--snh-ink) !important;
    border-color: var(--snh-line) !important;
  }

  /* ── Points line ── */
  .snh-cart-points {
    display: flex; align-items: center; gap: 11px;
    padding: 13px 14px; margin: 8px 0 4px;
    border-radius: 12px;
    background: var(--snh-orange-tint);
    border: 1px solid #f2ddd0;
  }
  .snh-cart-points__icon {
    flex: 0 0 30px; width: 30px; height: 30px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 9px; background: var(--snh-orange); color: #fff;
  }
  .snh-cart-points__icon svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.2; }
  .snh-cart-points__text { font-size: 13.5px; font-weight: 500; line-height: 1.35; color: var(--snh-ink); }
  .snh-cart-points__text b { font-weight: 700; color: var(--snh-orange-deep); }
  .snh-cart-points__text a { color: var(--snh-orange-deep); font-weight: 700; text-decoration: underline; }

  /* ── Auto add-ons strip: compact, sits above checkout, sized like the navbar's mini product cards ──
     Every rule below is !important because this strip sits inside the theme's
     .cart-form scope, which has its own rules for <form>/<button>/table-row-like
     children that were leaking in and stretching the "Add" button full height. */
  .snh-addons {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    margin: 20px 0 !important;
    grid-column: 1 / -1 !important;
    flex-basis: 100% !important;
    background: var(--snh-white) !important;
    border: 1px solid var(--snh-line) !important;
    border-radius: 18px !important;
    padding: 20px !important;
  }
  .snh-addons__head {
    display: block !important;
    font-family: var(--snh-display) !important;
    font-weight: 800 !important; text-transform: uppercase !important;
    font-size: 12.5px !important; letter-spacing: .3px !important;
    color: var(--snh-ink) !important; margin: 0 0 10px !important;
  }
  .snh-addons__track {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: flex-start !important;
    gap: 10px !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scrollbar-width: none !important;
    padding: 2px 2px 6px !important;
    margin: 0 !important;
    list-style: none !important;
  }
  .snh-addons__track::-webkit-scrollbar { display: none !important; }
  .snh-addons__skeleton {
    display: block !important;
    flex: 0 0 96px !important; width: 96px !important; height: 128px !important;
    border-radius: 12px !important;
    background: linear-gradient(90deg, #f3eee8 25%, #faf7f2 38%, #f3eee8 63%) !important;
    background-size: 400% 100% !important; animation: snhAddonsShimmer 1.25s ease infinite !important;
  }
  @keyframes snhAddonsShimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
  .snh-addons__card {
    display: flex !important;
    flex-direction: column !important;
    flex: 0 0 96px !important;
    width: 96px !important;
    max-width: 96px !important;
    min-width: 96px !important;
    height: auto !important;
    gap: 6px !important;
    text-align: left !important;
    background: none !important;
    border: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  .snh-addons__card img {
    display: block !important;
    width: 96px !important; height: 96px !important;
    max-width: 96px !important; max-height: 96px !important;
    object-fit: contain !important;
    border-radius: 12px !important; background: var(--snh-paper) !important;
    border: 1px solid var(--snh-line) !important;
  }
  .snh-addons__name {
    display: -webkit-box !important;
    font-size: 11.5px !important; font-weight: 600 !important; color: var(--snh-ink) !important;
    line-height: 1.25 !important; -webkit-line-clamp: 2 !important; -webkit-box-orient: vertical !important;
    overflow: hidden !important; text-decoration: none !important; margin: 0 !important;
  }
  .snh-addons__price {
    display: block !important;
    font-family: var(--snh-display) !important; font-weight: 800 !important;
    font-size: 12.5px !important; color: var(--snh-ink) !important; margin: 0 !important;
  }
  .snh-addons__flag {
    display: inline-block !important;
    font-size: 8.5px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: .3px !important;
    color: var(--snh-orange-deep) !important; background: var(--snh-orange-tint) !important;
    border-radius: 999px !important; padding: 2px 6px !important; width: fit-content !important;
  }
  .snh-addons__btn {
    display: block !important;
    width: 100% !important; height: auto !important;
    min-height: 30px !important; max-height: 30px !important;
    margin: 2px 0 0 !important; border: 0 !important; border-radius: 8px !important; cursor: pointer !important;
    background: var(--snh-orange) !important; color: #fff !important;
    font-family: var(--snh-sans) !important; font-weight: 600 !important; font-size: 11px !important;
    line-height: 1 !important; padding: 0 !important;
    transition: background .2s ease !important;
  }
  .snh-addons__btn:hover { background: var(--snh-orange-deep) !important; }

  /* ══ Refined cart layout and gap-matched add-ons ══ */
  .snh-cart-page .page-spacer {
    margin-block-start: clamp(18px, 3vw, 42px) !important;
  }
  .snh-cart-page .cart-header {
    display: grid !important;
    grid-template-columns: auto minmax(320px, 480px) !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 24px !important;
    margin-bottom: clamp(20px, 3vw, 34px) !important;
  }
  .snh-cart-page .cart-header h1 {
    margin: 0 !important;
    font-size: clamp(34px, 4vw, 52px) !important;
  }
  .snh-cart-delivery {
    display: grid;
    grid-template-columns: 34px minmax(0,1fr);
    gap: 0 10px;
    align-items: center;
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--snh-line);
    border-radius: 13px;
    background: var(--snh-white);
    text-align: left;
  }
  .snh-cart-delivery__icon {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--snh-orange-tint);
    color: var(--snh-orange-deep);
  }
  .snh-cart-delivery__icon svg { width: 18px; height: 18px; }
  .snh-cart-delivery__copy { min-width: 0; }
  .snh-cart-delivery__copy strong {
    display: block;
    color: var(--snh-ink);
    font-size: 13px;
    line-height: 1.25;
    font-weight: 700;
  }
  .snh-cart-delivery__copy > span {
    display: block;
    margin-top: 2px;
    color: var(--snh-muted);
    font-size: 10.5px;
    line-height: 1.25;
  }
  .snh-cart-delivery__track {
    grid-column: 2;
    display: block;
    height: 3px;
    margin-top: 7px;
    overflow: hidden;
    border-radius: 999px;
    background: #eadfd5;
  }
  .snh-cart-delivery__track i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--snh-orange);
  }

  @media (min-width: 1000px) {
    .snh-cart-page .cart-header {
      grid-template-columns: minmax(0,1fr) !important;
      gap: 14px !important;
    }
    .snh-cart-page .cart-header h1 { justify-self: start !important; }
    .snh-cart-page .cart-header .snh-cart-delivery {
      grid-column: 1 / -1 !important;
      width: 100% !important;
      max-width: none !important;
    }
    .snh-cart-page .cart-order {
      display: grid !important;
      grid-template-columns: minmax(0, 1.65fr) minmax(310px, .72fr) !important;
      gap: 28px !important;
      align-items: start !important;
    }
    .snh-cart-page .cart-order__summary { grid-column: 1 !important; min-width: 0 !important; }
    .snh-cart-page .cart-order__recap { grid-column: 2 !important; min-width: 0 !important; }
  }

  .snh-cart-page .cart-order__summary {
    padding: clamp(18px, 2vw, 24px) !important;
  }
  .snh-cart-page .cart-order__recap .cart-form {
    padding: clamp(18px, 2vw, 24px) !important;
    border: 1px solid var(--snh-line) !important;
    background: var(--snh-white) !important;
    box-shadow: 0 14px 34px rgba(42,31,22,.07) !important;
  }
  .snh-cart-page .cart-form__note textarea {
    min-height: 82px !important;
  }
  .snh-cart-page button[name="checkout"] {
    min-height: 50px !important;
  }
  .snh-cart-page .order-summary__body line-item-quantity .link {
    color: var(--snh-muted) !important;
    font-size: 10.5px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
  }
  .snh-cart-page .order-summary__body line-item-quantity .link:hover {
    color: var(--snh-orange-deep) !important;
  }
  .snh-cart-page .cart-order__summary > accordion-disclosure {
    display: block;
    margin-top: 4px;
    border-top: 1px solid var(--snh-line);
  }
  .snh-cart-page .cart-order__summary > accordion-disclosure > button,
  .snh-cart-page .cart-order__summary > .accordion button {
    min-height: 54px !important;
    padding-block: 10px !important;
  }

  .snh-addons {
    display: block !important;
    width: 100% !important;
    min-width: 0 !important;
    margin: 16px 0 12px !important;
    padding: 13px !important;
    border: 1px solid #f0d8c9 !important;
    border-radius: 14px !important;
    background: #fffaf6 !important;
  }
  .snh-addons__head {
    display: flex !important;
    align-items: end !important;
    justify-content: space-between !important;
    gap: 12px !important;
    margin: 0 0 10px !important;
    text-transform: none !important;
  }
  .snh-addons__head > span { min-width: 0; }
  .snh-addons__head small {
    display: block;
    margin-bottom: 2px;
    color: var(--snh-orange-deep);
    font-family: var(--snh-sans);
    font-size: 8.5px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .snh-addons__head strong {
    display: block;
    color: var(--snh-ink);
    font-family: var(--snh-display);
    font-size: 14px;
    line-height: 1.2;
    font-weight: 800;
  }
  .snh-addons__head em {
    flex: 0 0 auto;
    color: var(--snh-muted);
    font-family: var(--snh-sans);
    font-size: 9px;
    line-height: 1.2;
    font-style: normal;
    font-weight: 500;
  }
  .snh-addons__track {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(215px,1fr)) !important;
    gap: 8px !important;
    width: 100% !important;
    min-width: 0 !important;
    overflow: visible !important;
    padding: 0 !important;
  }
  .snh-addons__skeleton {
    flex: none !important;
    width: 100% !important;
    height: 70px !important;
    border-radius: 11px !important;
  }
  .snh-addons__card {
    display: grid !important;
    grid-template-columns: 52px minmax(0,1fr) 32px !important;
    grid-template-rows: auto !important;
    align-items: center !important;
    gap: 9px !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    min-height: 70px !important;
    padding: 7px !important;
    border: 1px solid var(--snh-line) !important;
    border-radius: 11px !important;
    background: var(--snh-white) !important;
  }
  .snh-addons__image {
    display: block;
    width: 52px;
    height: 52px;
  }
  .snh-addons__card img {
    width: 52px !important;
    height: 52px !important;
    max-width: 52px !important;
    max-height: 52px !important;
    border: 0 !important;
    border-radius: 8px !important;
  }
  .snh-addons__meta { min-width: 0; }
  .snh-addons__name {
    display: block !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    font-size: 10.5px !important;
    line-height: 1.2 !important;
    font-weight: 600 !important;
  }
  .snh-addons__price {
    margin-top: 4px !important;
    font-size: 11.5px !important;
    line-height: 1.1 !important;
  }
  .snh-addons__flag {
    display: block !important;
    max-width: 100% !important;
    margin-top: 4px !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: transparent !important;
    color: var(--snh-orange-deep) !important;
    font-size: 8px !important;
    line-height: 1.15 !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    text-transform: none !important;
  }
  .snh-addons__btn {
    display: grid !important;
    place-items: center !important;
    align-self: center !important;
    width: 32px !important;
    min-width: 32px !important;
    max-width: 32px !important;
    height: 32px !important;
    min-height: 32px !important;
    max-height: 32px !important;
    margin: 0 !important;
    border-radius: 9px !important;
    font-size: 18px !important;
    font-weight: 500 !important;
  }
  .snh-addons__empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: 9px 10px;
    border-radius: 9px;
    background: var(--snh-white);
    color: var(--snh-muted);
    font-size: 11px;
  }

  @media (max-width: 999px) {
    .shopify-section--main-cart {
      overflow-x: hidden !important;
      overflow-x: clip !important;
    }
    .container.snh-cart-page {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      margin-inline: auto !important;
      padding-inline: var(--container-gutter, 20px) !important;
      overflow: hidden !important;
      box-sizing: border-box !important;
    }
    .snh-cart-page,
    .snh-cart-page *,
    .snh-cart-page *::before,
    .snh-cart-page *::after { box-sizing: border-box; }
    .snh-cart-page .page-spacer,
    .snh-cart-page .cart,
    .snh-cart-page .cart-order,
    .snh-cart-page .cart-order__summary,
    .snh-cart-page .cart-order__recap,
    .snh-cart-page .cart-form {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }
    .snh-cart-page .page-spacer {
      margin-block-start: 10px !important;
      padding-block: 0 24px !important;
    }
    .snh-cart-page .cart { gap: 14px !important; }
    .snh-cart-page .cart-header {
      grid-template-columns: minmax(0,1fr) !important;
      gap: 10px !important;
      margin-bottom: 14px !important;
      padding: 0 !important;
      justify-items: stretch !important;
    }
    .snh-cart-page .cart-header h1 {
      justify-self: start !important;
      width: auto !important;
      max-width: 100% !important;
      margin: 0 !important;
      font-size: 30px !important;
      letter-spacing: -1px !important;
      text-align: left !important;
    }
    .snh-cart-delivery {
      width: 100% !important;
      max-width: 100% !important;
      grid-template-columns: 30px minmax(0,1fr);
      padding: 8px 10px;
      border-radius: 11px;
      box-sizing: border-box;
    }
    .snh-cart-delivery__icon { width: 30px; height: 30px; border-radius: 8px; }
    .snh-cart-delivery__copy strong { font-size: 12px; }
    .snh-cart-delivery__copy > span { display: none; }
    .snh-cart-delivery__track { grid-column: 1 / -1; margin-top: 6px; }
    .snh-cart-page .cart-order { display: block !important; }
    .snh-cart-page .cart-order__summary {
      padding: 12px !important;
      overflow: hidden !important;
      border-radius: 15px !important;
    }
    .snh-cart-page .cart-order__recap { margin-top: 14px !important; }
    .snh-cart-page .cart-order__recap .cart-form {
      padding: 14px !important;
      overflow: hidden !important;
      border-radius: 15px !important;
    }
    .snh-cart-page .cart-form__note textarea { min-height: 68px !important; }
    .snh-cart-page .order-summary,
    .snh-cart-page .order-summary__body {
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }
    .snh-cart-page .order-summary { table-layout: fixed !important; }
    .snh-cart-page .order-summary__header { display: none !important; }
    .snh-cart-page .order-summary__body tr {
      display: block !important;
      width: 100% !important;
      min-width: 0 !important;
      padding: 0 !important;
      border-bottom: 1px solid var(--snh-line) !important;
    }
    .snh-cart-page .order-summary__body tr:last-child { border-bottom: 0 !important; }
    .snh-cart-page .order-summary__body td:first-child {
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      padding: 12px 0 !important;
    }
    .snh-cart-page .order-summary__body line-item,
    .snh-cart-page .order-summary__body .line-item {
      display: grid !important;
      grid-template-columns: 76px minmax(0,1fr) !important;
      align-items: start !important;
      gap: 12px !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }
    .snh-cart-page .order-summary__body td:first-child img {
      width: 76px !important;
      height: 76px !important;
      max-width: 76px !important;
      max-height: 76px !important;
      object-fit: contain !important;
    }
    .snh-cart-page .line-item__media,
    .snh-cart-page .line-item__image-wrapper {
      width: 76px !important;
      max-width: 76px !important;
      min-width: 76px !important;
    }
    .snh-cart-page .line-item__info,
    .snh-cart-page .line-item__details,
    .snh-cart-page .line-item__content { min-width: 0 !important; }
    .snh-cart-page .line-item__title,
    .snh-cart-page .line-item__info > a:first-child {
      display: -webkit-box !important;
      overflow: hidden !important;
      -webkit-box-orient: vertical !important;
      -webkit-line-clamp: 2 !important;
      font-size: 14px !important;
      line-height: 1.2 !important;
    }
    .snh-cart-page .line-item__info,
    .snh-cart-page .line-item__info .text-subdued { font-size: 12px !important; }
    .snh-cart-page line-item-quantity {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 10px !important;
      margin-top: 7px !important;
    }
    .snh-cart-page .quantity-input {
      width: 54px !important;
      min-width: 54px !important;
      height: 36px !important;
      min-height: 36px !important;
      padding: 0 6px !important;
      font-size: 13px !important;
    }
    .snh-cart-page .order-summary__body line-item-quantity .link {
      font-size: 10.5px !important;
      color: var(--snh-muted) !important;
    }
    .snh-cart-page .cart-form__totals,
    .snh-cart-page .cart-form__totals .h-stack { min-width: 0 !important; }
    .snh-cart-page .cart-form__totals .h5 { font-size: 17px !important; }
    .snh-cart-points {
      align-items: flex-start;
      min-width: 0;
      max-width: 100%;
      padding: 10px 11px;
      gap: 9px;
      overflow: hidden;
    }
    .snh-cart-points__icon { flex-basis: 27px; width: 27px; height: 27px; }
    .snh-cart-points__text {
      min-width: 0;
      font-size: 11.5px;
      overflow-wrap: anywhere;
    }
    .snh-addons { margin: 13px 0 9px !important; padding: 11px !important; }
    .snh-addons__head { align-items: center !important; }
    .snh-addons__head em { display: none; }
    .snh-addons__track {
      display: grid !important;
      grid-template-columns: minmax(0,1fr) !important;
      gap: 8px !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      overflow: visible !important;
      padding: 0 !important;
    }
    .snh-addons__skeleton,
    .snh-addons__card {
      flex: none !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }
    .snh-addons__card {
      grid-template-columns: 48px minmax(0,1fr) 30px !important;
      min-height: 64px !important;
      padding: 6px !important;
    }
    .snh-addons__image,
    .snh-addons__card img {
      width: 48px !important;
      height: 48px !important;
      max-width: 48px !important;
      max-height: 48px !important;
    }
    .snh-addons__btn {
      width: 30px !important;
      min-width: 30px !important;
      max-width: 30px !important;
      height: 30px !important;
      min-height: 30px !important;
      max-height: 30px !important;
    }
    .snh-cart-page .cart-order__summary accordion-disclosure,
    .snh-cart-page .cart-order__summary .accordion {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      margin: 8px 0 0 !important;
    }
    .snh-cart-page .cart-order__summary accordion-disclosure summary,
    .snh-cart-page .cart-order__summary accordion-disclosure > button,
    .snh-cart-page .cart-order__summary .accordion summary,
    .snh-cart-page .cart-order__summary .accordion > button,
    .snh-cart-page .cart-order__summary .accordion__toggle {
      min-height: 56px !important;
      padding: 12px 0 !important;
      font-size: 16px !important;
      line-height: 1.2 !important;
    }
    .snh-cart-page .cart-order__summary accordion-disclosure svg,
    .snh-cart-page .cart-order__summary .accordion svg {
      width: 22px !important;
      height: 22px !important;
    }
  }

  @media (max-width: 560px) {
    .snh-cart-page .cart-header h1 { font-size: 29px !important; }
  }
</style>

<div class="container snh-cart-page">
  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <div class="empty-state__icon-wrapper">
        {%- render 'icon' with 'cart', width: 32, height: 32, stroke_width: 1 -%}
        <span class="count-bubble count-bubble--lg">0</span>
      </div>

      <div class="prose">
        <p class="h4">{{ 'cart.general.empty' | t }}</p>

        {%- assign button_content = 'cart.general.continue_shopping' | t -%}
        {%- render 'button', href: settings.cart_empty_button_link, size: 'xl', content: button_content -%}
      </div>
    </div>
  {%- else -%}
    <div class="page-spacer">
      <div class="cart">
        <div class="cart-header">
          <h1 class="h2">{{ 'cart.general.title' | t }}</h1>

          {%- if settings.cart_show_free_shipping_threshold -%}
            <div class="snh-cart-delivery" aria-live="polite">
              <span class="snh-cart-delivery__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M3 6h11v10H3zM14 9h3l4 4v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
              </span>
              <span class="snh-cart-delivery__copy">
                <strong>{%- if snh_gap > 0 -%}{{ snh_gap | money_without_trailing_zeros }} to free delivery{%- else -%}Free delivery unlocked{%- endif -%}</strong>
                <span>{%- if snh_gap > 0 -%}A small add-on can complete your cart.{%- else -%}Your order qualifies.{%- endif -%}</span>
              </span>
              <span class="snh-cart-delivery__track" aria-hidden="true"><i style="width: {{ snh_delivery_progress }}%;"></i></span>
            </div>
          {%- endif -%}
        </div>

        <div class="cart-order">
          <div class="cart-order__summary">
            {%- comment -%}
            ----------------------------------------------------------------------------------------------------------------
            ORDER SUMMARY
            ----------------------------------------------------------------------------------------------------------------
            {%- endcomment -%}
            <table class="order-summary">
              <thead class="order-summary__header">
                <tr>
                  <th>{{ 'customer.order.product' | t }}</th>
                  <th class="w-0">{{ 'customer.order.quantity' | t }}</th>
                  <th class="text-end">{{ 'customer.order.total' | t }}</th>
                </tr>
              </thead>

              <tbody class="order-summary__body">
                {%- for line_item in cart.items -%}
                  {% liquid
                    assign max_quantity = nil
                  
                    if line_item.variant.inventory_management != blank and line_item.variant.inventory_policy == 'deny'
                      assign current_quantity_for_variant = cart | item_count_for_variant: line_item.variant.id
                      assign max_quantity = line_item.variant.inventory_quantity | minus: current_quantity_for_variant | plus: line_item.quantity
                    endif
                  
                    if line_item.variant.quantity_rule.max != nil
                      assign max_quantity = max_quantity | default: 999999 | at_most: line_item.variant.quantity_rule.max
                    endif
                  %}

                  <tr>
                    <td>{%- render 'line-item', line_item: line_item -%}</td>

                    <td class="hidden align-center text-center text-subdued sm:table-cell">
                      <line-item-quantity class="v-stack justify-center gap-2">
                        <input class="quantity-input" type="number" is="quantity-input" inputmode="numeric" min="{{ line_item.variant.quantity_rule.min }}" step="{{ line_item.variant.quantity_rule.increment }}" {% if max_quantity != nil %}max="{{ max_quantity }}"{% endif %} data-line-key="{{ line_item.key }}" aria-label="{{ 'cart.order.change_quantity' | t | escape }}" value="{{ line_item.quantity }}">

                        <span class="text-xs">
                          <a href="{{ line_item.url_to_remove }}" class="link" aria-label="{{ 'cart.order.remove_with_title' | t: title: line_item.title | escape }}">
                            {{- 'cart.order.remove' | t -}}
                          </a>
                        </span>
                      </line-item-quantity>
                    </td>

                    <td class="hidden align-center text-subdued text-end sm:table-cell">{{ line_item.final_line_price | money_without_trailing_zeros }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>

            {%- if snh_gap > 0 -%}
              <div class="snh-addons" data-snh-addons
                   data-collection="{{ section.settings.addons_collection.handle | default: 'all' }}"
                   data-cart-ids="{{ cart.items | map: 'product_id' | join: ',' }}"
                   data-gap-cents="{{ snh_gap }}">
                <div class="snh-addons__head">
                  <span>
                    <small>Complete free delivery</small>
                    <strong>Add {{ snh_gap | money_without_trailing_zeros }} more</strong>
                  </span>
                  <em data-snh-addons-count>Finding smart picks...</em>
                </div>
                <div class="snh-addons__track" data-snh-addons-track>
                  <div class="snh-addons__skeleton"></div>
                  <div class="snh-addons__skeleton"></div>
                  <div class="snh-addons__skeleton"></div>
                </div>
              </div>
            {%- endif -%}

            {%- comment -%}
            ----------------------------------------------------------------------------------------------------------------
            SHIPPING ESTIMATOR
            ----------------------------------------------------------------------------------------------------------------
            {%- endcomment -%}

            {%- if section.settings.show_shipping_estimator and cart.requires_shipping -%}
              {%- assign accordion_title = 'cart.shipping_estimator.estimate_shipping' | t -%}
              {%- capture accordion_content -%}{%- render 'shipping-estimator' -%}{%- endcapture -%}

              {%- render 'accordion', title: accordion_title, icon: 'picto-box', content: accordion_content, size: 'lg' -%}
            {%- endif -%}
          </div>

          <safe-sticky class="cart-order__recap v-stack gap-6">
            <form action="{{ routes.cart_url }}" method="POST" class="cart-form rounded">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when '@app' -%}
                    {%- render block -%}

                  {%- when 'totals' -%}
                    <div class="cart-form__totals v-stack gap-2" {{ block.shopify_attributes }}>
                      {%- if block.settings.show_order_weight -%}
                        <div class="h-stack gap-4 justify-between">
                          <span class="text-subdued">{{ 'cart.general.weight' | t }}</span>
                          <span class="text-subdued">{{ cart.total_weight | weight_with_unit }}</span>
                        </div>
                      {%- endif -%}

                      <div class="h-stack gap-4 justify-between">
                        <span class="text-subdued">{{ 'cart.general.subtotal' | t }}</span>
                        <span class="text-subdued">{{ cart.items_subtotal_price | money_without_trailing_zeros }}</span>
                      </div>

                      {% for discount_application in cart.cart_level_discount_applications %}
                        <div class="h-stack gap-4 justify-between">
                          <div class="badge">
                            {%- render 'icon' with 'discount' -%} {{- discount_application.title -}}
                          </div>

                          <span class="text-subdued">-{{ discount_application.total_allocated_amount | money_without_trailing_zeros }}</span>
                        </div>
                      {% endfor %}

                      <div class="h-stack gap-4 justify-between">
                        <span class="h5">{{ 'cart.general.total' | t }}</span>
                        <span class="h5">{{- cart.total_price | money_with_currency -}}</span>
                      </div>

                      {%- comment -%} ── SNH Elite points line ── {%- endcomment -%}
                      {%- if customer -%}
                        <div class="snh-cart-points">
                          <span class="snh-cart-points__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
                          <span class="snh-cart-points__text">You'll earn <b>{{ snh_points | floor }} points</b> on this order as a {{ snh_tier }} member ({{ snh_rate }}% back). <a href="{{ routes.account_url }}#rewards">See my points</a></span>
                        </div>
                      {%- else -%}
                        <div class="snh-cart-points">
                          <span class="snh-cart-points__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
                          <span class="snh-cart-points__text"><a href="{{ routes.account_login_url }}">Log in</a> or <a href="{{ routes.account_register_url }}">join SNH Elite</a> to earn <b>{{ settings.snh_rate_bronze | default: 3 }}% back in points</b> on this order.</span>
                        </div>
                      {%- endif -%}

                      {%- if block.settings.show_shipping_text -%}
                        {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                          <span class="text-subdued text-sm">{{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}</span>
                        {%- elsif cart.taxes_included -%}
                          <span class="text-subdued text-sm">{{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}</span>
                        {%- elsif shop.shipping_policy.body != blank -%}
                          <span class="text-subdued text-sm">{{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}</span>
                        {%- else -%}
                          <span class="text-subdued text-sm">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</span>
                        {%- endif -%}
                      {%- endif -%}
                    </div>

                  {%- when 'cart_note' -%}
                    <cart-note class="cart-form__note block" {{ block.shopify_attributes }}>
                      {%- assign order_note = 'cart.general.order_note' | t -%}
                      {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note, maxlength: block.settings.maxlength -%}
                    </cart-note>

                  {%- when 'text' -%}
                    {%- if block.settings.content != blank -%}
                      <div class="prose text-subdued" {{ block.shopify_attributes }}>
                        {{- block.settings.content -}}
                      </div>
                    {%- endif -%}

                  {%- when 'offer' -%}
                    {%- assign previous_block_index = forloop.index0 | minus: 1 -%}
                    {%- assign next_block_index = forloop.index0 | plus: 1 -%}

                    {%- if section.blocks[next_block_index].type == 'offer' -%}
                      <div class="v-stack gap-4">
                    {%- endif -%}

                    {%- render 'offer', block: block -%}

                    {%- if section.blocks[previous_block_index].type == 'offer' -%}
                      </div>
                    {%- endif -%}

                  {%- when 'accelerated_buttons' -%}
                    {% if additional_checkout_buttons %}
                      <div class="additional-checkout-buttons additional-checkout-buttons--vertical" {{ block.shopify_attributes }}>
                        {{- content_for_additional_checkout_buttons -}}
                      </div>
                    {% endif %}

                  {%- when 'checkout_button' -%}
                    {%- assign checkout_button = 'cart.general.checkout' | t -%}
                    {%- render 'button', type: 'submit', icon: 'picto-lock', content: checkout_button, size: 'xl', name: 'checkout', stretch: true, block: block -%}
                {%- endcase -%}
              {%- endfor -%}
            </form>

            {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
              <div class="v-stack gap-4">
                <span class="text-xs text-subdued text-center">{{ 'cart.general.we_accept' | t }}</span>

                <ul class="h-stack gap-2 wrap justify-center">
                  {%- for type in shop.enabled_payment_types -%}
                    <li class="contents">{{ type | payment_type_svg_tag }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </safe-sticky>
        </div>
      </div>

    </div>
  {%- endif -%}
</div>

<script>
(function () {
  var strips = document.querySelectorAll('[data-snh-addons]');
  if (!strips.length) return;

  function esc(value) {
    return String(value || '').replace(/[&<>"']/g, function (char) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char];
    });
  }

  function fmtMoney(cents) {
    if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
      return window.Shopify.formatMoney(cents, {{ shop.money_format | json }});
    }
    return 'Rs. ' + Math.round(cents / 100).toLocaleString('en-LK');
  }

  function fetchProducts(handle) {
    return fetch('/collections/' + encodeURIComponent(handle || 'all') + '/products.json?limit=250&sort_by=best-selling', {
      headers: { 'Accept': 'application/json' }
    }).then(function (response) {
      if (!response.ok) return [];
      return response.json().then(function (data) { return data.products || []; });
    }).catch(function () { return []; });
  }

  function bestThresholdVariant(product, minimumPriceCents, maximumPriceCents) {
    return (product.variants || []).map(function (variant) {
      return { variant: variant, priceCents: Math.round(Number(variant.price) * 100) };
    }).filter(function (item) {
      return item.variant.available && item.priceCents >= minimumPriceCents && item.priceCents <= maximumPriceCents;
    }).sort(function (a, b) {
      return a.priceCents - b.priceCents;
    })[0] || null;
  }

  strips.forEach(function (strip) {
    var handle = strip.getAttribute('data-collection') || 'all';
    var cartIds = (strip.getAttribute('data-cart-ids') || '').split(',').filter(Boolean);
    var gapCents = Number(strip.getAttribute('data-gap-cents')) || 0;
    var maximumUsefulPrice = Math.max(gapCents * 1.75, gapCents + 150000);
    var track = strip.querySelector('[data-snh-addons-track]');
    var count = strip.querySelector('[data-snh-addons-count]');
    if (!track) return;

    var requests = [fetchProducts(handle)];
    if (handle !== 'all') requests.push(fetchProducts('all'));

    Promise.all(requests)
      .then(function (groups) {
        var seen = {};
        var pool = [];

        groups.forEach(function (products) {
          products.forEach(function (product) {
            if (seen[product.id] || cartIds.includes(String(product.id))) return;
            seen[product.id] = true;

            var match = bestThresholdVariant(product, gapCents, maximumUsefulPrice);
            if (!match) return;

            pool.push({
              product: product,
              variant: match.variant,
              priceCents: match.priceCents
            });
          });
        });

        var suitable = pool.filter(function (item) {
          return item.priceCents >= gapCents && item.priceCents <= maximumUsefulPrice;
        });

        suitable.sort(function (a, b) {
          return (a.priceCents - gapCents) - (b.priceCents - gapCents);
        });

        var shortlist = suitable.slice(0, 12);
        var displayCount = Math.min(4, shortlist.length);
        var rotationKey = 'snh-gap-picks-' + gapCents;
        var rotation = 0;
        try {
          rotation = Number(sessionStorage.getItem(rotationKey) || 0) % Math.max(1, shortlist.length);
          sessionStorage.setItem(rotationKey, String((rotation + displayCount) % Math.max(1, shortlist.length)));
        } catch (error) {}

        var matches = [];
        for (var matchIndex = 0; matchIndex < displayCount; matchIndex += 1) {
          matches.push(shortlist[(rotation + matchIndex) % shortlist.length]);
        }

        if (!matches.length) {
          if (count) count.textContent = 'No sensible match';
          track.innerHTML = '<p class="snh-addons__empty">No suitable low-cost add-ons are available right now.</p>';
          return;
        }

        if (count) count.textContent = matches.length + (matches.length === 1 ? ' smart pick' : ' smart picks');

        track.innerHTML = matches.map(function (item) {
          var product = item.product;
          var variant = item.variant;
          var image = variant.featured_image && variant.featured_image.src
            ? variant.featured_image.src
            : (product.images && product.images[0] ? product.images[0].src : '');
          var imageUrl = image ? image + (image.indexOf('?') > -1 ? '&' : '?') + 'width=140' : '';
          var helper = 'Unlocks free delivery';
          var productUrl = '/products/' + encodeURIComponent(product.handle || '');

          return (
            '<div class="snh-addons__card">' +
              '<a class="snh-addons__image" href="' + productUrl + '">' +
                (imageUrl ? '<img src="' + esc(imageUrl) + '" alt="' + esc(product.title) + '" loading="lazy" decoding="async">' : '') +
              '</a>' +
              '<span class="snh-addons__meta">' +
                '<a href="' + productUrl + '" class="snh-addons__name">' + esc(product.title) + '</a>' +
                '<span class="snh-addons__price">' + fmtMoney(item.priceCents) + '</span>' +
                '<span class="snh-addons__flag">' + esc(helper) + '</span>' +
              '</span>' +
              '<button type="button" class="snh-addons__btn" data-snh-add-variant="' + variant.id + '" aria-label="Add ' + esc(product.title) + ' to cart" title="Add to cart">+</button>' +
            '</div>'
          );
        }).join('');

        track.querySelectorAll('[data-snh-add-variant]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var variantId = btn.getAttribute('data-snh-add-variant');
            btn.textContent = '…';
            btn.disabled = true;
            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ id: Number(variantId), quantity: 1 })
            })
              .then(function (r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
              .then(function () { window.location.reload(); })
              .catch(function () { btn.textContent = '+'; btn.disabled = false; btn.title = 'Could not add. Try again.'; });
          });
        });
      })
      .catch(function () { strip.style.display = 'none'; });
  });
})();
</script>

{% schema %}
{
  "name": "Cart",
  "class": "shopify-section--main-cart",
  "tag": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "totals",
      "name": "Totals",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_order_weight",
          "label": "Show order weight",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_shipping_text",
          "label": "Show shipping/taxes text",
          "default": true
        }
      ]
    },
    {
      "type": "cart_note",
      "name": "Cart note",
      "limit": 1,
      "settings": [
        {
          "type": "number",
          "id": "max_length",
          "label": "Maximum number of characters"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "checkout_button",
      "name": "Checkout button",
      "limit": 1
    },
    {
      "type": "accelerated_buttons",
      "name": "Accelerated buttons",
      "limit": 1,
      "settings": [
