{%- comment -%}
  Round 19 #6: everyone gets onboarded. A friendly, dismissible slide-in for visitors with no preferences yet
  (guests: no quiz answers on this device; members: no goal: tag), pointing at the "Find my stack" quiz.
  Rules (assets/snh-onboard.js): after the delay or 30 % scroll · once per N days (localStorage snh_onb_t) · never on
  the cart, checkout, account or password pages · never on the same page view as the email popup or a campaign popup
  (window.SNHPopups.claim) and never over an open drawer/dialog · Escape or × closes (counts as seen).
  The button opens the homepage quiz band in place when it's on the page, else goes to /?snh-quiz=open.
  Everything here is editable in Customize → Overlay group → SNH onboarding prompt.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign skip = false
  if template.name == 'cart' or template.name == 'password' or template.name == 'gift_card' or template contains 'customers/'
    assign skip = true
  endif
  if request.design_mode and s.preview
    assign skip = false
  endif
  assign goal = ''
  for t in customer.tags
    assign tl = t | downcase | strip
    if tl contains 'goal:'
      assign goal = tl
      break
    endif
  endfor
  if goal != ''
    assign skip = true
  endif
-%}
{%- if s.enabled and skip == false -%}
{%- comment -%} 25 Nov: interactive goal card. Five goal chips; a tap shows "3 products picked for you" (the first three
  products of that goal's collection) and opens the quiz with the goal already answered (SNHQuiz.open({ goal }), or
  /?snh-quiz=open&goal=… on other pages). Same gate as before (one auto popup per session after 15 s + scroll, never on
  cart/account, 7-day cap). Phones: bottom sheet. Desktop: corner card. {%- endcomment -%}
{%- liquid
  assign goals = 'build-muscle|Build muscle|dumbbell|muscle-and-strength,lose-fat|Lose fat|flame|fat-loss,endurance|Energy & endurance|run|energy-and-endurance,hydration-recovery|Recovery & sleep|moon|sleep,daily-health|Daily health|heart|daily-wellness' | split: ','
-%}
<aside class="snh-onb" id="snh-onb-{{ section.id }}" role="dialog" aria-modal="false" aria-labelledby="snh-onb-{{ section.id }}-h" hidden
  data-snh-onb data-days="{{ s.days }}" data-delay="{{ s.delay }}" data-test="{% if request.design_mode and s.preview %}1{% endif %}">
  <span class="snh-onb__grab" aria-hidden="true"></span>
  <button class="snh-onb__x" type="button" data-onb-close aria-label="Close">{% render 'snh-v2-icon', name: 'close' %}</button>
  {%- if s.eyebrow != blank -%}<p class="snh-onb__eb">{{ s.eyebrow | escape }}</p>{%- endif -%}
  <p class="snh-onb__h" id="snh-onb-{{ section.id }}-h">{{ s.heading | escape | replace: '*', '' }}</p>
  {%- if s.text != blank -%}<p class="snh-onb__p">{{ s.text | escape }}</p>{%- endif -%}
  <div class="snh-onb__chips" role="group" aria-label="{{ s.heading | escape | replace: '*', '' }}">
    {%- for g in goals -%}
      {%- assign gp = g | split: '|' -%}
      {%- assign imgs = '' -%}
      {%- assign col = collections[gp[3]] -%}
      {%- for pr in col.products limit: 6 -%}
        {%- if pr.available and pr.featured_image -%}
          {%- assign u = pr.featured_image | image_url: width: 120 -%}
          {%- assign imgs = imgs | append: u | append: ' ' -%}
          {%- assign n_img = imgs | split: ' ' | size -%}
          {%- if n_img >= 3 -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <button class="snh-onb__chip" type="button" data-onb-goal="{{ gp[0] }}" data-imgs="{{ imgs | strip }}" style="--i:{{ forloop.index0 }}">{% render 'snh-v2-icon', name: gp[2] %}<span>{{ gp[1] }}</span></button>
    {%- endfor -%}
  </div>
  <div class="snh-onb__tease" data-onb-tease hidden aria-live="polite">
    <span class="snh-onb__thumbs" data-onb-thumbs></span>
    <span><b>3 products picked for you</b><small>A few more taps and your stack is ready.</small></span>
  </div>
  <div class="snh-onb__act">
    <a class="snh-onb__go" href="{{ s.link | default: '/?snh-quiz=open' }}" data-onb-go>{{ s.cta | escape }}</a>
    <button class="snh-onb__later" type="button" data-onb-close>{{ s.later | escape }}</button>
  </div>
</aside>
<style>
  .snh-onb { position: fixed; z-index: 120; right: 20px; bottom: calc(20px + env(safe-area-inset-bottom)); width: min(400px, calc(100vw - 32px)); padding: 20px 20px 16px; border-radius: 20px; background: #fff; color: #0E0E0E; box-shadow: 0 24px 60px -18px rgba(12, 12, 13, .45), 0 0 0 1px rgba(12, 12, 13, .06); transform: translateY(24px) scale(.98); opacity: 0; transition: transform .45s cubic-bezier(.2, .9, .25, 1.15), opacity .3s ease; }
  .snh-onb[hidden] { display: none; }
  .snh-onb.is-on { transform: none; opacity: 1; }
  .snh-onb__grab { display: none; }
  .snh-onb__x { position: absolute; top: 8px; right: 8px; display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 50%; background: none; color: #5C574F; cursor: pointer; }
  .snh-onb__x:hover { background: #F4F4F4; color: #0E0E0E; }
  .snh-onb__x svg { width: 18px; height: 18px; }
  .snh-onb__eb { margin: 0 0 2px; font: 600 12px/1.4 var(--sans, inherit); letter-spacing: .05em; text-transform: uppercase; color: #BF4512; }
  .snh-onb__h { margin: 0; padding-right: 36px; font: 800 24px/1.1 var(--sans, inherit); letter-spacing: -.02em; }
  .snh-onb__p { margin: 6px 0 0; font-size: 14px; line-height: 1.45; color: #4A4640; }
  .snh-onb__chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; }
  .snh-onb__chip { display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 16px 0 12px; border: 1.5px solid #E5E0D8; border-radius: 999px; background: #FAF7F2; color: #0E0E0E; font: 600 14.5px/1 var(--sans, inherit); cursor: pointer; transition: border-color .2s, background-color .2s, transform .15s; }
  .snh-onb__chip svg { width: 20px; height: 20px; color: #BF4512; flex: none; }
  .snh-onb__chip:hover { border-color: #BF4512; background: #FFF4EC; }
  .snh-onb__chip:active { transform: scale(.96); }
  .snh-onb__chip:focus-visible { outline: 3px solid #BF4512; outline-offset: 2px; }
  .snh-onb__chip[aria-pressed="true"] { border-color: #BF4512; background: #BF4512; color: #fff; }
  .snh-onb__chip[aria-pressed="true"] svg { color: #fff; }
  .snh-onb.is-on .snh-onb__chip { animation: snhOnbChip .42s cubic-bezier(.2, .9, .25, 1.2) both; animation-delay: calc(.12s + var(--i) * .06s); }
  @keyframes snhOnbChip { from { opacity: 0; transform: translateY(10px) scale(.96); } to { opacity: 1; transform: none; } }
  .snh-onb__tease { display: flex; align-items: center; gap: 12px; margin-top: 12px; padding: 10px 12px; border-radius: 14px; background: #0E0E0E; color: #fff; font-size: 13.5px; line-height: 1.3; }
  .snh-onb__tease[hidden] { display: none; }
  .snh-onb__tease b { display: block; font-weight: 700; }
  .snh-onb__tease small { display: block; color: #CFC7BC; font-size: 12.5px; }
  .snh-onb__thumbs { display: flex; flex: none; }
  .snh-onb__thumbs img { width: 40px; height: 40px; border-radius: 10px; background: #fff; object-fit: contain; border: 2px solid #0E0E0E; margin-left: -10px; animation: snhOnbChip .35s both; }
  .snh-onb__thumbs img:first-child { margin-left: 0; }
  .snh-onb__thumbs img:nth-child(2) { animation-delay: .08s; } .snh-onb__thumbs img:nth-child(3) { animation-delay: .16s; }
  .snh-onb__act { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-top: 12px; }
  .snh-onb__go { font-size: 14px; font-weight: 600; color: #0E0E0E; text-decoration: underline; text-underline-offset: 3px; }
  .snh-onb__later { min-height: 44px; padding: 0 4px; border: 0; background: none; font: 500 14px/1 var(--sans, inherit); color: #5C574F; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; margin-left: auto; }
  @media (max-width: 599px) {
    .snh-onb { left: 0; right: 0; bottom: 0; width: auto; padding: 10px 16px calc(12px + env(safe-area-inset-bottom)); border-radius: 22px 22px 0 0; transform: translateY(100%); box-shadow: 0 -16px 40px -12px rgba(12, 12, 13, .35); }
    .snh-onb__grab { display: block; width: 40px; height: 4px; margin: 0 auto 10px; border-radius: 4px; background: #DDD7CE; }
    .snh-onb__h { font-size: 22px; }
    .snh-onb__chips { gap: 6px; margin-top: 12px; }
    .snh-onb__chip { min-height: 44px; padding: 0 13px 0 10px; font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { .snh-onb { transition: opacity .2s; transform: none; } .snh-onb.is-on .snh-onb__chip, .snh-onb__thumbs img { animation: none; } }
</style>
<script src="{{ 'snh-onboard.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "SNH onboarding prompt",
  "class": "snh-sec snh-sec--onb",
  "settings": [
    { "type": "paragraph", "content": "A dismissible slide-in for visitors who haven't told us their goal yet (guests without quiz answers, members without a goal tag). Once per N days, never on cart / checkout / account pages, never on the same page view as the email popup." },
    { "type": "checkbox", "id": "enabled", "label": "Show the prompt", "default": true },
    { "type": "checkbox", "id": "preview", "label": "Preview it in the editor now", "default": false, "info": "Editor only: ignores the rules so you can style it." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Not sure what to buy?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's your goal?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tap one. We pick 3 products for you and build a free plan. About 60 seconds." },
    { "type": "image_picker", "id": "image", "label": "Image (not used)", "info": "Not shown since 25 Nov: the card shows the five goal chips instead." },
    { "type": "text", "id": "cta", "label": "Link (under the goals)", "default": "Or take the full quiz" },
    { "type": "url", "id": "link", "label": "Button link (optional)", "info": "Default: opens the homepage quiz (/?snh-quiz=open)." },
    { "type": "text", "id": "later", "label": "Dismiss link", "default": "Maybe later" },
    { "type": "range", "id": "delay", "label": "Show after", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 10 },
    { "type": "range", "id": "days", "label": "Show again after", "min": 1, "max": 30, "step": 1, "unit": "d", "default": 7 }
  ],
  "presets": [{ "name": "SNH onboarding prompt" }]
}
{% endschema %}
