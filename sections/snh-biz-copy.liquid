{%- comment -%} Round 17: long-form copy block (SEO text, investment overview…), optional photo beside it. {%- endcomment -%}
{{ 'snh-biz.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign parts = s.heading | split: '*'
-%}
<section class="v2 biz-sec biz-sec--{{ s.style }}" aria-labelledby="bx-{{ section.id }}">
  <div class="v-wrap biz-copy{% if s.image != blank %} biz-copy--img{% endif %}">
    <div class="biz-copy__txt">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="biz-h" id="bx-{{ section.id }}">{%- for p in parts -%}{%- if forloop.index0 == 1 -%}<em>{{ p | escape }}</em>{%- else -%}{{ p | escape }}{%- endif -%}{%- endfor -%}</h2>
      <div class="biz-rte">{{ s.body }}</div>
      {%- if s.cta_label != blank -%}<a class="v-btn v-btn--ink" href="{{ s.cta_link | default: '#biz-form' }}"><span>{{ s.cta_label | escape }}</span></a>{%- endif -%}
    </div>
    {%- if s.image != blank -%}<div class="biz-copy__img">{{ s.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500,800,1100', sizes: '(min-width: 1024px) 45vw, 100vw', alt: s.image_alt | default: s.image.alt }}</div>{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "SNH business copy", "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
    { "type": "text", "id": "image_alt", "label": "Photo description (alt text)" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#biz-form" },
    { "type": "select", "id": "style", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "ink", "label": "Ink" } ], "default": "white" }
  ],
  "presets": [ { "name": "SNH business copy" } ] }
{% endschema %}
