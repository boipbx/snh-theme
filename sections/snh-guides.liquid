{%- comment -%}SNH buying guides (prototype "Buying guides"): the latest articles with an image from the chosen blog.{%- endcomment -%}
{%- assign hid = 'blog-' | append: section.id -%}
{%- assign b = section.settings.blog | default: blogs.news -%}
<section class="v2 v-section" aria-labelledby="{{ hid }}">
  <div class="v-wrap">
    {%- render 'snh-v2-head', s: section.settings, id: hid -%}
    <div class="posts">
      {%- assign shown = 0 -%}
      {%- for a in b.articles -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- if a.image == blank -%}{%- continue -%}{%- endif -%}
        <a class="post" href="{{ a.url }}"><div class="post__img">{{ a.image | image_url: width: 800 | image_tag: width: 800, height: 600, loading: 'lazy', alt: '', sizes: '(max-width: 899px) 78vw, 33vw', widths: '400,600,800' }}</div>
          {%- if section.settings.label != blank -%}<p class="eyebrow">{{ section.settings.label | escape }}</p>{%- endif -%}<h3 class="v-h2 post__title">{{ a.title | escape }}</h3></a>
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SNH buying guides",
  "class": "snh-sec",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Defaults to the News blog." },
    { "type": "range", "id": "limit", "label": "Articles", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "label", "label": "Card label", "default": "Buying guide" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Read our blog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buying *guides*" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All articles" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "select", "id": "link_style", "label": "Link style", "options": [{ "value": "link", "label": "Underlined link" }, { "value": "button", "label": "Ink button" }], "default": "link" }
  ],
  "presets": [{ "name": "SNH buying guides" }]
}
{% endschema %}
