    if (!items.length) return;

    var qty = info.querySelector('quantity-selector, .quantity-selector, [class*="quantity" i]');
    var anchor = qty
      || info.querySelector('buy-buttons, .product-form__buttons')
      || info.querySelector('variant-picker, .variant-picker')
      || info.querySelector('[class*="description" i], .prose, .rte');
    if (anchor && anchor.closest) {
      var fieldset = anchor.closest('.product-form__input, fieldset');
      if (fieldset && info.contains(fieldset)) anchor = fieldset;
    }
    if (!anchor) return;

    var el = document.createElement('div');
    el.className = 'snh-benefits';
    el.innerHTML =
      '<div class="snh-benefits-label">Why athletes pick this</div>' +
      items.map(function (b) {
