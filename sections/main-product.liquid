        info.insertBefore(titleBlock, topline);
        var a = topline;
        if (hasSub) { a.insertAdjacentElement('afterend', st); a = st; }
        if (canMovePrice) { a.insertAdjacentElement('afterend', priceBlock); }
        if (priceBlock && priceBlock !== titleBlock) {
          var list = priceBlock.querySelector('.price-list') || priceBlock;
          var cmp = list.querySelector('s, del, [class*="compare" i]');
          if (cmp && !list.querySelector('.snh-save-chip')) {
            var firstNum = function (el) { var m = (el.textContent || '').match(/\d[\d,]*(?:\.\d+)?/); return m ? parseFloat(m[0].replace(/,/g, '')) : 0; };
            var was = firstNum(cmp);
            var probe = list.cloneNode(true);
            var pc = probe.querySelector('s, del, [class*="compare" i]');
            if (pc) pc.remove();
            var now = firstNum(probe);
            if (was > now && now > 0) {
              var chip = document.createElement('span');
              chip.className = 'snh-save-chip';
              chip.textContent = 'You save Rs. ' + Math.round(was - now).toLocaleString('en-US');
              cmp.insertAdjacentElement('afterend', chip);
            }
          }
        }
      }
    }
    /* morph-proof order assertion: zero writes when already in place */
    var tb3 = block('.product-title, h1');
    var tl3 = info.querySelector('.snh-topline');
    if (tb3 && info.firstElementChild !== tb3) info.insertBefore(tb3, info.firstElementChild);
    if (tb3 && tl3 && tb3.nextElementSibling !== tl3) tb3.insertAdjacentElement('afterend', tl3);
    var st3 = info.querySelector('.snh-subtitle') || window.__snhSub;
    if (st3 && tl3) {
