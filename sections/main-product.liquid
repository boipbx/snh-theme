<script>
(function () {
  'use strict';

  var SNH_CONFIG = {
    whatsappNumber: '{{ settings.snh_whatsapp | remove: "+" | remove: " " }}',
    freeDeliveryThreshold: 'Rs. 17,000',
    deliveryUrl: '/pages/delivery',
    paymentUrl: '/pages/payment',
    authenticityUrl: '/pages/authenticity',
    rates: [{{ settings.snh_rate_bronze | default: 3 }}, {{ settings.snh_rate_silver | default: 7 }}, {{ settings.snh_rate_gold | default: 10 }}],
  };

  var SNH_VARIANT_MEDIA = {
    {% for variant in product.variants %}{% if variant.featured_media %}'{{ variant.id }}': {{ variant.featured_media.position | minus: 1 }},
    {% endif %}{% endfor %}
  };

  /* ── STOCK TRUTH ──────────────────────────────────────────────────────────
     The theme's inventory line is an OPTIONAL block, and Impact renders nothing
     at all for a sold-out variant. Reading the pill off that element therefore
     produced a false "In stock" on sold-out products. Availability now comes
     from Liquid, per variant, which is the same data the Sold out button uses. */
  {%- assign snh_inv_block = section.blocks | where: 'type', 'inventory' | first -%}
  /* which media each variant should show — lets the gallery follow the flavour
     picker without depending on any theme internals */
  var SNH_VARIANT_MEDIA = {
    {%- for variant in product.variants -%}
      {%- if variant.featured_media -%}"{{ variant.id }}": {{ variant.featured_media.id }}{% unless forloop.last %},{% endunless %}{%- endif -%}
    {%- endfor -%}
  };

  /* ── Gallery controller — delegated, so it survives theme re-renders ── */
  (function snhGallery() {
    var sectionEl = document.querySelector('#shopify-section-{{ section.id }}');
    if (!sectionEl || sectionEl.dataset.snhGalBound) return;
    sectionEl.dataset.snhGalBound = '1';

    function gal() { return sectionEl.querySelector('[data-snh-gal]'); }
    function isMobile() { return window.matchMedia('(max-width: 999px)').matches; }

    function go(index, scroll) {
      var g = gal();
      if (!g) return;
      var slides = g.querySelectorAll('[data-snh-slide]');
      var thumbs = g.querySelectorAll('[data-snh-thumb]');
      if (!slides.length) return;
      index = Math.max(0, Math.min(index, slides.length - 1));
      for (var i = 0; i < slides.length; i++) slides[i].classList.toggle('is-active', i === index);
      for (var t = 0; t < thumbs.length; t++) thumbs[t].classList.toggle('is-active', t === index);
      var cur = g.querySelector('[data-snh-gal-cur]');
      if (cur) cur.textContent = index + 1;
      var bar = g.querySelector('[data-snh-gal-thumb-bar]');
      if (bar) bar.style.transform = 'translateX(' + (index * 100) + '%)';
      g.dataset.snhIndex = index;
      if (scroll && isMobile()) {
        var list = g.querySelector('[data-snh-gal-list]');
        if (list && slides[index]) list.scrollTo({ left: slides[index].offsetLeft - list.offsetLeft, behavior: 'smooth' });
      }
      var rail0 = g.querySelector('[data-snh-gal-thumbs]');
      if (rail0 && thumbs[index]) {
        var a0 = thumbs[index];
        if (isMobile()) rail0.scrollTo({ top: Math.max(0, a0.offsetTop - rail0.clientHeight / 2 + a0.offsetHeight / 2), behavior: 'smooth' });
        else rail0.scrollTo({ left: Math.max(0, a0.offsetLeft - rail0.clientWidth / 2 + a0.offsetWidth / 2), behavior: 'smooth' });
      }
    }

    function current() { var g = gal(); return g ? (Number(g.dataset.snhIndex) || 0) : 0; }

    sectionEl.addEventListener('click', function (e) {
      var thumb = e.target.closest && e.target.closest('[data-snh-thumb]');
      if (thumb) { e.preventDefault(); go(Number(thumb.dataset.index), true); return; }
      if (e.target.closest && e.target.closest('[data-snh-gal-prev]')) { e.preventDefault(); go(current() - 1, true); return; }
      if (e.target.closest && e.target.closest('[data-snh-gal-next]')) { e.preventDefault(); go(current() + 1, true); }
    });

    /* mobile swipe keeps the counter and thumbs honest */
    var raf;
    sectionEl.addEventListener('scroll', function (e) {
      var list = e.target.closest && e.target.closest('[data-snh-gal-list]');
      if (!list || !isMobile()) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () {
        var idx = Math.round(list.scrollLeft / Math.max(1, list.clientWidth));
        if (idx !== current()) go(idx, false);
      });
    }, true);

    /* follow the flavour / variant picker */
    function syncToVariant() {
      var g = gal();
      if (!g) return;
      var input = sectionEl.querySelector('form [name="id"]');
      if (!input || !input.value) return;
      var mediaId = SNH_VARIANT_MEDIA[String(input.value)];
      if (!mediaId) return;
      var slide = g.querySelector('[data-media-id="' + mediaId + '"]');
      if (slide) go(Number(slide.dataset.index), true);
    }
    sectionEl.addEventListener('change', function () { setTimeout(syncToVariant, 80); });
    document.documentElement.addEventListener('variant:change', function () { setTimeout(syncToVariant, 80); });

    /* keyboard on desktop */
    sectionEl.addEventListener('keydown', function (e) {
      if (isMobile() || !gal()) return;
      if (e.target.closest && e.target.closest('input, textarea, select')) return;
      if (e.key === 'ArrowLeft') go(current() - 1, true);
      else if (e.key === 'ArrowRight') go(current() + 1, true);
    });

    /* set initial index from the server-rendered active slide */
    (function init() {
      var g = gal();
      if (!g) return;
      var active = g.querySelector('[data-snh-slide].is-active');
      go(active ? Number(active.dataset.index) : 0, false);
    })();
  })();

  var SNH_VARIANT_STOCK = {
