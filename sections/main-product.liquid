  function snhDetectBenefits() {
    var hay = ((SNH_PRODUCT.type || '') + ' ' + (SNH_PRODUCT.tags || []).join(' ') + ' ' + (SNH_PRODUCT.title || '')).toLowerCase();
    var map = [
      ['creatine', 'creatine'],
      ['whey', 'protein'], ['protein', 'protein'], ['isolate', 'protein'], ['casein', 'protein'],
      ['pre-workout', 'preworkout'], ['pre workout', 'preworkout'], ['preworkout', 'preworkout'], ['pump', 'preworkout'],
      ['bcaa', 'bcaa'], ['eaa', 'bcaa'], ['amino', 'bcaa'], ['intra', 'bcaa'],
      ['carnitine', 'fatburner'], ['fat burn', 'fatburner'], ['thermo', 'fatburner'], ['cla', 'fatburner'],
      ['omega', 'omega'], ['fish oil', 'omega'], ['epa', 'omega'], ['dha', 'omega'],
      ['vitamin', 'vitamin'], ['multivit', 'vitamin'], ['zinc', 'vitamin'], ['magnesium', 'vitamin'], ['d3', 'vitamin'],
    ];
    for (var i = 0; i < map.length; i++) {
      if (hay.indexOf(map[i][0]) > -1) return SNH_BENEFIT_LIBRARY[map[i][1]];
    }
    return SNH_BENEFIT_LIBRARY._default;
  }

  function injectKeyBenefits() {
    var info = document.querySelector('#shopify-section-{{ section.id }} .product-info');
    if (!info || info.querySelector('.snh-benefits')) return;

    var items;
    if (SNH_PRODUCT.highlights && SNH_PRODUCT.highlights.length) {
      items = SNH_PRODUCT.highlights.map(function (h) {
        var parts = String(h).split('|');
        return { t: (parts[0] || '').trim(), s: (parts[1] || '').trim() };
      });
    } else {
      items = snhDetectBenefits();
