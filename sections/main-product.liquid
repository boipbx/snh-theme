    }
    var anchor3 = (st3 && st3.isConnected) ? st3 : tl3;
    var pb3 = block('.price-list, [class*="price" i]');
    if (pb3 && anchor3 && pb3 !== tb3 && !pb3.classList.contains('snh-payrow') && !pb3.querySelector('h1, variant-picker, buy-buttons') && anchor3.nextElementSibling !== pb3) {
      anchor3.insertAdjacentElement('afterend', pb3);
