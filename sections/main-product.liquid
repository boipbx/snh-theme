{%- comment -%}
  ══════════════════════════════════════════════════════════════════
  SNH — main-product patch 01
  Paste this WHOLE block at the very bottom of sections/main-product.liquid
  (after everything else). Nothing above it needs to change.

  1. Sold-out flavours: light ash pill, struck through, diagonal slash,
     small SOLD OUT corner tag — readable but clearly unbuyable.
  2. Mobile: the double side gutter (theme container + our own) is
     collapsed to a single tight 12px inset.
  3. Mobile: the desktop thumbnail rail now appears on mobile too, as a
     small vertical column floated over the right edge of the image.
  ══════════════════════════════════════════════════════════════════
{%- endcomment -%}

<style>
  /* ══ 1 · SOLD-OUT FLAVOUR PILLS ══════════════════════════════════
     Impact marks unavailable options three different ways depending on
     version (disabled input inside the label, aria-disabled, or a class),
     so all three are matched. */
  #shopify-section-{{ section.id }} variant-picker label:has(input:disabled),
  #shopify-section-{{ section.id }} variant-picker label[aria-disabled="true"],
  #shopify-section-{{ section.id }} variant-picker label.is-unavailable,
  #shopify-section-{{ section.id }} variant-picker label[data-unavailable],
  #shopify-section-{{ section.id }} variant-picker input:disabled + label,
  #shopify-section-{{ section.id }} .product-info .block-swatch:has(input:disabled) {
    position: relative !important;
    overflow: visible !important;
    background: #f4f2ee !important;
    border-color: #e9e4dc !important;
    border-width: 1.5px !important;
    color: #b2a99f !important;
    font-weight: 500 !important;
    text-decoration: line-through !important;
    text-decoration-thickness: 1px !important;
    text-decoration-color: rgba(23, 19, 15, 0.26) !important;
    cursor: not-allowed !important;
    opacity: 1 !important;
  }

  /* hairline slash across the pill */
  #shopify-section-{{ section.id }} variant-picker label:has(input:disabled)::before,
  #shopify-section-{{ section.id }} variant-picker label[aria-disabled="true"]::before,
  #shopify-section-{{ section.id }} variant-picker label.is-unavailable::before,
  #shopify-section-{{ section.id }} variant-picker input:disabled + label::before,
  #shopify-section-{{ section.id }} .product-info .block-swatch:has(input:disabled)::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(to top right, transparent calc(50% - 0.7px), rgba(23, 19, 15, 0.13) 50%, transparent calc(50% + 0.7px));
    pointer-events: none;
  }

  /* SOLD OUT corner tag */
  #shopify-section-{{ section.id }} variant-picker label:has(input:disabled)::after,
  #shopify-section-{{ section.id }} variant-picker label[aria-disabled="true"]::after,
  #shopify-section-{{ section.id }} variant-picker label.is-unavailable::after,
  #shopify-section-{{ section.id }} variant-picker input:disabled + label::after,
  #shopify-section-{{ section.id }} .product-info .block-swatch:has(input:disabled)::after {
    content: 'Sold out';
    position: absolute;
    top: -8px;
    right: -5px;
    z-index: 2;
    padding: 2px 7px 2.5px;
    border-radius: 99px;
    background: var(--snh-ink);
    color: #ffffff;
    font-family: var(--snh-font-body);
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.09em;
    line-height: 1.35;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    pointer-events: none;
  }

  /* room for the corner tag so it never clips the row above */
  #shopify-section-{{ section.id }} variant-picker fieldset,
  #shopify-section-{{ section.id }} variant-picker .variant-picker__option-values,
  #shopify-section-{{ section.id }} variant-picker [class*="option-values"] {
    padding-block-start: 5px !important;
    gap: 13px 8px !important;
    overflow: visible !important;
  }

  /* ══ 3 · MOBILE THUMBNAIL RAIL (right edge, small) ═══════════════ */
  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .snh-gal { position: relative; }

    #shopify-section-{{ section.id }} .snh-gal__thumbs {
      display: flex !important;
      position: absolute;
      z-index: 4;
      inset-block-start: 10px;
      inset-inline-end: 10px;
      flex-direction: column;
      gap: 6px;
      inline-size: 46px;
      max-block-size: calc(100% - 46px);
      padding: 0;
      overflow-y: auto;
      overflow-x: hidden;
      scroll-snap-type: y proximity;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(#000 0, #000 calc(100% - 20px), transparent 100%);
      mask-image: linear-gradient(#000 0, #000 calc(100% - 20px), transparent 100%);
    }
    #shopify-section-{{ section.id }} .snh-gal__thumbs::-webkit-scrollbar { display: none; }

    #shopify-section-{{ section.id }} .snh-gal__thumb {
      inline-size: 46px;
      border-width: 1px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.9);
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
      box-shadow: 0 1px 4px rgba(23, 19, 15, 0.06);
      scroll-snap-align: start;
    }
    #shopify-section-{{ section.id }} .snh-gal__thumb.is-active {
      border-color: var(--snh-orange, var(--snh-accent));
      background: #ffffff;
    }

    /* ══ 2 · MOBILE SIDE GUTTER ════════════════════════════════════
       The theme puts a container gutter on the section AND we added one on
       .product-info — that stacked inset is the wide empty margin. One
       tight gutter now, owned by .product-info alone. */
    #shopify-section-{{ section.id }} .section,
    #shopify-section-{{ section.id }} .section > .product,
    #shopify-section-{{ section.id }} .product {
      padding-inline: 0 !important;
      margin-inline: 0 !important;
      max-inline-size: 100% !important;
    }
    #shopify-section-{{ section.id }} .product-info {
      padding-inline: 12px !important;
      max-inline-size: 100% !important;
    }
    /* the topline had no room to sit on one line at the old inset */
    #shopify-section-{{ section.id }} .product-info .snh-topline { gap: 5px 10px; }
    #shopify-section-{{ section.id }} .product-info .snh-topline .jdgm-prev-badge { flex-wrap: nowrap !important; }
  }
</style>

<script>
(function () {
  'use strict';
  var sectionEl = document.querySelector('#shopify-section-{{ section.id }}');
  if (!sectionEl || sectionEl.dataset.snhPatch01) return;
  sectionEl.dataset.snhPatch01 = '1';

  /* Keep the active thumbnail in view in BOTH rails. The gallery's own
     centring used scrollIntoViewIfNeeded and skipped mobile entirely — now
     that mobile has a rail it needs it, and scrolling the rail directly
     never disturbs the page. Watching the class means this works however
     the change was triggered: tap, swipe, arrow or variant change. */
  function centreActive(rail) {
    var active = rail.querySelector('.snh-gal__thumb.is-active');
    if (!active) return;
    var vertical = window.matchMedia('(max-width: 999px)').matches;
    if (vertical) {
      var top = active.offsetTop - (rail.clientHeight / 2) + (active.offsetHeight / 2);
      rail.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    } else {
      var left = active.offsetLeft - (rail.clientWidth / 2) + (active.offsetWidth / 2);
      rail.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
    }
  }

  function bind() {
    var rail = sectionEl.querySelector('[data-snh-gal-thumbs]');
    if (!rail || rail.dataset.snhCentre) return;
    rail.dataset.snhCentre = '1';
    var t;
    new MutationObserver(function () {
      clearTimeout(t);
      t = setTimeout(function () { centreActive(rail); }, 60);
    }).observe(rail, { attributes: true, attributeFilter: ['class'], subtree: true });
    centreActive(rail);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bind);
  } else {
    bind();
  }
  /* the theme re-renders the gallery on variant change — re-bind then */
  document.addEventListener('shopify:section:load', bind);
  document.documentElement.addEventListener('variant:change', function () {
    setTimeout(bind, 120);
  });
})();
</script>
