  function injectPointsBanner() {
    var info = document.querySelector('#shopify-section-{{ section.id }} .product-info');
    if (!info) return;
    var priceEl = null;
    var cands = info.querySelectorAll('[class*="price" i]');
    for (var i = 0; i < cands.length; i++) {
      var tx = cands[i].textContent || '';
      if (/\d/.test(tx) && /rs/i.test(tx)) { priceEl = cands[i]; break; }
    }
    if (!priceEl) return;
    var m = (priceEl.textContent || '').replace(/,/g, '').match(/(\d+(?:\.\d+)?)/);
    if (!m) return;
    var price = parseFloat(m[1]);
    if (!price) return;
    var fmt = function (n) { return Math.round(n).toLocaleString('en-US'); };

    var el = info.querySelector('.snh-points-banner');
    if (!el) {
      el = document.createElement('button');
      el.type = 'button';
      el.className = 'snh-points-banner';
      var anchor = info.querySelector(
        '[class*="koko" i], [id*="koko" i], [class*="installment" i], shopify-payment-terms'
      );
      var target = anchor || priceEl.closest('div') || priceEl;
      if (anchor) {
        var aBlock = anchor; while (aBlock.parentElement && aBlock.parentElement !== info) aBlock = aBlock.parentElement;
        if (!aBlock.classList.contains('snh-payrow')) aBlock.classList.add('snh-payrow');
        aBlock.appendChild(el);
      } else {
        target.insertAdjacentElement('afterend', el);
      }
      el.addEventListener('click', function () { snhOpenModal('elite'); });
    }
    var ph = el.parentElement;
    if (ph && ph !== info && !ph.classList.contains('snh-payrow') && ph.querySelector('[class*="koko" i], [class*="installment" i], shopify-payment-terms')) ph.classList.add('snh-payrow');
    var phtml =
      '<span class="snh-tile" aria-hidden="true">' + snhIcon('zap') + '</span>' +
      '<span class="snh-points-text">Earn <b>' + fmt(price * SNH_CONFIG.rates[0] / 100) + ' to ' + fmt(price * SNH_CONFIG.rates[2] / 100) +
      '</b> SNH points on this order</span>' +
      '<span class="snh-points-arrow" aria-hidden="true">\u203a</span>';
    if (el.__snhHtml !== phtml) { el.__snhHtml = phtml; el.innerHTML = phtml; }
  }

  function enhanceWhatsApp() {
    var links = document.querySelectorAll(
      '#shopify-section-{{ section.id }} a[href*="wa.me" i], #shopify-section-{{ section.id }} a[href*="whatsapp" i]'
    );
    Array.prototype.forEach.call(links, function (a) {
      if (a.dataset.snhWa) return;
      a.dataset.snhWa = '1';
      try {
        var u = new URL(a.href);
        if (!u.searchParams.get('text')) {
          u.searchParams.set('text', 'Hi SNH! I\u2019d like to order: ' + SNH_PRODUCT.title + ' ' + SNH_PRODUCT.url);
          a.href = u.toString();
        }
      } catch (e) { /* relative or malformed href — leave it */ }
    });
  }

  /* Runs inside a MutationObserver callback, i.e. before the browser paints the
     re-rendered picker — the duplicated "Flavor: Unflavored" value never shows. */
  function snhTrimCaptions(scope) {
    if (!scope) return;
    scope.querySelectorAll('variant-picker legend, variant-picker [class*="option-name" i], variant-picker [class*="option-info" i], variant-picker [class*="option-label" i]').forEach(function (cap) {
      if (cap.querySelector('input, label, button, variant-picker')) return;
      var txt = (cap.textContent || '').replace(/\s+/g, ' ').trim();
      var ci = txt.indexOf(':');
      if (ci > -1 && ci < txt.length - 1) cap.textContent = txt.slice(0, ci + 1);
      cap.setAttribute('data-snh-cap', '');
    });
  }
  (function () {
    var host = document.querySelector('#shopify-section-{{ section.id }}');
    if (!host || !window.MutationObserver) return;
    snhTrimCaptions(host);
    new MutationObserver(function () { snhTrimCaptions(host); })
      .observe(host, { childList: true, subtree: true, characterData: true });
    /* safety: never leave a caption invisible if the observer never fires */
    setTimeout(function () {
      host.querySelectorAll('variant-picker legend, variant-picker [class*="option-name" i]').forEach(function (c) { c.setAttribute('data-snh-cap', ''); });
    }, 800);
  })();

  function snhFixSwatchBorders() {
    var info = document.querySelector('#shopify-section-{{ section.id }} .product-info');
    if (!info) return;
    var labels = info.querySelectorAll('.block-swatch, .block-swatch__item, [class*="swatch" i] label, .variant-picker__option-values label');
    labels.forEach(function (lbl) {
      var input = lbl.querySelector('input') || (lbl.previousElementSibling && lbl.previousElementSibling.matches('input') ? lbl.previousElementSibling : null);
      var checked = (input && input.checked) || lbl.getAttribute('aria-checked') === 'true' || lbl.classList.contains('is-selected');
      var target = (input && input.checked && lbl.tagName === 'INPUT') ? lbl.nextElementSibling : lbl;
      if (!target) target = lbl;
      var flag = checked ? 'on' : 'off';
      if (target.dataset.snhBfix === flag) return; // already applied — avoids observer loop
      target.dataset.snhBfix = flag;
      if (checked) {
        target.style.setProperty('border', '1px solid var(--snh-dark)', 'important');
        target.style.setProperty('outline', 'none', 'important');
        target.style.setProperty('box-shadow', 'none', 'important');
      } else {
        target.style.removeProperty('border');
        target.style.removeProperty('outline');
        target.style.removeProperty('box-shadow');
      }
    });
  }

  function watchVariant() {
    var section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section || section.dataset.snhVarWatch) return;
    section.dataset.snhVarWatch = '1';
    var handler = function () {
      setTimeout(function () {
        var input = section.querySelector('form[action*="/cart/add"] [name="id"], [name="id"]');
        if (input) {
          var idx = SNH_VARIANT_MEDIA[String(input.value)];
          if (typeof idx === 'number') snhGoToSlide(idx);
        }
        injectPointsBanner();
        enhanceWhatsApp();
        fixVendorLink();
        restructureInfo();
        initBundleBox();
        snhFixSwatchBorders();
      }, 120);
    };
    section.addEventListener('change', handler);
    section.addEventListener('click', function () { setTimeout(snhFixSwatchBorders, 30); });
    document.addEventListener('variant:change', handler);
  }

  var snhBxBar;
  function snhShowQuietBar(cart) {
    if (!snhBxBar || !snhBxBar.isConnected) {
      snhBxBar = document.createElement('div');
      snhBxBar.className = 'snh-bxbar';
      snhBxBar.setAttribute('role', 'status');
      document.body.appendChild(snhBxBar);
      snhBxBar.addEventListener('click', function () {
        snhBxBar.classList.remove('is-visible');
        if (document.querySelector('cart-drawer[data-snh-elite]')) {
          document.dispatchEvent(new CustomEvent('variant:add', { bubbles: true }));
        } else {
          window.location.href = '/cart';
        }
      });
      document.addEventListener('variant:add', function () {
        snhBxBar.classList.remove('is-visible');
      });
    }
    snhBxBar.innerHTML =
      '<span class="snh-bxbar-check" aria-hidden="true">' + snhIcon('check') + '</span>' +
      '<span class="snh-bxbar-text">Bundle added \u00b7 ' + cart.item_count + ' item' + (cart.item_count === 1 ? '' : 's') + ' in basket</span>' +
      '<button type="button" class="snh-bxbar-btn">View basket</button>';
    requestAnimationFrame(function () { snhBxBar.classList.add('is-visible'); });
  }

  function initBundleBox() {
    var srcWrap = document.querySelector('[data-snh-bundle-src]');
    var box = (srcWrap && srcWrap.querySelector('[data-snh-bx]')) || window.__snhBxBox || null;
    if (!box) return;
    window.__snhBxBox = box;
    var info = document.querySelector('#shopify-section-{{ section.id }} .product-info');
    var buy = info && info.querySelector('buy-buttons, .product-form__buttons');
    if (!buy) return;
    var waDock = info.querySelector('[data-snh-wa-block]');
    var dockAfter = (waDock && waDock.parentElement === buy.parentElement) ? waDock : buy;
    if (dockAfter.nextElementSibling !== box) dockAfter.insertAdjacentElement('afterend', box);
    if (srcWrap && srcWrap.parentElement) srcWrap.remove();
    if (box.dataset.snhWired) return;
    box.dataset.snhWired = '1';
    var head = box.querySelector('[data-bx-toggle]');
    if (head) {
      if (window.matchMedia('(max-width: 999px)').matches) {
        box.classList.add('is-collapsed');
        head.setAttribute('aria-expanded', 'false');
      }
      head.addEventListener('click', function () {
        var closed = box.classList.toggle('is-collapsed');
        head.setAttribute('aria-expanded', closed ? 'false' : 'true');
      });
    }
    var panels = box.querySelectorAll('[data-bx-panel]');
    var pills = box.querySelector('[data-bx-pills]');
    if (panels.length > 1 && pills) {
      pills.hidden = false;
      Array.prototype.forEach.call(panels, function (p, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'snh-bx-pill' + (i === 0 ? ' is-on' : '');
        b.textContent = p.getAttribute('data-bx-title') || ('Offer ' + (i + 1));
        b.addEventListener('click', function () {
          Array.prototype.forEach.call(panels, function (pp, j) { pp.hidden = j !== i; });
          Array.prototype.forEach.call(pills.children, function (x) { x.classList.remove('is-on'); });
          b.classList.add('is-on');
        });
        pills.appendChild(b);
      });
    }

    box.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('[data-bx-add]') : null;
      if (!btn || btn.disabled) return;
      var panel = btn.closest('[data-bx-panel]');
      var items = [];
      var mainForm = document.getElementById('{{ product_form_id }}');
      var main = (mainForm && mainForm.querySelector('[name="id"]')) ||
        document.querySelector('#shopify-section-{{ section.id }} form[action*="/cart/add"] [name="id"]');
      if (main && main.value) items.push({ id: Number(main.value), quantity: 1 });
      Array.prototype.forEach.call(panel.querySelectorAll('[data-bx-variant]'), function (s) {
        if (s.value) items.push({ id: Number(s.value), quantity: 1 });
      });
      if (!items.length) return;
      btn.disabled = true;
      var prev = btn.innerHTML;
      fetch({{ routes.cart_add_url | append: '.js' | json }}, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
        .then(function () { return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }); })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          document.querySelectorAll('cart-count, [data-cart-count]').forEach(function (el) { el.textContent = cart.item_count; });
          snhShowQuietBar(cart);
          btn.innerHTML = '\u2713 Added \u2014 discount applies at checkout';
          setTimeout(function () { btn.innerHTML = prev; btn.disabled = false; }, 2600);
        })
        .catch(function () { btn.innerHTML = prev; btn.disabled = false; });
    });
  }

  /* ── stock pill: resolve the real state of the SELECTED variant ───────────
     Order of trust: Liquid variant record → the buy button (survives theme
     re-renders) → the theme's inventory line (wording only, never to un-sell). */
  var SNH_OUT_RE = /sold\s*out|out[\s\-]*of[\s\-]*stock|unavailable|notify me|coming soon|back in stock/i;
  var SNH_LOW_RE = /low stock|only|left|few|selling fast|hurry/i;

  function snhSelectedVariantId() {
    var form = document.getElementById('{{ product_form_id }}');
    var input = (form && form.querySelector('[name="id"]')) ||
      document.querySelector('#shopify-section-{{ section.id }} form[action*="/cart/add"] [name="id"]') ||
      document.querySelector('#shopify-section-{{ section.id }} [name="id"]');
    return (input && input.value) ? String(input.value).trim() : '';
  }

  function snhStockState(info) {
    var st = { out: false, low: false, text: '' };

    /* 1. Liquid record for the variant currently in the form */
    var id = snhSelectedVariantId();
    var v = id ? SNH_VARIANT_STOCK[id] : null;
    if (v) {
      if (!v.a) {
        st.out = true;
      } else if (v.m === 'shopify' && SNH_LOW_STOCK_AT > 0 && v.q > 0 && v.q <= SNH_LOW_STOCK_AT) {
        st.low = true;
        st.text = 'Only ' + v.q + ' left';
      }
    } else if (SNH_PRODUCT_AVAILABLE === false) {
      st.out = true;
    }

    /* 2. The buy button is re-rendered by the theme on every variant change */
    var btn = info && info.querySelector('buy-buttons button[type="submit"], button[name="add"], .product-form__submit');
    if (btn && SNH_OUT_RE.test((btn.textContent || '').replace(/\s+/g, ' '))) st.out = true;

    /* 3. The theme's own inventory line, when the block exists, wins on wording */
    var tl = info && info.querySelector('.snh-topline');
    var inv = '';
    if (info) {
      info.querySelectorAll('[class*="inventory" i]').forEach(function (el) {
        if (tl && tl.contains(el)) return;
        var t = (el.textContent || '').replace(/\s+/g, ' ').trim();
        if (t) inv = t;
      });
    }
    if (inv) {
      if (SNH_OUT_RE.test(inv)) st.out = true;
      else if (!st.out) { st.text = inv; st.low = SNH_LOW_RE.test(inv); }
    }

    if (st.out) { st.text = 'Sold out'; st.low = false; }
    else if (!st.text) { st.text = 'In stock'; }
    return st;
  }

  function snhApplyStockPill(pill, info) {
    if (!pill) return;
    var st = snhStockState(info);
    if (pill.textContent !== st.text) pill.textContent = st.text;
    pill.classList.toggle('is-out', st.out);
    pill.classList.toggle('is-low', !st.out && st.low);
  }


  /* ── v2 layout (prototype buy box): runs after restructureInfo() on every pass. It only moves/labels existing
     pieces; the order itself is CSS `order`, so it never fights restructureInfo's own order assertions. ── */
  function v2Layout(info) {
    if (!info) return;
    var sec = document.getElementById('shopify-section-{{ section.id }}');
    if (!info.classList.contains('v2-info')) info.classList.add('v2-info');
    function top(el) { while (el && el.parentElement && el.parentElement !== info) el = el.parentElement; return el && el.parentElement === info ? el : null; }
    function ord(sel, o) { var el = info.querySelector(sel); var t = el && (el.parentElement === info ? el : top(el)); if (t && t.style.order !== String(o)) t.style.order = o; return t; }
    /* pieces restructureInfo nested inside other blocks come up to the buy-box level */
    ['.snh-benefits', '.snh-adv', '.snh-desc', '.snh-desc-more'].forEach(function (s) { var el = info.querySelector(s); if (el && el.parentElement !== info) info.appendChild(el); });
    /* key benefits stored as one multi-line value → one tick per line, like the prototype (once per render) */
    var bl = info.querySelector('.snh-benefits');
    if (bl && !bl.dataset.v2Split) {
      bl.dataset.v2Split = '1';
      bl.querySelectorAll('.snh-benefit').forEach(function (it) {
        var txt = it.querySelector('.snh-benefit-text');
        if (!txt) return;
        var lines = txt.innerText.split(/\n+/).map(function (x) { return x.trim(); }).filter(Boolean);
        if (lines.length < 2) return;
        lines.forEach(function (line) {
          var c = it.cloneNode(true);
          var t = c.querySelector('.snh-benefit-text');
          t.innerHTML = '';
          var b = document.createElement('b'); b.textContent = line; t.appendChild(b);
          it.parentElement.insertBefore(c, it);
        });
        it.remove();
      });
    }
    /* matched bundle box */
    var src = sec && sec.querySelector('[data-v2-bundle-src] .bx');
    if (src) info.appendChild(src);
    /* perks row: Koko pill + points pill, under the price (re-done after each variant re-render) */
    var pay = info.querySelector('.snh-payrow');
    if (pay) {
      var perks = pay.querySelector('.v2-perks');
      if (!perks) { perks = document.createElement('div'); perks.className = 'v2-perks'; pay.appendChild(perks); }
      var fresh = pay.querySelector('.price-list .koko-pdp-message');
      if (fresh) { var old = perks.querySelector('.koko-pdp-message'); if (old) old.remove(); perks.insertBefore(fresh, perks.firstChild); }
      var pts = pay.querySelector('.snh-points-banner');
      if (pts && pts.parentElement !== perks) perks.appendChild(pts);
      /* per serving, from the selected size ("61 Servings") */
      var sale = pay.querySelector('sale-price');
      var sizeLab = info.querySelector('variant-picker input:checked + label.block-swatch');
      var sv = 0;
      info.querySelectorAll('variant-picker input:checked + label').forEach(function (l) { var m = l.textContent.match(/(\d+)\s*serv/i); if (m) sv = Number(m[1]); });
      var per = pay.querySelector('.v2-per');
      if (sale && sv > 1) {
        var amt = Number((sale.textContent.match(/[\d,]+(\.\d+)?/g) || ['0']).pop().replace(/,/g, ''));
        if (!per) { per = document.createElement('span'); per.className = 'v2-per'; sale.insertAdjacentElement('afterend', per); }
        var perTxt = 'Rs ' + Math.round(amt / sv).toLocaleString('en-US') + ' per serving';
        if (per.textContent !== perTxt) per.textContent = perTxt;
      } else if (per) per.remove();
    }
    /* variants: flavour first, "IS" tag for Informed-Sport tested values, in-stock count in the caption */
    var vp = info.querySelector('variant-picker');
    if (vp) {
      vp.querySelectorAll('fieldset').forEach(function (fs) {
        var cap = fs.querySelector('.variant-picker__option-info');
        var name = cap ? cap.textContent : '';
        var isFlav = /flavo/i.test(name);
        var fo = isFlav ? '-1' : '0';
        if (fs.style.order !== fo) fs.style.order = fo;
        fs.querySelectorAll('label.block-swatch').forEach(function (l) {
          if (l.dataset.v2) return;
          l.dataset.v2 = '1';
          var t = l.firstChild && l.firstChild.nodeType === 3 ? l.firstChild : null;
          var txt = l.textContent;
          if (/ - Informed-Sport Tested/i.test(txt)) {
            var tw = document.createTreeWalker(l, NodeFilter.SHOW_TEXT), tn;
            while ((tn = tw.nextNode())) { if (/ - Informed-Sport Tested/i.test(tn.nodeValue)) tn.nodeValue = tn.nodeValue.replace(/ - Informed-Sport Tested/i, ''); }
            var is = document.createElement('span'); is.className = 'vpill__is'; is.title = 'Informed Sport tested'; is.textContent = 'IS'; l.appendChild(is);
          }
          if (l.classList.contains('is-disabled')) { var o = document.createElement('span'); o.className = 'vpill__out'; o.textContent = 'Sold out'; l.appendChild(o); }
        });
        /* in-stock count as a data attribute drawn by CSS: snhTrimCaptions() owns the caption text (its observer
           resets it), so writing a node into the caption would ping-pong with it forever */
        if (cap && isFlav) {
          var all = fs.querySelectorAll('label.block-swatch').length, out = fs.querySelectorAll('label.block-swatch.is-disabled').length;
          var cnt = ' · ' + (all - out) + ' of ' + all + ' in stock';
          if (cap.getAttribute('data-v2-count') !== cnt) cap.setAttribute('data-v2-count', cnt);
        }
      });
    }
    /* order = the prototype buy box */
    ord('.product-info__title', 1); ord('.snh-topline', 2); ord('.snh-subtitle', 3); ord('.snh-payrow', 4);
    ord('variant-picker', 5); ord('.popt', 6); ord('quantity-selector', 7); ord('buy-buttons', 8); ord('[data-snh-wa-block]', 9);
    ord('.bx', 10); ord('.snh-benefits', 11); ord('.snh-adv', 12); ord('.snh-desc', 13); ord('.snh-desc-more', 14);
    /* accordions → the full-width "The details" band under the grid */
    var acc = info.querySelector('.accordion-group, .product-info__block-group');
    var band = sec && sec.querySelector('[data-v2-details]');
    var slot = band && band.querySelector('[data-v2-details-slot]');
    if (acc && slot && !slot.contains(acc)) {
      slot.appendChild(acc);
      band.hidden = false;
      var grid = sec.querySelector('.product');
      var host = grid && grid.parentElement;
      if (host && band.previousElementSibling !== host) host.insertAdjacentElement('afterend', band);
      var firstAcc = acc.querySelector('details'); if (firstAcc && !acc.dataset.v2Opened) { acc.dataset.v2Opened = '1'; firstAcc.open = true; }
    }
    /* Appstle's own widget wins: hide the theme purchase options if it is on the page */
    var appstle = sec && sec.querySelector('[class*="appstle" i]:not(.popt)');
    var popt = info.querySelector('.popt');
    if (appstle && popt) popt.hidden = true;
  }

  function restructureInfo() {
    var info = document.querySelector('#shopify-section-{{ section.id }} .product-info');
    if (!info) return;
    var block = function (sel) {
      var el = info.querySelector(sel);
      while (el && el.parentElement && el.parentElement !== info) el = el.parentElement;
      return el;
    };
    /* breadcrumbs: dock above the product grid once */
    if (!document.body.dataset.snhCrumbs) {
      var cr = document.querySelector('[data-snh-crumbs]');
      var prodRoot = info.closest('.product');
      if (cr && prodRoot && prodRoot.parentElement) {
        document.body.dataset.snhCrumbs = '1';
        cr.hidden = false;
        prodRoot.parentElement.insertBefore(cr, prodRoot);
      }
    }
    /* Flavour/size pills are pure CSS now — name only, no icons, no injection.
       Caption lines keep just "Size:" / "Flavour:" — the selected value is
       already on the highlighted pill, so repeating it is noise. */
    snhTrimCaptions(info);
    /* every pass: one review row (the topline's); sync our stock pill from the hidden theme row */
    var tl = info.querySelector('.snh-topline');
    if (tl) {
      info.querySelectorAll('[class*="rating" i], .jdgm-prev-badge, [class*="jdgm-prev" i]').forEach(function (el) {
        if (tl.contains(el) || el.contains(tl)) return;
        if (el.querySelector('.price-list, sale-price, compare-at-price, variant-picker, buy-buttons, form, [name="id"]')) return;
        if (el.style.getPropertyValue('display') !== 'none') el.style.setProperty('display', 'none', 'important');
      });
      snhApplyStockPill(tl.querySelector('.snh-stock-pill'), info);
    }
    if (!info.querySelector('.snh-topline')) {
      var titleEl = info.querySelector('.product-title, h1');
      var titleBlock = block('.product-title, h1');
      var vendorEl = info.querySelector('.snh-vendor');
      if (titleEl && titleBlock && vendorEl) {
        var topline = document.createElement('div');
        topline.className = 'snh-topline';
        info.insertBefore(topline, info.firstElementChild);
        topline.appendChild(vendorEl);
        var badge = info.querySelector('.jdgm-prev-badge');
        if (badge) {
          var rate = document.createElement('a');
          rate.className = 'snh-rating';
          rate.href = '#judgeme_product_reviews';
          rate.appendChild(badge);
          topline.appendChild(rate);
        }
        var pill0 = document.createElement('span');
        pill0.className = 'snh-stock-pill';
        snhApplyStockPill(pill0, info);
        topline.appendChild(pill0);
        var st = document.querySelector('[data-snh-subtitle]');
        var hasSub = !!(st && st.textContent.trim());
        if (hasSub) { st.hidden = false; st.classList.add('snh-subtitle'); }
        var priceBlock = block('.price-list, [class*="price" i]');
        var canMovePrice = priceBlock && priceBlock !== titleBlock && !priceBlock.querySelector('h1, variant-picker, buy-buttons');
