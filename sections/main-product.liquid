  function fixVendorLink() {
    var info = document.querySelector('#shopify-section-{{ section.id }} .product-info');
    if (!info || info.querySelector('.snh-vendor')) return;
    var name = String(SNH_PRODUCT.vendor || '').trim().toLowerCase();

    var v = info.querySelector('.vendor, [class*="vendor" i]') ||
            info.querySelector('a[href*="vendors" i]');
    if (!v && name) {
      var els = info.querySelectorAll('a, span, p, div, h6');
      var best = null;
      for (var i = 0; i < els.length; i++) {
        var t = (els[i].textContent || '').trim().toLowerCase();
        if ((t === name || t === 'by ' + name) &&
            (!best || els[i].children.length < best.children.length)) {
          best = els[i];
        }
      }
      v = best;
    }
    if (!v) return;

    var key = name.replace(/[^a-z0-9]/g, '');
    var logo = SNH_BRAND_LOGOS[key] || SNH_BRAND_LOGOS[SNH_BRAND_ALIASES[key]];
    var wrap = document.createElement('div');
    wrap.className = 'snh-vendor';
    if (logo) {
      wrap.innerHTML =
        '<span>By</span><a class="snh-brand-link" href="' + SNH_PRODUCT.vendorUrl +
        '" aria-label="Shop all ' + SNH_PRODUCT.vendor + '">' +
        '<img class="snh-brand-logo" src="' + logo + '" alt="' + SNH_PRODUCT.vendor +
        '" loading="lazy" onerror="this.parentNode.className=\'snh-brand-link snh-brand-text\';this.parentNode.textContent=' +
        JSON.stringify(SNH_PRODUCT.vendor) + ';"></a>';
    } else {
      wrap.innerHTML =
        '<span>By</span><a class="snh-brand-link snh-brand-text" href="' + SNH_PRODUCT.vendorUrl + '">' +
        SNH_PRODUCT.vendor + '</a>';
    }
    v.parentNode.replaceChild(wrap, v);
  }

