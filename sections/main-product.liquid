      max-width: 100% !important;
      min-width: 0 !important;
      min-height: auto !important;
      flex: unset !important;
    }

    .jdgm-rev-widg {
      width: min(100% - 24px, 100%) !important;
      padding: 22px !important;
      border-radius: 18px !important;
      margin-block: 46px !important;
    }

    .jdgm-rev-widg__header {
      grid-template-columns: 1fr !important;
      align-items: start !important;
    }

    .jdgm-rev-widg__title {
      font-size: clamp(2rem, 11vw, 3.2rem) !important;
    }

    .wk-tiktok__header,
    .wk-tiktok__panel {
      grid-template-columns: 1fr !important;
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ─── Tablet (700–1099px) ──────────────────────────────────────── */
  @media screen and (min-width: 700px) and (max-width: 1099px) {
    .text-with-icons__list,
    .text-with-icons .grid,
    .text-with-icons .multi-column,
    .text-with-icons .multi-column__list {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  /* ─── Desktop (1000px+) ────────────────────────────────────────── */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- assign media_ratio = section.settings.desktop_media_width | divided_by: 50.0 -%}
      --product-grid: auto / minmax(0, {{ media_ratio }}fr) minmax(390px, {{ 2.0 | minus: media_ratio }}fr);
      --product-gallery-media-list-grid: {% if section.settings.desktop_media_layout contains 'grid' %}auto-flow dense / repeat({% if section.settings.desktop_media_layout == 'grid_one' %}1{% else %}2{% endif %}, minmax(0, 1fr)){% else %}auto / auto-flow 100%{% endif %};
      --product-gallery-media-list-gap: clamp(48px, 5vw, 72px);
    }

    #shopify-section-{{ section.id }} .product {
      align-items: start;
    }

    #shopify-section-{{ section.id }} .product-gallery {
      position: sticky;
      inset-block-start: calc(var(--sticky-area-height, 0px) + 34px);
    }

    #shopify-section-{{ section.id }} .product-info {
      justify-self: start;
      padding-top: 14px;
    }

    {%- if section.settings.desktop_media_layout == 'carousel_thumbnails_left' -%}
      #shopify-section-{{ section.id }} .product-gallery {
        display: grid !important;
        grid-template-columns: clamp(66px, 5vw, 84px) minmax(0, 1fr) !important;
        gap: clamp(16px, 1.4vw, 24px) !important;
        align-items: start !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__thumbnail-list-wrapper,
      #shopify-section-{{ section.id }} .product-gallery__thumbnail-list,
      #shopify-section-{{ section.id }} .product-gallery__thumbnail-scroller {
        grid-column: 1 !important;
        grid-row: 1 !important;
        inline-size: 100% !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__media-list-wrapper,
      #shopify-section-{{ section.id }} .product-gallery media-carousel {
        grid-column: 2 !important;
        grid-row: 1 !important;
        inline-size: 100% !important;
        display: block !important;
        min-inline-size: 0 !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__media-list {
        inline-size: 100% !important;
        max-inline-size: 100% !important;
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} .product-gallery__thumbnail-list,
    #shopify-section-{{ section.id }} .product-gallery__thumbnail-scroller,
    #shopify-section-{{ section.id }} .product-gallery__thumbnail-list-wrapper {
      max-block-size: var(--product-gallery-max-height);
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
    }

    #shopify-section-{{ section.id }} .product-gallery__thumbnail-list,
    #shopify-section-{{ section.id }} .product-gallery__thumbnail-scroller {
      overflow-y: auto;
      overflow-x: hidden;
    }

    {%- if section.settings.desktop_media_layout contains 'grid' -%}
      #shopify-section-{{ section.id }} .product-gallery__media-list {
        grid-auto-rows: max-content;
        row-gap: clamp(28px, 2.5vw, 44px) !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__media-list > * {
        grid-column: auto / span 1 !important;
        inline-size: 100%;
        scroll-margin-top: calc(var(--sticky-area-height, 0px) + 24px);
      }

      #shopify-section-{{ section.id }} .product-gallery__media--expand {
        grid-column: auto / span 1 !important;
      }
    {%- else -%}
      #shopify-section-{{ section.id }} .product-gallery__media img,
      #shopify-section-{{ section.id }} .product-gallery__media video,
      #shopify-section-{{ section.id }} .product-gallery__media model-viewer,
      #shopify-section-{{ section.id }} .product-gallery__media iframe {
        block-size: 100%;
      }
    {%- endif -%}

    {%- if section.settings.desktop_media_layout == 'grid_highlight' -%}
      #shopify-section-{{ section.id }} .product-gallery__media-list > :first-child:not([hidden]) {
        grid-column: 1 / -1 !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__media-list > :first-child:not([hidden]) ~ * {
        grid-column: auto / span 1 !important;
      }
    {%- endif -%}
  }

  /* ─── Wider breakpoints ─────────────────────────────────────────── */
  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }} {
      --product-grid: auto / minmax(610px, 1.1fr) minmax(420px, 0.9fr);
    }
  }

  @media screen and (min-width: 1400px) {
    #shopify-section-{{ section.id }} {
      --product-gallery-media-list-gap: clamp(22px, 2vw, 36px);
      --product-column-gap: clamp(48px, 4vw, 78px);
    }
  }

  @media screen and (min-width: 1600px) {
    #shopify-section-{{ section.id }} {
      --product-shell-max-width: 1800px;
      --product-grid: auto / minmax(780px, 1.05fr) minmax(600px, 0.95fr);
    }
  }

  /* ─── Reduced motion ────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .product-info .block-swatch,
    #shopify-section-{{ section.id }} .product-info .block-swatch__item,
    #shopify-section-{{ section.id }} .product-info .variant-picker__option-values label,
    #shopify-section-{{ section.id }} .product-info buy-buttons .button,
    #shopify-section-{{ section.id }} .product-info buy-buttons button[type="submit"],
    #shopify-section-{{ section.id }} .product-info .shopify-payment-button__button,
    #shopify-section-{{ section.id }} .product-info a[href*="wa.me" i],
    #shopify-section-{{ section.id }} .product-info a[href*="whatsapp" i],
    .text-with-icons__item,
    .jdgm-write-rev-link,
    .jdgm-btn,
    .snh-info-row {
      transition: none !important;
      transform: none !important;
    }
  }
  @media screen and (max-width: 999px) {
    .product-gallery__zoom-button,
    [class*="product-gallery"][class*="zoom"] {
      display: none !important;
    }
  }

  /* the theme's three-dot loader sat on top of "ADD TO CART" — show it only
     while the button is actually busy */
  #shopify-section-{{ section.id }} .product-info .button__loader,
  #shopify-section-{{ section.id }} .product-info [class*="loader" i]:not([aria-busy="true"] *) { display: none !important; }
  #shopify-section-{{ section.id }} .product-info [aria-busy="true"] .button__loader { display: flex !important; }

  /* phones: the thumbnail rail floats over the image, on its LEFT edge */
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} .snh-gal { position: relative !important; }
    #shopify-section-{{ section.id }} .snh-gal__thumbs {
      display: flex !important; flex-direction: column !important; gap: 8px !important;
      position: absolute !important; z-index: 4 !important;
      top: 12px !important; left: 12px !important; right: auto !important;
      inline-size: 50px !important;
      max-block-size: calc(100% - 36px); overflow-y: auto !important; overflow-x: hidden !important;
      scroll-snap-type: y proximity;
    }
    #shopify-section-{{ section.id }} .snh-gal__thumb { inline-size: 50px !important; border-radius: 8px !important; box-shadow: 0 2px 8px rgba(23,19,15,.08); }
    #shopify-section-{{ section.id }} .snh-gal--single .snh-gal__thumbs { display: none !important; }
  }

/* ══════════════════════════════════════════════════════════════════
   v2 LAYER (theme v2, phase 5): the prototype product page on the same markup and logic.
   12-column grid (gallery 7 / buy box 5, both sticky), Inter type, white canvas, prototype buy box.
   Everything above stays as the fallback; these rules come last and win.
   ══════════════════════════════════════════════════════════════════ */
#shopify-section-{{ section.id }} { background: #fff !important; --v2-gutter: 24px; }
#shopify-section-{{ section.id }} .section { padding-top: 0 !important; background: #fff !important; }
#shopify-section-{{ section.id }} .snh-crumbs { display: flex !important; flex-wrap: wrap; gap: 8px; max-width: calc(1152px + 48px); margin: 0 auto !important; padding: 16px 24px !important; font: 400 13px/1.4 var(--sans) !important; color: #6E6E6E !important; text-transform: none !important; letter-spacing: 0 !important; background: none !important; }
#shopify-section-{{ section.id }} .snh-crumbs a { color: #6E6E6E !important; font-weight: 400 !important; text-transform: none !important; }
#shopify-section-{{ section.id }} .snh-crumbs a:hover { color: #0C0C0D !important; }
#shopify-section-{{ section.id }} .snh-crumbs [aria-current] { color: #0C0C0D !important; font-weight: 400 !important; text-transform: none !important; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 60vw; }
#shopify-section-{{ section.id }} .product { display: grid !important; grid-template-columns: minmax(0, 1fr) !important; gap: 24px !important; max-width: calc(1152px + 48px) !important; margin: 0 auto !important; padding: 0 24px 56px !important; background: #fff !important; }
@media (min-width: 1024px) {
  #shopify-section-{{ section.id }} .product { grid-template-columns: repeat(12, minmax(0, 1fr)) !important; column-gap: 24px !important; align-items: start !important; padding-bottom: 80px !important; }
  #shopify-section-{{ section.id }} .snh-gal { grid-column: 1 / span 7 !important; position: sticky !important; top: calc(var(--hdr-h, 72px) + 16px) !important; }
  #shopify-section-{{ section.id }} .product-info { grid-column: 8 / span 5 !important; position: sticky !important; top: calc(var(--hdr-h, 72px) + 16px) !important; max-width: none !important; }
}
@media (min-width: 1280px) { #shopify-section-{{ section.id }} .product { column-gap: 32px !important; } #shopify-section-{{ section.id }} .product-info { padding-left: 16px !important; } }

/* gallery: 88px thumb column as tall as the square main image (desktop); full-bleed swipe + thumb strip (mobile) */
#shopify-section-{{ section.id }} .snh-gal { display: grid !important; gap: 12px !important; margin: 0 !important; background: none !important; box-shadow: none !important; padding: 0 !important; }
#shopify-section-{{ section.id }} .snh-gal__stage { position: relative; overflow: hidden !important; border-radius: 8px !important; background: #CDCDCD !important; aspect-ratio: 1 / 1 !important; box-shadow: none !important; border: 0 !important; }
#shopify-section-{{ section.id }} .snh-gal__list { height: 100% !important; }
#shopify-section-{{ section.id }} .snh-gal__slide, #shopify-section-{{ section.id }} .snh-gal__box { height: 100% !important; aspect-ratio: auto !important; background: transparent !important; padding: 0 !important; border: 0 !important; border-radius: 0 !important; }
#shopify-section-{{ section.id }} .snh-gal__box img { width: 100% !important; height: 100% !important; object-fit: cover !important; border-radius: 0 !important; }
#shopify-section-{{ section.id }} .snh-gal__nav, #shopify-section-{{ section.id }} .snh-gal__counter { display: none !important; }
#shopify-section-{{ section.id }} .snh-gal__thumb { padding: 0 !important; border: 1.5px solid transparent !important; border-radius: 8px !important; background: #CDCDCD !important; overflow: hidden !important; box-shadow: none !important; opacity: 1 !important; }
#shopify-section-{{ section.id }} .snh-gal__thumb img { width: 100% !important; height: 100% !important; object-fit: cover !important; }
#shopify-section-{{ section.id }} .snh-gal__thumb.is-active { border-color: #0C0C0D !important; }
@media (min-width: 1024px) {
  #shopify-section-{{ section.id }} .snh-gal { grid-template-columns: 88px minmax(0, 1fr) !important; gap: 16px !important; }
  #shopify-section-{{ section.id }} .snh-gal__stage { grid-column: 2 !important; grid-row: 1 !important; }
  #shopify-section-{{ section.id }} .snh-gal__thumbs { grid-column: 1 !important; grid-row: 1 !important; display: grid !important; grid-auto-rows: 88px !important; grid-template-columns: 88px !important; gap: 12px !important; height: 0 !important; min-height: 100% !important; overflow-y: auto !important; overflow-x: hidden !important; scrollbar-width: thin; padding: 0 2px 0 0 !important; margin: 0 !important; flex-direction: initial !important; }
  #shopify-section-{{ section.id }} .snh-gal__thumb { width: 88px !important; height: 88px !important; }
  #shopify-section-{{ section.id }} .snh-gal__bar { display: none !important; }
}
@media (max-width: 1023px) {
  #shopify-section-{{ section.id }} .snh-gal { margin-inline: -24px !important; }
  #shopify-section-{{ section.id }} .snh-gal__stage { border-radius: 0 !important; order: 2; }
  #shopify-section-{{ section.id }} .snh-gal__thumbs { order: 1; display: flex !important; gap: 8px !important; padding: 10px 24px 0 !important; overflow-x: auto !important; scrollbar-width: none; margin: 0 !important; }
