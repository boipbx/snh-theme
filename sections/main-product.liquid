    {
      var buyEl = info.querySelector('buy-buttons, .product-form__buttons');
      var waEl = info.querySelector('[class*="whatsapp" i], a[href*="wa.me"]');
      if (buyEl && waEl) {
        var buyBlock = buyEl; while (buyBlock.parentElement && buyBlock.parentElement !== info) buyBlock = buyBlock.parentElement;
        var waBlock = waEl; while (waBlock.parentElement && waBlock.parentElement !== info) waBlock = waBlock.parentElement;
