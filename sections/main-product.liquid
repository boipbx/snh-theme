    var horizontal = c.scrollWidth - c.clientWidth > 40;
    if (horizontal) {
      var delta = target.getBoundingClientRect().left - c.getBoundingClientRect().left;
      c.scrollTo({ left: c.scrollLeft + delta, behavior: 'smooth' });
    } else {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
