    dymatize: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_12.png?v=1763121072',
    // ─── ADD MORE BRAND LOGOS HERE ───────────────────────────────
    // For each brand whose logo shows as text only, add a line:
    //   vendorkey: 'https://cdn.shopify.com/.../your_logo.png',
