    ryse: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_8.png?v=1763121073',
    redcon1: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_6.png?v=1763121073',
    redcon: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_6.png?v=1763121073',
