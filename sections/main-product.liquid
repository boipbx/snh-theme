  if (window.MutationObserver) {
    var snhJdgmObs = new MutationObserver(function () {
      if (document.querySelector('.jdgm-rev-widg')) {
        enhanceJudgeMe();
        if (document.querySelector('.jdgm-rev-widg .sn-jdgm-eyebrow')) snhJdgmObs.disconnect();
      }
    });
    snhJdgmObs.observe(document.body, { childList: true, subtree: true });
  }
})();
