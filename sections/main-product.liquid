        {%- comment -%}list.single_line_text_field gives a list; a multi-line text metafield gives one string: one point per line{%- endcomment -%}
        {%- unless product.metafields.custom.key_benefits.type contains 'list' -%}{%- assign snh_kb = snh_kb | newline_to_br | split: '<br />' -%}{%- endunless -%}
        {%- for point in snh_kb -%}
          {%- assign snh_pt = point | strip -%}
          {%- if snh_pt != blank -%}{{ snh_pt | json }},{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    ],
  };

  var SNH_BRAND_LOGOS = {
    ehplabs: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_1.png?v=1763121073',
    appliednutrition: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_10.png?v=1763121073',
    myprotein: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_4.png?v=1763121073',
    raw: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_5.png?v=1763121073',
    sis: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_9.png?v=1763121073',
    scienceinsport: 'https://cdn.shopify.com/s/files/1/0258/9625/5550/files/brand_logos_9.png?v=1763121073',
