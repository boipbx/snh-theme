    .snh-trust-item:nth-child(2n) { border-right: 0; }
    .snh-trust-item:nth-child(n+3) { border-bottom: 0; }

    .text-with-icons__list,
    .text-with-icons .grid,
    .text-with-icons .multi-column,
    .text-with-icons .multi-column__list {
