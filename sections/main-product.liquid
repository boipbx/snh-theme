    var overlay = document.querySelector('.snh-modal-overlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.className = 'snh-modal-overlay';
      overlay.innerHTML =
        '<div class="snh-modal" role="dialog" aria-modal="true">' +
        '<button type="button" class="snh-modal-close" aria-label="Close">\u00d7</button>' +
        '<div class="snh-modal-kicker"></div>' +
        '<div class="snh-modal-head"><span class="snh-tile"></span><h3></h3></div>' +
        '<div class="snh-modal-body"></div>' +
        '<div class="snh-modal-actions"></div>' +
        '</div>';
      document.body.appendChild(overlay);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) snhCloseModal();
      });
      overlay.querySelector('.snh-modal-close').addEventListener('click', snhCloseModal);
