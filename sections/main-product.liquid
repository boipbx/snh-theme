  /* ── Bundle & save box (docked under checkout) ────────────────── */
  .snh-bx { margin-block: 12px 2px; border: 0; border-radius: 10px; background: linear-gradient(140deg, #e85a22, #d2470f 70%, var(--snh-accent-hover)); overflow: hidden; }
  .snh-bx-body { margin: 0 6px 6px; background: #ffffff; border-radius: 7px; overflow: hidden; }
  .snh-bx-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; padding: 11px 14px 9px; }
  .snh-bx-head .snh-bx-label { color: #fff2e6; }
  .snh-bx-headr { display: inline-flex; align-items: center; font-size: 0.74rem; font-weight: 800; }
  .snh-bx-headr b { color: #ffffff; font-weight: 800; }
  .snh-bx-label { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--snh-orange); }
  .snh-bx-pills { display: flex; flex-wrap: wrap; gap: 6px; padding: 11px 12px 2px; }
  .snh-bx-pill { flex: 0 0 auto; appearance: none; cursor: pointer; min-height: 32px; padding: 0 12px; border: 1px solid var(--snh-line-strong); border-radius: 8px; background: #ffffff; color: var(--snh-dark); font-size: 0.72rem; font-weight: 750; line-height: 1; white-space: nowrap; transition: background 140ms ease, color 140ms ease, border-color 140ms ease; }
  .snh-bx-pill.is-on { background: var(--snh-dark); border-color: var(--snh-dark); color: #ffffff; }
  .snh-bx-rows { padding: 2px 12px 0; }
  .snh-bx-row { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 12px; align-items: start; padding: 9px 0; border-bottom: 1px solid var(--snh-line); }
  .snh-bx-row:last-child { border-bottom: 0; }
  .snh-bx-row img, .snh-bx-thumb { width: 48px; height: 48px; border-radius: 6px; object-fit: contain; background: #ffffff; border: 1px solid var(--snh-line); box-sizing: border-box; display: block; }
  .snh-bx-name { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.78rem !important; font-weight: 700 !important; color: var(--snh-dark); line-height: 1.35; letter-spacing: 0 !important; }
  .snh-bx-this { display: inline-block; margin-left: 6px; padding: 2px 7px; border-radius: 99px; background: var(--snh-soft); color: var(--snh-muted); font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; vertical-align: 1px; }
  .snh-bx-sub { display: block; margin-top: 3px; font-size: 0.76rem !important; font-weight: 650 !important; letter-spacing: 0 !important; color: var(--snh-muted) !important; }
  .snh-bx-row select { width: 100%; margin-top: 6px; height: 38px; min-height: 38px; padding: 0 32px 0 11px; border: 1px solid var(--snh-line-strong); border-radius: 8px; appearance: none; -webkit-appearance: none; background: #ffffff url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23171717' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='m6 9 6 6 6-6'/%3E%3C/svg%3E") no-repeat right 11px center / 14px; color: var(--snh-dark); font-size: 0.78rem !important; font-weight: 600; line-height: 36px; cursor: pointer; }
  .snh-bx-foot { padding: 8px 12px 2px; }
  .snh-bx-add { display: flex; align-items: center; justify-content: center; gap: 7px; width: 100%; min-height: 46px; border: 0; border-radius: 8px; background: var(--snh-dark); color: #ffffff; font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: filter 150ms ease; }
  .snh-bx-add:hover { filter: brightness(1.15); }
  .snh-bx-add[disabled] { opacity: 0.65; cursor: default; }
  .snh-bx-add b { color: var(--snh-orange-2); font-weight: 800; }
  .snh-bx-note { margin: 0; padding: 6px 12px 10px; font-size: 0.68rem; font-weight: 600; color: var(--snh-muted); text-align: center; }
  /* quiet "bundle added" bar — docked to the bottom edge, page never moves */
  .snh-bxbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1002; display: flex; align-items: center; gap: 11px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: #ffffff; border-top: 1px solid var(--snh-line-strong); box-shadow: 0 -8px 30px rgba(23, 19, 15, 0.10); cursor: pointer; transform: translateY(102%); transition: transform 280ms var(--snh-ease); }
  .snh-bxbar.is-visible { transform: none; }
  .snh-bxbar-check { flex: 0 0 22px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 99px; background: var(--snh-orange); color: #ffffff; }
  .snh-bxbar-check .snh-ic { width: 12px; height: 12px; stroke-width: 3; }
  .snh-bxbar-text { flex: 1 1 auto; min-width: 0; font-size: 0.8rem; font-weight: 700; color: var(--snh-dark); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .snh-bxbar-btn { flex: 0 0 auto; border: 0; border-radius: 8px; min-height: 36px; padding: 0 14px; background: var(--snh-dark); color: #ffffff; font-size: 0.74rem; font-weight: 800; cursor: pointer; }

