#shopify-section-{{ section.id }} .snh-adv-links a { padding: 8px 6px !important; font-size: 12.5px !important; line-height: 1.25 !important; text-align: center !important; white-space: normal !important; }
</style>

{%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}

<div {% render 'section-properties', tight: true %}>
    <div class="product">
      {%- if product.media.size > 0 -%}
        {%- liquid
          # Theme settings → SNH product images → Prefer clean images: leave out media whose file name or alt
          # matches a frame keyword (SNH's orange-frame renders), as long as at least one image is left.
          assign gal_skip = ','
          if settings.snh_clean_images
            assign kws = settings.snh_frame_keywords | downcase | split: ','
            assign kept = 0
            for media in product.media
              assign probe = media.preview_image.src | split: '?' | first | split: '/' | last | append: ' ' | append: media.alt | downcase
              assign hit = false
              for k in kws
                assign kk = k | strip
                if kk != blank and probe contains kk
                  assign hit = true
                endif
              endfor
              if hit
                assign gal_skip = gal_skip | append: media.id | append: ','
              else
                assign kept = kept | plus: 1
              endif
            endfor
            if kept == 0
              assign gal_skip = ','
            endif
          endif
          assign gal_count = 0
          for media in product.media
            assign key = ',' | append: media.id | append: ','
            unless gal_skip contains key
              assign gal_count = gal_count | plus: 1
            endunless
          endfor
          assign gal_active = product.selected_or_first_available_variant.featured_media | default: product.featured_media
        -%}
        <div class="snh-gal{% if gal_count == 1 %} snh-gal--single{% endif %}" data-snh-gal>
          <div class="snh-gal__stage">
            <ul class="snh-gal__list" data-snh-gal-list>
              {%- assign gi = 0 -%}
              {%- for media in product.media -%}
                {%- assign key = ',' | append: media.id | append: ',' -%}
                {%- if gal_skip contains key -%}{%- continue -%}{%- endif -%}
                <li class="snh-gal__slide{% if media.id == gal_active.id %} is-active{% endif %}" data-snh-slide data-index="{{ gi }}" data-media-id="{{ media.id }}">
                  <div class="snh-gal__box" style="--snh-asp: {{ media.preview_image.aspect_ratio | default: 1 }};">
                    {%- if media.media_type == 'image' -%}
                      <img src="{{ media | image_url: width: 1200 }}"
                        srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1400 }} 1400w"
                        sizes="(max-width: 999px) 100vw, 46vw"
                        alt="{{ media.alt | escape }}"
                        width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}"
                        loading="{% if gi == 0 %}eager{% else %}lazy{% endif %}"{% if gi == 0 %} fetchpriority="high"{% endif %} decoding="async">
                    {%- else -%}
                      {{ media | media_tag: image_size: '1200x' }}
                    {%- endif -%}
                  </div>
                </li>
                {%- assign gi = gi | plus: 1 -%}
              {%- endfor -%}
            </ul>
            {%- if gal_count > 1 -%}
              <button type="button" class="snh-gal__nav snh-gal__nav--prev" data-snh-gal-prev aria-label="Previous image"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
              <button type="button" class="snh-gal__nav snh-gal__nav--next" data-snh-gal-next aria-label="Next image"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
              <span class="snh-gal__counter" aria-hidden="true"><b data-snh-gal-cur>1</b>&thinsp;/&thinsp;{{ gal_count }}</span>
            {%- endif -%}
          </div>
          {%- if gal_count > 1 -%}
            <div class="snh-gal__bar" data-snh-gal-bar role="scrollbar" aria-orientation="horizontal" aria-hidden="true">
              <span class="snh-gal__bar-track"><span class="snh-gal__bar-thumb" data-snh-gal-thumb-bar style="inline-size: {{ 100 | divided_by: gal_count }}%;"></span></span>
            </div>
            <div class="snh-gal__thumbs" data-snh-gal-thumbs role="tablist" aria-label="Product images">
              {%- assign gi = 0 -%}
              {%- for media in product.media -%}
                {%- assign key = ',' | append: media.id | append: ',' -%}
                {%- if gal_skip contains key -%}{%- continue -%}{%- endif -%}
                <button type="button" class="snh-gal__thumb{% if media.id == gal_active.id %} is-active{% endif %}" data-snh-thumb data-index="{{ gi }}" role="tab" aria-label="Image {{ gi | plus: 1 }}">
                  <img src="{{ media.preview_image | image_url: width: 160 }}" alt="" loading="lazy" decoding="async" width="80" height="80">
                </button>
                {%- assign gi = gi | plus: 1 -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <product-rerender id="product-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender class="snh-info-host">
      {%- render 'product-info',
        product: product,
        update_url: true,
        product_form_id: product_form_id,
        context: 'main_product'
      -%}
      </product-rerender>
    </div>
</div>

{%- assign snh_bc_url = '' -%}{%- assign snh_bc_title = '' -%}
{%- for c in product.collections -%}
  {%- assign ct = c.title | downcase -%}
  {%- if snh_bc_url == '' and ct != 'all' and ct != 'all products' and ct != 'everything' and ct != 'home page' and ct != 'frontpage' and ct != 'bestsellers' -%}
    {%- assign snh_bc_url = c.url -%}{%- assign snh_bc_title = c.title -%}
  {%- endif -%}
{%- endfor -%}
<nav hidden data-snh-crumbs class="snh-crumbs" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>
  {%- if snh_bc_url != '' -%}<span class="snh-crumbs-sep">/</span><a href="{{ snh_bc_url }}">{{ snh_bc_title | downcase | capitalize | escape }}</a>{%- endif -%}
  <span class="snh-crumbs-sep">/</span><span aria-current="page">{% render 'snh-v2-title', product: product, short: true %}</span>
</nav>
{%- capture snh_sub -%}{{ product.metafields.custom.subtitle }}{%- endcapture -%}
{%- if snh_sub == blank -%}{%- capture snh_sub -%}{{ product.type | downcase | capitalize }}{%- unless product.has_only_default_variant %} · {{ product.selected_or_first_available_variant.title | replace: ' / ', ' · ' | replace: ' - Informed-Sport Tested', '' | replace: 'Servings', 'servings' }}{%- endunless -%}{%- endcapture -%}{%- endif -%}
<span hidden data-snh-subtitle>{{ snh_sub | strip }}</span>

{%- comment -%} ── SNH Bundle & Save: offers read from Theme settings (global, every template) with per-section fallback ── {%- endcomment -%}
{%- assign snh_bx_count = 0 -%}
{%- assign snh_bx_first_save = '' -%}
{%- capture snh_bundle_panels -%}
  {%- for i in (1..20) -%}
    {%- assign pkey = 'bundle_' | append: i | append: '_products' -%}
    {%- assign tkey = 'bundle_' | append: i | append: '_title' -%}
    {%- assign skey = 'bundle_' | append: i | append: '_save' -%}
    {%- assign plist = settings[pkey] | default: section.settings[pkey] -%}
    {%- assign btitle = settings[tkey] | default: section.settings[tkey] -%}
    {%- assign bsave = settings[skey] | default: section.settings[skey] -%}
    {%- if plist.size > 0 -%}
      {%- assign in_it = false -%}
      {%- for bp in plist -%}{%- if bp.id == product.id -%}{%- assign in_it = true -%}{%- endif -%}{%- endfor -%}
      {%- if in_it -%}
        {%- assign twin = false -%}
        {%- if plist.size == 1 -%}{%- assign twin = true -%}{%- endif -%}
        {%- assign offer_dead = false -%}
        {%- capture snh_bx_rows -%}
          {%- for bp in plist -%}
            {%- if twin or bp.id != product.id -%}
              {%- assign avail = 0 -%}
              {%- for v in bp.variants -%}{%- if v.available -%}{%- assign avail = avail | plus: 1 -%}{%- endif -%}{%- endfor -%}
              {%- if avail == 0 -%}
                {%- assign offer_dead = true -%}
              {%- else -%}
                <div class="snh-bx-row">
                  {%- if bp.featured_image -%}<img src="{{ bp.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="48" height="48">{%- else -%}<span class="snh-bx-thumb"></span>{%- endif -%}
                  <div class="snh-bx-cell">
                    <span class="snh-bx-name">{{ bp.title | escape }}{% if twin %}<span class="snh-bx-this">2nd unit</span>{% endif %}</span>
                    {%- if bp.has_only_default_variant or avail == 1 -%}
                      {%- assign only_v = false -%}
                      {%- for v in bp.variants -%}{%- if v.available and only_v == false -%}{%- assign only_v = v -%}{%- endif -%}{%- endfor -%}
                      <span class="snh-bx-sub">{% unless bp.has_only_default_variant %}{{ only_v.title | escape }} &middot; {% endunless %}{{ only_v.price | money }}</span>
                      <input type="hidden" data-bx-variant value="{{ only_v.id }}">
                    {%- else -%}
                      <select data-bx-variant aria-label="Choose an option for {{ bp.title | escape }}">
                        {%- for v in bp.variants -%}{%- if v.available -%}<option value="{{ v.id }}">{{ v.title | escape }} &middot; {{ v.price | money }}</option>{%- endif -%}{%- endfor -%}
                      </select>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- unless offer_dead -%}
          {%- assign snh_bx_count = snh_bx_count | plus: 1 -%}
          {%- if snh_bx_count == 1 and bsave != blank -%}{%- assign snh_bx_first_save = bsave -%}{%- endif -%}
          <div class="snh-bx-panel" data-bx-panel data-bx-title="{{ btitle | default: 'Bundle offer' | escape }}"{% if snh_bx_count > 1 %} hidden{% endif %}>
            <div class="snh-bx-rows">
              <div class="snh-bx-row">
                {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="48" height="48">{%- else -%}<span class="snh-bx-thumb"></span>{%- endif -%}
                <div class="snh-bx-cell"><span class="snh-bx-name">{{ product.title | escape }}<span class="snh-bx-this">This item</span></span><span class="snh-bx-sub">As selected above</span></div>
              </div>
              {{ snh_bx_rows }}
            </div>
            <div class="snh-bx-foot">
              <button type="button" class="snh-bx-add" data-bx-add>Add bundle{% if bsave != blank %} &middot; <b>{{ bsave }}</b>{% endif %}</button>
            </div>
          </div>
        {%- endunless -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if snh_bx_count > 0 -%}
  <div hidden data-snh-bundle-src>
    <div class="snh-bx" data-snh-bx>
      <div class="snh-bx-head">
        <span class="snh-bx-label">Bundle &amp; save</span>
        {% if snh_bx_first_save != blank %}<span class="snh-bx-headr"><b>{{ snh_bx_first_save }}</b></span>{% endif %}
      </div>
      <div class="snh-bx-body">
        <div class="snh-bx-pills" data-bx-pills hidden></div>
        {{ snh_bundle_panels }}
        <p class="snh-bx-note">Bundle discount applies automatically at checkout.</p>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} ── v2 (prototype layout): matched bundle box + full-width "The details" band; both are moved into place by v2Layout() ── {%- endcomment -%}
{%- if section.settings.v2_bundles -%}
  <div hidden data-v2-bundle-src>{%- render 'snh-v2-bundles', product: product, handles: section.settings.v2_bundle_handles, limit: 3 -%}</div>
{%- endif -%}
{%- comment -%}
  "The details" band: full-width tabs on desktop, accordions on phones (assets/snh-v2.js data-v2="dtabs").
  Panels, each shown only when it has content: Description · How to use (block or custom.how_to_use) ·
  Ingredients & nutrition (custom.ingredients + the product's nutrition-panel images) · FAQs (custom.faqs) ·
  Delivery & returns (section setting, with a built-in fallback) · then the template's other collapsible blocks.
  Merchant rich text is normalised (.det__rte) so pasted headings, grids and tables can't break the layout.
{%- endcomment -%}
{%- liquid
  assign det_tabs = ''
  assign det_panels = ''
  assign det_n = 0
-%}
{%- capture det_desc -%}{{ product.description }}{%- endcapture -%}
{%- capture det_how -%}
  {%- for b in section.blocks -%}
    {%- assign bt = b.settings.title | downcase -%}
    {%- if b.type == 'collapsible_text' and bt contains 'how to' -%}{{ b.settings.page.content | default: b.settings.content }}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign how_text = det_how | strip_html | remove: '.' | strip -%}
{%- if how_text == blank and product.metafields.custom.how_to_use != blank -%}
  {%- capture det_how -%}{{ product.metafields.custom.how_to_use | metafield_tag }}{%- endcapture -%}
{%- endif -%}
{%- capture det_ing -%}
  {%- if product.metafields.custom.ingredients != blank -%}{{ product.metafields.custom.ingredients | metafield_tag }}{%- endif -%}
  {%- assign panels_shown = 0 -%}
  {%- for m in product.media -%}
    {%- if m.media_type != 'image' -%}{%- continue -%}{%- endif -%}
    {%- assign fname = m.preview_image.src | split: '?' | first | split: '/' | last | downcase | remove: 'sportsnutritionhub' | remove: 'appliednutrition' | remove: 'rawnutrition' | remove: 'optimumnutrition' | remove: 'nutritionhub' -%}
    {%- assign probe = m.alt | downcase | append: ' ' | append: fname -%}
    {%- if probe contains 'nutritional' or fname contains 'nutri' or probe contains 'panel' or probe contains 'facts' or probe contains 'ingredient' or fname contains 'screenshot' -%}
      <figure class="det__panelimg">{{ m.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 767px) 100vw, 720px', widths: '600,900,1200', alt: m.alt | default: 'Nutrition information' }}</figure>
      {%- assign panels_shown = panels_shown | plus: 1 -%}
      {%- if panels_shown >= 2 -%}{%- break -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture det_faq -%}
  {%- if product.metafields.custom.faqs != blank -%}{{ product.metafields.custom.faqs | metafield_tag }}{%- elsif product.metafields.custom.faq != blank -%}{{ product.metafields.custom.faq | metafield_tag }}{%- endif -%}
{%- endcapture -%}
{%- capture det_ship -%}
  {%- if section.settings.v2_delivery != blank -%}
    {{ section.settings.v2_delivery }}
  {%- else -%}
    {%- assign free_from = settings.cart_free_shipping_threshold | default: 17000 | times: 100 | money_without_trailing_zeros -%}
    <ul><li><strong>Colombo:</strong> same-day delivery.</li><li><strong>Rest of Sri Lanka:</strong> 2–3 working days.</li><li><strong>Free delivery</strong> on orders over {{ free_from }}.</li><li>Pay by card, bank transfer, cash on delivery or Koko (pay in 3).</li></ul>
    {%- if shop.refund_policy -%}<p>Returns and refunds: see our <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a>.</p>{%- endif -%}
  {%- endif -%}
{%- endcapture -%}
{%- capture det_list -%}description|Description,how|How to use,ing|Ingredients & nutrition,faq|FAQs,ship|Delivery & returns{%- endcapture -%}
{%- assign det_items = det_list | split: ',' -%}
{%- for it in det_items -%}
  {%- assign kv = it | split: '|' -%}
  {%- case kv[0] -%}
    {%- when 'description' -%}{%- assign body = det_desc -%}
    {%- when 'how' -%}{%- assign body = det_how -%}
    {%- when 'ing' -%}{%- assign body = det_ing -%}
    {%- when 'faq' -%}{%- assign body = det_faq -%}
    {%- when 'ship' -%}{%- assign body = det_ship -%}
  {%- endcase -%}
  {%- assign txt = body | strip_html | remove: '.' | strip -%}
  {%- unless txt != blank or body contains '<img' -%}{%- continue -%}{%- endunless -%}
  {%- assign det_n = det_n | plus: 1 -%}
  {%- capture pid -%}det-{{ section.id }}-{{ kv[0] }}{%- endcapture -%}
  {%- capture det_tabs -%}{{ det_tabs }}<button type="button" role="tab" id="{{ pid }}-t" aria-controls="{{ pid }}" aria-selected="{% if det_n == 1 %}true{% else %}false{% endif %}">{{ kv[1] | escape }}</button>{%- endcapture -%}
  {%- capture det_panels -%}{{ det_panels }}<div class="det__panel{% if det_n == 1 %} is-on{% endif %}" id="{{ pid }}" role="tabpanel" aria-labelledby="{{ pid }}-t"><button type="button" class="det__acc" aria-expanded="{% if det_n == 1 %}true{% else %}false{% endif %}">{{ kv[1] | escape }}<i aria-hidden="true"></i></button><div class="det__body det__rte">{{ body }}</div></div>{%- endcapture -%}
{%- endfor -%}
{%- for b in section.blocks -%}
  {%- if b.type != 'collapsible_text' -%}{%- continue -%}{%- endif -%}
  {%- assign bt = b.settings.title | downcase -%}
  {%- if bt contains 'how to' or bt contains 'description' -%}{%- continue -%}{%- endif -%}
  {%- capture body -%}{{ b.settings.page.content | default: b.settings.content }}{%- endcapture -%}
  {%- assign txt = body | strip_html | remove: '.' | strip -%}
  {%- if txt == blank -%}{%- continue -%}{%- endif -%}
  {%- assign det_n = det_n | plus: 1 -%}
  {%- capture pid -%}det-{{ section.id }}-{{ b.id }}{%- endcapture -%}
  {%- capture det_tabs -%}{{ det_tabs }}<button type="button" role="tab" id="{{ pid }}-t" aria-controls="{{ pid }}" aria-selected="false">{{ b.settings.title | escape }}</button>{%- endcapture -%}
  {%- capture det_panels -%}{{ det_panels }}<div class="det__panel" id="{{ pid }}" role="tabpanel" aria-labelledby="{{ pid }}-t"><button type="button" class="det__acc" aria-expanded="false">{{ b.settings.title | escape }}<i aria-hidden="true"></i></button><div class="det__body det__rte">{{ body }}</div></div>{%- endcapture -%}
{%- endfor -%}
{%- comment -%} Stats band: product metafield custom.stats, one "value | label" per line (or a list), up to 4. Nothing renders without it. {%- endcomment -%}
{%- liquid
  assign stat_src = product.metafields.custom.stats.value
  unless product.metafields.custom.stats.type contains 'list'
    assign stat_src = product.metafields.custom.stats.value | newline_to_br | split: '<br />'
  endunless
  assign stat_n = 0
-%}
{%- capture stat_html -%}
  {%- for line in stat_src -%}
    {%- assign parts = line | strip_html | split: '|' -%}
    {%- assign sv = parts[0] | strip -%}{%- assign sl = parts[1] | strip -%}
    {%- if sv == blank or sl == blank -%}{%- continue -%}{%- endif -%}
    <div class="pstat"><strong>{{ sv | escape }}</strong><span>{{ sl | escape }}</span></div>
    {%- assign stat_n = stat_n | plus: 1 -%}
    {%- if stat_n >= 4 -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if stat_n > 0 -%}
<section class="v2 pstats" aria-label="Key stats"><div class="v-wrap pstats__in">{{ stat_html }}</div></section>
{%- endif -%}
{%- if det_n > 0 -%}
<section class="v2 v-section v2pdp-details" id="details-{{ section.id }}" aria-labelledby="det-{{ section.id }}">
  <div class="v-wrap">
    <div class="det__head">
      {%- if section.settings.v2_details_eyebrow != blank -%}<p class="eyebrow">{{ section.settings.v2_details_eyebrow | escape }}</p>{%- endif -%}
      <h2 class="v-h1" id="det-{{ section.id }}">{% render 'snh-v2-heading', text: section.settings.v2_details_heading %}</h2>
      {%- if section.settings.v2_details_lead != blank -%}<p class="lead">{{ section.settings.v2_details_lead | escape }}</p>{%- endif -%}
    </div>
    <div class="det" data-v2="dtabs">
      <div class="det__tabs" role="tablist" aria-label="Product details">{{ det_tabs }}</div>
      {{ det_panels }}
    </div>
  </div>
</section>
{%- endif -%}

{%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}

{%- if section.settings.show_fixed_add_to_cart and product.available and buy_buttons_block != blank -%}
  <product-rerender id="{{ product_form_id }}-sticky-bar" observe-form="{{ product_form_id }}">
    {%- if product.selected_or_first_available_variant.available -%}
      <product-quick-add form="{{ product_form_id }}" class="product-quick-add">
        {%- assign button_label = 'product.general.add_to_cart_button' | t -%}

        <buy-buttons template="{{ product.template_suffix }}" form="{{ product_form_id }}" class="sm:hidden">
          {%- render 'button', type: 'submit', content: button_label, form: product_form_id, background: buy_buttons_block.settings.atc_button_background, text_color: buy_buttons_block.settings.atc_button_text_color, secondary: true, stretch: true, size: 'lg' -%}
        </buy-buttons>

        {%- assign image = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

        <div class="product-quick-add__variant {% if image == blank %}no-image{% endif %} hidden sm:grid">
          {%- if image != blank -%}
            <variant-media widths="80,160" form="{{ product_form_id }}">
              {{- image | image_url: width: image.width | image_tag: loading: 'lazy', sizes: '80px', widths: '80,160', class: 'rounded-xs' -}}
            </variant-media>
          {%- endif -%}

          <div class="v-stack gap-0.5">
            {%- assign vendor_block = section.blocks | where: 'type', 'vendor' -%}
            {%- if vendor_block != blank -%}
              {%- render 'vendor' with product.vendor, class: 'text-xs' -%}
            {%- endif -%}

            <a href="{{ product.url }}" class="bold truncate-text">{{ product.title }}</a>
            {%- render 'price-list', product: product, variant: product.selected_or_first_available_variant, form_id: product_form_id -%}
          </div>

          <buy-buttons template="{{ product.template_suffix }}" form="{{ product_form_id }}" force-secondary-button>
            {%- render 'button', type: 'submit', content: button_label, form: product_form_id, background: buy_buttons_block.settings.atc_button_background, text_color: buy_buttons_block.settings.atc_button_text_color, secondary: true -%}
          </buy-buttons>
        </div>
      </product-quick-add>
    {%- endif -%}
  </product-rerender>
{%- endif -%}

