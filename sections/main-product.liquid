    '{{ variant.id }}': { a: {{ variant.available | json }}, q: {{ variant.inventory_quantity | default: 0 }}, m: {{ variant.inventory_management | json }} }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  };
