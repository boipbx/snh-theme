            more.textContent = c ? 'Read more' : 'Read less';
          });
        }
      }
    }
    v2Layout(info);
  }

  if (typeof fixGallery !== 'function') { var fixGallery = function () {}; }   /* was called but never defined: the throw skipped the rest of init() */

  function init() {
    enhanceJudgeMe();
    injectConversionElements();
    initBundleBox();
    injectKeyBenefits();
    fixWhyChooseUs();
    fixGallery();
    injectPointsBanner();
    enhanceWhatsApp();
    watchVariant();
    snhFixSwatchBorders();
    fixVendorLink();
    restructureInfo();
  }

  var snhResizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(snhResizeTimer);
    snhResizeTimer = setTimeout(fixGallery, 250);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function snhLate() { injectPointsBanner(); enhanceWhatsApp(); fixVendorLink(); initBundleBox(); restructureInfo(); }
  setTimeout(snhLate, 600);
  setTimeout(snhLate, 1800);
  window.addEventListener('load', snhLate);


  // Watch the product-info for theme re-renders of the variant picker and
  // re-apply the swatch border fix each time. This is what finally beats
  // the theme redrawing the swatches after our script runs.
  (function watchSwatches() {
    var host = document.querySelector('#shopify-section-{{ section.id }} .snh-info-host') ||
               document.querySelector('#shopify-section-{{ section.id }} .product-info');
    if (!host || !window.MutationObserver) return;
    var opts = { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'aria-checked', 'checked'] };
    var queued = false;
    var obs = new MutationObserver(function () {
      if (queued) return;
      queued = true;
      /* microtask: runs after the theme's swap but before the next paint */
      Promise.resolve().then(function () {
        queued = false;
        obs.disconnect();              /* our own writes must not re-trigger */
        try {
          snhFixSwatchBorders();
          fixVendorLink();
          restructureInfo();
          injectPointsBanner();
          initBundleBox();
        } catch (e) {}
        obs.takeRecords();
        obs.observe(host, opts);
      });
    });
    obs.observe(host, opts);
  })();

