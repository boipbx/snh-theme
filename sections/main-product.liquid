{%- render 'section-spacing-collapsing' -%}



<style>
/* ══════════════════════════════════════════════════════════════════
   SPORTS NUTRITION HUB — main-product.liquid v3 (Elite-aligned)
   Aligned to SNH Elite loyalty look: Archivo display font, unified
   premium orange (var(--snh-accent)), matched warm charcoal. Structure, gallery
   fixes, Judge.me skin, and JS unchanged from v2.
   ══════════════════════════════════════════════════════════════════ */

  :root {
    --snh-orange: var(--snh-accent);
    --snh-orange-2: #ff7d3a;
    --snh-orange-deep: var(--snh-accent-hover);
    --snh-dark: var(--snh-ink);
    --snh-ink: #202020;
    --snh-muted: rgba(23, 23, 23, 0.62);
    --snh-line: rgba(23, 23, 23, 0.11);
    --snh-line-strong: rgba(23, 23, 23, 0.22);
    --snh-soft: #f3f3f1;
    --snh-shadow-soft: 0 14px 40px rgba(17, 17, 17, 0.075);
    --snh-shadow-card: 0 18px 54px rgba(17, 17, 17, 0.09);
    --snh-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --snh-green: #1a8f47;
    --snh-display: var(--snh-font-display);
  }

  #shopify-section-{{ section.id }} {
    --product-grid: auto / minmax(0, 1fr);
    --product-shell-max-width: 1800px;
    --product-shell-edge-gutter: clamp(16px, 2.2vw, 44px);
    --product-top-spacing: clamp(18px, 2vw, 36px);
    --product-column-gap: clamp(28px, 3.5vw, 60px);
    --product-gallery-media-list-grid: auto / auto-flow 100%;
    --product-gallery-media-list-gap: {% if section.settings.mobile_media_size == 'expanded' %}0px{% else %}clamp(12px, 2vw, 18px){% endif %};
    --product-gallery-card-radius: 12px;
    --product-gallery-card-background: #ffffff;
    --product-gallery-max-height: min(790px, calc(100svh - 150px));
    --product-info-max-width: 820px;
    --snh-orange: var(--snh-accent);
    --snh-orange-2: #ff7d3a;
    --snh-orange-deep: var(--snh-accent-hover);
    --snh-dark: var(--snh-ink);
    --snh-ink: #202020;
    --snh-muted: rgba(23, 23, 23, 0.62);
    --snh-line: rgba(23, 23, 23, 0.11);
    --snh-line-strong: rgba(23, 23, 23, 0.22);
    --snh-soft: #f3f3f1;
    --snh-shadow-soft: 0 14px 40px rgba(17, 17, 17, 0.075);
    --snh-shadow-card: 0 18px 54px rgba(17, 17, 17, 0.09);
    --snh-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --snh-green: #1a8f47;
    --snh-green-bg: rgba(26, 143, 71, 0.08);
    --snh-display: var(--snh-font-display);
  }

  /* the re-render host is layout-neutral: .product-info stays the grid item */
  #shopify-section-{{ section.id }} .snh-info-host { display: contents; }

  /* ── Product shell ───────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .product {
    display: grid;
    grid: var(--product-grid);
    align-items: start;
    gap: var(--product-column-gap);
    inline-size: 100%;
    max-inline-size: min(var(--product-shell-max-width), calc(100vw - (var(--product-shell-edge-gutter) * 2))) !important;
    margin-inline: auto !important;
    padding-inline: 0 !important;
    padding-block-start: var(--product-top-spacing);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product,
  #shopify-section-{{ section.id }} .product-gallery,
  #shopify-section-{{ section.id }} .product-info,
  #shopify-section-{{ section.id }} .product-gallery__media-list,
  #shopify-section-{{ section.id }} .product-gallery__media-list-wrapper,
  #shopify-section-{{ section.id }} media-carousel {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  /* ── Satoshi type for the whole product section ── */
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .product-info,
  #shopify-section-{{ section.id }} .product-info p,
  #shopify-section-{{ section.id }} .product-info span,
  #shopify-section-{{ section.id }} .product-info a,
  #shopify-section-{{ section.id }} .product-info button,
  #shopify-section-{{ section.id }} .product-info label,
  #shopify-section-{{ section.id }} .product-info select,
  #shopify-section-{{ section.id }} .product-info input,
  #shopify-section-{{ section.id }} .snh-bx,
  #shopify-section-{{ section.id }} .snh-bx * {
    font-family: var(--snh-font-body);
  }
  #shopify-section-{{ section.id }} .product-info .product-title,
  #shopify-section-{{ section.id }} .product-info h1,
  #shopify-section-{{ section.id }} .product-info h2,
  #shopify-section-{{ section.id }} .product-info h3 {
    font-family: var(--snh-font-body);
    font-weight: 800;
    letter-spacing: -.028em;
  }
  #shopify-section-{{ section.id }} .product-info .price-list,
  #shopify-section-{{ section.id }} .product-info .price-list * {
    font-family: var(--snh-font-body);
    font-weight: 800;
    letter-spacing: -.022em;
  }

  /* ── SNH owned gallery ─────────────────────────────────────────
     We render this markup ourselves, so single-image and multi-image
     products use the SAME structure — no wrapper guessing, no !important
     width chasing, no MutationObserver. Every slide reserves its box from
     the real aspect ratio, so nothing shifts while images load. ── */
  #shopify-section-{{ section.id }} .snh-gal {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(10px, 1vw, 14px);
    align-items: start;
    min-inline-size: 0;
    inline-size: 100%;
  }
  #shopify-section-{{ section.id }} .snh-gal--single { grid-template-columns: minmax(0, 1fr); }
  #shopify-section-{{ section.id }} .snh-gal__stage {
    position: relative;
    grid-column: 1;
    min-inline-size: 0;
    inline-size: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 0 rgba(17,17,17,.04), 0 12px 32px rgba(17,17,17,.06);
  }

  #shopify-section-{{ section.id }} .snh-gal__list {
    display: grid;
    grid-template-areas: "stack";
    margin: 0; padding: 0; list-style: none;
    inline-size: 100%;
  }
  #shopify-section-{{ section.id }} .snh-gal__slide {
    grid-area: stack;
    min-inline-size: 0;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.015);
    transition: opacity .42s cubic-bezier(.22,1,.36,1), transform .52s cubic-bezier(.22,1,.36,1), visibility .42s;
  }
  #shopify-section-{{ section.id }} .snh-gal__slide.is-active {
    opacity: 1; visibility: visible; transform: none;
  }
  #shopify-section-{{ section.id }} .snh-gal__box {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .snh-gal__box > img,
  #shopify-section-{{ section.id }} .snh-gal__box > video,
  #shopify-section-{{ section.id }} .snh-gal__box model-viewer,
  #shopify-section-{{ section.id }} .snh-gal__box iframe {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    transition: transform .6s cubic-bezier(.22,1,.36,1);
  }
  @media (hover: hover) and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .snh-gal__box:hover > img { transform: scale(1.04); }
  }
  #shopify-section-{{ section.id }} .snh-gal__nav {
    position: absolute; top: 50%; z-index: 3;
    display: grid; place-items: center;
    width: 38px; height: 38px; margin: 0; padding: 0;
    transform: translateY(-50%);
    border: 1px solid rgba(17,17,17,.1); border-radius: 50%;
    background: rgba(255,255,255,.92); color: var(--snh-ink);
    cursor: pointer; opacity: 0;
    transition: opacity .25s ease, background-color .25s ease;
  }
  #shopify-section-{{ section.id }} .snh-gal__nav > svg { display: block; margin: 0; transform: none; }
  #shopify-section-{{ section.id }} .snh-gal__nav--prev { left: 12px; }
  #shopify-section-{{ section.id }} .snh-gal__nav--next { right: 12px; }
  #shopify-section-{{ section.id }} .snh-gal__stage:hover .snh-gal__nav,
  #shopify-section-{{ section.id }} .snh-gal__nav:focus-visible { opacity: 1; }
  #shopify-section-{{ section.id }} .snh-gal__nav:hover { background: #fff; }
  #shopify-section-{{ section.id }} .snh-gal__counter {
    position: absolute; bottom: 12px; right: 12px; z-index: 3;
    padding: 5px 11px; border-radius: 99px;
    background: rgba(23,19,15,.7); color: #fff;
    font-size: 11.5px; font-weight: 600; letter-spacing: .02em;
  }
  #shopify-section-{{ section.id }} .snh-gal__counter b { font-weight: 800; }
  #shopify-section-{{ section.id }} .snh-gal__thumbs {
    grid-column: 1;
    display: flex; flex-direction: row; gap: 10px;
    inline-size: 100%;
    overflow-x: auto; overflow-y: hidden;
    padding-block-end: 2px;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  #shopify-section-{{ section.id }} .snh-gal__thumbs::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .snh-gal__thumb {
    flex: 0 0 auto; display: block; padding: 0;
    inline-size: clamp(66px, 5.4vw, 88px); aspect-ratio: 1 / 1;
    scroll-snap-align: start;
    border: 1.5px solid #e7e0d6; border-radius: 8px;
    background: #fff; overflow: hidden; cursor: pointer;
    transition: border-color .24s ease, transform .24s ease;
  }
  #shopify-section-{{ section.id }} .snh-gal__thumb:hover { border-color: rgba(23,19,15,.28); }
  #shopify-section-{{ section.id }} .snh-gal__thumb.is-active { border-color: var(--snh-orange, var(--snh-accent)); }
  #shopify-section-{{ section.id }} .snh-gal__thumb > img {
    display: block; inline-size: 100%; block-size: 100%; object-fit: contain;
  }
  /* progress bar — desktop hides it, the thumbnail rail is the indicator there */
  #shopify-section-{{ section.id }} .snh-gal__bar { display: none; }
  #shopify-section-{{ section.id }} .snh-gal__bar-track {
    display: block; inline-size: 100%; block-size: 2px;
    background: rgba(23,19,15,.12); overflow: hidden;
  }
  #shopify-section-{{ section.id }} .snh-gal__bar-thumb {
    display: block; block-size: 100%;
    background: var(--snh-orange, var(--snh-accent));
    transform: translateX(0);
    transition: transform .28s cubic-bezier(.22,1,.36,1);
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} .snh-gal { grid-template-columns: minmax(0, 1fr); gap: 0; }
    /* full-bleed like the reference theme: the image owns the whole viewport
       width, no card, no radius, no side gutters */
    #shopify-section-{{ section.id }} .snh-gal__stage {
      grid-column: 1;
      inline-size: 100vw;
      max-inline-size: 100vw;
      margin-inline: calc(50% - 50vw);
      border-radius: 0;
      box-shadow: none;
      background: #fff;
    }
    #shopify-section-{{ section.id }} .snh-gal__counter { display: none; }
    #shopify-section-{{ section.id }} .snh-gal__bar {
      display: block;
      grid-column: 1;
      inline-size: 100vw;
      margin-inline: calc(50% - 50vw);
      margin-block-start: 0;
    }
    #shopify-section-{{ section.id }} .snh-gal__box { aspect-ratio: 1 / 1; }
    /* mobile: real swipe, one slide per screen, no thumbnail column eating height */
    #shopify-section-{{ section.id }} .snh-gal__list {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    #shopify-section-{{ section.id }} .snh-gal__list::-webkit-scrollbar { display: none; }
    #shopify-section-{{ section.id }} .snh-gal__slide {
      flex: 0 0 100%;
      inline-size: 100%;
      scroll-snap-align: center;
      opacity: 1; visibility: visible; transform: none; transition: none;
    }
    #shopify-section-{{ section.id }} .snh-gal__nav { display: none; }
    #shopify-section-{{ section.id }} .snh-gal__thumbs { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .snh-gal__slide,
    #shopify-section-{{ section.id }} .snh-gal__box > img { transition: none; }
  }

  /* ── Gallery wrapper (legacy theme gallery — no longer rendered) ── */
  #shopify-section-{{ section.id }} .product-gallery {
    align-self: start;
    justify-self: stretch;
    inline-size: 100%;
  }

  #shopify-section-{{ section.id }} .product-gallery__media-list-wrapper,
  #shopify-section-{{ section.id }} media-carousel {
    inline-size: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .product-gallery__media-list {
    display: grid;
    grid: var(--product-gallery-media-list-grid);
    gap: var(--product-gallery-media-list-gap);
    align-items: stretch;
    inline-size: 100%;
    max-inline-size: 100%;
    overscroll-behavior: contain;
    scroll-padding-inline: var(--product-gallery-media-list-gap);
  }

  #shopify-section-{{ section.id }} .product-gallery__media-list > * {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  /* ── Gallery media item — always has height ──────────────────── */
  #shopify-section-{{ section.id }} .product-gallery__media {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--product-gallery-card-radius);
    background: var(--product-gallery-card-background);
    isolation: isolate;
    box-shadow: 0 2px 0 rgba(17,17,17,.04), 0 12px 32px rgba(17,17,17,.06);
    aspect-ratio: 1 / 1;
    min-block-size: 260px;
    /* single-image products render this box with no list/carousel wrapper
       around it, so it never inherited inline-size:100% from the ancestor
       chain below — it shrank to content. Force it directly here. */
    inline-size: 100% !important;
    max-inline-size: 100% !important;
    flex: 1 1 auto;
  }

  /* belt-and-braces: force every level between .product-gallery and the
     media box to full width when there's no thumbnail rail (single image) */
  #shopify-section-{{ section.id }} .product-gallery > .product-gallery__media,
  #shopify-section-{{ section.id }} .product-gallery > .product-gallery__media-list,
  #shopify-section-{{ section.id }} .product-gallery > .product-gallery__media-list-wrapper,
  #shopify-section-{{ section.id }} .product-gallery > media-carousel {
    inline-size: 100% !important;
    max-inline-size: 100% !important;
    flex: 1 1 auto !important;
  }

  #shopify-section-{{ section.id }} .product-gallery__media img,
  #shopify-section-{{ section.id }} .product-gallery__media video,
  #shopify-section-{{ section.id }} .product-gallery__media model-viewer,
  #shopify-section-{{ section.id }} .product-gallery__media iframe {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: 100%;
    object-fit: contain;
  }

  /* ── Thumbnails ──────────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .product-gallery__thumbnail-list,
  #shopify-section-{{ section.id }} .product-gallery__thumbnail-scroller {
    gap: 10px !important;
  }

  #shopify-section-{{ section.id }} .product-gallery__thumbnail,
  #shopify-section-{{ section.id }} .product-gallery__thumbnail-list button,
  #shopify-section-{{ section.id }} .product-gallery__thumbnail-list a {
    width: clamp(58px, 4.2vw, 74px) !important;
    aspect-ratio: 1 / 1 !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    background: #ffffff !important;
    border: 1.5px solid var(--snh-line) !important;
    box-shadow: none !important;
    transition: border-color 150ms ease !important;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .product-gallery__thumbnail img,
  #shopify-section-{{ section.id }} .product-gallery__thumbnail-list button img,
  #shopify-section-{{ section.id }} .product-gallery__thumbnail-list a img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    border-radius: inherit !important;
  }

  #shopify-section-{{ section.id }} .product-gallery__thumbnail[aria-current="true"],
  #shopify-section-{{ section.id }} .product-gallery__thumbnail.is-selected,
  #shopify-section-{{ section.id }} .product-gallery__thumbnail-list button[aria-current="true"],
  #shopify-section-{{ section.id }} .product-gallery__thumbnail-list a[aria-current="true"] {
    border-color: var(--snh-orange) !important;
    box-shadow: 0 0 0 1px var(--snh-orange) !important;
  }

  /* The theme wraps sections in its own "Content width" container (1400px in
     theme settings). Rather than guess its class name, the product shell is
     centred against the VIEWPORT and sized independently of any ancestor. */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .product {
      position: relative;
      left: 50%;
      transform: translateX(-50%);
      inline-size: min(var(--product-shell-max-width), calc(100vw - (var(--product-shell-edge-gutter) * 2))) !important;
      max-inline-size: none !important;
      margin-inline: 0 !important;
    }
    #shopify-section-{{ section.id }} > *,
    #shopify-section-{{ section.id }} > * > * {
      max-inline-size: none !important;
    }
  }

  /* ── Product info column ─────────────────────────────────────── */
  #shopify-section-{{ section.id }} .product-info {
    align-self: start;
    inline-size: 100%;
    max-inline-size: var(--product-info-max-width);
  }

  #shopify-section-{{ section.id }} .product-info > *,
  #shopify-section-{{ section.id }} .product-info .shopify-block,
  #shopify-section-{{ section.id }} .product-info .shopify-app-block,
  #shopify-section-{{ section.id }} .product-info [data-shopify-app-block],
  #shopify-section-{{ section.id }} .product-info [id*="loyalty" i],
  #shopify-section-{{ section.id }} .product-info [class*="loyalty" i],
  #shopify-section-{{ section.id }} .product-info [id*="reward" i],
  #shopify-section-{{ section.id }} .product-info [class*="reward" i] {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  /* ── Vendor badge ─────────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .product-info .vendor,
  #shopify-section-{{ section.id }} .product-info a[href*="/vendors"],
  #shopify-section-{{ section.id }} .product-info a[href*="vendor" i] {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    min-height: 30px;
    padding: 5px 10px;
    border: 1px solid var(--snh-line);
    border-radius: 8px;
    background: #ffffff;
    color: var(--snh-dark) !important;
    font-size: 0.8rem;
    font-weight: 850;
    text-decoration: none !important;
    box-shadow: 0 2px 6px rgba(17,17,17,.04);
    margin-block-end: 6px;
  }

  #shopify-section-{{ section.id }} .product-info .vendor::after,
  #shopify-section-{{ section.id }} .product-info a[href*="/vendors"]::after,
  #shopify-section-{{ section.id }} .product-info a[href*="vendor" i]::after {
    content: "View brand";
    color: var(--snh-orange);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* ── Display headings → Archivo, to match SNH Elite ──────────── */
  .jdgm-rev-widg__title,
  .text-with-icons h2,
  .text-with-icons .section-header__title,
  .wk-tiktok__heading,
  .wk-tiktok__title,
  .snh-modal-head h3 {
    font-family: var(--snh-display, 'Archivo', system-ui, sans-serif) !important;
    font-weight: 800 !important;
  }

  /* ── Title (reverted to theme-natural size) ──────────────────── */
  #shopify-section-{{ section.id }} .product-info h1,
  #shopify-section-{{ section.id }} .product-info .product-title,
  #shopify-section-{{ section.id }} .product-info [class*="title" i] h1,
  #shopify-section-{{ section.id }} .product-info [class*="title" i] h2 {
    max-width: 30ch;
    color: var(--snh-dark) !important;
    text-wrap: balance;
    margin-block-end: 8px;
  }

  /* ── Description ──────────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .product-info [class*="description" i],
  #shopify-section-{{ section.id }} .product-info .prose,
  #shopify-section-{{ section.id }} .product-info .rte {
    max-width: 56ch;
    color: rgba(23,23,23,.76) !important;
    font-size: clamp(0.95rem, 1vw, 1.08rem) !important;
    line-height: 1.65 !important;
    font-weight: 520;
  }

  /* ── Variant picker ───────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .product-info variant-picker,
  #shopify-section-{{ section.id }} .product-info .variant-picker {
    display: grid;
    gap: 12px;
    margin-block: clamp(14px, 1.3vw, 20px) clamp(8px, 0.7vw, 12px);
  }

  #shopify-section-{{ section.id }} .product-info .variant-picker__option,
  #shopify-section-{{ section.id }} .product-info fieldset.product-form__input {
    padding: 0;
    border: 0;
  }

  #shopify-section-{{ section.id }} .product-info .variant-picker__option-info,
  #shopify-section-{{ section.id }} .product-info .product-form__input legend,
  #shopify-section-{{ section.id }} .product-info .form__label {
    margin-block-end: 8px;
    color: rgba(23,23,23,.62);
    font-size: 0.88rem;
    font-weight: 850;
    letter-spacing: -0.01em;
  }

  #shopify-section-{{ section.id }} .product-info .variant-picker__option-values,
  #shopify-section-{{ section.id }} .product-info .product-form__input .h-stack,
  #shopify-section-{{ section.id }} .product-info .product-form__input .wrap {
    gap: 8px 10px;
  }

  #shopify-section-{{ section.id }} .product-info .block-swatch,
  #shopify-section-{{ section.id }} .product-info .block-swatch__item,
  #shopify-section-{{ section.id }} .product-info .variant-picker__option-values label:not(.sr-only),
  #shopify-section-{{ section.id }} .product-info .product-form__input input[type="radio"] + label {
    min-block-size: 42px;
    padding: 0 18px;
    border: 1px solid var(--snh-line-strong);
    border-radius: 8px;
    background: #ffffff;
    color: var(--snh-dark);
    font-weight: 700;
    line-height: 1;
    box-shadow: none;
    cursor: pointer;
