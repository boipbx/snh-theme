    #shopify-section-{{ section.id }} .product-info h1,
    #shopify-section-{{ section.id }} .product-info .product-title,
    #shopify-section-{{ section.id }} .product-info [class*="title" i] h1,
    #shopify-section-{{ section.id }} .product-info [class*="title" i] h2 {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .product-info .vendor::after,
    #shopify-section-{{ section.id }} .product-info a[href*="/vendors"]::after,
    #shopify-section-{{ section.id }} .product-info a[href*="vendor" i]::after {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-info buy-buttons,
    #shopify-section-{{ section.id }} .product-info .product-form__buttons {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .product-info variant-picker,
    #shopify-section-{{ section.id }} .product-info .variant-picker {
      gap: 12px;
      margin-block: clamp(12px, 1.4vw, 20px) clamp(8px, 0.8vw, 12px);
    }

    .snh-usps {
      gap: 7px 14px;
      padding: 11px 13px;
    }

    #shopify-section-{{ section.id }} .product-info .product-title,
    #shopify-section-{{ section.id }} .product-info h1 { font-size: 1.9rem !important; line-height: 1.05 !important; }
    #shopify-section-{{ section.id }} .product-info .price-list > [class*="price" i]:not([class*="compare" i]),
    #shopify-section-{{ section.id }} .product-info .price-list > span:first-child { font-size: 2.1rem; }
    .snh-subtitle { font-size: 0.86rem; margin-top: 5px; }
    .snh-topline { gap: 6px 12px; }
    /* compact vertical rhythm: theme gives every info block a big margin — halve it */
    #shopify-section-{{ section.id }} .product-info > * { margin-block-start: 0 !important; margin-block-end: 10px !important; }
    #shopify-section-{{ section.id }} .product-info > .product-title,
    #shopify-section-{{ section.id }} .product-info > h1 { margin-block-end: 2px !important; }
    #shopify-section-{{ section.id }} .product-info > .snh-topline { margin-block-end: 8px !important; }
    #shopify-section-{{ section.id }} .product-info > .snh-subtitle { margin-block-end: 8px !important; }
    #shopify-section-{{ section.id }} .product-info .prose p { margin-block: 0 0.5em; }
    #shopify-section-{{ section.id }} .product-info .prose { line-height: 1.55; }
    #shopify-section-{{ section.id }} .product-info variant-picker .v-stack,
    #shopify-section-{{ section.id }} .product-info .variant-picker__option { gap: 6px; }
    .snh-benefits { margin-block: 8px 0; }
    .snh-adv { margin-block: 10px 0; }
    .snh-bx { margin-block: 10px 0; }
    .snh-adv-links { grid-template-columns: 1fr; }
    .snh-adv-links a { justify-content: flex-start; padding: 9px 13px; font-size: 0.66rem; white-space: normal; border-top: 1px solid rgba(255, 242, 230, 0.09); border-left: 0 !important; }
    .snh-adv-links a:first-child { border-top: 0; }
    #shopify-section-{{ section.id }} .section { padding-block-start: 8px !important; }
    .snh-crumbs { margin: 0 0 10px; font-size: 0.7rem; gap: 6px; }
    .snh-bx-row { grid-template-columns: 42px minmax(0, 1fr); gap: 10px; padding: 8px 0; }
    .snh-bx-row img, .snh-bx-thumb { width: 42px; height: 42px; }
    .snh-info-row { padding: 9px 14px; }
    .snh-benefits { margin-block: 10px 2px; padding: 12px 14px; }
    .snh-benefit { padding: 6px 0; }
    .snh-usps { margin-block: 10px 0; }
    .snh-trust-item { padding: 10px 8px; }

    .snh-trust-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }
    .snh-trust-item {
      border-bottom: 1px solid var(--snh-line);
      padding: 12px 8px;
