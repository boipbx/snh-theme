{% comment %}
  SNH Performance Quiz — v3
  ► SELECT ALL → DELETE → PASTE THIS ENTIRE FILE
  ► Only one {% schema %} block exists — at the very bottom
{% endcomment %}

{% assign quiz_id = 'snhq-' | append: section.id %}
{% assign kicker_text = section.settings.kicker %}
{% if kicker_text == blank %}{% assign kicker_text = 'SNH Product Finder' %}{% endif %}
{% assign heading_text = section.settings.heading %}
{% if heading_text == blank %}{% assign heading_text = 'Find your performance match.' %}{% endif %}
{% assign subheading_text = section.settings.subheading %}
{% if subheading_text == blank %}{% assign subheading_text = 'Take the quick quiz and get routed to the SNH range that fits your sport, training style, and goal.' %}{% endif %}
{% assign whatsapp_number = section.settings.whatsapp_number | default: '' %}
{% assign logo_url = section.settings.logo_url %}
{% if logo_url == blank %}{% assign logo_url = 'https://www.sportsnutritionhub.lk/cdn/shop/files/ffd.png?v=1764319494&width=520' %}{% endif %}

<section id="{{ quiz_id }}" class="snhq" data-snhq data-whatsapp="{{ whatsapp_number | escape }}">
  <div class="snhq__scene">
    <div class="snhq__mesh"></div>
    <div class="snhq__blob snhq__blob--one"></div>
    <div class="snhq__blob snhq__blob--two"></div>

    <div class="snhq__shell">

      <!-- INTRO -->
      <div class="snhq__intro" data-welcome>
        <div class="snhq__eyebrow"><span></span>{{ kicker_text }}</div>
        <div class="snhq__hero-grid">
          <div class="snhq__hero-copy">
            <h1>{{ heading_text }}</h1>
            <p>{{ subheading_text }}</p>
            <div class="snhq__hero-actions">
              <button type="button" class="snhq__button snhq__button--primary" data-start>
                Start the quiz
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 5.5 20 12l-6.5 6.5M4 12h15"/></svg>
              </button>
              <small>8 quick questions · personalised result</small>
            </div>
          </div>
          <div class="snhq__play-card" aria-hidden="true">
            <div class="snhq__ring">
              <span><img src="{{ logo_url }}" alt="SNH" loading="lazy"></span>
              <i></i><i></i><i></i>
            </div>
            <div class="snhq__floating-pill snhq__floating-pill--a">
              <svg viewBox="0 0 24 24"><path d="M13 3 5 13.5h5l-1 7.5 8-10.5h-5z"/></svg>Energy
            </div>
            <div class="snhq__floating-pill snhq__floating-pill--b">
              <svg viewBox="0 0 24 24"><path d="M20 8A8 8 0 0 0 6 6.5L4 8.5M4 4.5v4h4"/><path d="M4 16a8 8 0 0 0 14 1.5l2-2M20 19.5v-4h-4"/></svg>Recovery
            </div>
            <div class="snhq__floating-pill snhq__floating-pill--c">
              <svg viewBox="0 0 24 24"><path d="M6.5 9v6M4 10.5v3M17.5 9v6M20 10.5v3M6.5 12h11"/></svg>Strength
            </div>
            <div class="snhq__mini-path">
              <div><b>01</b><span>Answer</span></div>
              <div><b>02</b><span>Match</span></div>
              <div><b>03</b><span>Shop</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- QUIZ -->
      <div class="snhq__quiz" data-question hidden>
        <div class="snhq__quiz-head">
          <div>
            <span class="snhq__step" data-step>Question 1</span>
            <h2 data-title></h2>
            <p data-help></p>
          </div>
          <div class="snhq__progress">
            <strong data-count>1/8</strong>
            <div><span data-bar></span></div>
          </div>
        </div>
        <div class="snhq__options" data-options></div>
        <div class="snhq__nav">
          <button type="button" class="snhq__button snhq__button--ghost" data-back>Back</button>
          <button type="button" class="snhq__button snhq__button--primary" data-next disabled>
            <span>Continue</span>
            <svg viewBox="0 0 24 24"><path d="M13.5 5.5 20 12l-6.5 6.5M4 12h15"/></svg>
          </button>
        </div>
      </div>

      <!-- RESULT -->
      <div class="snhq__result" data-result hidden>
        <div class="snhq__result-intro">
          <span class="snhq__result-logo"><img src="{{ logo_url }}" alt="SNH" loading="lazy"></span>
          <span class="snhq__result-found">
            <i class="snhq__burst" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></i>
            Match found
          </span>
        </div>
        <span class="snhq__result-badge" data-result-badge>Your result</span>
        <h2 data-result-title></h2>
        <p data-result-copy></p>

        <div class="snhq__safe-note" data-safe-note hidden>
          For younger customers, start with general wellness, hydration, and expert guidance before choosing performance supplements.
        </div>

        <!-- PRODUCT CARDS (image + name, direct product links, no collection routing) -->
        <div class="snhq__products">
          <h3>Picked for you</h3>
          <div class="snhq__products-scroll" data-result-products></div>
        </div>

        <!-- RANGE CHIPS -->
        <div class="snhq__result-panel">
          <h3>Recommended SNH ranges</h3>
          <div class="snhq__chips" data-result-ranges></div>
        </div>

        <div class="snhq__result-actions">
          <button type="button" class="snhq__button snhq__button--ghost" data-retake>Retake quiz</button>
        </div>

        <!-- WHATSAPP LEAD -->
        <div class="snhq__lead">
          <div>
            <h3>Want SNH to help you choose?</h3>
            <p>Send your result to WhatsApp with your answers included.</p>
          </div>
          <div class="snhq__fields">
            <input type="text" placeholder="Name" data-lead-name>
            <input type="tel" placeholder="Your WhatsApp number" data-lead-phone>
          </div>
          <button type="button" class="snhq__whatsapp" data-whatsapp-btn>Send result on WhatsApp</button>
          <small data-whatsapp-warning hidden></small>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #{{ quiz_id }}, #{{ quiz_id }} * { box-sizing: border-box; }

  #{{ quiz_id }} {
    --snhq-orange: #ff6500;
    --snhq-orange-soft: #ffb06b;
    --snhq-line: rgba(255,255,255,.13);
    font-family: inherit;
  }
  #{{ quiz_id }} [hidden] { display: none !important; }

  /* SCENE */
  #{{ quiz_id }} .snhq__scene {
    position: relative;
    overflow: hidden;
    min-height: 720px;
    padding: clamp(48px,7vw,92px) 20px;
    background:
      radial-gradient(circle at 18% 18%, rgba(255,101,0,.32), transparent 31%),
      radial-gradient(circle at 88% 14%, rgba(255,176,107,.18), transparent 28%),
      linear-gradient(135deg,#101114 0%,#17191f 48%,#0f1013 100%);
    color: #fff;
    isolation: isolate;
  }
  #{{ quiz_id }} .snhq__scene::after {
    content:"";
    position:absolute;
    inset:0;
    background:
      radial-gradient(circle at 50% 0%,rgba(255,255,255,.08),transparent 40%),
      linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
    background-size:100% 100%,48px 48px,48px 48px;
    mask-image:radial-gradient(circle at 50% 46%,black 0%,transparent 72%);
    pointer-events:none;
    animation:snhqGrid 28s linear infinite;
    z-index:-2;
  }
  #{{ quiz_id }} .snhq__mesh {
    position:absolute;inset:0;
    background:
      linear-gradient(115deg,transparent 0 18%,rgba(255,101,0,.12) 18% 18.4%,transparent 18.4% 100%),
      linear-gradient(65deg,transparent 0 28%,rgba(255,255,255,.08) 28% 28.25%,transparent 28.25% 100%);
    opacity:.9;pointer-events:none;z-index:-1;
  }
  #{{ quiz_id }} .snhq__blob { position:absolute;border-radius:999px;filter:blur(56px);pointer-events:none;opacity:.5;z-index:-1; }
  #{{ quiz_id }} .snhq__blob--one { width:260px;height:260px;left:-90px;bottom:90px;background:rgba(255,101,0,.26);animation:snhqBlobOne 9s ease-in-out infinite; }
  #{{ quiz_id }} .snhq__blob--two { width:310px;height:310px;right:-120px;top:86px;background:rgba(255,176,107,.18);animation:snhqBlobTwo 11s ease-in-out infinite; }
  #{{ quiz_id }} .snhq__shell { width:min(1120px,100%);margin:0 auto;position:relative;z-index:2; }

  #{{ quiz_id }} .snhq__intro,
  #{{ quiz_id }} .snhq__quiz,
  #{{ quiz_id }} .snhq__result {
    position:relative;
    border:1px solid var(--snhq-line);
    background:linear-gradient(180deg,rgba(255,255,255,.12),rgba(255,255,255,.06)),rgba(255,255,255,.04);
    box-shadow:0 34px 95px rgba(0,0,0,.36),inset 0 1px 0 rgba(255,255,255,.16);
    backdrop-filter:blur(24px);
  }

  /* INTRO */
  #{{ quiz_id }} .snhq__intro { border-radius:42px;padding:clamp(28px,5vw,58px);animation:snhqEnter .65s cubic-bezier(.2,.8,.2,1) both; }
  #{{ quiz_id }} .snhq__eyebrow {
    display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border-radius:999px;
    background:rgba(255,101,0,.16);border:1px solid rgba(255,101,0,.24);
    color:var(--snhq-orange-soft);font-size:12px;font-weight:950;letter-spacing:.08em;text-transform:uppercase;margin-bottom:26px;
  }
  #{{ quiz_id }} .snhq__eyebrow span { width:9px;height:9px;border-radius:999px;background:var(--snhq-orange);box-shadow:0 0 0 7px rgba(255,101,0,.16);animation:snhqPing 1.8s ease-in-out infinite; }
  #{{ quiz_id }} .snhq__hero-grid { display:grid;grid-template-columns:minmax(0,1fr) 420px;gap:clamp(28px,5vw,64px);align-items:center; }
  #{{ quiz_id }} h1,#{{ quiz_id }} h2,#{{ quiz_id }} h3,#{{ quiz_id }} p { margin:0; }
  #{{ quiz_id }} h1 { max-width:560px;color:#fff;font-size:clamp(34px,5.2vw,62px);line-height:1.02;letter-spacing:-.03em;font-weight:950; }
  #{{ quiz_id }} .snhq__hero-copy p { margin-top:22px;max-width:590px;color:rgba(255,255,255,.72);font-size:clamp(16px,1.7vw,19px);line-height:1.62;font-weight:650; }
  #{{ quiz_id }} .snhq__hero-actions { display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:34px; }
  #{{ quiz_id }} .snhq__hero-actions small,#{{ quiz_id }} .snhq__lead small { color:rgba(255,255,255,.52);font-size:13px;line-height:1.4; }

  /* PLAY CARD */
  #{{ quiz_id }} .snhq__play-card {
    min-height:430px;border-radius:34px;position:relative;overflow:hidden;
    background:radial-gradient(circle at 50% 34%,rgba(255,101,0,.22),transparent 36%),linear-gradient(180deg,rgba(255,255,255,.14),rgba(255,255,255,.06));
    border:1px solid rgba(255,255,255,.14);box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 24px 60px rgba(0,0,0,.20);
  }
  #{{ quiz_id }} .snhq__ring {
    --orbit-1:96px;--orbit-2:92px;--orbit-3:88px;
    width:190px;height:190px;border-radius:50%;position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);
    display:grid;place-items:center;
    background:radial-gradient(circle,#0d0e11 0 48%,rgba(255,101,0,.28) 49% 50%,transparent 51%),conic-gradient(from 120deg,rgba(255,101,0,.08),rgba(255,101,0,.80),rgba(255,255,255,.10),rgba(255,101,0,.08));
    box-shadow:0 0 0 18px rgba(255,255,255,.04),0 28px 70px rgba(0,0,0,.30);
    animation:snhqFloat 4.8s ease-in-out infinite;
  }
  #{{ quiz_id }} .snhq__ring span { width:98px;height:98px;border-radius:29px;display:grid;place-items:center;background:#090a0c;box-shadow:inset 0 1px 0 rgba(255,255,255,.08); }
  #{{ quiz_id }} .snhq__ring span img { width:66px;height:66px;object-fit:contain; }
  #{{ quiz_id }} .snhq__ring i { position:absolute;width:11px;height:11px;border-radius:50%;background:var(--snhq-orange);box-shadow:0 0 0 8px rgba(255,101,0,.16); }
  #{{ quiz_id }} .snhq__ring i:nth-child(2) { animation:snhqOrbitOne 5s linear infinite; }
  #{{ quiz_id }} .snhq__ring i:nth-child(3) { width:8px;height:8px;background:#fff;animation:snhqOrbitTwo 7s linear infinite; }
  #{{ quiz_id }} .snhq__ring i:nth-child(4) { width:7px;height:7px;animation:snhqOrbitThree 8s linear infinite; }
  #{{ quiz_id }} .snhq__floating-pill {
    position:absolute;padding:9px 14px 9px 10px;border-radius:999px;color:#fff;
    background:rgba(12,13,16,.7);border:1px solid rgba(255,255,255,.16);font-size:13px;font-weight:900;
    display:inline-flex;align-items:center;gap:7px;box-shadow:0 16px 35px rgba(0,0,0,.18);
  }
  #{{ quiz_id }} .snhq__floating-pill svg { width:15px;height:15px;fill:none;stroke:var(--snhq-orange-soft);stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0; }
  #{{ quiz_id }} .snhq__floating-pill--a { left:34px;top:54px;animation:snhqBob 4.6s ease-in-out infinite; }
  #{{ quiz_id }} .snhq__floating-pill--b { right:34px;top:116px;animation:snhqBob 5s ease-in-out infinite .3s; }
  #{{ quiz_id }} .snhq__floating-pill--c { left:62px;bottom:126px;animation:snhqBob 5.4s ease-in-out infinite .6s; }
  #{{ quiz_id }} .snhq__mini-path { position:absolute;left:18px;right:18px;bottom:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px; }
  #{{ quiz_id }} .snhq__mini-path div { min-height:78px;padding:12px;border-radius:20px;display:flex;flex-direction:column;justify-content:flex-end;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.10); }
  #{{ quiz_id }} .snhq__mini-path b { color:var(--snhq-orange);font-size:12px;margin-bottom:6px; }
  #{{ quiz_id }} .snhq__mini-path span { color:rgba(255,255,255,.84);font-size:13px;font-weight:850; }

  /* QUIZ & RESULT shared */
  #{{ quiz_id }} .snhq__quiz,
  #{{ quiz_id }} .snhq__result {
    width:min(860px,100%);margin:0 auto;border-radius:38px;
    padding:clamp(24px,4.5vw,44px);animation:snhqEnter .45s cubic-bezier(.2,.8,.2,1) both;
  }
  #{{ quiz_id }} .snhq__quiz-head { display:flex;align-items:flex-start;justify-content:space-between;gap:28px;margin-bottom:28px; }
  #{{ quiz_id }} .snhq__step,#{{ quiz_id }} .snhq__result-badge {
    display:inline-flex;align-items:center;padding:9px 12px;border-radius:999px;
    background:rgba(255,101,0,.15);color:var(--snhq-orange-soft);border:1px solid rgba(255,101,0,.22);
    font-size:12px;font-weight:950;letter-spacing:.06em;text-transform:uppercase;margin-bottom:14px;
  }
  #{{ quiz_id }} h2 { color:#fff;font-size:clamp(26px,3.2vw,42px);line-height:1.08;letter-spacing:-.02em;font-weight:850; }
  #{{ quiz_id }} .snhq__quiz-head p,#{{ quiz_id }} .snhq__result > p,#{{ quiz_id }} .snhq__lead p { margin-top:12px;color:rgba(255,255,255,.66);font-size:15.5px;line-height:1.58;font-weight:650; }
  #{{ quiz_id }} .snhq__progress { min-width:150px;text-align:right; }
  #{{ quiz_id }} .snhq__progress strong { color:rgba(255,255,255,.76);font-size:13px;font-weight:950; }
  #{{ quiz_id }} .snhq__progress div { height:9px;width:150px;margin-top:10px;overflow:hidden;border-radius:999px;background:rgba(255,255,255,.10); }
  #{{ quiz_id }} .snhq__progress span { display:block;height:100%;width:0%;border-radius:inherit;background:linear-gradient(90deg,var(--snhq-orange),var(--snhq-orange-soft));box-shadow:0 0 22px rgba(255,101,0,.45);transition:width .45s cubic-bezier(.2,.8,.2,1); }

  /* OPTIONS — fixed alignment */
  #{{ quiz_id }} .snhq__options { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px; }
  #{{ quiz_id }} .snhq__option {
    position:relative;
    min-height:126px;
    padding:18px 52px 18px 18px; /* ← extra right padding clears the radio */
    border:1px solid rgba(255,255,255,.12);border-radius:24px;
    background:rgba(255,255,255,.07);color:#fff;text-align:left;cursor:pointer;
    opacity:0;transform:translateY(12px);
    animation:snhqOptionIn .42s cubic-bezier(.2,.8,.2,1) forwards;
    transition:transform .3s cubic-bezier(.22,1,.36,1),border-color .2s ease,background .2s ease,box-shadow .3s cubic-bezier(.22,1,.36,1);
  }
  #{{ quiz_id }} .snhq__option:nth-child(1){animation-delay:.02s}
  #{{ quiz_id }} .snhq__option:nth-child(2){animation-delay:.06s}
  #{{ quiz_id }} .snhq__option:nth-child(3){animation-delay:.10s}
  #{{ quiz_id }} .snhq__option:nth-child(4){animation-delay:.14s}
  #{{ quiz_id }} .snhq__option:nth-child(5){animation-delay:.18s}
  #{{ quiz_id }} .snhq__option:nth-child(6){animation-delay:.22s}
  #{{ quiz_id }} .snhq__option .snhq__ic {
    width:46px;height:46px;border-radius:15px;display:grid;place-items:center;margin-bottom:16px;
    color:var(--snhq-orange);background:linear-gradient(155deg,rgba(255,101,0,.16),rgba(255,101,0,.03));
    border:1px solid rgba(255,101,0,.22);box-shadow:inset 0 1px 0 rgba(255,255,255,.08);
    transition:transform .32s cubic-bezier(.22,1,.36,1),background .25s ease,border-color .25s ease;
    flex-shrink:0;
  }
  #{{ quiz_id }} .snhq__option .snhq__ic svg { width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round; }
  #{{ quiz_id }} .snhq__option.is-selected .snhq__ic { background:linear-gradient(155deg,rgba(255,101,0,.34),rgba(255,101,0,.10));border-color:rgba(255,101,0,.62);transform:scale(1.07); }
  @media (hover:hover) {
    #{{ quiz_id }} .snhq__option:hover .snhq__ic { transform:translateY(-2px) rotate(-4deg);border-color:rgba(255,101,0,.4); }
  }
  /* Radio circle — vertical centre right */
  #{{ quiz_id }} .snhq__option::after {
    content:"";position:absolute;
    top:50%;right:18px;
    transform:translateY(-50%);
    width:20px;height:20px;
    border:2px solid rgba(255,255,255,.22);border-radius:999px;
    transition:border-color .22s ease,box-shadow .22s ease,background .22s ease;
    flex-shrink:0;
  }
  @media (hover:hover) {
    #{{ quiz_id }} .snhq__option:hover { transform:translateY(-3px);border-color:rgba(255,101,0,.44);background:rgba(255,255,255,.10);box-shadow:0 18px 40px rgba(0,0,0,.18); }
  }
  #{{ quiz_id }} .snhq__option:active { transform:scale(.985);transition-duration:.12s; }
  #{{ quiz_id }} .snhq__option.is-selected { border-color:rgba(255,101,0,.78);background:rgba(255,101,0,.16);box-shadow:0 22px 45px rgba(255,101,0,.12); }
  #{{ quiz_id }} .snhq__option.is-selected::after { border-color:var(--snhq-orange);background:var(--snhq-orange);box-shadow:0 0 0 7px rgba(255,101,0,.16); }
  #{{ quiz_id }} .snhq__option strong { display:block;color:#fff;font-size:16px;line-height:1.18;font-weight:950; }
  #{{ quiz_id }} .snhq__option span { display:block;margin-top:7px;color:rgba(255,255,255,.58);font-size:13px;line-height:1.42;font-weight:650; }

  /* BUTTONS */
  #{{ quiz_id }} .snhq__nav,#{{ quiz_id }} .snhq__result-actions {
    display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center;margin-top:28px;
  }
  #{{ quiz_id }} .snhq__button,#{{ quiz_id }} .snhq__whatsapp {
    appearance:none;min-height:54px;border:0;border-radius:999px;padding:16px 22px;
    display:inline-flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;
    text-decoration:none;font-size:15px;font-weight:950;
    transition:transform .26s cubic-bezier(.22,1,.36,1),opacity .22s ease,box-shadow .26s cubic-bezier(.22,1,.36,1),background .22s ease;
  }
  #{{ quiz_id }} .snhq__button svg { width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2.3;stroke-linecap:round;stroke-linejoin:round;transition:transform .22s ease; }
  #{{ quiz_id }} .snhq__button--primary { background:var(--snhq-orange);color:#fff;box-shadow:0 16px 36px rgba(255,101,0,.24); }
  #{{ quiz_id }} .snhq__button--ghost { background:rgba(255,255,255,.10);color:#fff;border:1px solid rgba(255,255,255,.13); }
  @media (hover:hover) {
    #{{ quiz_id }} .snhq__button:hover,#{{ quiz_id }} .snhq__whatsapp:hover { transform:translateY(-2px); }
    #{{ quiz_id }} .snhq__button--primary:hover { box-shadow:0 20px 46px rgba(255,101,0,.34); }
    #{{ quiz_id }} .snhq__button--primary:hover svg { transform:translateX(3px); }
  }
  #{{ quiz_id }} .snhq__button:active,#{{ quiz_id }} .snhq__whatsapp:active { transform:scale(.97);transition-duration:.1s; }
  #{{ quiz_id }} .snhq__button:disabled { background:rgba(255,255,255,.07);color:rgba(255,255,255,.42);cursor:not-allowed;transform:none;box-shadow:none; }

  /* RESULT */
  #{{ quiz_id }} .snhq__result { text-align:center; }
  #{{ quiz_id }} .snhq__result-intro { display:flex;justify-content:center;align-items:center;gap:10px;margin:0 0 16px; }
  #{{ quiz_id }} .snhq__result-logo { width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:#0b0c0f;border:1px solid rgba(255,101,0,.28);box-shadow:0 0 0 6px rgba(255,101,0,.08);flex-shrink:0; }
  #{{ quiz_id }} .snhq__result-logo img { width:24px;height:24px;object-fit:contain; }
  #{{ quiz_id }} .snhq__result-found { position:relative;color:var(--snhq-orange-soft);font-size:13px;font-weight:900;letter-spacing:.1em;text-transform:uppercase; }
