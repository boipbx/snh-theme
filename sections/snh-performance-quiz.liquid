      people:'<svg viewBox="0 0 24 24"><circle cx="9" cy="8.5" r="2.7"/><path d="M3.8 19a5.2 5.2 0 0 1 10.4 0"/><circle cx="17" cy="9.5" r="2"/><path d="M15 19a4 4 0 0 1 6.5-3.1"/></svg>',
      team:'<svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="2.4"/><path d="M8 18a4 4 0 0 1 8 0"/><circle cx="5" cy="10" r="2"/><path d="M2 18a3.4 3.4 0 0 1 5-3"/><circle cx="19" cy="10" r="2"/><path d="M22 18a3.4 3.4 0 0 0-5-3"/></svg>',
      search:'<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="M20.5 20.5 16 16"/></svg>',
      shield:'<svg viewBox="0 0 24 24"><path d="M12 3 19 6v5.5c0 4.4-3 7.5-7 8.9-4-1.4-7-4.5-7-8.9V6z"/></svg>',
      bolt:'<svg viewBox="0 0 24 24"><path d="M13 3 5 13.5h5l-1 7.5 8-10.5h-5z"/></svg>',
      target:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7.6"/><circle cx="12" cy="12" r="3.4"/></svg>',
      heart:'<svg viewBox="0 0 24 24"><path d="M12 20.5C5.5 16.3 3.5 12.3 3.5 9.2 3.5 6.5 5.6 4.5 8 4.5c1.7 0 3 .9 4 2.6 1-1.7 2.3-2.6 4-2.6 2.4 0 4.5 2 4.5 4.7 0 3.1-2 7.1-8.5 11.3z"/></svg>',
      dots:'<svg viewBox="0 0 24 24"><path d="M6 12h.01M12 12h.01M18 12h.01"/></svg>',
      dumbbell:'<svg viewBox="0 0 24 24"><path d="M6.5 9v6M4 10.5v3M17.5 9v6M20 10.5v3M6.5 12h11"/></svg>',
      pulse:'<svg viewBox="0 0 24 24"><path d="M3 12h4l2-5.5 3.5 11L15 9l2 3h4"/></svg>',
      court:'<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M12 5v14M3 12h18"/></svg>',
      ball:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8.2l3.2 2.3-1.2 3.8h-4l-1.2-3.8z"/></svg>',
      leaf:'<svg viewBox="0 0 24 24"><path d="M5 19C4 11 9 5 19 5c.5 8-5 14-14 14z"/><path d="M9.5 14.5C12 11 15 9 18 8"/></svg>',
      calendar:'<svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="14.5" rx="2.2"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/></svg>',
      moon:'<svg viewBox="0 0 24 24"><path d="M20 14.2A8 8 0 1 1 9.8 4 6.3 6.3 0 0 0 20 14.2z"/></svg>',
      refresh:'<svg viewBox="0 0 24 24"><path d="M20 8A8 8 0 0 0 6 6.5L4 8.5M4 4.5v4h4"/><path d="M4 16a8 8 0 0 0 14 1.5l2-2M20 19.5v-4h-4"/></svg>',
      droplet:'<svg viewBox="0 0 24 24"><path d="M12 3.5s6 6.3 6 10.5a6 6 0 0 1-12 0c0-4.2 6-10.5 6-10.5z"/></svg>',
      scale:'<svg viewBox="0 0 24 24"><path d="M12 4v16M7.5 7.5h9M9 20.5h6"/><path d="M7.5 7.5 4.5 14a3 3 0 0 0 6 0zM16.5 7.5 13.5 14a3 3 0 0 0 6 0z"/></svg>',
      battery:'<svg viewBox="0 0 24 24"><rect x="3" y="8" width="15" height="8" rx="2.2"/><path d="M21 11v2M6.5 11.5v1"/></svg>',
      question:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M9.5 9.3a2.6 2.6 0 0 1 5 .9c0 1.8-2.5 2.3-2.5 3.8M12 17h.01"/></svg>',
      check:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M8 12.2l2.7 2.8L16 9.5"/></svg>',
      trophy:'<svg viewBox="0 0 24 24"><path d="M7 4.5h10v3.5a5 5 0 0 1-10 0z"/><path d="M7 5.5H4.2V8a3 3 0 0 0 2.8 3M17 5.5h2.8V8a3 3 0 0 1-2.8 3M9.5 14h5M10 17.5h4M9 20.5h6"/></svg>',
      sparkle:'<svg viewBox="0 0 24 24"><path d="M12 4l1.6 4.8L18 10.5l-4.4 1.7L12 17l-1.6-4.8L6 10.5l4.4-1.7z"/><path d="M18.5 15.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/></svg>',
      coffee:'<svg viewBox="0 0 24 24"><path d="M5 9h11v4a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z"/><path d="M16 10h1.8a2 2 0 0 1 0 4H16M4.5 20.5h12M5 5l14 14"/></svg>',
      mars:'<svg viewBox="0 0 24 24"><circle cx="10" cy="14" r="4.8"/><path d="M14.5 9.5 20 4M20 4h-4.5M20 4v4.5"/></svg>',
      venus:'<svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="4.8"/><path d="M12 13.8V21M9 18h6"/></svg>'
    };
    var ICON_MAP = {
      ME:I.person,FM:I.people,TM:I.team,BR:I.search,
      U18:I.shield,"18":I.bolt,"31":I.target,"46":I.heart,NA:I.dots,
      GY:I.dumbbell,EN:I.pulse,PD:I.court,TS:I.ball,WL:I.leaf,
      "02":I.leaf,"34":I.calendar,"5+":I.bolt,NO:I.moon,
      EG:I.bolt,RC:I.refresh,MS:I.dumbbell,HY:I.droplet,WV:I.heart,WM:I.scale,
      TI:I.battery,SO:I.refresh,CS:I.calendar,"?":I.question,OK:I.check,
      MN:I.mars,WN:I.venus,PF:I.trophy,NP:I.sparkle,
      CF:I.coffee,VG:I.leaf,IS:I.shield
    };

    // DOM refs
    var welcome = root.querySelector("[data-welcome]");
    var question = root.querySelector("[data-question]");
    var result = root.querySelector("[data-result]");
    var step = root.querySelector("[data-step]");
    var title = root.querySelector("[data-title]");
    var help = root.querySelector("[data-help]");
    var count = root.querySelector("[data-count]");
    var bar = root.querySelector("[data-bar]");
    var optionsWrap = root.querySelector("[data-options]");
    var startBtn = root.querySelector("[data-start]");
    var backBtn = root.querySelector("[data-back]");
    var nextBtn = root.querySelector("[data-next]");
    var retakeBtn = root.querySelector("[data-retake]");
    var resultBadge = root.querySelector("[data-result-badge]");
    var resultTitle = root.querySelector("[data-result-title]");
    var resultCopy = root.querySelector("[data-result-copy]");
    var resultRanges = root.querySelector("[data-result-ranges]");
    var resultProducts = root.querySelector("[data-result-products]");
    var safeNote = root.querySelector("[data-safe-note]");
    var whatsappBtn = root.querySelector("[data-whatsapp-btn]");
    var whatsappWarning = root.querySelector("[data-whatsapp-warning]");
    var leadName = root.querySelector("[data-lead-name]");
    var leadPhone = root.querySelector("[data-lead-phone]");

    function getOption(q, value) {
      for (var i = 0; i < q.options.length; i++) {
        if (q.options[i][2] === value) return q.options[i];
      }
      return null;
    }

    function renderQuestion() {
      var q = questions[state.index];
      var sel = state.answers[q.id];
      welcome.hidden = true; result.hidden = true; question.hidden = false;
      question.style.animation = "none"; question.offsetHeight; question.style.animation = "";
      step.textContent = "Question " + (state.index + 1);
      title.textContent = q.title; help.textContent = q.help;
      count.textContent = (state.index + 1) + "/" + questions.length;
      bar.style.width = (((state.index + 1) / questions.length) * 100) + "%";
      optionsWrap.innerHTML = "";
      q.options.forEach(function(opt) {
        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "snhq__option" + (sel === opt[2] ? " is-selected" : "");
        btn.innerHTML = '<i class="snhq__ic">' + (ICON_MAP[opt[4]] || I.dots) + '</i><strong>' + opt[0] + "</strong><span>" + opt[1] + "</span>";
        btn.addEventListener("click", function() {
          state.answers[q.id] = opt[2];
          Array.prototype.slice.call(optionsWrap.querySelectorAll(".snhq__option")).forEach(function(el) { el.classList.remove("is-selected"); });
          btn.classList.add("is-selected");
          nextBtn.disabled = false;
        });
        optionsWrap.appendChild(btn);
      });
      backBtn.style.visibility = state.index === 0 ? "hidden" : "visible";
      nextBtn.querySelector("span").textContent = state.index === questions.length - 1 ? "See my match" : "Continue";
      nextBtn.disabled = !sel;
    }

    function calculateResult() {
      var score = {performance:0,endurance:0,strength:0,recovery:0,wellness:0,weight:0};
      questions.forEach(function(q) {
        var opt = getOption(q, state.answers[q.id]);
        if (!opt) return;
        Object.keys(opt[3] || {}).forEach(function(k) { score[k] += opt[3][k]; });
      });
      var winner = Object.keys(score).sort(function(a,b){return score[b]-score[a];})[0];
      if (state.answers.age === "under18" && (winner === "weight" || winner === "strength")) {
        winner = state.answers.goal === "hydration" ? "recovery" : "wellness";
      }
      return winner;
    }

    // Fetch product image from Shopify AJAX API
    function loadProductImage(card, url) {
      var handle = (url.split("/products/")[1] || "").split("?")[0];
      if (!handle) return;
      var imgEl = card.querySelector(".snhq__product-img");
      var phEl  = card.querySelector(".snhq__product-ph");
      fetch("/products/" + handle + ".js")
        .then(function(r) { if (!r.ok) throw 0; return r.json(); })
        .then(function(data) {
          var src = data.featured_image || (data.images && data.images[0]);
          if (!src) return;
          if (typeof src === "string" && src.indexOf("//") === 0) src = "https:" + src;
          // Shopify CDN: strip existing params, add sizing
          src = src.split("?")[0] + "?width=480";
          imgEl.onload = function() {
            imgEl.style.opacity = "1";
            if (phEl) phEl.style.opacity = "0";
          };
          imgEl.onerror = function() { /* keep placeholder */ };
          imgEl.src = src;
        })
        .catch(function() { /* keep placeholder */ });
    }

    function renderResult() {
      state.resultKey = calculateResult();
      var r = results[state.resultKey];
      welcome.hidden = true; question.hidden = true; result.hidden = false;
      result.style.animation = "none"; result.offsetHeight; result.style.animation = "";
      resultBadge.textContent = r.badge;
      resultTitle.textContent = r.title;
      resultCopy.textContent = r.copy;
      safeNote.hidden = state.answers.age !== "under18";

      // Range chips
      resultRanges.innerHTML = "";
      r.ranges.forEach(function(range, i) {
        var chip = document.createElement("span");
        chip.className = "snhq__chip";
        chip.style.animationDelay = (i * 0.05) + "s";
        chip.textContent = range;
        resultRanges.appendChild(chip);
      });

      // Product cards with images
      if (resultProducts) {
        resultProducts.innerHTML = "";
        (r.products || []).forEach(function(p, i) {
          var card = document.createElement("a");
          card.href = p.url;
          card.className = "snhq__product-card";
          card.style.animationDelay = (i * 0.07) + "s";
          card.setAttribute("aria-label", p.brand + " — " + p.name);
          card.innerHTML =
            '<div class="snhq__product-img-wrap">' +
              '<img class="snhq__product-img" src="" alt="' + p.name + '" loading="lazy">' +
              '<div class="snhq__product-ph"><span>' + p.brand.charAt(0) + '</span></div>' +
            '</div>' +
            '<div class="snhq__product-body">' +
              '<span class="snhq__product-brand">' + p.brand + '</span>' +
              '<span class="snhq__product-name">' + p.name + '</span>' +
              '<span class="snhq__product-cta">Shop now ' +
                '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 5.5 20 12l-6.5 6.5M4 12h15"/></svg>' +
              '</span>' +
            '</div>';
          resultProducts.appendChild(card);
          loadProductImage(card, p.url);
        });
      }

      // WhatsApp
      if (!whatsappNumber) {
        whatsappBtn.disabled = true; whatsappBtn.style.opacity = ".45"; whatsappBtn.style.cursor = "not-allowed";
        whatsappWarning.hidden = false;
      } else {
        whatsappBtn.disabled = false; whatsappBtn.style.opacity = "1"; whatsappBtn.style.cursor = "pointer";
        whatsappWarning.hidden = true;
      }
    }

    function answerSummary() {
      return questions.map(function(q) {
        var opt = getOption(q, state.answers[q.id]);
        return q.title + " " + (opt ? opt[0] : "-");
      }).join("\n");
    }

    function openWhatsApp() {
      if (!whatsappNumber || !state.resultKey) return;
      var r = results[state.resultKey];
      var msg =
        "Hi SNH, I completed the Performance Quiz.\n\n" +
        "Name: " + (leadName.value.trim() || "-") + "\n" +
        "Customer WhatsApp: " + (leadPhone.value.trim() || "-") + "\n" +
        "Quiz Result: " + r.badge + "\n" +
        "Recommended Ranges: " + r.ranges.join(", ") + "\n\n" +
        "Answers:\n" + answerSummary();
      window.open("https://wa.me/" + whatsappNumber + "?text=" + encodeURIComponent(msg), "_blank");
    }

    startBtn.addEventListener("click", function() { state.index = 0; renderQuestion(); });
    backBtn.addEventListener("click", function() { if (state.index > 0) { state.index--; renderQuestion(); } });
    nextBtn.addEventListener("click", function() {
      if (state.index < questions.length - 1) { state.index++; renderQuestion(); }
      else { renderResult(); }
    });
    retakeBtn.addEventListener("click", function() { state.index = 0; state.answers = {}; state.resultKey = null; renderQuestion(); });
    whatsappBtn.addEventListener("click", openWhatsApp);
  }

  document.querySelectorAll("[data-snhq]").forEach(initSnhQuiz);
  document.addEventListener("shopify:section:load", function(e) {
    var root = e.target.querySelector("[data-snhq]");
    if (root) initSnhQuiz(root);
  });
})();
</script>

{% schema %}
{
  "name": "SNH Quiz",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "SNH Product Finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your performance match." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Take the quick quiz and get routed to the SNH range that fits your sport, training style, and goal." },
    { "type": "text", "id": "logo_url", "label": "Logo image URL", "info": "Leave blank to use the default SNH logo." },
    { "type": "text", "id": "whatsapp_number", "label": "SNH WhatsApp number", "info": "International format without +. Example: 947XXXXXXXX" }
  ],
  "presets": [{ "name": "SNH Quiz" }]
}
{% endschema %}
