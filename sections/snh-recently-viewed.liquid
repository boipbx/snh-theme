{%- comment -%}
  Recently viewed (Round 6): the visitor's last viewed products (saved by snippets/js-variables), the v2 card, 2 → 4
  columns. Loaded by the theme's <recently-viewed-products> element through search; with no history the section removes
  itself.
{%- endcomment -%}
{{ 'snh-product.css' | asset_url | stylesheet_tag }}
{%- assign hid = 'rv-' | append: section.id -%}
<section data-sp-recs class="v2 sp-sec{% if section.settings.cream %} sp-sec--cream{% endif %}" aria-labelledby="{{ hid }}">
  <recently-viewed-products products-count="{{ section.settings.limit }}"{% if request.page_type == 'product' %} exclude-id="{{ product.id }}"{% endif %}>
    {%- if search.performed and search.results_count > 0 -%}
      <div class="sp-wrap">
        <div class="sp-head">
          <h2 class="sp-head__t" id="{{ hid }}">{% render 'snh-v2-heading', text: section.settings.heading %}</h2>
        </div>
        <div class="sp-cards">
          {%- for p in search.results limit: section.settings.limit -%}{%- render 'snh-v2-card', product: p, sizes: '(max-width: 1023px) 50vw, 300px' -%}{%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </recently-viewed-products>
</section>

{% schema %}
{
  "name": "SNH recently viewed",
  "class": "snh-sec",
  "settings": [
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 2, "default": 4 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently *viewed*" },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": false }
  ],
  "presets": [{ "name": "SNH recently viewed" }]
}
{% endschema %}
