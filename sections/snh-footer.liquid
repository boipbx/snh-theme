{%- comment -%}
  SNH footer v2: stores + menu columns, payments line, socials, legal, and the full-width SNH logo that bleeds off the
  bottom edge under a black gradient, with a wipe reveal and the orange dot pop (assets/snh-v2.js data-v2="reveal").
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'snh-capture.css' | asset_url }}" media="print" onload="this.media='all'"><noscript>{{ 'snh-capture.css' | asset_url | stylesheet_tag }}</noscript>
<footer class="v2 ftr footer">
  <div class="v-wrap">
    {%- if section.settings.news_show -%}
      {%- comment -%} Round 11: the inline newsletter (snippets/snh-email-form, same form as the homepage band) {%- endcomment -%}
      <div class="ftr__news">
        <div class="ftr__news-t"><p class="ftr__news-h">{% render 'snh-v2-heading', text: section.settings.news_heading %}</p>{%- if section.settings.news_text != blank -%}<p class="ftr__news-p">{{ section.settings.news_text | escape }}</p>{%- endif -%}</div>
        {%- assign nfid = 'ftr-news-' | append: section.id -%}
        {%- render 'snh-email-form', id: nfid, tags: 'newsletter,footer', button: 'Subscribe' -%}
      </div>
    {%- endif -%}
    <div class="ftr__cols">
      {%- assign stores = section.blocks | where: 'type', 'store' -%}
      {%- if stores.size > 0 -%}
        <div class="ftr__col ftr__stores"><h3>{{ section.settings.stores_heading | escape }}</h3>
          {%- for b in stores -%}
            {%- assign tel = b.settings.phone | remove: ' ' | remove: '-' -%}
            <p {{ b.shopify_attributes }}><strong>{{ b.settings.name | escape }}</strong>{{ b.settings.address | escape }}{% if b.settings.phone != blank %} · <a href="tel:{{ tel }}">{{ b.settings.phone | escape }}</a>{% endif %}</p>
          {%- endfor -%}
          {%- if section.settings.hours != blank -%}<p class="ftr__hours">{{ section.settings.hours | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- for b in section.blocks -%}
        {%- if b.type == 'menu' -%}
          <div class="ftr__col" {{ b.shopify_attributes }}><h3>{{ b.settings.heading | escape }}</h3>
            <ul class="ftr__links">{% render 'snh-v2-links', menu: b.settings.menu, lines: b.settings.links %}</ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- capture koko_pay -%}<b class="ftr__koko">{% render 'snh-koko-logo', h: 14 %} pay in 3</b>{%- endcapture -%}
    <div class="ftr__pay">
      <span>{{ section.settings.payments | strip_html | escape | replace: 'Koko · pay in 3', koko_pay }}</span>
      <span class="ftr__social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
        {%- if settings.snh_whatsapp != blank -%}<a href="https://wa.me/{{ settings.snh_whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">WhatsApp</a>{%- endif -%}
      </span>
    </div>
    <div class="ftr__legal"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal | escape }}</span>
      {%- if section.settings.policy_links -%}
        <span class="ftr__policies">{%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endfor -%}</span>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.mark != blank -%}
    <div class="ftr__mark" aria-hidden="true" data-v2="reveal">
      <span class="ftr__wipe">{{ section.settings.mark | image_url: width: 2400 | image_tag: width: 1283, height: 374, alt: '', loading: 'lazy', sizes: '100vw', widths: '800,1200,1800,2400' }}</span>
      {%- if section.settings.dot -%}<i class="ftr__dot"></i>{%- endif -%}
    </div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "SNH footer",
  "class": "snh-ftr-sec shopify-section--footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "news_show",
      "label": "Show the newsletter row",
      "default": true
    },
    {
      "type": "text",
      "id": "news_heading",
      "label": "Heading",
      "default": "First to *know*"
    },
    {
      "type": "text",
      "id": "news_text",
      "label": "Text",
      "default": "New drops, restocks and member offers. No spam."
    },
    {
      "type": "text",
      "id": "stores_heading",
      "label": "Stores heading",
      "default": "Visit or call"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours line",
      "default": "Open every day · Support 10am–7pm"
    },
    {
      "type": "text",
      "id": "payments",
      "label": "Payments line",
      "default": "Pay by card, bank transfer, cash on delivery or Koko · pay in 3"
    },
    {
      "type": "paragraph",
      "content": "WhatsApp comes from Theme settings → SNH contact and reviews; Instagram, TikTok and Facebook from Theme settings → Social media."
    },
    {
      "type": "text",
      "id": "legal",
      "label": "Legal line",
      "default": "Sports Nutrition Hub (Pvt) Ltd."
    },
    {
      "type": "checkbox",
      "id": "policy_links",
      "label": "Show store policy links",
      "default": false
    },
    {
      "type": "header",
      "content": "Bleeding logo"
    },
    {
      "type": "image_picker",
      "id": "mark",
      "label": "Logo",
      "info": "Spans the full width, cropped by the bottom edge under a black gradient. Shown white."
    },
    {
      "type": "checkbox",
      "id": "dot",
      "label": "Orange dot",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dehiwala"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address",
          "default": "133A Kawdana Road"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+94 77 977 3359"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Info"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Pick a Navigation menu. When none is picked the lines below are used."
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Fallback links",
          "info": "One per line: Label | /pages/handle"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "presets": [
    {
      "name": "SNH footer",
      "blocks": [
        {
          "type": "store"
        },
        {
          "type": "menu"
        }
      ]
    }
  ]
}
{% endschema %}
