{%- comment -%}
  SNH ELITE — REFINED CUSTOMER LOGIN
  Focused member-access layout matching the SNH Elite registration aesthetic.
{%- endcomment -%}


<style>
  html, body { overflow-x: hidden; width: 100%; }

  #shopify-section-{{ section.id }} {
    --snh-black: var(--snh-ink);
    --snh-brown: #2a160f;
    --snh-orange: var(--snh-accent);
    --snh-orange-dark: var(--snh-accent-hover);
    --snh-cream: #fbf8f4;
    --snh-ink: var(--snh-ink);
    --snh-muted: var(--snh-muted);
    --snh-line: #eadfd5;
    --snh-display: var(--snh-font-display);
    --snh-sans: var(--snh-font-body);
  }

  #shopify-section-{{ section.id }} .snh-login-page,
  #shopify-section-{{ section.id }} .snh-login-page * { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .snh-login-page {
    width: 100%;
    min-height: min(840px, calc(100vh - 72px));
    background: var(--snh-cream);
    color: var(--snh-ink);
    font-family: var(--snh-sans);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .snh-login-shell {
    display: grid;
    grid-template-columns: minmax(520px, 1.08fr) minmax(520px, .92fr);
    min-height: inherit;
  }

  #shopify-section-{{ section.id }} .snh-login-visual {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: inherit;
    padding: clamp(48px, 5vw, 76px);
    overflow: hidden;
    background:
      radial-gradient(circle at 66% 76%, rgba(235,78,22,.22), transparent 28%),
      radial-gradient(circle at 22% 18%, rgba(235,78,22,.16), transparent 31%),
      linear-gradient(135deg, #2d180f 0%, #17100c 50%, #090908 100%);
  }

  #shopify-section-{{ section.id }} .snh-login-visual::before {
    content: none;
  }

  #shopify-section-{{ section.id }} .snh-login-visual::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    height: 33%;
    background: linear-gradient(180deg, transparent, rgba(5,5,5,.7));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .snh-login-copy {
    position: relative;
    z-index: 4;
    width: min(590px, 72%);
    padding-bottom: clamp(22px, 4vw, 64px);
  }

  #shopify-section-{{ section.id }} .snh-login-kicker {
    margin: 0 0 18px;
    color: #ff7544;
    font-family: var(--snh-display);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.4px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .snh-login-copy h1 {
    margin: 0;
    color: #fff;
    font-family: var(--snh-display);
    font-size: clamp(48px, 5.7vw, 86px);
    font-weight: 800;
    letter-spacing: -3px;
    line-height: .93;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .snh-login-copy h1 span { color: var(--snh-orange); }

  #shopify-section-{{ section.id }} .snh-login-copy p {
    max-width: 470px;
    margin: 22px 0 0;
    color: rgba(255,255,255,.67);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .snh-member-image-wrap {
    position: absolute;
    z-index: 2;
    right: clamp(-38px, 0vw, 18px);
    bottom: 0;
    width: min(47%, 500px);
    height: 88%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .snh-member-image-wrap::before {
    content: '';
    position: absolute;
    width: 90%;
    height: 58%;
    left: 7%;
    bottom: 4%;
    border-radius: 50%;
    background: rgba(235,78,22,.17);
    filter: blur(48px);
  }

  #shopify-section-{{ section.id }} .snh-member-image {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: bottom center;
    filter: saturate(.78) contrast(.94) drop-shadow(0 28px 32px rgba(0,0,0,.42));
    opacity: .9;
  }

  #shopify-section-{{ section.id }} .snh-float {
    position: absolute;
    z-index: 3;
    display: grid;
    place-items: center;
    pointer-events: none;
    opacity: .58;
    filter: drop-shadow(0 12px 16px rgba(0,0,0,.28));
    animation: snhLoginFloat 6.4s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .snh-float svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ section.id }} .snh-float--gift-a { width: 48px; height: 48px; top: 16%; right: 17%; transform: rotate(9deg); }
  #shopify-section-{{ section.id }} .snh-float--gift-b { width: 35px; height: 35px; top: 43%; left: 8%; animation-delay: -2.7s; transform: rotate(-12deg); opacity: .42; }
  #shopify-section-{{ section.id }} .snh-float--coin-a { width: 31px; height: 31px; top: 24%; left: 47%; animation-delay: -1.4s; }
  #shopify-section-{{ section.id }} .snh-float--coin-b { width: 22px; height: 22px; top: 10%; left: 23%; animation-delay: -4.1s; opacity: .35; }
  #shopify-section-{{ section.id }} .snh-float--coin-c { width: 18px; height: 18px; top: 50%; right: 9%; animation-delay: -3.3s; opacity: .28; }

  @keyframes snhLoginFloat {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .snh-float { animation: none; }
  }

  #shopify-section-{{ section.id }} .snh-login-form-zone {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(34px, 5vw, 74px);
    background:
      radial-gradient(circle at 100% 0%, rgba(235,78,22,.09), transparent 28%),
      var(--snh-cream);
  }

  #shopify-section-{{ section.id }} .snh-login-form-zone::before {
    content: none;
  }

  #shopify-section-{{ section.id }} .snh-login-card {
    position: relative;
    z-index: 1;
    width: min(510px, 100%);
    padding: clamp(34px, 4vw, 52px);
    border: 1px solid rgba(94,68,51,.14);
    border-radius: 28px;
    background: rgba(255,255,255,.78);
    box-shadow: 0 28px 80px rgba(71,45,28,.11);
    backdrop-filter: blur(16px);
  }

  #shopify-section-{{ section.id }} .snh-form-kicker {
    margin: 0 0 12px;
    color: var(--snh-orange);
    font-family: var(--snh-display);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.8px;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .snh-login-card h2 {
    margin: 0;
    color: var(--snh-ink);
    font-family: var(--snh-display);
    font-size: clamp(40px, 4vw, 58px);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: .98;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .snh-form-intro {
    max-width: 360px;
    margin: 13px auto 28px;
    color: var(--snh-muted);
    font-size: 14px;
    line-height: 1.55;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .snh-field { margin-bottom: 16px; text-align: left; }

  #shopify-section-{{ section.id }} .snh-field-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .snh-label {
    display: block;
    margin: 0 0 8px;
    color: #4c443d;
    font-size: 12px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .snh-field-head .snh-label { margin: 0; }

  #shopify-section-{{ section.id }} .snh-input {
    width: 100%;
    min-height: 56px;
    margin: 0;
    padding: 15px 17px;
    border: 1.5px solid #ded4ca;
    border-radius: 14px;
    outline: none;
    background: rgba(255,255,255,.86);
    color: var(--snh-ink);
    font: 600 15px/1.3 var(--snh-sans);
    transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
  }

  #shopify-section-{{ section.id }} .snh-input::placeholder { color: #aaa096; font-weight: 500; }
  #shopify-section-{{ section.id }} .snh-input:focus { border-color: var(--snh-orange); background: #fff; box-shadow: 0 0 0 4px rgba(235,78,22,.09); }

  #shopify-section-{{ section.id }} .snh-small-link {
    color: var(--snh-muted);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .snh-small-link:hover { color: var(--snh-orange); }

  #shopify-section-{{ section.id }} .snh-login-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: var(--snh-btn-h, 52px); padding: 0 28px; border: 0; border-radius: var(--snh-radius-button, 12px); background: var(--snh-accent); color: #fff; font-family: var(--snh-font-body); font-size: 15px; font-weight: 600; line-height: 1.2; letter-spacing: 0; text-transform: none; text-decoration: none; box-shadow: none; cursor: pointer; transition: filter 200ms var(--snh-ease), transform 200ms var(--snh-ease), background-color 200ms var(--snh-ease), color 200ms var(--snh-ease); width: 100%; margin-top: 7px; }

  #shopify-section-{{ section.id }} .snh-login-btn:hover { filter: brightness(.92); transform: translateY(-1px); box-shadow: none; }

  #shopify-section-{{ section.id }} .snh-form-foot {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--snh-line);
    color: var(--snh-muted);
    font-size: 13px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .snh-form-foot a {
    display: inline-block;
    margin-left: 5px;
    color: var(--snh-orange);
    font-weight: 800;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .snh-form-foot a:hover { text-decoration: underline; text-underline-offset: 4px; }

  #shopify-section-{{ section.id }} .snh-error,
  #shopify-section-{{ section.id }} .snh-success {
    margin: 0 0 18px;
    padding: 13px 15px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .snh-error { border: 1px solid #fecaca; background: #fff1f0; color: #a61b14; }
  #shopify-section-{{ section.id }} .snh-success { border: 1px solid #b7e8cf; background: #ecfbf3; color: #07633e; }

  #shopify-section-{{ section.id }} .snh-reset-copy {
    margin: 14px 0 24px;
    color: var(--snh-muted);
    font-size: 14px;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 1080px) {
    #shopify-section-{{ section.id }} .snh-login-shell { grid-template-columns: minmax(430px, .9fr) minmax(500px, 1.1fr); }
    #shopify-section-{{ section.id }} .snh-login-visual { padding: 48px 40px; }
    #shopify-section-{{ section.id }} .snh-login-copy { width: 78%; }
    #shopify-section-{{ section.id }} .snh-member-image-wrap { width: 48%; right: -32px; opacity: .86; }
  }

  @media (max-width: 820px) {
    #shopify-section-{{ section.id }} .snh-login-page { min-height: auto; background: var(--snh-ink); }
    #shopify-section-{{ section.id }} .snh-login-shell { display: block; }
    #shopify-section-{{ section.id }} .snh-login-visual {
      display: flex !important;
      min-height: 290px;
      align-items: center;
      padding: 38px 22px;
      background: var(--snh-ink);
    }
    #shopify-section-{{ section.id }} .snh-login-visual::after { height: 38%; opacity: .55; }
    #shopify-section-{{ section.id }} .snh-login-copy { width: 67%; padding: 0; }
    #shopify-section-{{ section.id }} .snh-login-copy h1 { font-size: clamp(38px, 9.2vw, 50px); letter-spacing: -1.6px; }
    #shopify-section-{{ section.id }} .snh-login-copy p { max-width: 390px; margin-top: 14px; font-size: 13px; line-height: 1.5; }
    #shopify-section-{{ section.id }} .snh-login-kicker { margin-bottom: 14px; font-size: 10px; }
    #shopify-section-{{ section.id }} .snh-member-image-wrap {
      display: flex !important;
      width: 39%;
      height: 91%;
      right: -2%;
      bottom: 0;
      opacity: .58;
    }
    #shopify-section-{{ section.id }} .snh-member-image-wrap::before {
      width: 88%;
      height: 54%;
      left: 8%;
      bottom: 2%;
      background: rgba(235,78,22,.14);
      filter: blur(42px);
    }
    #shopify-section-{{ section.id }} .snh-member-image { filter: saturate(.68) contrast(.91) drop-shadow(0 20px 26px rgba(0,0,0,.38)); }
    #shopify-section-{{ section.id }} .snh-float--gift-a,
    #shopify-section-{{ section.id }} .snh-float--coin-b,
    #shopify-section-{{ section.id }} .snh-float--coin-c { display: none; }
    #shopify-section-{{ section.id }} .snh-float--gift-b { display: block; width: 30px; height: 30px; top: 24%; left: auto; right: 8%; opacity: .28; }
    #shopify-section-{{ section.id }} .snh-float--coin-a { display: block; width: 24px; height: 24px; top: 64%; left: auto; right: 20%; opacity: .35; }
    #shopify-section-{{ section.id }} .snh-login-form-zone { min-height: auto; padding: 18px 18px 46px; align-items: flex-start; background: var(--snh-ink); }
    #shopify-section-{{ section.id }} .snh-login-card { padding: 36px 24px; border-radius: 24px; }
  }

  @media (max-width: 420px) {
    #shopify-section-{{ section.id }} .snh-login-visual { min-height: 260px; padding: 30px 17px; }
    #shopify-section-{{ section.id }} .snh-login-copy { width: 68%; }
    #shopify-section-{{ section.id }} .snh-login-copy h1 { font-size: 36px; letter-spacing: -1.2px; }
    #shopify-section-{{ section.id }} .snh-login-copy p { font-size: 12px; line-height: 1.45; }
    #shopify-section-{{ section.id }} .snh-member-image-wrap { width: 43%; height: 88%; right: -7%; opacity: .5; }
    #shopify-section-{{ section.id }} .snh-login-form-zone { min-height: auto; padding: 14px 12px 36px; align-items: flex-start; }
    #shopify-section-{{ section.id }} .snh-login-card { padding: 30px 19px; border-radius: 21px; }
    #shopify-section-{{ section.id }} .snh-login-card h2 { font-size: 38px; }
    #shopify-section-{{ section.id }} .snh-form-intro { margin-bottom: 24px; font-size: 13px; }
    #shopify-section-{{ section.id }} .snh-input { min-height: 54px; }
  }
</style>

<div class="snh-login-page">
  <div class="snh-login-shell">
    <section class="snh-login-visual" aria-label="SNH Elite member welcome">
      <div class="snh-login-copy">
        <div class="snh-login-kicker">SNH Elite Member Access</div>
        <h1>Welcome<br><span>Back.</span></h1>
        <p>Your rewards, member benefits and account details are ready when you are.</p>
      </div>

      <div class="snh-member-image-wrap" aria-hidden="true">
        <img
          class="snh-member-image"
          src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/boy.png?v=1783764655"
          alt=""
          width="1000"
          height="1400"
          loading="eager"
          fetchpriority="high"
        >
      </div>

      <span class="snh-float snh-float--gift-a" aria-hidden="true">
        <svg viewBox="0 0 48 48"><path fill="#f55c25" d="M7 20h34v23H7z"/><path fill="#ff8d62" d="M4 14h40v9H4z"/><path fill="#ffd0bd" d="M21 14h6v29h-6z"/><path fill="none" stroke="#ffd0bd" stroke-width="4" stroke-linecap="round" d="M24 14C12 13 12 5 18 5c4 0 6 5 6 9Zm0 0c12-1 12-9 6-9-4 0-6 5-6 9Z"/></svg>
      </span>
      <span class="snh-float snh-float--gift-b" aria-hidden="true">
        <svg viewBox="0 0 48 48"><path fill="#d74012" d="M7 20h34v23H7z"/><path fill="#f06a3c" d="M4 14h40v9H4z"/><path fill="#ffc0a6" d="M21 14h6v29h-6z"/><path fill="none" stroke="#ffc0a6" stroke-width="4" stroke-linecap="round" d="M24 14C12 13 12 5 18 5c4 0 6 5 6 9Zm0 0c12-1 12-9 6-9-4 0-6 5-6 9Z"/></svg>
      </span>
      <span class="snh-float snh-float--coin-a" aria-hidden="true">
        <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="14" fill="#f2a126"/><circle cx="16" cy="16" r="10" fill="none" stroke="#ffd77a" stroke-width="2"/><path fill="#ffe0a0" d="M17 8v2.1c2.8.3 4.3 1.8 4.5 4h-3c-.2-1.1-1-1.7-2.5-1.7-1.3 0-2 .5-2 1.2 0 .7.6 1.1 2.5 1.5 3.5.7 5 1.9 5 4.4 0 2.3-1.7 3.9-4.5 4.3V26h-2v-2.1c-3-.3-4.8-1.9-5-4.5h3c.2 1.3 1.1 2 2.8 2 1.5 0 2.4-.5 2.4-1.4 0-.8-.7-1.2-2.7-1.6-3.2-.7-4.7-1.8-4.7-4.3 0-2.2 1.6-3.7 4.2-4V8h2Z"/></svg>
      </span>
      <span class="snh-float snh-float--coin-b" aria-hidden="true">
        <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="14" fill="#f2a126"/><circle cx="16" cy="16" r="10" fill="none" stroke="#ffd77a" stroke-width="2"/></svg>
      </span>
      <span class="snh-float snh-float--coin-c" aria-hidden="true">
        <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="14" fill="#f2a126"/><circle cx="16" cy="16" r="10" fill="none" stroke="#ffd77a" stroke-width="2"/></svg>
      </span>
    </section>

    <section class="snh-login-form-zone" aria-label="Customer login form">
      <div class="snh-login-card customer-form__box">
        <account-login class="customer-form__box-inner text-center">
          {%- liquid
            capture _recovery
              form 'recover_customer_password'
                if form.errors or form.posted_successfully?
                  assign show_recover_form = true
                endif
              endform
            endcapture
          -%}

          <div id="snh-login-{{ section.id }}" {% if show_recover_form %}hidden{% endif %}>
            <div class="snh-form-kicker"></div>
            <h2>Login</h2>
            <p class="snh-form-intro">Sign in to continue to your SNH Elite dashboard.</p>

            {%- form 'customer_login', class: 'form' -%}
              <input type="hidden" name="checkout_url" value="{{ routes.account_url }}">
              <input type="hidden" name="return_to" value="{{ routes.account_url }}">

              {%- if form.errors -%}
                <div class="snh-error">{{ form.errors | default_errors }}</div>
              {%- endif -%}

              <div class="snh-field">
                <label class="snh-label" for="snh-login-email-{{ section.id }}">Email address</label>
                <input id="snh-login-email-{{ section.id }}" type="email" name="customer[email]" class="snh-input" placeholder="you@email.com" autocomplete="email" autocapitalize="off" required>
              </div>

              <div class="snh-field">
                <div class="snh-field-head">
                  <label class="snh-label" for="snh-login-password-{{ section.id }}">Password</label>
                  <a href="#snh-recover-{{ section.id }}" class="snh-small-link" onclick="document.getElementById('snh-login-{{ section.id }}').hidden=true; document.getElementById('snh-recover-{{ section.id }}').style.display='block'; return false;">Forgot password?</a>
                </div>
                <input id="snh-login-password-{{ section.id }}" type="password" name="customer[password]" class="snh-input" placeholder="Enter your password" autocomplete="current-password" required>
              </div>

              <button type="submit" class="snh-login-btn">Open VIP Dashboard</button>

              <div class="snh-form-foot">
                New to SNH Elite?
                <a href="{{ routes.account_register_url }}">Create free account</a>
              </div>
            {%- endform -%}
          </div>

          <div id="snh-recover-{{ section.id }}" style="{% if show_recover_form %}display:block;{% else %}display:none;{% endif %}">
            <div class="snh-form-kicker">Account Recovery</div>
            <h2 style="font-size:clamp(34px,3.5vw,46px);">Reset Password</h2>

            {%- form 'recover_customer_password', class: 'form' -%}
              {%- if form.errors -%}
                <div class="snh-error">{{ form.errors | default_errors }}</div>
              {%- endif -%}

              {%- if form.posted_successfully? -%}
                <div class="snh-success">We’ve emailed you a secure link to update your password.</div>
              {%- else -%}
                <p class="snh-reset-copy">Enter your account email and we’ll send you a password reset link.</p>
                <div class="snh-field">
                  <label class="snh-label" for="snh-recover-email-{{ section.id }}">Email address</label>
                  <input id="snh-recover-email-{{ section.id }}" type="email" name="email" class="snh-input" placeholder="you@email.com" autocomplete="email" autocapitalize="off" required>
                </div>
                <button type="submit" class="snh-login-btn">Send Reset Link</button>
              {%- endif -%}

              <div class="snh-form-foot">
                <a href="#snh-login-{{ section.id }}" class="snh-small-link" onclick="document.getElementById('snh-recover-{{ section.id }}').style.display='none'; document.getElementById('snh-login-{{ section.id }}').hidden=false; return false;">Back to login</a>
              </div>
            {%- endform -%}
          </div>
        </account-login>
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Customer login",
  "class": "shopify-section--main-customers-login",
  "tag": "section"
}
{% endschema %}
