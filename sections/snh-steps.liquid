{%- comment -%}
  SNH steps (Round 11, v2): numbered steps or a timeline (label = year). Replaces Impact's timeline. Step blocks:
  label, title, text, optional image.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hid = 'st-' | append: section.id
-%}
<section class="v2 v-section stp{% if s.cream %} v-section--cream{% endif %}" aria-labelledby="{{ hid }}">
  <div class="v-wrap">
    <div class="head"><div class="head__text">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="v-h1" id="{{ hid }}">{% render 'snh-v2-heading', text: s.heading %}</h2>
      {%- if s.lead != blank -%}<p class="lead">{{ s.lead | escape }}</p>{%- endif -%}
    </div></div>
    <ol class="stp__list{% if s.layout == 'timeline' %} stp__list--tl{% endif %}" role="list">
      {%- for b in section.blocks -%}
        <li class="stp__i" {{ b.shopify_attributes }}>
          <span class="stp__n">{{ b.settings.label | default: forloop.index | prepend: '' | escape }}</span>
          <div class="stp__b">
            {%- if b.settings.image != blank -%}<span class="stp__img">{{ b.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(max-width: 767px) 100vw, 33vw' }}</span>{%- endif -%}
            <h3 class="stp__t">{{ b.settings.title | escape }}</h3>
            {%- if b.settings.text != blank -%}<div class="v-prose stp__p">{{ b.settings.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "SNH steps",
  "class": "snh-sec",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it *works*" },
    { "type": "text", "id": "lead", "label": "Lead" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "steps", "label": "Numbered steps" }, { "value": "timeline", "label": "Timeline (label = year)" }], "default": "steps" },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": false }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "label", "label": "Label", "info": "Empty = the step number." },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "image_picker", "id": "image", "label": "Image" }
    ] }
  ],
  "presets": [{ "name": "SNH steps" }]
}
{% endschema %}
