{%- comment -%}SNH "Shop by goal" (prototype #goals): two tabbed groups of portrait goal tiles. Tile blocks pick their group.{%- endcomment -%}
{%- assign hid = 'goal-' | append: section.id -%}
<section class="v2 v-section" aria-labelledby="{{ hid }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="v-wrap">
    <div class="head"><div class="head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="v-h1" id="{{ hid }}">{% render 'snh-v2-heading', text: section.settings.heading %}</h2></div>
      <div class="v-tabs" role="tablist" data-v2="tabs">
        <button class="tab" type="button" role="tab" aria-selected="true" aria-controls="{{ hid }}-train" id="{{ hid }}-t1">{{ section.settings.tab_1 | escape }}</button>
        <button class="tab" type="button" role="tab" aria-selected="false" aria-controls="{{ hid }}-wellness" id="{{ hid }}-t2">{{ section.settings.tab_2 | escape }}</button>
      </div>
    </div>
    {%- for g in (1..2) -%}
      {%- if g == 1 -%}{%- assign key = 'train' -%}{%- else -%}{%- assign key = 'wellness' -%}{%- endif -%}
      <div class="gtiles" data-goal-panel="{{ key }}" id="{{ hid }}-{{ key }}" role="tabpanel" aria-labelledby="{{ hid }}-t{{ g }}"{% if g == 2 %} hidden{% endif %}>
        {%- for b in section.blocks -%}
          {%- if b.settings.group == key -%}
            <a class="gtile" href="{{ b.settings.link | default: '#' }}" {{ b.shopify_attributes }}>
              {%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 1086 | image_tag: width: 1086, height: 1448, loading: 'lazy', alt: '', sizes: '(max-width: 767px) 44vw, (max-width: 1023px) 30vw, 25vw', widths: '400,600,800,1086' }}{%- endif -%}
              <span>{{ b.settings.title | escape }}</span></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "SNH shop by goal",
  "class": "snh-sec",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by goal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What are you *training* for?" },
    { "type": "text", "id": "tab_1", "label": "Tab 1", "default": "Train & perform" },
    { "type": "text", "id": "tab_2", "label": "Tab 2", "default": "Health & wellness" },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "goals", "info": "Links to /#goals jump here." }
  ],
  "blocks": [
    { "type": "goal", "name": "Goal tile", "settings": [
      { "type": "select", "id": "group", "label": "Tab", "options": [{ "value": "train", "label": "Tab 1" }, { "value": "wellness", "label": "Tab 2" }], "default": "train" },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait 3:4." },
      { "type": "text", "id": "title", "label": "Title", "default": "Muscle & strength" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "SNH shop by goal", "blocks": [{ "type": "goal" }, { "type": "goal" }] }]
}
{% endschema %}
