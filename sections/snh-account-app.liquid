{%- comment -%}
  SNH Elite member app (Round 8, customers/account): sidebar (desktop) or bottom tab bar (phones) and five views on
  hash routes #overview #rewards #orders #goals #profile. Builds the member's data here and hands it to
  snippets/snh-app, which the QA mock (sections/snh-app-mock) renders with persona data.
  Loyalty figures: snippets/snh-elite-calc (metafields custom.loyalty_tier / loyalty_points / annual_spend, display
  only). Orders: snippets/snh-app-order-data. Writes: redeem request + goal tags (customer form → /contact), address
  forms, avatar (localStorage). Docs: ELITE-ROADMAP.md. Styles: assets/snh-app.css · JS: assets/snh-app.js.
{%- endcomment -%}
{%- liquid
  capture m
    render 'snh-elite-calc', customer: customer
  endcapture
  assign m = m | strip | split: '|'

  assign ini = customer.first_name | slice: 0 | append: '' | upcase
  assign ini = customer.last_name | slice: 0 | upcase | prepend: ini
  if ini == blank
    assign ini = customer.email | slice: 0 | upcase
  endif
  assign phone = customer.phone | default: customer.default_address.phone
  assign mkt = 0
  if customer.accepts_marketing
    assign mkt = 1
  endif
  assign bday = customer.metafields.facts.birth_date.value | default: customer.metafields.custom.birthday.value
  assign joined = customer.metafields.custom.joined_at.value | date: '%s'
  assign tags = customer.tags | join: ','
  capture me
    echo customer.first_name | remove: '|' | append: '|'
    echo customer.name | remove: '|' | append: '|'
    echo customer.email | append: '|'
    echo phone | remove: '|' | append: '|'
    echo customer.id | modulo: 900 | plus: 100 | append: '|'
    echo ini | append: '|' | append: mkt | append: '|'
    echo bday | append: '|' | append: joined | append: '|'
    echo customer.orders_count | append: '|' | append: customer.addresses_count | append: '|'
    echo tags | remove: '|'
  endcapture
  assign me = me | strip_newlines | split: '|'

  capture recent
    for order in customer.orders limit: 16
      render 'snh-app-order-data', order: order, deliver_days: section.settings.deliver_days
      unless forloop.last
        echo '@@'
      endunless
    endfor
  endcapture
  # photo avatar (Round 10): customer.metafields.custom.avatar, a file reference or a URL, written by the future
  # app proxy /apps/elite/avatar (ELITE-ROADMAP.md §5). Empty = the preset avatars.
  assign av = customer.metafields.custom.avatar.value
  assign avatar_url = ''
  if av.src or av.preview_image
    assign avatar_url = av | image_url: width: 240, height: 240, crop: 'center'
  elsif av != blank
    assign avatar_url = av | append: ''
  endif
-%}
{%- paginate customer.orders by 16 -%}
  {%- capture page_orders -%}
    {%- for order in customer.orders -%}{% render 'snh-app-order-data', order: order, deliver_days: section.settings.deliver_days %}{% unless forloop.last %}@@{% endunless %}{%- endfor -%}
  {%- endcapture -%}
  {%- capture pages -%}{% render 'pagination', paginate: paginate, hash: 'orders' %}{%- endcapture -%}
  {%- assign page_no = paginate.current_page -%}
{%- endpaginate -%}
{%- liquid
  assign recent = recent | strip | split: '@@'
  assign page_orders = page_orders | strip | split: '@@'
-%}
{%- render 'snh-app',
  m: m,
  me: me,
  recent: recent,
  page_orders: page_orders,
  pagination_html: pages,
  page_no: page_no,
  s: section.settings,
  blocks: section.blocks,
  sid: section.id,
  avatar_url: avatar_url
-%}

{% schema %}
{
  "name": "SNH Elite member app",
  "class": "shopify-section--snh-app",
  "settings": [
    { "type": "paragraph", "content": "Points, tier and spend come from the customer's loyalty metafields. Rates, thresholds, point value, welcome points and perks: Theme settings → SNH Elite." },
    { "type": "header", "content": "Picked for you" },
    { "type": "collection", "id": "best_collection", "label": "Bestsellers (fallback)", "info": "Shown when a member has no goal and no order history. Empty = the Everything collection." },
    { "type": "textarea", "id": "pick_map", "label": "Order history → complementary collections", "info": "One rule per line: words found in a product's type or title => collection handles. Example: whey, isolate => creatine, accessories-1", "default": "whey, isolate, protein powder, mass gainer => creatine, accessories-1\npre-workout, pre workout, pump => creatine, hydration-recovery\ncreatine => whey-protein, pre-workout-1\ngel, carb, beta fuel => hydration-recovery, energy-and-endurance\nelectrolyte, hydro, hydration => energy-gels, magnesium\nmagnesium, sleep => vitamins-minerals, probiotics\nvitamin, omega, fish oil, multi => magnesium, probiotics\ncollagen => joint-and-mobility, vitamins-minerals\nfat burner, carnitine, weight => fat-loss, clear-protein" },
    { "type": "header", "content": "Orders" },
    { "type": "range", "id": "deliver_days", "label": "Show an order as delivered after", "min": 1, "max": 14, "step": 1, "unit": "d", "default": 4, "info": "Days after it's dispatched. Shopify doesn't tell the theme when a parcel is delivered, so the status timeline assumes it." },
    { "type": "text", "id": "bundle_handles", "label": "Bundle collections", "default": "training-strength-bundles, daily-health-wellness-bundles, endurance-bundles, bundle-offers", "info": "Searched for \"Now in a bundle\" (with the bundle offers in Theme settings). Same rule as the product page's Bundle & save." },
    { "type": "header", "content": "Referral" },
    { "type": "text", "id": "refer_text", "label": "Referral card heading", "default": "Give Rs 500, *get* Rs 500", "info": "Leave empty to hide. Wrap a word in *asterisks* for the serif." },
    { "type": "text", "id": "refer_body", "label": "Referral card text", "default": "Share SNH Elite with a friend. When they shop, you both win." },
    { "type": "url", "id": "refer_link", "label": "Referral link", "info": "Only used with \"Referral rewards are live\"." },
    { "type": "checkbox", "id": "refer_live", "label": "Referral rewards are live", "default": false, "info": "Off: the card says referral rewards are coming soon, with a notify-me button. A referral app's block (Add block → Apps) replaces the card." },
    { "type": "header", "content": "Profile photo" },
    { "type": "checkbox", "id": "avatar_upload", "label": "Show \"Upload a photo\"", "default": false, "info": "Needs the SNH Elite app proxy (/apps/elite/avatar). Leave off until it's live." },
    { "type": "header", "content": "Marketing preferences" },
    { "type": "checkbox", "id": "sms_live", "label": "SMS updates are live", "default": false, "info": "Off shows SMS as \"coming soon\". The app also switches it on when it finds an SMS app (Postscript, Attentive, Yotpo SMS) on the page." },
    { "type": "header", "content": "Goals" },
    { "type": "textarea", "id": "stack_map", "label": "Plan quiz → stack categories", "info": "One per line: key | collection handle | title words (optional). Keys the quiz uses: protein, vegan, clear, creatine, pre, hydra, gel, magnesium, multi, omega, fat, bar. Empty = the defaults in snippets/snh-quiz-stackdata." },
    { "type": "checkbox", "id": "goal_prompt", "label": "Prompt members with no goal to personalise", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "goal", "name": "Goal", "settings": [
      { "type": "select", "id": "key", "label": "Goal", "options": [
        { "value": "build-muscle", "label": "Build muscle" },
        { "value": "lose-fat", "label": "Lose fat" },
        { "value": "endurance", "label": "Endurance" },
        { "value": "hydration-recovery", "label": "Hydration & recovery" },
        { "value": "daily-health", "label": "Daily health" },
        { "value": "sport-specific", "label": "Sport-specific" }
      ], "default": "build-muscle" },
      { "type": "text", "id": "title", "label": "Card heading", "info": "Wrap a word in *asterisks* for the serif." },
      { "type": "textarea", "id": "tips", "label": "Tips", "info": "One per line." },
      { "type": "collection", "id": "collection", "label": "Recommended products" },
      { "type": "textarea", "id": "guides", "label": "Buying guides", "info": "One per line: title | /blogs/news/handle" }
    ] },
    { "type": "quiz", "name": "Quiz question", "settings": [
      { "type": "select", "id": "step", "label": "Step", "options": [
        { "value": "goal", "label": "Primary goal" }, { "value": "goal2", "label": "Secondary goal" }, { "value": "lvl", "label": "Experience level" }, { "value": "freq", "label": "Training days" }, { "value": "sess", "label": "Session type" }, { "value": "sport", "label": "Sport" }, { "value": "diet", "label": "Diet" },  { "value": "exp", "label": "Supplement experience" }, { "value": "take", "label": "Already taking (multi-select)" }, { "value": "challenge", "label": "Biggest challenge" }, { "value": "flavour", "label": "Flavour" }, { "value": "age", "label": "Age range" }
      ], "default": "goal" },
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "text", "id": "help", "label": "Help text" },
      { "type": "textarea", "id": "answers", "label": "Answers", "info": "One per line: tag value | label | icon. The value is saved as a tag (goal:value …, see ELITE-ROADMAP.md). Keep goal values matching the Goal blocks. Icons: dumbbell flame run drop heart trophy sparkle bolt clock refresh ball bat racket bike wave leaf smile wallet pill shaker cup moon target star." }
    ] },
    { "type": "promo", "name": "Member promotion", "settings": [
      { "type": "paragraph", "content": "Used until a \"Member promotion\" metaobject has entries (ELITE-ROADMAP.md §6). Empty targeting = every member." },
      { "type": "text", "id": "title", "label": "Title", "info": "Wrap a word in *asterisks* for the serif." },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "text", "id": "cta", "label": "Button label", "default": "Shop now" },
      { "type": "url", "id": "link", "label": "Link", "info": "Empty = the collection below." },
      { "type": "collection", "id": "collection", "label": "Collection", "info": "Link and image fallback." },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "start", "label": "Starts (YYYY-MM-DD)", "info": "Empty = now." },
      { "type": "text", "id": "end", "label": "Ends (YYYY-MM-DD)", "info": "Empty = no end. Seasonal promos swap themselves by date." },
      { "type": "text", "id": "tiers", "label": "Tiers", "info": "bronze, silver, gold. Empty = all." },
      { "type": "text", "id": "goals", "label": "Goals", "info": "build-muscle, lose-fat, endurance, hydration-recovery, daily-health, sport-specific (goal or second goal)." },
      { "type": "text", "id": "sports", "label": "Sports", "info": "cricket, padel, running, gym, cycling, swimming, football, rugby, other" },
      { "type": "text", "id": "diets", "label": "Diets", "info": "none, vegetarian, vegan, lactose-free" },
      { "type": "text", "id": "bought", "label": "Bought triggers", "info": "Words found in the brand, type, title or handle of anything they've ordered, e.g. creatine, Applied Nutrition, RYSE." },
      { "type": "range", "id": "priority", "label": "Priority", "min": 0, "max": 9, "step": 1, "default": 5 }
    ] },
    { "type": "faq", "name": "Points FAQ", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer" }
    ] }
  ]
}
{% endschema %}
