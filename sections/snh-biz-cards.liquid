{%- comment -%}
  Round 17: business card grid (who it's for, benefits, what you get, what we look for, why SNH). Heading (*serif*), an
  intro (rich text, SEO copy lives here), then icon cards. Style: white / cream / ink.
{%- endcomment -%}
{{ 'snh-biz.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign parts = s.heading | split: '*'
-%}
<section class="v2 biz-sec biz-sec--{{ s.style }}" aria-labelledby="bc-{{ section.id }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="v-wrap">
    <header class="biz-head">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="biz-h" id="bc-{{ section.id }}">{%- for p in parts -%}{%- if forloop.index0 == 1 -%}<em>{{ p | escape }}</em>{%- else -%}{{ p | escape }}{%- endif -%}{%- endfor -%}</h2>
      {%- if s.intro != blank -%}<div class="biz-rte">{{ s.intro }}</div>{%- endif -%}
    </header>
    <ul class="biz-cards biz-cards--{{ s.columns }}" role="list">
      {%- for b in section.blocks -%}
        <li class="biz-card" {{ b.shopify_attributes }}>
          {%- if b.settings.icon != 'none' -%}<span class="biz-card__ic">{% render 'snh-v2-icon', name: b.settings.icon %}</span>{%- endif -%}
          <h3 class="biz-card__h">{{ b.settings.title | escape }}</h3>
          {%- if b.settings.text != blank -%}<div class="biz-card__p">{{ b.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.outro != blank -%}<div class="biz-rte biz-rte--after">{{ s.outro }}</div>{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "SNH business cards", "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who it's *for*" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "richtext", "id": "outro", "label": "Text under the cards" },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" } ], "default": "3" },
    { "type": "select", "id": "style", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "ink", "label": "Ink" } ], "default": "white" }
  ],
  "blocks": [ { "type": "card", "name": "Card", "settings": [ { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "none", "label": "None" }, { "value": "shield", "label": "Shield" }, { "value": "badge", "label": "Badge" }, { "value": "truck", "label": "Truck" }, { "value": "pin", "label": "Pin" }, { "value": "star", "label": "Star" }, { "value": "bolt", "label": "Bolt" }, { "value": "dumbbell", "label": "Dumbbell" }, { "value": "trophy", "label": "Trophy" }, { "value": "heart", "label": "Heart" }, { "value": "pill", "label": "Pill" }, { "value": "user", "label": "Person" }, { "value": "chat", "label": "Chat" }, { "value": "card", "label": "Card" }, { "value": "wallet", "label": "Wallet" }, { "value": "gift", "label": "Gift" }, { "value": "target", "label": "Target" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "home", "label": "Store" }, { "value": "bag", "label": "Bag" }, { "value": "clock", "label": "Clock" }, { "value": "check", "label": "Check" }, { "value": "run", "label": "Run" }, { "value": "leaf", "label": "Leaf" }, { "value": "shaker", "label": "Shaker" } ], "default": "check" }, { "type": "text", "id": "title", "label": "Title", "default": "Title" }, { "type": "richtext", "id": "text", "label": "Text" } ] } ],
  "presets": [ { "name": "SNH business cards" } ] }
{% endschema %}
