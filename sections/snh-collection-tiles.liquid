{%- comment -%}
  SNH collection tiles (Round 11, v2): a grid of tiles linking to collections or any page. Replaces Impact's
  collection-list, image-link-blocks and logo-list. Tiles come from the Collections list, then Tile blocks (image,
  title, link, or a collection). Style "logos" shows brand marks on white plates.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hid = 'ct-' | append: section.id
  assign tiles = section.blocks | where: 'type', 'tile'
-%}
{%- if s.collections.size > 0 or tiles.size > 0 -%}
<section class="v2 v-section{% if s.cream %} v-section--cream{% endif %} ctl ctl--{{ s.style }}" aria-labelledby="{{ hid }}">
  <div class="v-wrap">
    {%- if s.heading != blank -%}
      <div class="head">
        <div class="head__text">
          {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="v-h1" id="{{ hid }}">{% render 'snh-v2-heading', text: s.heading %}</h2>
        </div>
        {%- if s.link_label != blank -%}<a class="v-link" href="{{ s.link_url | default: routes.collections_url }}">{{ s.link_label | escape }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="ctl__grid" role="list" style="--cols: {{ s.cols }}">
      {%- for c in s.collections -%}
        <li><a class="ctl__tile" href="{{ c.url }}">
          <span class="ctl__img">{%- assign im = c.featured_image | default: c.products.first.featured_image -%}{% if im %}{{ im | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(max-width: 767px) 50vw, 25vw', alt: c.title }}{% endif %}</span>
          <span class="ctl__t">{{ c.title | escape }}</span>
          {%- if s.style != 'logos' -%}<span class="ctl__n">{{ c.products_count }} product{% if c.products_count != 1 %}s{% endif %}</span>{%- endif -%}
        </a></li>
      {%- endfor -%}
      {%- for b in tiles -%}
        {%- assign bc = b.settings.collection -%}
        {%- assign im = b.settings.image | default: bc.featured_image | default: bc.products.first.featured_image -%}
        {%- assign t = b.settings.title | default: bc.title -%}
        <li {{ b.shopify_attributes }}><a class="ctl__tile" href="{{ b.settings.link | default: bc.url | default: '#' }}">
          <span class="ctl__img">{% if im %}{{ im | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(max-width: 767px) 50vw, 25vw', alt: t }}{% endif %}</span>
          {%- if t != blank -%}<span class="ctl__t">{{ t | escape }}</span>{%- endif -%}
        </a></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "SNH collection tiles",
  "class": "snh-sec",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "collection_list", "id": "collections", "label": "Collections", "limit": 16 },
    { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "cards", "label": "Image cards" }, { "value": "logos", "label": "Brand logos" }], "default": "cards" },
    { "type": "range", "id": "cols", "label": "Tiles per row (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": false }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "collection", "id": "collection", "label": "Collection", "info": "Link and image fallback." },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "SNH collection tiles" }]
}
{% endschema %}
