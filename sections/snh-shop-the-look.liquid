{%- comment -%}
  SNH Shop the Look / Brand of the month (prototype section.hs): campaign image with numbered hotspot dots on the
  left, numbered product list on the right. Product blocks keep the old section's schema (product, horizontal and
  vertical position). Dots and list items are linked both ways; desktop opens a popover card at the dot, mobile a
  bottom sheet (assets/snh-v2.js data-v2="hotspots").
  SNH Elite points strip: tier-aware earn rate from the customer's total spend vs the thresholds below.
  Round 11 (OLD-COMPONENTS.md §3): the list items are your horizontal product cards (pack shot, name, price +
  compare-at, "or 3 × Rs X with KOKO", "+ Add"); phones get them as a swipe rail under the image, like the old
  section. The SNH Elite strip is your dark bar ("● SNH ELITE" · "You'll earn Rs X back in points") and follows the
  product that's active (dot or card, hover or tap). Brand logo setting: "Shop the look:" + the logo as the heading.
{%- endcomment -%}
{%- liquid
  assign hid = 'stl-' | append: section.id
  assign points_rate = settings.snh_rate_bronze | default: 3
  if customer
    assign tier = customer.metafields.custom.loyalty_tier.value
    assign spent_rs = customer.total_spent | divided_by: 100
    if tier == 'Gold' or tier == 'MAXED OUT' or tier == blank and spent_rs >= settings.snh_gold_threshold
      assign points_rate = settings.snh_rate_gold | default: 10
    elsif tier == 'Silver' or tier == blank and spent_rs >= settings.snh_silver_threshold
      assign points_rate = settings.snh_rate_silver | default: 7
    endif
  endif
  assign img = section.settings.image
-%}
<section class="v2 v-section v-section--cream hs" aria-labelledby="{{ hid }}" data-v2="hotspots" data-popover="{{ section.settings.popover }}">
  <div class="v-wrap">
    {%- if section.settings.brand_logo != blank -%}
      <div class="head"><div class="head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="v-h1 hs__brandh" id="{{ hid }}"><span>Shop the look:</span>{{ section.settings.brand_logo | image_url: height: 112 | image_tag: height: 56, alt: section.settings.brand_logo.alt | default: 'Brand of the month', class: 'hs__logo' }}</h2>
        {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}<a class="v-link" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
      </div>
    {%- else -%}
      {%- render 'snh-v2-head', s: section.settings, id: hid -%}
    {%- endif -%}
    <div class="hs__grid">
      <div class="hs__media">
        <div class="hs__frame">
          {%- if img != blank -%}
            {{ img | image_url: width: 1400 | image_tag: width: 2000, height: 2000, loading: 'lazy', alt: section.settings.image_alt, sizes: '(max-width: 1023px) 100vw, 58vw', widths: '600,900,1400,2000', class: 'hs__img-main' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hs__img-main hs__ph' }}
          {%- endif -%}
          {%- for b in section.blocks -%}
            {%- assign p = b.settings.product -%}
            {%- if p == blank -%}{%- continue -%}{%- endif -%}
            <button class="hs__dot" type="button" style="left:{{ b.settings.horizontal_position }}%;top:{{ b.settings.vertical_position }}%;--x:{{ b.settings.horizontal_position }};--y:{{ b.settings.vertical_position }}" data-spot="{{ forloop.index0 }}" aria-label="{{ forloop.index }}: {{ p.title | escape }}" aria-expanded="false" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ b.shopify_attributes }}><span>{{ forloop.index }}</span></button>
          {%- endfor -%}
        </div>
        {%- for b in section.blocks -%}
          {%- assign p = b.settings.product -%}
          {%- if p == blank -%}{%- continue -%}{%- endif -%}
          <div class="hs__pop" data-pop="{{ forloop.index0 }}" hidden role="dialog" aria-modal="false" aria-label="{{ p.title | escape }}">
            <button class="hs__close" type="button" aria-label="Close">×</button>
            {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 320 | image_tag: width: 160, height: 160, loading: 'lazy', alt: '' }}{%- endif -%}
            <div class="hs__popbody"><span class="eyebrow">{{ p.vendor | escape }}</span><a class="hs__name" href="{{ p.url }}">{% render 'snh-v2-title', product: p, short: true %}</a><span class="hs__price">{{ p.price | money_without_trailing_zeros }}</span>
              <div class="hs__popcta">{% render 'snh-v2-stl-add', product: p, cls: 'v-btn v-btn--accent v-btn--sm', label: 'Add to basket' %}<a class="v-link" href="{{ p.url }}">View</a></div></div>
          </div>
        {%- endfor -%}
      </div>
      <div class="hs__scrim" hidden></div>
      <div class="hs__side">
       <div class="hs__stack">
        <ol class="hs__list">
          {%- for b in section.blocks -%}
            {%- assign p = b.settings.product -%}
            {%- if p == blank -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign pts_i = p.price | times: points_rate | divided_by: 10000.0 | round | times: 100
              capture retail
                render 'snh-v2-retail', product: p
              endcapture
              assign retail = retail | strip | plus: 0
              assign third = p.price | divided_by: 300.0 | round | times: 100
            -%}
            <li class="hs__item hpc" data-spot="{{ forloop.index0 }}" data-earn="{{ pts_i | money_without_trailing_zeros }}">
              <span class="hs__n">{{ forloop.index }}</span>
              <a class="hs__img" href="{{ p.url }}" tabindex="-1" aria-label="{{ p.title | escape }}"><span class="card__img">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 300 | image_tag: width: 150, height: 150, loading: 'lazy', alt: '', data-v2-lift: '' }}{%- endif -%}</span></a>
              <span class="hs__info">
                <span class="hpc__brand">{{ p.vendor | escape }}</span>
                <a class="hs__name" href="{{ p.url }}">{% render 'snh-v2-title', product: p, short: true %}</a>
                <span class="hs__price">{% if p.price_varies %}From {% endif %}{{ p.price | money_without_trailing_zeros }}{% if retail > p.price %} <s>{{ retail | money_without_trailing_zeros }}</s>{% endif %}</span>
                <span class="hpc__koko">or 3 × {{ third | money_without_trailing_zeros }} with {% render 'snh-koko-logo', h: 13 %}</span>
              </span>
              {%- render 'snh-v2-stl-add', product: p, cls: 'hpc__add', label: '+ Add' -%}
            </li>
          {%- endfor -%}
        </ol>
        {%- if section.settings.show_points -%}
          {%- assign first = section.blocks.first.settings.product -%}
          {%- if first != blank -%}
            {%- assign pts = first.price | times: points_rate | divided_by: 10000.0 | round | times: 100 -%}
            <a class="hs__pts" href="{% if customer %}{{ routes.account_url }}#rewards{% else %}{{ routes.account_login_url }}{% endif %}" data-hs-pts>
              <span class="hs__pts-tag">SNH Elite</span>
              <span class="hs__pts-t">{% if customer %}You'll earn{% else %}Sign in to earn{% endif %} <strong data-hs-earn>{{ pts | money_without_trailing_zeros }}</strong> back in points{% if customer %} ({{ points_rate }}%){% endif %}</span>
            </a>
          {%- endif -%}
        {%- endif -%}
       </div>
      </div>
    </div>
  </div>
  <script>
    /* the Elite strip follows the active product (dot or card; hover, focus or tap) */
    (function (sec) {
      var strip = sec.querySelector('[data-hs-earn]');
      if (!strip) return;
      function to(i) { var it = sec.querySelector('.hs__item[data-spot="' + i + '"]'); if (it && it.dataset.earn) strip.textContent = it.dataset.earn; }
      ['mouseover', 'focusin', 'click'].forEach(function (t) { sec.addEventListener(t, function (e) { var d = e.target.closest('[data-spot]'); if (d) to(d.getAttribute('data-spot')); }); });
    })(document.currentScript.closest('section'));
  </script>
  {%- for b in section.blocks -%}
    {%- assign p = b.settings.product -%}
    {%- if p != blank and p.available and p.has_only_default_variant == false -%}
      <quick-buy-drawer id="v2-qb-{{ section.id }}-{{ p.id }}" header-bordered open-from="bottom" handle="{{ p.handle }}?variant={{ p.selected_or_first_available_variant.id }}" role="region" aria-live="polite" class="quick-buy-drawer drawer"></quick-buy-drawer>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "SNH shop the look",
  "class": "snh-sec",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Brand of the month"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the *look*",
      "info": "Wrap a word in *asterisks* for the serif italic."
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand logo",
      "info": "When set, the heading reads \"Shop the look:\" + this logo instead of the text heading."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "Button style",
      "options": [
        {
          "value": "button",
          "label": "Ink button"
        },
        {
          "value": "link",
          "label": "Underlined link"
        }
      ],
      "default": "button"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign image",
      "info": "Square, 2000 × 2000px. Place each product's dot with its block's position sliders."
    },
    {
      "type": "checkbox",
      "id": "popover",
      "label": "Quick product card at the dot (desktop)",
      "default": true,
      "info": "Phones always open a bottom sheet."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description"
    },
    {
      "type": "header",
      "content": "SNH Elite points strip"
    },
    {
      "type": "checkbox",
      "id": "show_points",
      "label": "Show points strip",
      "default": true,
      "info": "Signed-in members see their tier's earn rate; guests are invited to sign in."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "horizontal_position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 30
        },
        {
          "type": "range",
          "id": "vertical_position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNH shop the look",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
