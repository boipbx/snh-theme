{%- comment -%} Round 17: "What you can stock" category tiles; each links to its collection (image: the tile's or the collection's). {%- endcomment -%}
{{ 'snh-biz.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign parts = s.heading | split: '*'
-%}
<section class="v2 biz-sec biz-sec--{{ s.style }}" aria-labelledby="bt-{{ section.id }}">
  <div class="v-wrap">
    <header class="biz-head">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="biz-h" id="bt-{{ section.id }}">{%- for p in parts -%}{%- if forloop.index0 == 1 -%}<em>{{ p | escape }}</em>{%- else -%}{{ p | escape }}{%- endif -%}{%- endfor -%}</h2>
      {%- if s.intro != blank -%}<div class="biz-rte">{{ s.intro }}</div>{%- endif -%}
    </header>
    <ul class="biz-tiles" role="list">
      {%- for b in section.blocks -%}
        {%- liquid
          assign c = b.settings.collection
          assign img = b.settings.image | default: c.featured_image | default: c.products.first.featured_image
          assign label = b.settings.label | default: c.title
        -%}
        <li {{ b.shopify_attributes }}>
          <a class="biz-tile" href="{{ c.url | default: '#' }}">
            <span class="biz-tile__img">{%- if img != blank -%}{{ img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 1024px) 20vw, 45vw', alt: '' }}{%- endif -%}</span>
            <span class="biz-tile__t">{{ label | escape }}</span>
            {%- if b.settings.text != blank -%}<span class="biz-tile__p">{{ b.settings.text | escape }}</span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{ "name": "SNH business categories", "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you can *stock*" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "select", "id": "style", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" } ], "default": "white" }
  ],
  "blocks": [ { "type": "tile", "name": "Category", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "text", "id": "label", "label": "Label (defaults to the collection title)" }, { "type": "text", "id": "text", "label": "One line" }, { "type": "image_picker", "id": "image", "label": "Image (defaults to the collection image)" } ] } ],
  "presets": [ { "name": "SNH business categories" } ] }
{% endschema %}
