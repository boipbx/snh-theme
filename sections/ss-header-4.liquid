                <img class="snh-elite-portrait" src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/boy.png?v=1783764655&amp;width=260" alt="" loading="eager" decoding="async">
                <img class="snh-elite-portrait" src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/padl.png?v=1783835906&amp;width=260" alt="" loading="eager" decoding="async">
              </div>
              <a class="snh-mobile-rewards__link" href="{{ snh_loyalty_href }}">
