                          <ul class="snh-mobile-child-list">
                            {%- for sub_link in link.links -%}
                              <li><a href="{{ sub_link.url }}">{{ sub_link.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <div class="snh-mobile-promo-grid">
                  {%- if block.settings.collections != blank -%}
                    {%- for collection in block.settings.collections limit: 3 -%}
                      <a class="snh-mobile-promo-card" href="{{ collection.url }}">
                        {%- if collection.featured_image != blank -%}
                          <img src="{{ collection.featured_image | image_url: width: 240 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy">
                        {%- endif -%}
                        <span>
                          <strong>{{ collection.title }}</strong>
                          <span>{{ block.settings.collection_cta_label | default: 'Shop now' }}</span>
                        </span>
                      </a>
                    {%- endfor -%}
                  {%- endif -%}

                  {%- if block.settings.image != blank -%}
                    <a class="snh-mobile-promo-card" href="{{ block.settings.button_url | default: block.settings.url | default: '#' }}">
                      <img src="{{ block.settings.image | image_url: width: 240 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy">
                      <span>
                        <strong>{{ block.settings.title | default: block.settings.text }}</strong>
                        <span>{{ block.settings.button_text | default: 'Shop now' }}</span>
                      </span>
                    </a>
                  {%- endif -%}

                  {%- if block.settings.second_image != blank -%}
                    <a class="snh-mobile-promo-card" href="{{ block.settings.second_button_url | default: block.settings.url | default: '#' }}">
                      <img src="{{ block.settings.second_image | image_url: width: 240 }}" alt="{{ block.settings.second_image.alt | default: block.settings.second_title | escape }}" loading="lazy">
                      <span>
                        <strong>{{ block.settings.second_title | default: block.settings.text }}</strong>
                        <span>{{ block.settings.second_button_text | default: 'Explore' }}</span>
                      </span>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if mobile_menu != blank -%}
          {%- for link in mobile_menu.links -%}
            {%- if link.links.size > 0 -%}
              <div class="snh-mobile-level" data-mobile-menu-link-level="{{ forloop.index0 }}">
                <button type="button" class="snh-mobile-back" data-mobile-back>
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="m15 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Back
                </button>
                <h2 class="snh-mobile-subtitle">{{ link.title }}</h2>
                <ul class="snh-mobile-link-list">
                  <li><a href="{{ link.url }}">View all {{ link.title }}</a></li>
                  {%- for child_link in link.links -%}
                    <li>
                      <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                      {%- if child_link.links.size > 0 -%}
                        <ul class="snh-mobile-child-list">
                          {%- for grandchild_link in child_link.links -%}
                            <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment -%}
        Sign in / Join sits OUTSIDE .snh-mobile-body. As a sticky child of the
        scrolling level it hovered mid-scroll and cut through the loyalty card
        below it; as a flex footer of the panel it is always pinned and never
        overlaps content.
      {%- endcomment -%}
      {%- if shop.customer_accounts_enabled and section.settings.enable_account -%}
        <div class="snh-mobile-auth">
          <a class="snh-btn snh-btn--dark" href="{{ routes.account_login_url }}">Sign in</a>
          <a class="snh-btn snh-btn--orange" href="{{ routes.account_register_url }}">Join SNH Elite</a>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.enable_cart_drawer -%}
    <div class="snh-cart-drawer" data-cart-drawer aria-hidden="true">
      <div class="snh-cart-panel" role="dialog" aria-modal="true" aria-label="Cart">
        <div class="snh-cart-head">
          <h2 class="snh-cart-title">Your basket</h2>
          <button type="button" class="snh-icon-button" data-cart-close aria-label="Close basket">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="snh-free-ship-card" data-free-shipping-card{% if snh_gap_is_waived %} hidden{% endif %}>
          <div class="snh-free-ship-card__top">
            <span data-free-shipping-message>{{ snh_free_shipping_message }}</span>
            <strong>Rs. {{ snh_free_shipping_cents | money_without_currency | replace: '.00', '' }}</strong>
          </div>
          <div class="snh-free-ship-card__bar" aria-hidden="true">
            <span data-free-shipping-progress style="width: {{ snh_free_shipping_progress }}%"></span>
          </div>
        </div>
        <div class="snh-cart-body" data-cart-items>
          <div class="snh-cart-empty">
            <strong>Loading basket...</strong>
          </div>
        </div>
        <div class="snh-cart-foot">
          <div class="snh-mini-points" data-mini-cart-points></div>
          <div class="snh-cart-subtotal">
            <span>Subtotal</span>
            <span data-cart-subtotal>{{ cart.total_price | money }}</span>
          </div>
          <div class="snh-cart-foot-actions">
            <a class="snh-btn snh-btn--outline" href="{{ routes.cart_url }}">View basket</a>
            <a class="snh-btn snh-btn--orange" href="/checkout">Checkout</a>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
</header>

<script>
  (() => {
    const root = document.getElementById('snh-header-{{ section.id }}');
    if (!root || root.dataset.snhReady === 'true') return;
    root.dataset.snhReady = 'true';

    const docEl = document.documentElement;
    const stickyBehavior = root.dataset.sticky || 'scroll_up';
    const enableCartDrawer = {{ section.settings.enable_cart_drawer | json }};
    const predictiveUrl = {{ routes.predictive_search_url | default: '/search/suggest' | append: '.json' | json }};
    const searchUrl = {{ routes.search_url | json }};
    const exclusiveBrandsRaw = {{ section.settings.exclusive_brands | default: 'Science in Sport, Revive, Healthspan Elite, Trace Minerals, Vitabiotics, Seven Seas' | json }};
    const routesRoot = {{ routes.root_url | default: '/' | json }};
    const popularCollectionHandle = {{ section.settings.popular_products_collection.handle | default: 'all' | json }};
    const cartJsonUrl = {{ routes.cart_url | append: '.js' | json }};
    const cartChangeUrl = {{ routes.cart_change_url | json }};
    const cartAddUrl = {{ routes.cart_add_url | append: '.js' | json }};
    const accountLoginUrl = {{ routes.account_login_url | json }};
    const accountRegisterUrl = {{ routes.account_register_url | json }};
    const moneyFormat = {{ shop.money_format | json }};
    const liveTrendsLimit = 2;
    const liveTrendsTtl = 3 * 60 * 1000;

    const overlay = root.querySelector('[data-close-all]');
    const navArea = root.querySelector('.snh-desktop-nav');
    const megaTriggers = Array.from(root.querySelectorAll('[data-mega-trigger]'));
    const megaPanels = Array.from(root.querySelectorAll('[data-mega-panel]'));
    const megaArea = root.querySelector('[data-mega-area]');
    const accountToggle = root.querySelector('[data-account-toggle]');
    const searchOpeners = Array.from(root.querySelectorAll('[data-search-open]'));
    const searchModal = root.querySelector('[data-search-modal]');
    const searchInput = root.querySelector('[data-search-input]');
    const searchClose = root.querySelector('[data-search-close]');
    const searchResults = root.querySelector('[data-search-results]');
    const searchResultsTitle = root.querySelector('[data-search-results-title]');
    const liveTrendsEl = root.querySelector('[data-live-trends]');
    const mobileOpen = root.querySelector('[data-mobile-open]');
    const mobileClose = root.querySelector('[data-mobile-close]');
    const mobileDrawer = root.querySelector('[data-mobile-drawer]');
    const cartOpen = root.querySelector('[data-cart-open]');
    const cartClose = root.querySelector('[data-cart-close]');
    const cartDrawer = root.querySelector('[data-cart-drawer]');
    const cartItems = root.querySelector('[data-cart-items]');
    const cartSubtotal = root.querySelector('[data-cart-subtotal]');
    const freeShippingCard = root.querySelector('[data-free-shipping-card]');
    const miniCartPoints = root.querySelector('[data-mini-cart-points]');
    const cartCountEls = Array.from(root.querySelectorAll('[data-cart-count]'));
    const freeShippingThreshold = Number(root.dataset.freeShippingThreshold || 1700000);
    const freeShippingTolerance = Number(root.dataset.freeShippingTolerance || 10000);
    const loyaltyRate = Number(root.dataset.loyaltyRate || 3);
    const loyaltyTier = root.dataset.loyaltyTier || 'Bronze';
    const customerAuthenticated = root.dataset.customerAuthenticated === 'true';
    const freeShippingMessageEls = Array.from(root.querySelectorAll('[data-free-shipping-message]'));
    const freeShippingProgressEls = Array.from(root.querySelectorAll('[data-free-shipping-progress]'));

    /* V5.1: rotating popular searches + new arrivals */
    const popularListEl = root.querySelector('.snh-popular-list');
    const popularPool = ({{ section.settings.popular_searches | default: '' | json }} || '')
      .split(',').map(function(t) { return t.trim(); }).filter(Boolean);
    let snhNewArrivals = null;
    let snhLiveProducts = [];
    let snhLiveProductsLoadedAt = 0;
    let snhLiveProductsRequest = null;
    let snhMiniCatalogue = null;
    let snhMiniCatalogueRequest = null;
    let snhMiniRecommendationRun = 0;

    let megaCloseTimer = null;
    let searchTimer = null;
    let searchController = null;
    let latestSearchId = 0;
    let lastY = window.scrollY;
    let ticking = false;

    const isDesktop = () => window.matchMedia('(min-width: 990px)').matches;

    function lockPage() {
      docEl.classList.add('snh-header-lock-{{ section.id }}');
    }

    function unlockPage() {
      const shouldRemainLocked =
        root.classList.contains('is-search-open') ||
        root.classList.contains('is-mobile-open') ||
        root.classList.contains('is-cart-open');

      if (!shouldRemainLocked) {
        docEl.classList.remove('snh-header-lock-{{ section.id }}');
      }
    }

    function updateOverlay() {
      const overlayed =
        root.classList.contains('is-mega-open') ||
        root.classList.contains('is-search-open') ||
        root.classList.contains('is-mobile-open') ||
        root.classList.contains('is-cart-open');

      root.classList.toggle('is-overlayed', overlayed);

      if (
        root.classList.contains('is-search-open') ||
        root.classList.contains('is-mobile-open') ||
        root.classList.contains('is-cart-open')
      ) {
        lockPage();
      } else {
        unlockPage();
      }
    }

    function isInsideMegaCluster(node) {
      if (!node) return false;
      return Boolean(
        (navArea && navArea.contains(node)) ||
        (megaArea && megaArea.contains(node))
      );
    }

    function cancelCloseMega() {
      if (megaCloseTimer) {
        clearTimeout(megaCloseTimer);
        megaCloseTimer = null;
      }
    }

    function scheduleCloseMega(delay = 260) {
      cancelCloseMega();
      megaCloseTimer = window.setTimeout(closeMega, delay);
    }

    function closeMega() {
      cancelCloseMega();
      root.classList.remove('is-mega-open');

      megaPanels.forEach(panel => {
        panel.classList.remove('is-active');
      });

      megaTriggers.forEach(trigger => {
        trigger.setAttribute('aria-expanded', 'false');
      });

      updateOverlay();
    }

    function openMega(id) {
      if (!isDesktop()) return;

      cancelCloseMega();
      closeAccount(false);
      root.classList.remove('is-hidden');

      megaPanels.forEach(panel => {
        panel.classList.toggle('is-active', panel.dataset.megaPanel === String(id));
      });

      megaTriggers.forEach(trigger => {
        trigger.setAttribute('aria-expanded', trigger.dataset.megaTrigger === String(id) ? 'true' : 'false');
      });

      root.classList.add('is-mega-open');
      updateOverlay();
    }

    function closeAccount(update = true) {
      root.classList.remove('is-account-open');
      if (accountToggle) accountToggle.setAttribute('aria-expanded', 'false');
      if (update) updateOverlay();
    }

    function toggleAccount() {
      closeMega();
      closeSearch();
      closeMobile();
      closeCart();
      root.classList.remove('is-hidden');
      root.classList.toggle('is-account-open');
      if (accountToggle) {
        accountToggle.setAttribute('aria-expanded', root.classList.contains('is-account-open') ? 'true' : 'false');
      }
      updateOverlay();
    }

    /* the on-screen keyboard shrinks the visible viewport without firing a
       normal resize on some browsers — visualViewport is the one API that
       reports it. Falls back to innerHeight where visualViewport is absent. */
    function syncKeyboardViewport() {
      var h = (window.visualViewport && window.visualViewport.height) || window.innerHeight;
      root.style.setProperty('--snh-kb-vh', h + 'px');
      /* --snh-vh is NOT cleared on close: the mobile drawer depends on it */
      root.style.setProperty('--snh-vh', h + 'px');
    }
    syncKeyboardViewport();
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', syncKeyboardViewport);
      window.visualViewport.addEventListener('scroll', syncKeyboardViewport);
    }
    window.addEventListener('resize', syncKeyboardViewport);
    window.addEventListener('orientationchange', function () {
      window.setTimeout(syncKeyboardViewport, 60);
      window.setTimeout(syncKeyboardViewport, 400);
    });

    function openSearch() {
      closeMega();
      closeAccount(false);
      closeMobile();
      closeCart();

      root.classList.remove('is-hidden');
      root.classList.add('is-search-open');
      if (searchModal) searchModal.setAttribute('aria-hidden', 'false');

      lockPage();
      updateOverlay();

      /* V5.1: refresh popular terms + new arrivals every open */
      renderPopular();
      if (liveTrendsEl) liveTrendsEl.setAttribute('aria-busy', 'true');
      loadLiveTrends().then(renderLiveTrends);
      if (!searchInput || !searchInput.value.trim()) setSearchIdle();

      ensureCatalogue();

      window.setTimeout(() => {
        if (searchInput) searchInput.focus();
        /* the keyboard animates in over ~300ms on iOS; re-measure a few
           times as it rises so the results card never ends up capped
           against a viewport height that no longer exists */
        syncKeyboardViewport();
        window.setTimeout(syncKeyboardViewport, 150);
        window.setTimeout(syncKeyboardViewport, 350);
        window.setTimeout(syncKeyboardViewport, 600);
      }, 70);
    }

    function closeSearch() {
      root.classList.remove('is-search-open');
      root.style.removeProperty('--snh-kb-vh');
      if (searchModal) searchModal.setAttribute('aria-hidden', 'true');
      updateOverlay();
      unlockPage();
    }

    function openMobile() {
      closeMega();
      closeAccount(false);
      closeSearch();
      closeCart();

      root.classList.remove('is-hidden');
      root.classList.add('is-mobile-open');
      if (mobileOpen) mobileOpen.setAttribute('aria-expanded', 'true');
      if (mobileDrawer) mobileDrawer.setAttribute('aria-hidden', 'false');

      lockPage();
      updateOverlay();
    }

    function closeMobile() {
      root.classList.remove('is-mobile-open');
      if (mobileOpen) mobileOpen.setAttribute('aria-expanded', 'false');
      if (mobileDrawer) mobileDrawer.setAttribute('aria-hidden', 'true');

      resetMobileLevels();
      updateOverlay();
      unlockPage();
    }

    async function openCart() {
      if (!enableCartDrawer || !cartDrawer) return;

      closeMega();
      closeAccount(false);
      closeSearch();
      closeMobile();

      root.classList.remove('is-hidden');
      root.classList.add('is-cart-open');
      cartDrawer.setAttribute('aria-hidden', 'false');

      lockPage();
      updateOverlay();
      await loadCart();
    }

    function closeCart() {
      root.classList.remove('is-cart-open');
      if (cartDrawer) cartDrawer.setAttribute('aria-hidden', 'true');

      updateOverlay();
      unlockPage();
    }

    function closeAll() {
      closeMega();
      closeAccount(false);
      closeSearch();
      closeMobile();
      closeCart();
      updateOverlay();
    }

    function resetMobileLevels() {
      const main = root.querySelector('[data-mobile-level="main"]');

      root.querySelectorAll('.snh-mobile-level').forEach(level => {
        level.classList.remove('is-active', 'is-behind');
      });

      if (main) main.classList.add('is-active');
    }

    function openMobileLevel(selector) {
      const main = root.querySelector('[data-mobile-level="main"]');
      const target = root.querySelector(selector);

      if (!target || !main) return;

      root.querySelectorAll('.snh-mobile-level').forEach(level => {
        level.classList.remove('is-active');
      });

      main.classList.add('is-behind');
      target.classList.add('is-active');
    }

    function escapeHtml(value = '') {
      return String(value).replace(/[&<>"']/g, char => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      }[char]));
    }

    function formatMoney(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(cents, moneyFormat);
      }

      try {
        return (Number(cents) / 100).toLocaleString(undefined, {
          style: 'currency',
          currency: {{ cart.currency.iso_code | default: shop.currency | json }}
        });
      } catch (error) {
        return `${(Number(cents) / 100).toFixed(2)}`;
      }
    }

    function formatRupees(cents) {
      const amount = Math.max(0, Math.ceil(Number(cents || 0) / 100));
      return `Rs. ${amount.toLocaleString('en-LK')}`;
    }

    function updateFreeShipping(cart) {
      if (!cart || !freeShippingThreshold) return;
      const remaining = freeShippingThreshold - Number(cart.total_price || 0);
      const progress = Math.max(0, Math.min(100, (Number(cart.total_price || 0) / freeShippingThreshold) * 100));
      const waiveSmallGap = Number(cart.item_count || 0) > 0 && remaining > 0 && remaining <= freeShippingTolerance;
      let message = 'Free delivery over Rs. 17,000';

      if (waiveSmallGap) {
        message = '';
      } else if (Number(cart.item_count || 0) > 0 && remaining > 0) {
        message = `Add ${formatRupees(remaining)} more for free delivery`;
      } else if (Number(cart.item_count || 0) > 0 && remaining <= 0) {
        message = `Free delivery on orders ${formatRupees(freeShippingThreshold)}+`;
      }

      freeShippingMessageEls.forEach(el => { el.textContent = message; });
      freeShippingProgressEls.forEach(el => { el.style.width = `${progress}%`; });
      if (freeShippingCard) freeShippingCard.hidden = waiveSmallGap;

      const deliverySlide = root.querySelector('.snh-top__promo-text');
      const announcementTrack = root.querySelector('.snh-top__track');
      if (deliverySlide) deliverySlide.hidden = waiveSmallGap;
      if (announcementTrack) announcementTrack.classList.toggle('has-single-slide', waiveSmallGap);
    }

    let catalogue = null;
    let cataloguePromise = null;
    const CATALOGUE_KEY = 'snh-catalogue-v1';

    function readCachedCatalogue() {
      try {
        const raw = sessionStorage.getItem(CATALOGUE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (parsed && Array.isArray(parsed.items) && parsed.items.length) return parsed.items;
      } catch (e) {}
      return null;
    }

    function loadCatalogue() {
      if (catalogue) return Promise.resolve(catalogue);
      if (cataloguePromise) return cataloguePromise;

      const cached = readCachedCatalogue();
      if (cached) { catalogue = cached; return Promise.resolve(catalogue); }

      cataloguePromise = (async () => {
        const items = [];
        try {
          for (let page = 1; page <= 6; page += 1) {
            const res = await fetch(`${routesRoot.replace(/\/$/, '')}/products.json?limit=250&page=${page}`, {
              headers: { 'Accept': 'application/json' }
            });
            if (!res.ok) break;
            const body = await res.json();
            const batch = (body && body.products) || [];
            batch.forEach(p => {
              const variants = p.variants || [];
              const cheapest = variants.reduce(
                (low, v) => (low === null || Number(v.price) < Number(low.price) ? v : low),
                null
              );
              items.push({
                id: p.id,
                title: p.title || '',
                vendor: p.vendor || '',
                type: p.product_type || '',
                handle: p.handle || '',
                url: `${routesRoot.replace(/\/$/, '')}/products/${p.handle}`,
                price: cheapest ? Number(cheapest.price) : '',
                image: (p.images && p.images[0] && p.images[0].src) || '',
                available: variants.some(v => v && v.available !== false),
                fromCatalogue: true
              });
            });
            if (batch.length < 250) break;
          }
        } catch (e) { /* predictive results still render on their own */ }

        catalogue = items;
        try {
          sessionStorage.setItem(CATALOGUE_KEY, JSON.stringify({ items }));
        } catch (e) { /* over quota — keep it in memory only */ }
        return catalogue;
      })();

      return cataloguePromise;
    }

    /* brands SNH is the exclusive local stockist for — the ones that convert */
    const exclusiveBrands = String(exclusiveBrandsRaw || '')
      .split(',')
      .map(part => part.toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').replace(/\s+/g, ' ').trim())
      .filter(Boolean);

    function isExclusiveBrand(product) {
      if (!exclusiveBrands.length) return false;
      const vendor = String((product && product.vendor) || '')
        .toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').replace(/\s+/g, ' ').trim();
      if (!vendor) return false;
      return exclusiveBrands.some(brand => vendor === brand || vendor.includes(brand) || brand.includes(vendor));
    }

    const BUNDLE_INDEX = [
      ['testosterone support max', 22398, 'zma shilajit resin trace testosterone booster'],
      ['testosterone support', 16498, 'pure shilajit ashwagandha ksm 66 testosterone booster'],
      ['gut metabolic support', 14298, 'berberine gut health capsules metabolic digestion'],
      ['bone strength', 13198, 'vitamin d3 k2 4000 iu calcium bone joint'],
      ['scar tissue recovery repair', 23697, 'zinc vitamin c 1000mg collagen peptides scar skin recovery'],
      ['daily foundation', 22097, 'vitamin d3 k2 magnesium glycinate omega 3 softgels revive daily'],
      ['stress recovery', 16498, 'magnesium glycinate ashwagandha ksm 66 stress sleep revive'],
      ['main mineral trio', 20997, 'zinc magnesium glycinate vitamin d3 k2 minerals revive'],
      ['immunity daily', 19897, 'omega 3 softgels vitamin c 1000mg vitamin d3 k2 immunity'],
      ['everyday essentials', 14398, 'multi vitamin complex multivitamin omega 3 softgels daily'],
      ['revive daily', 17298, 'magnesium glycinate vitamin k2 d3 5000 iu revive'],
      ['deep sleep', 23098, 'sleep support supplement zma magnesium sleep'],
      ['couples bedroom bundle', 17998, 'sex bomb for him her libido couples'],
      ['strength foundation', 24997, 'zma creatine monohydrate unflavoured vitamin d3 k2 strength'],
      ['strength skin', 17998, 'creatine monohydrate beauty collagen skin strength'],
      ['creatine starter', 10998, 'creatine monohydrate unflavoured shaker bottle 750ml starter'],
      ['whey pre stack', 30998, 'critical whey protein abe all black everything pre workout'],
      ['whey training stack', 30997, 'critical whey protein creatine monohydrate shaker bottle'],
      ['isolate pre stack', 33998, 'iso xp isolate whey abe all black everything pre workout'],
      ['isolate training stack', 33997, 'iso xp isolate whey creatine monohydrate shaker bottle'],
      ['raw loaded stack', 30497, 'raw essential pre workout creatine monohydrate 500g shaker'],
      ['raw training stack', 18498, 'raw essential pre workout creatine monohydrate 30 serv'],
      ['endurance trial pack', 5095, 'sis go isotonic energy gel beta fuel electrolyte caffeine nootropics endurance'],
      ['race day pack 2', 9993, 'sis hydro tablets beta fuel gel electrolyte race endurance'],
      ['race day pack 1', 9393, 'sis hydro tablets go isotonic energy gel race endurance']
    ];

    function bundleFor(product) {
      const title = normalise(product && product.title);
      if (!title) return null;
      for (let i = 0; i < BUNDLE_INDEX.length; i += 1) {
        const entry = BUNDLE_INDEX[i];
        if (title.includes(entry[0])) {
          return { normalRs: entry[1], words: entry[2].split(' ') };
        }
      }
      return null;
    }

    function normalizeImage(image) {
      if (!image) return '';
      if (typeof image === 'string') return image;
      if (image.url) return image.url;
      if (image.src) return image.src;
      return '';
    }

    function normalizePrice(product) {
      const candidate =
        product.price ||
        product.price_min ||
        product.price_max ||
        product.compare_at_price_min ||
        '';

      if (candidate === '' || candidate === null || candidate === undefined) return '';

      if (typeof candidate === 'number') {
        const amount = candidate > 100000 ? candidate / 100 : candidate;
        return `Rs. ${Math.round(amount).toLocaleString('en-LK')}`;
      }

      const asString = String(candidate).trim();
      if (/rs\.?|lkr|රු/i.test(asString)) return asString.replace(/\.00(?!\d)/g, '');

      const numeric = Number(asString.replace(/,/g, ''));
      if (!Number.isNaN(numeric) && Number.isFinite(numeric)) {
        return `Rs. ${Math.round(numeric).toLocaleString('en-LK')}`;
      }

      return asString;
    }

    /* V6: stable popular searches — no automatic reshuffling while reading */
    function renderPopular() {
      if (!popularListEl || popularPool.length < 2) return;
      const picks = popularPool.slice(0, 6);
      popularListEl.innerHTML = picks.map(term => `
        <li>
          <a class="snh-popular-link" href="${searchUrl}?q=${encodeURIComponent(term)}">
            <span class="snh-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            ${escapeHtml(term)}
          </a>
        </li>
      `).join('');
    }

    /* Backend-ranked best sellers with a short refresh window and safe fallbacks. */
    function buildStoreUrl(path = '') {
      const base = String(routesRoot || '/').replace(/\/+$/, '');
      const cleanPath = String(path).replace(/^\/+/, '');
      return `${base}/${cleanPath}`;
    }

    /* a real product record — availability is NOT part of validity:
       customers search a name to check we carry it, so out-of-stock
       products must still appear (tagged, ranked last). */
    function productIsAvailable(product) {
      return !!(product && product.handle && product.title);
    }

    /* brand shorthand customers actually type → what the catalogue calls it */
    const BRAND_ALIASES = {
      sis: ['science in sport', 'science', 'sport'],
      an: ['applied nutrition', 'applied'],
      on: ['optimum nutrition', 'optimum'],
      bsn: ['bsn'],
      raw: ['raw nutrition', 'raw'],
      ryse: ['ryse'],
      pvl: ['pvl'],
      usn: ['usn'],
      mp: ['myprotein', 'my protein'],
      gn: ['go nutrition'],
      hs: ['healthspan'],
      tm: ['trace minerals'],
      vb: ['vitabiotics'],
      ss: ['seven seas'],
      dym: ['dymatize'],
      scitec: ['scitec nutrition', 'scitec']
    };

    function normalise(value) {
      return String(value || '')
        .toLowerCase()
        .replace(/[^a-z0-9\s]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    /* "sis go electrolyte" → "science in sport go electrolyte" so Shopify
       itself can find products whose title never contains the shorthand */
    function expandQuery(query) {
      const tokens = normalise(query).split(' ').filter(Boolean);
      if (!tokens.length) return '';
      let changed = false;
      const out = tokens.map(token => {
        const alias = BRAND_ALIASES[token];
        if (alias && alias[0]) { changed = true; return alias[0]; }
        return token;
      });
      return changed ? out.join(' ') : '';
    }

    function productInStock(product) {
      if (!product) return false;
      if (product.available === false) return false;
      if (product.available === true) return true;
      if (!Array.isArray(product.variants) || !product.variants.length) return true;
      return product.variants.some(variant => variant && variant.available !== false);
    }

    function uniqueProducts(...groups) {
      const seen = new Set();
      const list = groups.flat().filter(product => {
        const key = product && (product.id || product.handle);
        if (!key || seen.has(String(key))) return false;
        seen.add(String(key));
        return productIsAvailable(product);
      });
      /* in-stock first, sold-out at the end — order otherwise preserved */
      return list
        .map((product, index) => ({ product, index, stocked: productInStock(product) }))
        .sort((a, b) => (a.stocked === b.stocked ? a.index - b.index : (a.stocked ? -1 : 1)))
        .map(entry => entry.product);
    }

    async function fetchStoreProducts(url) {
      const controller = typeof AbortController === 'function' ? new AbortController() : null;
      const timeout = window.setTimeout(() => {
        if (controller) controller.abort();
      }, 4500);

      try {
        const response = await fetch(url, {
          cache: 'no-store',
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' },
          signal: controller ? controller.signal : undefined
        });
        if (!response.ok) throw new Error('Store products unavailable');
        const data = await response.json();
        return Array.isArray(data.products) ? data.products : [];
      } finally {
        window.clearTimeout(timeout);
      }
    }

    async function fetchRankedCollection(handle, refreshBucket) {
      const safeHandle = encodeURIComponent(handle || 'all');
      const url = buildStoreUrl(`collections/${safeHandle}/products.json`) +
        `?limit=12&sort_by=best-selling&snh_refresh=${refreshBucket}`;
      return fetchStoreProducts(url);
    }

    async function loadLiveTrends(force = false) {
      const now = Date.now();
      const isFresh = snhLiveProductsLoadedAt && (now - snhLiveProductsLoadedAt < liveTrendsTtl);

      if (!force && isFresh) return snhLiveProducts;
      if (snhLiveProductsRequest) return snhLiveProductsRequest;

      snhLiveProductsRequest = (async () => {
        const refreshBucket = Math.floor(now / liveTrendsTtl);
        const sourceHandle = popularCollectionHandle || 'all';
        let ranked = [];

        try {
          ranked = uniqueProducts(await fetchRankedCollection(sourceHandle, refreshBucket));
        } catch (error) {
          ranked = [];
        }

        if (ranked.length < liveTrendsLimit && sourceHandle !== 'all') {
          try {
            const allStoreBestSellers = await fetchRankedCollection('all', refreshBucket);
            ranked = uniqueProducts(ranked, allStoreBestSellers);
          } catch (error) {
            /* The text fallback below remains available if both collection requests fail. */
          }
        }

        if (ranked.length < liveTrendsLimit) {
          try {
            const recentProducts = await fetchStoreProducts(
              buildStoreUrl('products.json') + `?limit=12&snh_refresh=${refreshBucket}`
            );
            ranked = uniqueProducts(ranked, recentProducts);
          } catch (error) {
            /* Keep any ranked products already returned. */
          }
        }

        snhLiveProducts = uniqueProducts(ranked).slice(0, liveTrendsLimit);
        snhLiveProductsLoadedAt = Date.now();
        return snhLiveProducts;
      })().catch(() => {
        snhLiveProducts = [];
        snhLiveProductsLoadedAt = Date.now();
        return snhLiveProducts;
      }).finally(() => {
        snhLiveProductsRequest = null;
      });

      return snhLiveProductsRequest;
    }

    function renderLiveTrends(products) {
      if (!liveTrendsEl) return;

      const liveItems = (products || []).slice(0, liveTrendsLimit).map((product, index) => `
        <a class="snh-live-trends__item" href="${buildStoreUrl(`products/${encodeURIComponent(product.handle || '')}`)}">
          <span>0${index + 1}</span>
          <span>${escapeHtml(product.title || '')}</span>
        </a>
      `).join('');

      const fallbackItems = popularPool.slice(0, liveTrendsLimit).map((term, index) => `
        <a class="snh-live-trends__item" href="${searchUrl}?q=${encodeURIComponent(term)}">
          <span>0${index + 1}</span>
          <span>${escapeHtml(term)}</span>
        </a>
      `).join('');

      liveTrendsEl.innerHTML = `
        <span class="snh-live-trends__eyebrow">Popular now at SNH</span>
        <span class="snh-live-trends__list">${liveItems || fallbackItems}</span>
      `;
      liveTrendsEl.setAttribute('aria-busy', 'false');
    }

    /* V5.1: "New in store" showcase */
    async function loadNewArrivals() {
      if (snhNewArrivals) return snhNewArrivals;
      try {
        const response = await fetch('/products.json?limit=4', { headers: { 'Accept': 'application/json' } });
        const data = await response.json();
        snhNewArrivals = (data.products || []).slice(0, 4);
      } catch (error) {
        snhNewArrivals = [];
      }
      return snhNewArrivals;
    }

    function renderNewArrivals(products) {
      if (!searchResults) return;

      if (!products.length) {
        searchResults.innerHTML = `
          <ul class="snh-suggest-list">
            <li><span class="snh-suggest-link">Search by product, brand, goal, supplement type or flavour.</span></li>
          </ul>
        `;
        return;
      }

      searchResults.innerHTML = `
        <div class="snh-new-grid">
          ${products.map(p => {
            const img = p.images && p.images[0] ? p.images[0].src : '';
            const imgUrl = img ? img + (img.indexOf('?') > -1 ? '&' : '?') + 'width=180' : '';
            const price = p.variants && p.variants[0]
              ? 'Rs. ' + Math.round(Number(p.variants[0].price)).toLocaleString('en-LK')
              : '';
            return `
              <a class="snh-new-card" href="/products/${p.handle}">
                ${imgUrl ? `<img src="${imgUrl}" alt="${escapeHtml(p.title)}" loading="lazy">` : ''}
                <strong>${escapeHtml(p.title)}</strong>
                ${price ? `<em>${price}</em>` : ''}
              </a>
            `;
          }).join('')}
        </div>
        <a class="snh-btn snh-btn--orange snh-search-view-all" href="/collections/all?sort_by=created-descending" style="margin-top:14px;width:100%;">View all new arrivals</a>
      `;
    }

    function setSearchIdle() {
      if (searchResultsTitle) searchResultsTitle.textContent = 'New arrivals';

      if (searchResults) {
        searchResults.innerHTML = `
          <div class="snh-search-loading" aria-hidden="true">
            <span class="snh-search-skeleton"></span>
            <span class="snh-search-skeleton"></span>
          </div>
        `;
      }

      loadNewArrivals().then(renderNewArrivals);
    }

    function setSearchLoading() {
      if (searchResultsTitle) searchResultsTitle.textContent = 'Searching...';

      if (searchResults) {
        searchResults.innerHTML = `
          <div class="snh-search-loading" aria-hidden="true">
            <span class="snh-search-skeleton"></span>
            <span class="snh-search-skeleton"></span>
            <span class="snh-search-skeleton"></span>
          </div>
        `;
      }
    }

    function renderSearchResults(data, query) {
      const results = data && data.resources && data.resources.results ? data.resources.results : {};
      const rawProducts = results.products || [];
      const collections = results.collections || [];
      const articles = results.articles || [];
      const pages = results.pages || [];
      const queries = results.queries || [];

      if (!rawProducts.length && !collections.length && !articles.length && !pages.length && !queries.length) {
        if (searchResultsTitle) searchResultsTitle.textContent = 'No matches yet';
        if (searchResults) {
          searchResults.innerHTML = `
            <ul class="snh-suggest-list">
              <li>
                <a class="snh-suggest-link" href="${searchUrl}?q=${encodeURIComponent(query)}">
                  Search the store for “${escapeHtml(query)}”
                </a>
              </li>
            </ul>
          `;
        }
        return;
      }

      if (searchResultsTitle) searchResultsTitle.textContent = `Results for “${query}”`;

      /* ── relevance scoring ───────────────────────────────────────────
         Titles alone are not enough: customers type brand shorthand
         ("SIS go electrolyte", "AN creatine") that never appears in the
         product title, so those results used to rank below unrelated
         whey proteins. Score every token against title + vendor + type
         + handle, expanding known brand shorthands first. */
      const q = normalise(query);
      const rawTokens = q.split(' ').filter(Boolean);
      /* every token, plus whatever a brand shorthand expands to */
      const tokenGroups = rawTokens.map(token => {
        const expanded = BRAND_ALIASES[token] || [];
        return [token].concat(expanded.map(normalise));
      });

      /* bounded edit distance — tolerates one or two typed slips
         ("electroryte" → "electrolyte") without matching unrelated words */
      const withinEdits = (a, b, max) => {
        if (Math.abs(a.length - b.length) > max) return false;
        let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
        for (let i = 1; i <= a.length; i++) {
          const row = [i];
          let best = i;
          for (let j = 1; j <= b.length; j++) {
            const cost = a[i - 1] === b[j - 1] ? 0 : 1;
            row[j] = Math.min(prev[j] + 1, row[j - 1] + 1, prev[j - 1] + cost);
            if (row[j] < best) best = row[j];
          }
          if (best > max) return false;
          prev = row;
        }
        return prev[b.length] <= max;
      };

      /* score one token against a list of whole words.
         Word-based, never a blind substring: "go" must not match "reGO". */
      const tokenScore = (token, words) => {
        if (!token) return 0;
        let best = 0;
        for (let i = 0; i < words.length; i++) {
          const word = words[i];
          if (word === token) { return 100; }
          if (token.length >= 3 && word.startsWith(token)) { best = Math.max(best, 82); continue; }
          if (token.length >= 5 && word.length >= 5) {
            const allowed = token.length >= 8 ? 2 : 1;
            if (withinEdits(token, word, allowed)) { best = Math.max(best, 68); continue; }
            if (word.includes(token)) { best = Math.max(best, 55); }
          }
        }
        return best;
      };

      const wordsOf = (value) => normalise(value).split(' ').filter(Boolean);

      const scoreProduct = (product) => {
        const titleWords = wordsOf(product.title);
        const brandWords = wordsOf(product.vendor)
          .concat(wordsOf(product.type))
          .concat(wordsOf(String(product.handle || '').replace(/-/g, ' ')));
        const title = titleWords.join(' ');

        let score = 0;
        if (title === q) score += 1200;
        else if (title.startsWith(q)) score += 700;
        else if (title.includes(q)) score += 450;

        let matched = 0;
        tokenGroups.forEach(group => {
          let inTitle = 0;
          let inBrand = 0;
          group.forEach(variant => {
            variant.split(' ').filter(Boolean).forEach(part => {
              inTitle = Math.max(inTitle, tokenScore(part, titleWords));
              inBrand = Math.max(inBrand, tokenScore(part, brandWords));
            });
          });
          const best = Math.max(inTitle, inBrand);
          if (best) {
            matched += 1;
            score += inTitle >= inBrand ? inTitle : Math.round(inBrand * 0.7);
          }
        });

        /* every word the customer typed is accounted for somewhere */
        if (rawTokens.length && matched === rawTokens.length) score += 320;
        else if (rawTokens.length) score -= (rawTokens.length - matched) * 90;

        /* prefer the plainest product of an equally-matching set:
           a shorter title means fewer words the customer did not ask for */
        score -= Math.min(titleWords.length, 12) * 2;

        /* a bundle whose contents cover everything the customer typed is a
           genuine answer to the query, so it clears the relevance floor —
           but stays below a product whose own title matches */
        const bundleMeta = bundleFor(product);
        product.__snhBundleHit = false;
        if (bundleMeta && rawTokens.length) {
          let bundleMatched = 0;
          tokenGroups.forEach(group => {
            let best = 0;
            group.forEach(token => { best = Math.max(best, tokenScore(token, bundleMeta.words)); });
            if (best >= 68) bundleMatched += 1;
          });
          if (bundleMatched === rawTokens.length) {
            score = Math.max(score, 305) + bundleMatched * 35;
            product.__snhBundleHit = true;
          }
        }

        /* exclusive brands break ties in their favour — never ahead of a
           better match, only ahead of an equally good one */
        if (isExclusiveBrand(product)) score += 45;

        return score;
      };

      /* Shopify may simply never return the right product (its index skips
         some titles entirely) — score OUR catalogue too and merge anything
         that genuinely matches but was missing from the API response */
      const merged = rawProducts.slice();
      if (catalogue && catalogue.length && rawTokens.length) {
        const seen = new Set(merged.map(p => String(p.id || p.handle)));
        const localHits = catalogue
          .map(product => ({ product, score: scoreProduct(product) }))
          .filter(entry => entry.score >= 300)
          .sort((a, b) => b.score - a.score)
          .slice(0, 60);
        localHits.forEach(entry => {
          const key = String(entry.product.id || entry.product.handle);
          if (seen.has(key)) return;
          seen.add(key);
          merged.push(entry.product);
        });
      }

      const scored = merged
        .map((product, index) => ({ product, index, score: scoreProduct(product), stocked: productInStock(product) }));
      const topScore = scored.length ? Math.max.apply(null, scored.map(e => e.score)) : 0;
      /* below this, nothing Shopify handed back is really "the thing they typed" —
         predictive search caps at 10 results per type, so on a crowded, unbranded
         query the actual product can be sitting just outside that window and
         never reaches this list at all; no amount of client re-ranking can surface
         a product the API didn't return, so point straight at the full results */
      const weakMatch = rawTokens.length > 0 && (scored.length === 0 || topScore < 260) && !!catalogue;
      const hasRealMatch = scored.some(e => e.score >= 300);
      const cleaned = hasRealMatch ? scored.filter(e => e.score >= 120) : scored;
      const products = cleaned
        .sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          if (a.stocked !== b.stocked) return a.stocked ? -1 : 1;
          return a.index - b.index;
        })
        .map(entry => entry.product);

      const soldOutCount = products.filter(p => !productInStock(p)).length;

      const renderProductCard = (product) => {
        const image = normalizeImage(product.featured_image) || normalizeImage(product.image);
        const title = escapeHtml(product.title || '');
        const vendor = product.vendor ? escapeHtml(product.vendor) : '';
        const url = product.url || `${searchUrl}?q=${encodeURIComponent(query)}`;
        const price = escapeHtml(normalizePrice(product));
        const stocked = productInStock(product);
        const productLink = product.url ? (location.origin + product.url) : '';
        const restockUrl = 'https://wa.me/94764863359?text=' + encodeURIComponent(
          'Hi SNH, I want updates on when this is restocked:\n\n' +
          (product.title || query) + (productLink ? '\n' + productLink : '')
        );

        return `
          <a class="snh-product-suggestion${stocked ? '' : ' is-soldout'}" href="${url}">
            ${image ? `<img src="${image}" alt="${title}" loading="lazy" decoding="async">` : `<span class="snh-product-placeholder"></span>`}
            <span>
              ${vendor ? `<small class="snh-product-vendor">${vendor}${isExclusiveBrand(product) ? '<em class="snh-product-excl">Exclusive to SNH</em>' : ''}</small>` : ''}
              <strong>${title}</strong>
              <span class="snh-product-meta">
                ${price ? `<span class="snh-product-price">${price}</span>` : ''}
                ${(() => {
                  const meta = bundleFor(product);
                  if (!meta) return '';
                  const raw = parseFloat(String(product.price).replace(/[^0-9.]/g, ''));
                  if (!raw) return '';
                  /* a rupee figure here never runs past six digits; anything
                     larger arrived in cents and is brought back to rupees */
                  const nowRs = raw > 200000 ? raw / 100 : raw;
                  if (meta.normalRs <= nowRs) return '';
                  const rs = (value) => 'Rs. ' + Math.round(value).toLocaleString('en-US');
                  return `<em class="snh-bundle-save">Save ${rs(meta.normalRs - nowRs)}</em><s class="snh-bundle-was">${rs(meta.normalRs)}</s>`;
                })()}
                ${stocked ? '' : '<em class="snh-product-stockflag">Out of stock</em>'}
              </span>
            </span>
          </a>
          ${(stocked || soldOutCount > 1) ? '' : `<a class="snh-product-similar" href="${restockUrl}" target="_blank" rel="noopener">Update when restocked <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>`}
        `;
      };

      const soldOutList = products.filter(p => !productInStock(p));
      const combinedRestockMarkup = soldOutList.length > 1 ? (() => {
        const lines = soldOutList.map(p => {
          const link = p.url ? (location.origin + p.url) : '';
          return (p.title || '') + (link ? '\n' + link : '');
        }).join('\n\n');
        const url = 'https://wa.me/94764863359?text=' + encodeURIComponent(
          'Hi SNH, I want updates on when these are restocked:\n\n' + lines
        );
        return `<a class="snh-product-similar snh-product-similar--combined" href="${url}" target="_blank" rel="noopener">Update me on all ${soldOutList.length} out-of-stock items <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>`;
      })() : '';

      const bundleAt = products.findIndex(entry => {
        const item = entry && entry.product ? entry.product : entry;
        return item && item.__snhBundleHit;
      });
      if (bundleAt > 2 && products.length > 2) {
        products.splice(1, 0, products.splice(bundleAt, 1)[0]);
      }

      /* every match, listed — nothing hidden behind a toggle */
      const primaryProducts = products;
      const extraProducts = [];
      const productMarkup = primaryProducts.map(renderProductCard).join('') + (extraProducts.length ? '' : combinedRestockMarkup);
      const extraProductMarkup = extraProducts.map(renderProductCard).join('') + (extraProducts.length ? combinedRestockMarkup : '');

      const queryMarkup = queries.slice(0, 5).map(item => {
        const raw = item.text || item.title || item.styled_text || query;
        const text = escapeHtml(raw);
        const url = item.url || `${searchUrl}?q=${encodeURIComponent(raw)}`;

        return `
          <li>
            <a class="snh-suggest-link" href="${url}">
              <span class="snh-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span>${text}</span>
            </a>
          </li>
        `;
      }).join('');

      const articleMarkup = articles.slice(0, 3).map(item => {
        const image = normalizeImage(item.image);
        const title = escapeHtml(item.title || 'SNH guide');
        const url = item.url || `${searchUrl}?q=${encodeURIComponent(query)}`;

        return `
          <a class="snh-content-result" href="${url}">
            ${image ? `<img src="${image}" alt="" loading="lazy" decoding="async">` : `<span class="snh-content-result__placeholder"></span>`}
            <span><small>Guide & article</small><strong>${title}</strong></span>
          </a>
        `;
      }).join('');

      const linkMarkup = [
        ...collections.map(item => ({ title: item.title, url: item.url, label: 'Collection' })),
        ...pages.map(item => ({ title: item.title, url: item.url, label: 'Page' }))
      ].slice(0, 8).map(item => `
        <li>
          <a class="snh-suggest-link" href="${item.url}">
            <span class="snh-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>${escapeHtml(item.title)} <small style="color:var(--snh-muted);font-weight:650;">${escapeHtml(item.label)}</small></span>
          </a>
        </li>
      `).join('');

      /* with the catalogue indexed locally there is nothing left to escape to —
         a genuinely empty result is stated plainly instead */
      const weakMatchBanner = (weakMatch && !products.length) ? `
        <p class="snh-search-empty">No products match “${escapeHtml(query)}”. Try a brand, a goal or a supplement type.</p>
      ` : '';

      if (searchResultsTitle && products.length) {
        searchResultsTitle.textContent = `${products.length} ${products.length === 1 ? 'result' : 'results'} for “${query}”`;
      }

      if (searchResults) {
        searchResults.innerHTML = `
          ${weakMatchBanner}
          ${productMarkup ? `<div style="display:grid;gap:0;margin-bottom:10px;">${productMarkup}</div>` : ''}
          ${extraProductMarkup ? `<details class="snh-product-more"><summary>View ${extraProducts.length} more products</summary><div class="snh-product-more__list">${extraProductMarkup}</div></details>` : ''}
          ${articleMarkup ? `<p class="snh-section-label" style="margin-top:17px;">Guides & articles</p><div class="snh-content-results">${articleMarkup}</div>` : ''}
          ${queryMarkup ? `<p class="snh-section-label" style="margin-top:16px;">Suggested searches</p><ul class="snh-suggest-list">${queryMarkup}</ul>` : ''}
          ${linkMarkup ? `<p class="snh-section-label" style="margin-top:18px;">Collections & pages</p><ul class="snh-suggest-list">${linkMarkup}</ul>` : ''}
          <a class="snh-btn snh-btn--orange snh-search-view-all" href="${searchUrl}?q=${encodeURIComponent(query)}" style="margin-top:18px;width:100%;">See all results for “${escapeHtml(query)}”</a>
        `;
      }
    }

    function ensureCatalogue() {
      const alreadyLoaded = !!catalogue;
      loadCatalogue().then(() => {
        /* first load finished after the customer already typed — redo the
           search so the freshly indexed products appear without a keystroke */
        if (!alreadyLoaded && searchInput && searchInput.value.trim().length >= 2) {
          runSearch(searchInput.value);
        }
      });
    }

    async function runSearch(query) {
      if (!query || query.trim().length < 2) {
        if (searchController) searchController.abort();
        setSearchIdle();
        return;
      }

      const localSearchId = ++latestSearchId;

      if (searchController) {
        searchController.abort();
      }

      searchController = new AbortController();
      setSearchLoading();

      try {
        const buildUrl = (term) => `${predictiveUrl}?q=${encodeURIComponent(term)}&resources[type]=product,collection,article,page,query&resources[limit]=10&resources[limit_scope]=each&resources[options][unavailable_products]=last`;

        const response = await fetch(buildUrl(query), {
          headers: { 'Accept': 'application/json' },
          signal: searchController.signal
        });

        if (!response.ok) throw new Error('Search request failed');

        const data = await response.json();

        /* brand shorthand: run the expanded term too and merge the products in,
           otherwise "SIS go electrolyte" never reaches the product at all */
        const alt = expandQuery(query);
        if (alt && alt !== normalise(query)) {
          try {
            const altResponse = await fetch(buildUrl(alt), {
              headers: { 'Accept': 'application/json' },
              signal: searchController.signal
            });
            if (altResponse.ok) {
              const altData = await altResponse.json();
              const base = (data.resources && data.resources.results) || {};
              const extra = (altData.resources && altData.resources.results) || {};
              const seen = new Set((base.products || []).map(p => String(p.id || p.handle)));
              base.products = (base.products || []).concat(
                (extra.products || []).filter(p => {
                  const key = String(p.id || p.handle);
                  if (seen.has(key)) return false;
                  seen.add(key);
                  return true;
                })
              );
            }
          } catch (altError) { /* the primary result set still renders */ }
        }

        if (localSearchId === latestSearchId) {
          renderSearchResults(data, query);
        }
      } catch (error) {
        /* a cancelled-by-newer-keystroke request must never show as "unavailable" —
           some browsers throw a plain error (not AbortError) when a fetch is aborted,
           so also bail out whenever a newer search has already superseded this one. */
        if (error.name === 'AbortError' || localSearchId !== latestSearchId) return;

        if (searchResultsTitle) searchResultsTitle.textContent = 'Live suggestions unavailable';
        if (searchResults) {
          searchResults.innerHTML = `
            <ul class="snh-suggest-list">
              <li>
                <a class="snh-suggest-link" href="${searchUrl}?q=${encodeURIComponent(query)}">
                  Search for “${escapeHtml(query)}”
                </a>
              </li>
            </ul>
          `;
        }
      }
    }

    function renderMiniCartPoints(cart) {
      if (!miniCartPoints) return;
      if (!cart || !cart.item_count) {
        miniCartPoints.classList.remove('is-visible');
        miniCartPoints.innerHTML = '';
        return;
      }

      const bolt = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m13 2-9 12h8l-1 8 9-12h-8l1-8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>';
      if (customerAuthenticated) {
        const points = Math.floor((Number(cart.total_price || 0) / 100) * loyaltyRate / 100);
        miniCartPoints.innerHTML = `${bolt}<span>You'll earn <b>${points} points</b> as a ${escapeHtml(loyaltyTier)} member.</span>`;
      } else {
        miniCartPoints.innerHTML = `${bolt}<span><a href="${accountLoginUrl}">Log in</a> or <a href="${accountRegisterUrl}">join SNH Elite</a> to earn 3% back.</span>`;
      }
      miniCartPoints.classList.add('is-visible');
    }

    function loadMiniCatalogue() {
      if (snhMiniCatalogue) return Promise.resolve(snhMiniCatalogue);
      if (snhMiniCatalogueRequest) return snhMiniCatalogueRequest;

      snhMiniCatalogueRequest = fetch('/collections/all/products.json?limit=250&sort_by=best-selling', {
        headers: { 'Accept': 'application/json' }
      }).then(response => response.ok ? response.json() : { products: [] })
        .then(data => {
          snhMiniCatalogue = data.products || [];
          return snhMiniCatalogue;
        })
        .catch(() => [])
        .finally(() => { snhMiniCatalogueRequest = null; });

      return snhMiniCatalogueRequest;
    }

    function cheapestCatalogueVariant(product) {
      return (product.variants || []).filter(variant => variant.available && Number(variant.price) > 0)
        .sort((a, b) => Number(a.price) - Number(b.price))[0] || null;
    }

    function cheapestRecommendationVariant(product) {
      return (product.variants || []).filter(variant => variant.available && Number(variant.price) > 0)
        .sort((a, b) => Number(a.price) - Number(b.price))[0] || null;
    }

    function rotateMiniItems(items, key, limit) {
      if (!items.length) return [];
      const count = Math.min(limit, items.length);
      let offset = 0;
      try {
        offset = Number(sessionStorage.getItem(key) || 0) % items.length;
        sessionStorage.setItem(key, String((offset + count) % items.length));
      } catch (error) {}

      return Array.from({ length: count }, (_, index) => items[(offset + index) % items.length]);
    }

    function miniRecommendationCard(item) {
      const product = item.product;
      const image = item.image || normalizeImage(product.featured_image) || normalizeImage(product.image) || (product.images && normalizeImage(product.images[0]));
      const imageUrl = image ? `${image}${image.includes('?') ? '&' : '?'}width=140` : '';
      const productUrl = product.url || `/products/${encodeURIComponent(product.handle || '')}`;

      return `
        <article class="snh-mini-rec">
          <a href="${productUrl}">
            ${imageUrl ? `<img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(product.title || '')}" loading="lazy" decoding="async">` : '<span class="snh-mini-rec__placeholder"></span>'}
          </a>
          <span class="snh-mini-rec__meta">
            <a class="snh-mini-rec__name" href="${productUrl}">${escapeHtml(product.title || '')}</a>
            <span class="snh-mini-rec__price">${formatMoney(item.priceCents)}</span>
            <span class="snh-mini-rec__helper">${escapeHtml(item.helper || '')}</span>
          </span>
          <button type="button" class="snh-mini-rec__add" data-mini-add-variant="${item.variant.id}" aria-label="Add ${escapeHtml(product.title || '')} to basket">+</button>
        </article>
      `;
    }

    async function priceMatchedMiniProducts(cart, remaining) {
      if (remaining <= freeShippingTolerance) return [];
      const catalogue = await loadMiniCatalogue();
      const cartProductIds = new Set((cart.items || []).map(item => String(item.product_id)));
      const minimumUsefulPrice = remaining; /* must clear the gap on its own */
      const maximumUsefulPrice = Math.max(remaining * 1.9, remaining + 600000);

      const candidates = catalogue.map(product => {
        if (cartProductIds.has(String(product.id))) return null;
        const variant = cheapestCatalogueVariant(product);
        if (!variant) return null;
        return { product, variant, priceCents: Math.round(Number(variant.price) * 100) };
      }).filter(Boolean).filter(item => item.priceCents >= minimumUsefulPrice && item.priceCents <= maximumUsefulPrice);

      /* cheapest product that still clears the gap comes first */
      candidates.sort((a, b) => a.priceCents - b.priceCents);

      return rotateMiniItems(candidates.slice(0, 12), `snh-mini-gap-${remaining}`, 2).map(item => ({
        ...item,
        image: item.variant.featured_image && item.variant.featured_image.src ? item.variant.featured_image.src : '',
        helper: 'Unlocks free delivery'
      }));
    }

    async function frequentlyBoughtMiniProducts(cart) {
      const anchor = cart.items && cart.items.length ? cart.items[cart.items.length - 1] : null;
      if (!anchor || !anchor.product_id) return [];
      const rootUrl = window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/';

      async function request(intent) {
        try {
          const response = await fetch(`${rootUrl}recommendations/products.json?product_id=${encodeURIComponent(anchor.product_id)}&limit=10&intent=${intent}`, {
            headers: { 'Accept': 'application/json' }
          });
          if (!response.ok) return [];
          const data = await response.json();
          return data.products || [];
        } catch (error) {
          return [];
        }
      }

      const anchorTitle = String(anchor.product_title || anchor.title || '').toLowerCase();
      const cartProductIds = new Set((cart.items || []).map(item => String(item.product_id)));

      /* Shopify order insights: top pairs anchored on Flavored Creatine Monohydrate */
      const SNH_PAIR_KEYS = ['creatine monohydrate 50', 'creatine monohydrate 100', 'shaker bottle', 'iso-xp', 'beef-xp', 'caffeine capsules', 'abe - all black everything', 'l-arginine', 'zinc', 'l-carnitine', 'bcaa amino hydrate', 'omega 3', 'vitamin d3', 'effervescent', 'collagen peptides', 'vitamin c 1000', 'protein chips', 'beauty collagen', 'vitamin-b complex', 'diet whey', 'protein wafers', 'abe shaker', 'creatine + hydration', 'diet protein bar'];
      let insightMatches = [];
      if (anchorTitle.indexOf('creatine') > -1) {
        const catalogue = await loadMiniCatalogue();
        SNH_PAIR_KEYS.forEach(key => {
          const hit = catalogue.find(p => String(p.title || '').toLowerCase().indexOf(key) > -1 && !cartProductIds.has(String(p.id)));
          if (hit && !insightMatches.some(m => m.id === hit.id)) insightMatches.push(hit);
        });
      }

      let products = insightMatches;
      if (!products.length) products = await request('complementary');
      if (!products.length) products = await request('related');

      /* never pitch a near-duplicate of what's already in the basket (e.g. another ashwagandha) */
      const anchorTokens = anchorTitle.split(/[^a-z0-9-]+/).filter(w => w.length >= 7 && w !== 'nutrition' && w !== 'servings' && w !== 'capsules');
      const isNearDuplicate = (title) => {
        if (anchorTitle.indexOf('creatine') > -1) return false; /* creatine+creatine is a proven pair */
        const lower = String(title || '').toLowerCase();
        return anchorTokens.some(tok => lower.indexOf(tok) > -1);
      };

      const candidates = products.filter(product => !isNearDuplicate(product.title)).map(product => {
        if (cartProductIds.has(String(product.id))) return null;
        let variant = cheapestRecommendationVariant(product);
        let priceCents = variant ? Number(variant.price) : 0;
        if (!variant || !isFinite(priceCents) || priceCents <= 0) {
          variant = cheapestCatalogueVariant(product);
          priceCents = variant ? Math.round(Number(variant.price) * 100) : 0;
        }
        if (!variant) return null;
        return {
          product,
          variant,
          priceCents,
          image: variant.featured_image && variant.featured_image.src ? variant.featured_image.src : '',
          helper: 'Pairs with your basket'
        };
      }).filter(Boolean);

      return rotateMiniItems(candidates, `snh-mini-related-${anchor.product_id}`, 2);
    }

    async function renderMiniCartRecommendations(cart) {
      const container = cartItems && cartItems.querySelector('[data-mini-cart-recommendations]');
      if (!container || !cart.item_count) return;
      const run = ++snhMiniRecommendationRun;
      const remaining = freeShippingThreshold - Number(cart.total_price || 0);
      const [gapMatches, relatedMatches] = await Promise.all([
        priceMatchedMiniProducts(cart, remaining),
        frequentlyBoughtMiniProducts(cart)
      ]);
      if (run !== snhMiniRecommendationRun || !container.isConnected) return;

      const sections = [];
      if (remaining > freeShippingTolerance && gapMatches.length) {
        sections.push(`
          <section class="snh-mini-recs">
            <div class="snh-mini-recs__head"><span><small>Complete free delivery</small><strong>${formatRupees(remaining)} to go</strong></span><em>${gapMatches.length} smart ${gapMatches.length === 1 ? 'pick' : 'picks'}</em></div>
            <div class="snh-mini-recs__grid">${gapMatches.map(miniRecommendationCard).join('')}</div>
          </section>
        `);
      }
      if (relatedMatches.length) {
        sections.push(`
          <section class="snh-mini-recs">
            <div class="snh-mini-recs__head"><span><small>Selected for this basket</small><strong>Frequently bought together</strong></span><em>${relatedMatches.length} ${relatedMatches.length === 1 ? 'suggestion' : 'suggestions'}</em></div>
            <div class="snh-mini-recs__grid">${relatedMatches.map(miniRecommendationCard).join('')}</div>
          </section>
        `);
      }
      container.innerHTML = sections.join('');

      container.querySelectorAll('[data-mini-add-variant]').forEach(button => {
        button.addEventListener('click', async () => {
          button.textContent = '…';
          button.disabled = true;
          try {
            const response = await fetch(cartAddUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ id: Number(button.dataset.miniAddVariant), quantity: 1 })
            });
            if (!response.ok) throw new Error('Add failed');
            await loadCart();
          } catch (error) {
            button.textContent = '+';
            button.disabled = false;
          }
        });
      });
    }

    function renderCart(cart) {
      updateFreeShipping(cart);
      cartCountEls.forEach(el => {
        el.textContent = cart.item_count;
      });

      if (cartSubtotal) cartSubtotal.textContent = formatMoney(cart.total_price);

      if (!cartItems) return;

      if (!cart.items || cart.items.length === 0) {
        renderMiniCartPoints(cart);
        cartItems.innerHTML = `
          <div class="snh-cart-empty">
            <strong>Your basket is empty</strong>
            <span>Add your favourites and they’ll appear here instantly.</span>
            <a class="snh-btn snh-btn--orange" href="/collections/all">Start shopping</a>
          </div>
        `;
        return;
      }

      renderMiniCartPoints(cart);
      cartItems.innerHTML = cart.items.map((item, index) => `
        <article class="snh-cart-item">
          ${item.image ? `<img src="${item.image}" alt="${escapeHtml(item.product_title)}" loading="lazy">` : `<span style="width:82px;height:82px;border-radius:14px;background:#f6f6f6;display:block;"></span>`}
          <div>
            <a class="snh-cart-item-title" href="${item.url}">${escapeHtml(item.product_title)}</a>
            ${item.variant_title && item.variant_title !== 'Default Title' ? `<div class="snh-cart-item-meta">${escapeHtml(item.variant_title)}</div>` : ''}
            <div class="snh-cart-line-bottom">
              <div class="snh-qty" aria-label="Quantity controls">
                <button type="button" data-cart-change="${index + 1}" data-cart-qty="${Math.max(0, item.quantity - 1)}" aria-label="Decrease quantity">−</button>
                <span>${item.quantity}</span>
                <button type="button" data-cart-change="${index + 1}" data-cart-qty="${item.quantity + 1}" aria-label="Increase quantity">+</button>
              </div>
              <strong class="snh-cart-price">${formatMoney(item.final_line_price)}</strong>
            </div>
          </div>
        </article>
      `).join('') + '<div data-mini-cart-recommendations></div>';
      renderMiniCartRecommendations(cart);
    }

    async function loadCart() {
      if (!enableCartDrawer || !cartItems) return;

      try {
        const response = await fetch(cartJsonUrl, { headers: { 'Accept': 'application/json' } });
        const cart = await response.json();
        renderCart(cart);
      } catch (error) {
        cartItems.innerHTML = `
          <div class="snh-cart-empty">
            <strong>Basket unavailable</strong>
            <span>Please open the basket page to review your items.</span>
            <a class="snh-btn snh-btn--orange" href="/cart">Open basket</a>
          </div>
        `;
      }
    }

    async function updateCartLine(line, quantity) {
      if (!enableCartDrawer || !cartItems) return;

      try {
        cartItems.style.opacity = '.55';

        const response = await fetch(cartChangeUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ line: Number(line), quantity: Number(quantity) })
        });

        const cart = await response.json();
        renderCart(cart);
      } finally {
        cartItems.style.opacity = '';
      }
    }

    megaTriggers.forEach(trigger => {
      const panelId = trigger.dataset.megaTrigger;

      trigger.addEventListener('pointerenter', event => {
        if (event.pointerType === 'touch') return;
        openMega(panelId);
      });

      trigger.addEventListener('pointerleave', event => {
        if (event.pointerType === 'touch') return;
        if (isInsideMegaCluster(event.relatedTarget)) return;
        scheduleCloseMega();
      });

      trigger.addEventListener('focus', () => openMega(panelId));

      trigger.addEventListener('click', event => {
        event.preventDefault();

        const isOpen = root.classList.contains('is-mega-open') && trigger.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          closeMega();
        } else {
          openMega(panelId);
        }
      });
    });

    if (navArea) {
      navArea.addEventListener('pointerenter', cancelCloseMega);
      navArea.addEventListener('pointerleave', event => {
        if (isInsideMegaCluster(event.relatedTarget)) return;
        scheduleCloseMega();
      });
    }

    if (megaArea) {
      megaArea.addEventListener('pointerenter', cancelCloseMega);
      megaArea.addEventListener('pointerleave', event => {
        if (isInsideMegaCluster(event.relatedTarget)) return;
        scheduleCloseMega();
      });
    }

    if (accountToggle) {
      accountToggle.addEventListener('click', toggleAccount);
    }

    searchOpeners.forEach(button => {
      button.addEventListener('click', openSearch);
    });

    if (searchClose) {
      searchClose.addEventListener('click', closeSearch);
    }

    if (searchModal) {
      searchModal.addEventListener('click', event => {
        if (event.target === searchModal) closeSearch();
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', event => {
        window.clearTimeout(searchTimer);
        const query = event.target.value.trim();
        searchTimer = window.setTimeout(() => runSearch(query), 145);
      });
    }

    if (mobileOpen) {
      mobileOpen.addEventListener('click', openMobile);
    }

    if (mobileClose) {
      mobileClose.addEventListener('click', closeMobile);
    }

    if (mobileDrawer) {
      mobileDrawer.addEventListener('click', event => {
        if (event.target === mobileDrawer) closeMobile();
      });
    }

    root.querySelectorAll('[data-mobile-panel-trigger]').forEach(button => {
      button.addEventListener('click', () => {
        openMobileLevel(`[data-mobile-level="${button.dataset.mobilePanelTrigger}"]`);
      });
    });

    root.querySelectorAll('[data-mobile-menu-link-panel]').forEach(button => {
      button.addEventListener('click', () => {
        openMobileLevel(`[data-mobile-menu-link-level="${button.dataset.mobileMenuLinkPanel}"]`);
      });
    });

    root.querySelectorAll('[data-mobile-back]').forEach(button => {
      button.addEventListener('click', resetMobileLevels);
    });

    if (cartOpen) {
      cartOpen.addEventListener('click', event => {
        if (!enableCartDrawer) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        openCart();
      });
    }

    if (cartClose) {
      cartClose.addEventListener('click', closeCart);
    }

    if (cartDrawer) {
      cartDrawer.addEventListener('click', event => {
        if (event.target === cartDrawer) closeCart();
      });
    }

    root.addEventListener('click', event => {
      const cartButton = event.target.closest('[data-cart-change]');
      if (cartButton) {
        updateCartLine(cartButton.dataset.cartChange, cartButton.dataset.cartQty);
      }

    });

    if (overlay) {
      overlay.addEventListener('click', closeAll);
    }

    document.addEventListener('click', event => {
      if (!root.contains(event.target)) {
        closeMega();
        closeAccount();
      }
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeAll();
      }
    });

    function handleScroll() {
      const currentY = window.scrollY;
      root.classList.toggle('is-scrolled', currentY > 8);

      if (stickyBehavior === 'scroll_up') {
        const isOverlayOpen =
          root.classList.contains('is-overlayed') ||
          root.classList.contains('is-search-open') ||
          root.classList.contains('is-mobile-open') ||
          root.classList.contains('is-cart-open');

        if (!isOverlayOpen && currentY > 160 && currentY > lastY + 6) {
          root.classList.add('is-hidden');
        } else if (currentY < lastY - 6 || currentY < 160) {
          root.classList.remove('is-hidden');
        }
      }

      lastY = currentY;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(handleScroll);
        ticking = true;
      }
    }, { passive: true });

    window.addEventListener('resize', () => {
      if (!isDesktop()) closeMega();
    });

    document.addEventListener('shopify:section:unload', event => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        docEl.classList.remove('snh-header-lock-{{ section.id }}');
      }
    });

    /* V5.1: load new arrivals into idle panel on first paint */
    setSearchIdle();
  })();
</script>

