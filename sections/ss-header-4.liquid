{% comment %}
  SNH Premium Ecommerce Header V6
  Original Shopify / Impact compatible replacement section.
  V6: calm announcement rail, refined mobile navigation,
  compact predictive search, and restrained SNH Elite avatar treatment.
{% endcomment %}


{%- liquid
  assign menu_block_count = 0
  assign utility_count = 0
  assign mobile_menu = section.settings.mobile_menu
  assign secondary_menu = section.settings.secondary_menu

  for block in section.blocks
    if block.type == 'menu_item'
      assign menu_block_count = menu_block_count | plus: 1
    elsif block.type == 'utility_link'
      assign utility_count = utility_count | plus: 1
    endif
  endfor

  assign snh_customer_tier = customer.metafields.custom.loyalty_tier.value | default: 'Bronze'
  assign snh_customer_rate = 3
  if snh_customer_tier == 'Silver'
    assign snh_customer_rate = 7
  elsif snh_customer_tier == 'Gold' or snh_customer_tier == 'MAXED OUT'
    assign snh_customer_rate = 10
  endif
-%}

<style>
  #snh-header-{{ section.id }} {
    --snh-orange: {{ section.settings.accent_color }};
    --snh-orange-dark: {{ section.settings.accent_dark_color }};
    --snh-orange-soft: {{ section.settings.accent_soft_color }};
    --snh-black: {{ section.settings.text_color }};
    --snh-muted: {{ section.settings.muted_text_color }};
    --snh-border: {{ section.settings.border_color }};
    --snh-bg: {{ section.settings.background_color }};
    --snh-panel: {{ section.settings.panel_background_color }};
    --snh-top-bg: {{ section.settings.top_bar_background_color }};
    --snh-top-text: {{ section.settings.top_bar_text_color }};
    --snh-top-gradient: linear-gradient(112deg, #b83f00 0%, #e85a00 22%, var(--snh-orange) 46%, #ffb04d 68%, #d94d00 100%);
    --snh-top-glow: rgba(255, 216, 150, .38);
    --snh-display: var(--snh-font-body);
    --snh-font: var(--snh-font-body);
    --snh-ease: cubic-bezier(.22, .61, .36, 1);
    --snh-page-width: {{ section.settings.content_width }}px;
    --snh-radius-sm: 6px;
    --snh-radius-md: 8px;
    --snh-radius-lg: 10px;
    --snh-shadow-sm: 0 8px 24px rgba(16, 16, 16, .07);
    --snh-shadow-lg: 0 30px 90px rgba(0, 0, 0, .20);
    position: relative;
    z-index: 90;
    width: 100%;
    background: var(--snh-bg);
    color: var(--snh-black);
    font-family: var(--snh-font);
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
    border-bottom: 1px solid var(--snh-border);
    transition: transform .28s var(--snh-ease), box-shadow .28s var(--snh-ease);
  }

  html.snh-header-lock-{{ section.id }},
  html.snh-header-lock-{{ section.id }} body {
    overflow: hidden;
  }

  #snh-header-{{ section.id }}[data-sticky="always"],
  #snh-header-{{ section.id }}[data-sticky="scroll_up"] {
    position: sticky;
    top: 0;
  }

  #snh-header-{{ section.id }}.is-scrolled {
    box-shadow: var(--snh-shadow-sm);
  }

  #snh-header-{{ section.id }}.is-hidden {
    transform: translateY(-105%);
  }

  #snh-header-{{ section.id }} * {
    box-sizing: border-box;
  }

  #snh-header-{{ section.id }} a,
  #snh-header-{{ section.id }} button,
  #snh-header-{{ section.id }} input {
    font-family: var(--snh-font);
    -webkit-tap-highlight-color: transparent;
  }

  #snh-header-{{ section.id }} button {
    font: inherit;
  }

  #snh-header-{{ section.id }} :focus-visible {
    outline: 2px solid rgba(224, 82, 28, .55);
    outline-offset: 2px;
  }

  #snh-header-{{ section.id }} .snh-inner {
    width: 100%;
    max-width: {% if section.settings.full_width %}none{% else %}var(--snh-page-width){% endif %};
    margin: 0 auto;
    padding-left: {{ section.settings.padding_horizontal_mobile }}px;
    padding-right: {{ section.settings.padding_horizontal_mobile }}px;
  }

  #snh-header-{{ section.id }} .snh-top,
  #snh-header-{{ section.id }} .snh-main,
  #snh-header-{{ section.id }} .snh-chip-row {
    position: relative;
    z-index: 92;
  }

  #snh-header-{{ section.id }} .snh-top {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--snh-top-gradient);
    background-size: 260% 100%;
    color: var(--snh-top-text);
    font-size: 13px;
    line-height: 1.25;
    animation: snhPromoFlow-{{ section.id }} 14s ease-in-out infinite alternate;
  }

  #snh-header-{{ section.id }} .snh-top::before {
    content: "";
    position: absolute;
    inset: -90% -18%;
    z-index: -1;
    background:
      radial-gradient(circle at 12% 50%, rgba(255, 255, 255, .22), transparent 24%),
      radial-gradient(circle at 74% 42%, var(--snh-top-glow), transparent 30%),
      linear-gradient(90deg, transparent, rgba(255, 255, 255, .16), transparent);
    transform: translateX(-24%) rotate(-5deg);
    animation: snhPromoGlow-{{ section.id }} 9s ease-in-out infinite alternate;
    pointer-events: none;
  }

  #snh-header-{{ section.id }} .snh-top::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(0,0,0,.16), transparent 22%, transparent 78%, rgba(0,0,0,.10));
    pointer-events: none;
  }

  @keyframes snhPromoFlow-{{ section.id }} {
    0% { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }

  @keyframes snhPromoGlow-{{ section.id }} {
    0% { transform: translateX(-26%) rotate(-5deg); opacity: .48; }
    100% { transform: translateX(18%) rotate(-5deg); opacity: .84; }
  }

  @keyframes snhPromoTicker-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  #snh-header-{{ section.id }} .snh-top__inner {
    min-height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  #snh-header-{{ section.id }} .snh-top__promo {
    width: min(100%, 980px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 0;
    font-weight: 600;
    letter-spacing: -0.006em;
  }

  #snh-header-{{ section.id }} .snh-top__marquee {
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  #snh-header-{{ section.id }} .snh-top__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 34px;
    white-space: nowrap;
    animation: snhPromoTicker-{{ section.id }} 24s linear infinite;
    will-change: transform;
  }

  #snh-header-{{ section.id }} .snh-top:hover .snh-top__track {
    animation-play-state: paused;
  }

  #snh-header-{{ section.id }} .snh-top__promo-text,
  #snh-header-{{ section.id }} .snh-top__message {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    text-shadow: 0 1px 12px rgba(0, 0, 0, .16);
  }

  #snh-header-{{ section.id }} .snh-top__message-dot {
    width: 5px;
    height: 5px;
    border-radius: 6px;
    background: rgba(255,255,255,.75);
    box-shadow: 0 0 0 4px rgba(255,255,255,.12);
  }

  #snh-header-{{ section.id }} .snh-top__code {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    padding: 4px 11px;
    border-radius: 9px;
    background: rgba(255, 255, 255, .16);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, .28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 6px 18px rgba(0,0,0,.10);
    font-weight: 680;
    cursor: pointer;
    letter-spacing: .03em;
    transition: background .16s var(--snh-ease), transform .16s var(--snh-ease), border-color .16s var(--snh-ease);
  }

  #snh-header-{{ section.id }} .snh-top__code:hover {
    background: rgba(255, 255, 255, .24);
    border-color: rgba(255, 255, 255, .40);
    transform: translateY(-1px);
  }

  #snh-header-{{ section.id }} .snh-top__loyalty {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 28px;
    padding: 4px 11px;
    border-radius: 6px;
    background: rgba(255,255,255,.92);
    color: #7d2c00;
    text-decoration: none;
    font-weight: 670;
    white-space: nowrap;
    border: 1px solid rgba(255,255,255,.64);
    box-shadow: 0 7px 20px rgba(0,0,0,.12);
    transition: transform .16s var(--snh-ease), box-shadow .16s var(--snh-ease), color .16s var(--snh-ease), background .16s var(--snh-ease);
  }

  #snh-header-{{ section.id }} .snh-top__loyalty:hover {
    transform: translateY(-1px);
    color: var(--snh-black);
    background: #fff;
    box-shadow: 0 10px 26px rgba(0,0,0,.16);
  }

  #snh-header-{{ section.id }} .snh-top__loyalty svg {
    width: 15px;
    height: 15px;
  }

  #snh-header-{{ section.id }} .snh-icon,
  #snh-header-{{ section.id }} .snh-top__copy-icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  #snh-header-{{ section.id }} .snh-icon svg,
  #snh-header-{{ section.id }} .snh-top__copy-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #snh-header-{{ section.id }} .snh-top__cta,
  #snh-header-{{ section.id }} .snh-top__utility a {
    color: var(--snh-top-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 560;
    white-space: nowrap;
    opacity: .95;
  }

  #snh-header-{{ section.id }} .snh-top__cta:hover,
  #snh-header-{{ section.id }} .snh-top__utility a:hover {
    opacity: 1;
  }

  #snh-header-{{ section.id }} .snh-top__utility {
    display: none;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }

  #snh-header-{{ section.id }} .snh-main {
    background: var(--snh-bg);
  }

  #snh-header-{{ section.id }} .snh-main__inner {
    min-height: 70px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
  }

  #snh-header-{{ section.id }} .snh-burger,
  #snh-header-{{ section.id }} .snh-icon-button,
  #snh-header-{{ section.id }} .snh-action {
    border: 0;
    background: transparent;
    color: var(--snh-black);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
  }

  #snh-header-{{ section.id }} .snh-burger {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    padding: 0;
  }

  #snh-header-{{ section.id }} .snh-burger:hover,
  #snh-header-{{ section.id }} .snh-icon-button:hover,
  #snh-header-{{ section.id }} .snh-action:hover {
    background: rgba(255, 122, 0, .10);
    color: var(--snh-orange-dark);
  }

  #snh-header-{{ section.id }} .snh-burger__lines {
    width: 24px;
    height: 16px;
    position: relative;
    display: block;
  }

  #snh-header-{{ section.id }} .snh-burger__lines::before,
  #snh-header-{{ section.id }} .snh-burger__lines::after,
  #snh-header-{{ section.id }} .snh-burger__line {
    content: "";
    position: absolute;
    left: 0;
    width: 24px;
    height: 2px;
    background: currentColor;
    border-radius: 6px;
    transition: transform .22s var(--snh-ease), top .22s var(--snh-ease), opacity .22s var(--snh-ease);
  }

  #snh-header-{{ section.id }} .snh-burger__lines::before { top: 0; }
  #snh-header-{{ section.id }} .snh-burger__line { top: 7px; }
  #snh-header-{{ section.id }} .snh-burger__lines::after { top: 14px; }

  #snh-header-{{ section.id }} .snh-logo {
    display: flex;
    justify-content: center;
    min-width: 0;
    position: relative;
  }

  #snh-header-{{ section.id }} .snh-logo__link {
    position: relative;
    overflow: hidden;
    animation: snhLogoReveal-{{ section.id }} .8s var(--snh-ease) .1s both;
  }

  #snh-header-{{ section.id }} .snh-logo__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 34%, rgba(255, 255, 255, .9) 48%, rgba(255, 193, 120, .65) 54%, transparent 68%);
    transform: translateX(-160%);
    animation: snhLogoShine-{{ section.id }} 1.15s var(--snh-ease) .5s 1 both;
  }

  @keyframes snhLogoReveal-{{ section.id }} {
    from { clip-path: inset(0 100% 0 0); opacity: .25; }
    to { clip-path: inset(0 0 0 0); opacity: 1; }
  }

  @keyframes snhLogoShine-{{ section.id }} {
    from { transform: translateX(-160%); }
    to { transform: translateX(160%); }
  }

  @media (prefers-reduced-motion: reduce) {
    #snh-header-{{ section.id }} .snh-logo__link { animation: none; }
    #snh-header-{{ section.id }} .snh-logo__link::after { display: none; }
  }

  #snh-header-{{ section.id }} .snh-logo__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--snh-black);
    text-decoration: none;
    font-size: 28px;
    line-height: 1;
    font-weight: 780;
    letter-spacing: -0.028em;
    min-width: 0;
  }

  #snh-header-{{ section.id }} .snh-logo img {
    display: block;
    width: auto;
    max-width: {{ section.settings.logo_width_mobile }}px;
    max-height: 54px;
    object-fit: contain;
  }

  #snh-header-{{ section.id }} .snh-logo__mobile {
    display: inline-flex;
  }

  #snh-header-{{ section.id }} .snh-logo__desktop,
  #snh-header-{{ section.id }} .snh-desktop-nav,
  #snh-header-{{ section.id }} .snh-desktop-search {
    display: none;
  }

  #snh-header-{{ section.id }} .snh-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    min-width: 0;
  }

  #snh-header-{{ section.id }} .snh-action {
    position: relative;
    width: 42px;
    min-width: 42px;
    height: 42px;
    border-radius: 6px;
    padding: 0;
    transition: background .18s var(--snh-ease), color .18s var(--snh-ease), transform .18s var(--snh-ease);
  }

  #snh-header-{{ section.id }} .snh-action:hover {
    background: rgba(22, 22, 22, .05);
  }

  #snh-header-{{ section.id }} .snh-action__text {
    display: none;
  }

  #snh-header-{{ section.id }} .snh-cart-count {
    position: absolute;
    top: 1px;
    right: 1px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--snh-orange);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 760;
    line-height: 1;
    box-shadow: 0 2px 6px rgba(255, 122, 0, .32);
  }

  #snh-header-{{ section.id }} .snh-mobile-search {
    display: block;
    padding-bottom: 14px;
  }

  #snh-header-{{ section.id }} .snh-search-trigger {
    width: 100%;
    min-height: 46px;
    border: 1px solid var(--snh-border);
    border-radius: 8px;
    background: #fff;
    color: var(--snh-muted);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    padding: 0 16px;
    cursor: text;
    text-align: left;
    transition: border-color .18s var(--snh-ease), box-shadow .18s var(--snh-ease);
  }

  #snh-header-{{ section.id }} .snh-search-trigger:hover,
  #snh-header-{{ section.id }} .snh-search-trigger:focus-visible {
    border-color: rgba(22, 22, 22, .4);
  }

  #snh-header-{{ section.id }} .snh-search-trigger__label {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 14.5px;
    font-weight: 500;
    letter-spacing: -.01em;
  }

  #snh-header-{{ section.id }} .snh-search-trigger__icon {
    min-width: 18px;
    width: 18px;
    height: 18px;
    order: -1;
    background: none;
    color: var(--snh-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color .18s var(--snh-ease);
  }

  #snh-header-{{ section.id }} .snh-search-trigger:hover .snh-search-trigger__icon {
    color: var(--snh-black);
  }

  #snh-header-{{ section.id }} .snh-chip-row {
    display: none;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, .05);
    border-bottom: 1px solid rgba(0, 0, 0, .05);
  }

  #snh-header-{{ section.id }} .snh-chip-scroller {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding: 14px {{ section.settings.padding_horizontal_mobile }}px;
  }

  #snh-header-{{ section.id }} .snh-chip-scroller::-webkit-scrollbar {
    display: none;
  }

  #snh-header-{{ section.id }} .snh-chip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 6px;
    background: var(--snh-orange-soft);
    color: var(--snh-orange-dark);
    text-decoration: none;
    font-weight: 670;
    font-size: 14px;
    letter-spacing: -.006em;
    transition: background .18s var(--snh-ease), transform .18s var(--snh-ease), color .18s var(--snh-ease), border-color .18s var(--snh-ease);
  }

  #snh-header-{{ section.id }} .snh-chip:hover {
    background: var(--snh-orange);
    color: #fff;
    transform: translateY(-1px);
  }

  #snh-header-{{ section.id }} .snh-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .48);
    z-index: 80;
    opacity: 0;
    pointer-events: none;
    transition: opacity .22s var(--snh-ease), background .22s var(--snh-ease);
    backdrop-filter: blur(1px);
  }

  #snh-header-{{ section.id }}.is-overlayed .snh-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  #snh-header-{{ section.id }}.is-mega-open .snh-overlay {
    background: rgba(0, 0, 0, .36);
  }

  #snh-header-{{ section.id }} .snh-mega {
    display: none;
  }

  #snh-header-{{ section.id }} .snh-account-popover {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(350px, calc(100vw - 28px));
    background: #fff;
    border: 1px solid var(--snh-border);
    border-radius: 10px;
    box-shadow: var(--snh-shadow-lg);
    padding: 18px;
    z-index: 105;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity .2s var(--snh-ease), transform .2s var(--snh-ease);
  }

  #snh-header-{{ section.id }}.is-account-open .snh-account-popover {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #snh-header-{{ section.id }} .snh-account-popover::before {
    content: "";
    position: absolute;
    top: -7px;
    right: 28px;
    width: 14px;
    height: 14px;
    transform: rotate(45deg);
    background: #fff;
    border-left: 1px solid var(--snh-border);
    border-top: 1px solid var(--snh-border);
  }

  #snh-header-{{ section.id }} .snh-pop-title,
  #snh-header-{{ section.id }} .snh-cart-title,
  #snh-header-{{ section.id }} .snh-mobile-subtitle {
    margin: 0;
    font-family: var(--snh-display);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  #snh-header-{{ section.id }} .snh-pop-title {
    font-size: 20px;
    margin-bottom: 8px;
  }

  #snh-header-{{ section.id }} .snh-pop-copy {
    margin: 0 0 16px;
    color: var(--snh-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  #snh-header-{{ section.id }} .snh-pop-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  #snh-header-{{ section.id }} .snh-btn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--snh-black);
    background: var(--snh-black);
    color: #fff;
    text-decoration: none;
    font-weight: 720;
    font-size: 14px;
    line-height: 1;
    letter-spacing: -.008em;
    padding: 0 16px;
    cursor: pointer;
    transition: background .18s var(--snh-ease), color .18s var(--snh-ease), border-color .18s var(--snh-ease), transform .18s var(--snh-ease);
  }

  #snh-header-{{ section.id }} .snh-btn:hover {
    transform: translateY(-1px);
  }

  #snh-header-{{ section.id }} .snh-btn--orange {
    background: var(--snh-orange);
    border-color: var(--snh-orange);
    color: #fff;
  }

