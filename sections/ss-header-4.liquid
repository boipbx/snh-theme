                <p class="snh-pop-title">Welcome back</p>
                <p class="snh-pop-copy">Jump into your account, check orders, or manage your details.</p>
                <div class="snh-pop-actions">
                  <a class="snh-btn snh-btn--orange" href="{{ routes.account_url }}">My account</a>
                  <a class="snh-btn snh-btn--outline" href="{{ routes.account_logout_url }}">Log out</a>
                </div>
              {%- else -%}
                <p class="snh-pop-title">{{ section.settings.account_popover_title }}</p>
                <p class="snh-pop-copy">{{ section.settings.account_popover_text }}</p>
                <div class="snh-pop-actions">
                  <a class="snh-btn snh-btn--orange" href="{{ routes.account_login_url }}">Sign in</a>
                  <a class="snh-btn snh-btn--outline" href="{{ routes.account_register_url }}">Join rewards</a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <a
          href="{{ routes.cart_url }}"
          class="snh-action snh-action--cart"
          data-cart-open
          aria-label="Basket with {{ cart.item_count }} items"
        >
          <span class="snh-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M5.75 8.25h12.5v10.75a1.75 1.75 0 0 1-1.75 1.75h-9a1.75 1.75 0 0 1-1.75-1.75V8.25Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M9 10.75V6.75a3 3 0 0 1 6 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          <span class="snh-action__text">{{ section.settings.cart_label }}</span>
          <span class="snh-cart-count" data-cart-count>{{ cart.item_count }}</span>
        </a>
      </div>
    </div>

    {%- if section.settings.enable_search -%}
      <div class="snh-inner snh-mobile-search">
        <button type="button" class="snh-search-trigger" data-search-open aria-label="Open search">
          <span class="snh-search-trigger__label">{{ section.settings.search_placeholder }}</span>
          <span class="snh-search-trigger__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75"/></svg>
          </span>
        </button>
      </div>
    {%- endif -%}
