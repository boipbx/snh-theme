                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-4.44 7-11a7 7 0 1 0-14 0c0 6.56 7 11 7 11Z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="2" stroke="currentColor" stroke-width="2"/></svg>
                    </span>
                    {{ block.settings.text }}
