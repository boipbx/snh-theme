  {%- if secondary_menu != blank and secondary_menu.links.size > 0 -%}
    <nav class="snh-chip-row" aria-label="Featured categories">
      <div class="snh-chip-scroller">
        {%- for link in secondary_menu.links -%}
          <a href="{{ link.url }}" class="snh-chip">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </nav>
  {%- endif -%}

  <div class="snh-overlay" data-close-all></div>

  <div class="snh-mega" data-mega-area>
    {%- for block in section.blocks -%}
      {%- if block.type == 'menu_item' -%}
        {%- liquid
          assign has_mega = false
          if block.settings.submenu != blank or block.settings.collections != blank or block.settings.image != blank or block.settings.second_image != blank
            assign has_mega = true
          endif
        -%}

        {%- if has_mega -%}
          <div
            id="snh-mega-{{ section.id }}-{{ forloop.index0 }}"
            class="snh-mega-panel"
            data-mega-panel="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <div class="snh-mega__inner">
              <div class="snh-mega-card">
                <div class="snh-mega-side">
                  {%- if block.settings.badge != blank -%}
                    <span class="snh-mega-eyebrow">{{ block.settings.badge }}</span>
                  {%- endif -%}
                  <h2 class="snh-mega-title">{{ block.settings.text | default: 'Shop' }}</h2>
                  {%- if block.settings.subtitle != blank -%}
                    <p class="snh-mega-subtitle">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                  {%- if block.settings.url != blank -%}
                    <a class="snh-btn snh-btn--orange" href="{{ block.settings.url }}">{{ block.settings.cta_label | default: 'Shop all' }}</a>
                  {%- endif -%}

                  <div class="snh-mega-bundles">
                    <span class="snh-mega-bundles__label">Bundle &amp; save</span>
                    <a class="snh-mega-bundles__link" href="/collections/endurance-bundles"><span>Endurance bundles</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                    <a class="snh-mega-bundles__link" href="/collections/training-strength-bundles"><span>Training &amp; strength</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                    <a class="snh-mega-bundles__link" href="/collections/daily-health-wellness-bundles"><span>Daily health &amp; wellness</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                    <em>Discounts apply automatically at checkout</em>
                  </div>
                </div>

                <div class="snh-mega-content">
                  <ul class="snh-mega-menu">
                    {%- if block.settings.submenu != blank -%}
                      {%- for link in block.settings.submenu.links -%}
                        <li class="snh-mega-group">
                          <a href="{{ link.url }}">{{ link.title }}</a>
                          {%- if link.links.size > 0 -%}
                            <ul class="snh-mega-sublist">
                              {%- for sub_link in link.links limit: 8 -%}
                                <li><a href="{{ sub_link.url }}">{{ sub_link.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    {%- elsif mobile_menu != blank -%}
                      {%- for link in mobile_menu.links limit: 8 -%}
                        <li class="snh-mega-group"><a href="{{ link.url }}">{{ link.title }}</a></li>
                      {%- endfor -%}
                    {%- endif -%}
                  </ul>

                  <div class="snh-mega-promos">
                    {%- if block.settings.collections != blank -%}
                      {%- for collection in block.settings.collections limit: 3 -%}
                        <a class="snh-mega-promo" href="{{ collection.url }}">
                          {%- if collection.featured_image != blank -%}
                            <img src="{{ collection.featured_image | image_url: width: 720 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy">
                          {%- endif -%}
                          <span class="snh-mega-promo__content">
                            <strong>{{ collection.title }}</strong>
                            <span class="snh-mega-promo__cta">{{ block.settings.collection_cta_label | default: 'Shop now' }}</span>
                          </span>
                        </a>
                      {%- endfor -%}
                    {%- endif -%}

                    {%- if block.settings.image != blank -%}
                      <a class="snh-mega-promo" href="{{ block.settings.button_url | default: block.settings.url | default: '#' }}">
                        <img src="{{ block.settings.image | image_url: width: 720 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy">
                        <span class="snh-mega-promo__content">
                          <strong>{{ block.settings.title | default: block.settings.text }}</strong>
                          <span class="snh-mega-promo__cta">{{ block.settings.button_text | default: 'Shop now' }}</span>
                        </span>
                      </a>
                    {%- endif -%}

                    {%- if block.settings.second_image != blank -%}
                      <a class="snh-mega-promo" href="{{ block.settings.second_button_url | default: block.settings.url | default: '#' }}">
                        <img src="{{ block.settings.second_image | image_url: width: 720 }}" alt="{{ block.settings.second_image.alt | default: block.settings.second_title | escape }}" loading="lazy">
                        <span class="snh-mega-promo__content">
                          <strong>{{ block.settings.second_title | default: block.settings.text }}</strong>
                          <span class="snh-mega-promo__cta">{{ block.settings.second_button_text | default: 'Explore' }}</span>
                        </span>
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.enable_search -%}
    <div class="snh-search-modal" data-search-modal aria-hidden="true">
      <div class="snh-search-card" role="dialog" aria-modal="true" aria-label="Search">
        <form class="snh-search-form" action="{{ routes.search_url }}" method="get" role="search">
          <input
            class="snh-search-input"
            data-search-input
            type="search"
            name="q"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            aria-label="Search products"
          >
          <button type="submit" class="snh-search-submit" aria-label="Submit search">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none"><path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75"/></svg>
          </button>
          <button type="button" class="snh-search-close" data-search-close aria-label="Close search">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </form>

        <div class="snh-search-body">
          <div class="snh-search-column">
            <p class="snh-section-label">Popular searches</p>
            <ul class="snh-popular-list">
              {%- assign popular_terms = section.settings.popular_searches | split: ',' -%}
              {%- for term in popular_terms -%}
                {%- assign clean_term = term | strip -%}
                {%- if clean_term != blank -%}
                  <li>
                    <a class="snh-popular-link" href="{{ routes.search_url }}?q={{ clean_term | url_encode }}">
                      <span class="snh-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                      {{ clean_term }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {%- if snh_loyalty_href != blank -%}
              <a class="snh-search-loyalty-card" href="{{ snh_loyalty_href }}">
                <span class="snh-search-loyalty-card__copy">
                  <strong>Make every order count</strong>
                  <span>Earn points, unlock member perks and move through Bronze, Silver and Gold.</span>
                  <b>Explore membership
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </b>
                </span>
                <span class="snh-search-loyalty-card__media" aria-hidden="true">
                  <img class="snh-elite-portrait" src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/girl.png?v=1783764656&amp;width=260" alt="" loading="eager" fetchpriority="high" decoding="async">
                  <img class="snh-elite-portrait" src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/boy.png?v=1783764655&amp;width=260" alt="" loading="eager" decoding="async">
                  <img class="snh-elite-portrait" src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/padl.png?v=1783835906&amp;width=260" alt="" loading="eager" decoding="async">
                </span>
              </a>
            {%- endif -%}

            <div class="snh-live-trends" data-live-trends aria-live="polite">
              <span class="snh-live-trends__eyebrow">Popular now</span>
              <span class="snh-live-trends__loading">Loading live store picks…</span>
            </div>

            {%- if section.settings.goal_menu != blank and section.settings.goal_menu.links.size > 0 -%}
              <div class="snh-search-goals">
                <p class="snh-section-label">Shop by goal</p>
                <div class="snh-search-goal-grid">
                  {%- for link in section.settings.goal_menu.links limit: 6 -%}
                    <a class="snh-search-goal-chip" href="{{ link.url }}">{{ link.title }}</a>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.help_cta_label != blank and section.settings.help_cta_url != blank -%}
              <a class="snh-help-strip" href="{{ section.settings.help_cta_url }}">
                <span>Need help choosing?</span>
                <strong>{{ section.settings.help_cta_label }}</strong>
              </a>
            {%- endif -%}

          </div>

          <div class="snh-search-column">
            <p class="snh-section-label" data-search-results-title>New arrivals</p>
            <div data-search-results>
              <ul class="snh-suggest-list">
                <li><span class="snh-suggest-link">Search by product, brand, goal, supplement type or flavour.</span></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="snh-mobile-drawer" data-mobile-drawer aria-hidden="true">
