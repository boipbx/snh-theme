            <a class="snh-mobile-bundles__link" href="/collections/daily-health-wellness-bundles">Daily health &amp; wellness bundles <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>

