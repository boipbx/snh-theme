  /* ── mobile drawer: bundles box up top, loyalty rail at the bottom ── */
  #snh-header-{{ section.id }} .snh-mobile-bundles {
    display: grid;
    gap: 8px;
    margin: 2px 0 18px;
    padding: 15px;
    border: 1px solid rgba(224,82,28,.2);
    border-radius: 10px;
    background: linear-gradient(150deg, #fff6ef, #fff);
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles__label {
    display: block;
    margin-bottom: 2px;
    color: var(--snh-orange-dark);
    font-family: var(--snh-display);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 0 14px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid var(--snh-border);
    color: var(--snh-black);
    text-decoration: none;
    font-family: var(--snh-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -.01em;
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link svg { width: 17px; height: 17px; color: var(--snh-orange); flex: 0 0 17px; }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link:active { background: #fff6ef; }

  @media (max-width: 989px) {
    /* loyalty announcement drops out of the top rail — it lives at the bottom of the drawer instead */
    #snh-header-{{ section.id }} .snh-top__message--loyalty { display: none !important; }
    #snh-header-{{ section.id }} .snh-top__slide { animation-delay: var(--snh-am, 0s); }
    #snh-header-{{ section.id }} .snh-logo { justify-content: center; }
    #snh-header-{{ section.id }} .snh-logo img { max-height: 38px; }
    #snh-header-{{ section.id }} .snh-mobile-rewards { margin-top: 26px; }
  }
  /* ── V8: tighter desktop lockup, bolder menu items, animated bundle rail ── */
  @media (min-width: 990px) {
    #snh-header-{{ section.id }} .snh-main__inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: clamp(16px, 1.6vw, 26px);
    }
    /* nav hugs the logo instead of floating in the middle */
    #snh-header-{{ section.id }} .snh-desktop-nav { justify-content: flex-start; gap: clamp(2px, 0.35vw, 6px); }
    #snh-header-{{ section.id }} .snh-desktop-nav__link {
      color: var(--snh-black);
      font-family: var(--snh-display);
      font-size: clamp(11.5px, 0.9vw, 14px);
      font-weight: 800;
      letter-spacing: -.005em;
      padding: 0 clamp(7px, 0.7vw, 14px);
    }
    #snh-header-{{ section.id }} .snh-desktop-nav__link .snh-icon { opacity: .55; }
    #snh-header-{{ section.id }} .snh-desktop-nav__link:hover .snh-icon { opacity: 1; }
  }

  /* mobile menu rows: ink black and heavier, like the product-card titles */
  #snh-header-{{ section.id }} .snh-mobile-row strong {
    color: var(--snh-black) !important;
    font-family: var(--snh-display) !important;
    font-weight: 800 !important;
  }

  @keyframes snhBundleIn-{{ section.id }} {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles { margin: 26px 0 6px; }
  #snh-header-{{ section.id }}.is-mobile-open .snh-mobile-bundles > * {
    animation: snhBundleIn-{{ section.id }} .42s var(--snh-ease) both;
  }
  #snh-header-{{ section.id }}.is-mobile-open .snh-mobile-bundles > *:nth-child(2) { animation-delay: .05s; }
  #snh-header-{{ section.id }}.is-mobile-open .snh-mobile-bundles > *:nth-child(3) { animation-delay: .1s; }
  #snh-header-{{ section.id }}.is-mobile-open .snh-mobile-bundles > *:nth-child(4) { animation-delay: .15s; }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link {
    transition: border-color .26s var(--snh-ease), background .26s var(--snh-ease), transform .26s var(--snh-ease);
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link svg { transition: transform .3s var(--snh-ease); }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link:hover,
  #snh-header-{{ section.id }} .snh-mobile-bundles__link:active {
    border-color: var(--snh-orange);
    background: #fff6ef;
    transform: translateX(3px);
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link:hover svg,
  #snh-header-{{ section.id }} .snh-mobile-bundles__link:active svg { transform: translateX(4px); }

  /* ── V9 ── */
  /* no motion on the logo, at all */
  #snh-header-{{ section.id }} .snh-logo,
  #snh-header-{{ section.id }} .snh-logo__link,
  #snh-header-{{ section.id }} .snh-logo img {
    animation: none !important;
    transition: none !important;
    transform: none !important;
    filter: none !important;
  }
  #snh-header-{{ section.id }} .snh-logo::before,
  #snh-header-{{ section.id }} .snh-logo::after { content: none !important; display: none !important; }

  /* mega side: bundle rail fills the empty column */
  #snh-header-{{ section.id }} .snh-mega-bundles {
    display: grid;
    gap: 7px;
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid rgba(23,19,15,.1);
  }
  #snh-header-{{ section.id }} .snh-mega-bundles__label {
    color: var(--snh-orange-dark);
    font-family: var(--snh-display);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  #snh-header-{{ section.id }} .snh-mega-bundles__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 44px;
    padding: 0 13px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid rgba(23,19,15,.09);
    color: var(--snh-black);
    text-decoration: none;
    font-family: var(--snh-display);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: -.01em;
    transition: border-color .26s var(--snh-ease), background .26s var(--snh-ease), transform .26s var(--snh-ease);
  }
  #snh-header-{{ section.id }} .snh-mega-bundles__link svg { width: 15px; height: 15px; flex: 0 0 15px; color: var(--snh-orange); transition: transform .3s var(--snh-ease); }
  #snh-header-{{ section.id }} .snh-mega-bundles__link:hover { border-color: var(--snh-orange); background: #fff6ef; transform: translateX(3px); }
  #snh-header-{{ section.id }} .snh-mega-bundles__link:hover svg { transform: translateX(3px); }
  #snh-header-{{ section.id }} .snh-mega-bundles em {
    margin-top: 3px;
    color: var(--snh-muted);
    font-size: 10.5px;
    font-style: normal;
    line-height: 1.35;
  }

  @media (min-width: 990px) {
    /* breathe: header gutters line up with the page content below */
    #snh-header-{{ section.id }} .snh-inner,
    #snh-header-{{ section.id }} .snh-chip-scroller,
    #snh-header-{{ section.id }} .snh-mega__inner {
      padding-left: clamp(28px, 3.4vw, 64px);
      padding-right: clamp(28px, 3.4vw, 64px);
    }
    #snh-header-{{ section.id }} .snh-mega-side {
      display: flex;
      flex-direction: column;
      min-height: 0;
      max-height: min(560px, calc(100vh - 170px));
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    #snh-header-{{ section.id }} .snh-mega-side .snh-btn { margin-top: 16px; }
    #snh-header-{{ section.id }} .snh-mega-bundles { margin-top: 18px; padding-top: 16px; }
    #snh-header-{{ section.id }} .snh-mega-bundles__link { min-height: 40px; font-size: 12.5px; }
  }

  /* mobile bundle rail: dark, with real presence */
  #snh-header-{{ section.id }} .snh-mobile-bundles {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    gap: 9px;
    padding: 18px 16px 16px;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(150deg, #24140c 0%, #14100d 100%);
    box-shadow: 0 14px 34px rgba(23,19,15,.16);
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at 88% 8%, rgba(224,82,28,.35), transparent 42%);
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles__label {
    margin-bottom: 4px;
    color: #ff9a63;
    font-size: 10px;
    letter-spacing: .16em;
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link {
    min-height: 52px;
    padding: 0 14px;
    border: 1px solid rgba(255,242,230,.14);
    border-radius: 10px;
    background: rgba(255,255,255,.05);
    color: #fff2e6;
    font-size: 14.5px;
    font-weight: 800;
  }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link svg { color: var(--snh-orange); }
  #snh-header-{{ section.id }} .snh-mobile-bundles__link:hover,
  #snh-header-{{ section.id }} .snh-mobile-bundles__link:active {
    border-color: rgba(224,82,28,.65);
    background: rgba(224,82,28,.16);
    transform: translateX(3px);
  }

  /* ============ END V7 ============ */

  /* ============ END V5.1 ============ */
</style>

<header
  id="snh-header-{{ section.id }}"
  class="snh-header"
  data-sticky="{{ section.settings.sticky_behavior }}"
  data-section-id="{{ section.id }}"
  data-free-shipping-threshold="{{ section.settings.free_shipping_threshold | default: 17000 | times: 100 }}"
  data-free-shipping-tolerance="{{ section.settings.free_delivery_tolerance | default: 100 | times: 100 }}"
  data-loyalty-rate="{{ snh_customer_rate }}"
  data-loyalty-tier="{{ snh_customer_tier | escape }}"
  data-customer-authenticated="{% if customer %}true{% else %}false{% endif %}"
>
  {%- liquid
    assign snh_loyalty_href = section.settings.loyalty_cta_url
    if snh_loyalty_href == blank and shop.customer_accounts_enabled
      assign snh_loyalty_href = routes.account_register_url
    endif

    assign snh_free_shipping_threshold = section.settings.free_shipping_threshold | default: 17000
    assign snh_free_shipping_cents = snh_free_shipping_threshold | times: 100
    assign snh_free_shipping_remaining = snh_free_shipping_cents | minus: cart.total_price
    assign snh_free_shipping_tolerance_cents = section.settings.free_delivery_tolerance | default: 100 | times: 100
    assign snh_gap_is_waived = false
    if snh_free_shipping_remaining > 0 and snh_free_shipping_remaining <= snh_free_shipping_tolerance_cents
      assign snh_gap_is_waived = true
    endif
    assign snh_free_shipping_progress = cart.total_price | times: 100 | divided_by: snh_free_shipping_cents
    if snh_free_shipping_progress > 100
      assign snh_free_shipping_progress = 100
    endif

    if cart.item_count == 0
      assign snh_free_shipping_message = 'Free delivery over Rs. 17,000'
    elsif snh_gap_is_waived
      assign snh_free_shipping_message = blank
    elsif snh_free_shipping_remaining > 0
      assign snh_remaining_display = snh_free_shipping_remaining | money_without_currency | replace: '.00', ''
      assign snh_free_shipping_message = 'Add Rs. ' | append: snh_remaining_display | append: ' more for free delivery'
    else
      assign snh_threshold_display = snh_free_shipping_cents | money_without_currency | replace: '.00', ''
      assign snh_free_shipping_message = 'Free delivery on orders Rs. ' | append: snh_threshold_display | append: '+'
    endif
  -%}

  {%- liquid
    assign snh_trust_message = section.settings.trust_message
    assign snh_trust_label = section.settings.trust_label | default: 'Trusted'
    assign snh_slide_seconds = section.settings.announcement_seconds | default: 5

    assign snh_has_trust = false
    if snh_trust_message != blank
      assign snh_has_trust = true
    endif
    assign snh_has_ship = false
    if snh_free_shipping_message != blank and snh_gap_is_waived == false
      assign snh_has_ship = true
    endif
    assign snh_has_loyalty = false
    if snh_loyalty_href != blank
      assign snh_has_loyalty = true
    endif

    # desktop shows every slide; mobile drops the loyalty one, so the two
    # rotations are timed separately rather than leaving a blank gap
    assign snh_d_total = 0
    assign snh_m_total = 0
    if snh_has_trust
      assign snh_d_total = snh_d_total | plus: 1
      assign snh_m_total = snh_m_total | plus: 1
    endif
    if snh_has_ship
      assign snh_d_total = snh_d_total | plus: 1
      assign snh_m_total = snh_m_total | plus: 1
    endif
    if snh_has_loyalty
      assign snh_d_total = snh_d_total | plus: 1
    endif
    if snh_m_total < 1
      assign snh_m_total = snh_d_total
    endif
    if snh_d_total < 1
      assign snh_d_total = 1
    endif

    assign snh_d_cycle = snh_d_total | times: snh_slide_seconds
    assign snh_d_hold = 100 | divided_by: snh_d_total | minus: 7
    assign snh_d_fade = 100 | divided_by: snh_d_total
    assign snh_m_cycle = snh_m_total | times: snh_slide_seconds
    assign snh_m_hold = 100 | divided_by: snh_m_total | minus: 7
    assign snh_m_fade = 100 | divided_by: snh_m_total

    assign snh_di = 0
    assign snh_mi = 0
  -%}

  {%- if snh_has_trust or snh_free_shipping_message != blank or snh_loyalty_href != blank -%}
    <style>
      {%- if snh_d_total > 1 -%}
        #snh-header-{{ section.id }} .snh-top__slide {
          animation-name: snhAnnounceD-{{ section.id }};
          animation-duration: {{ snh_d_cycle }}s;
          animation-timing-function: ease-in-out;
          animation-iteration-count: infinite;
        }
        @keyframes snhAnnounceD-{{ section.id }} {
          0%, {{ snh_d_hold }}% { opacity: 1; transform: translate3d(0,0,0); pointer-events: auto; }
          {{ snh_d_fade }}%, 93% { opacity: 0; transform: translate3d(0,-7px,0); pointer-events: none; }
          100% { opacity: 1; transform: translate3d(0,0,0); pointer-events: auto; }
        }
      {%- else -%}
        #snh-header-{{ section.id }} .snh-top__slide { opacity: 1; animation: none; }
      {%- endif -%}

      @media (max-width: 989px) {
        {%- if snh_m_total > 1 -%}
          #snh-header-{{ section.id }} .snh-top__slide {
            animation-name: snhAnnounceM-{{ section.id }};
            animation-duration: {{ snh_m_cycle }}s;
          }
          @keyframes snhAnnounceM-{{ section.id }} {
            0%, {{ snh_m_hold }}% { opacity: 1; transform: translate3d(0,0,0); pointer-events: auto; }
            {{ snh_m_fade }}%, 93% { opacity: 0; transform: translate3d(0,-7px,0); pointer-events: none; }
            100% { opacity: 1; transform: translate3d(0,0,0); pointer-events: auto; }
          }
        {%- else -%}
          #snh-header-{{ section.id }} .snh-top__slide { opacity: 0 !important; animation: none !important; }
          #snh-header-{{ section.id }} .snh-top__slide:first-child { opacity: 1 !important; }
        {%- endif -%}
      }
    </style>

    <div class="snh-top">
      <div class="snh-inner snh-top__inner">
        <div class="snh-top__promo">
          <div class="snh-top__marquee" aria-label="Store announcements">
            <div class="snh-top__track{% if snh_d_total == 1 %} has-single-slide{% endif %}">

              {%- if snh_has_trust -%}
                {%- capture snh_trust_vars -%}--snh-ad: -{{ snh_di | times: snh_slide_seconds }}s; --snh-am: -{{ snh_mi | times: snh_slide_seconds }}s;{%- endcapture -%}
                {%- assign snh_di = snh_di | plus: 1 -%}
                {%- assign snh_mi = snh_mi | plus: 1 -%}
                {%- if section.settings.trust_url != blank -%}
                  <a class="snh-top__message snh-top__slide" href="{{ section.settings.trust_url }}" style="{{ snh_trust_vars }}">
                    <span class="snh-top__label">{{ snh_trust_label }}</span>
                    <span>{{ snh_trust_message }}</span>
                  </a>
                {%- else -%}
                  <span class="snh-top__promo-text snh-top__slide" style="{{ snh_trust_vars }}">
                    <span class="snh-top__label">{{ snh_trust_label }}</span>
                    <span>{{ snh_trust_message }}</span>
                  </span>
                {%- endif -%}
              {%- endif -%}

              {%- capture snh_ship_vars -%}--snh-ad: -{{ snh_di | times: snh_slide_seconds }}s; --snh-am: -{{ snh_mi | times: snh_slide_seconds }}s;{%- endcapture -%}
              {%- if snh_has_ship -%}
                {%- assign snh_di = snh_di | plus: 1 -%}
                {%- assign snh_mi = snh_mi | plus: 1 -%}
              {%- endif -%}
              <span class="snh-top__promo-text snh-top__slide" style="{{ snh_ship_vars }}"{% if snh_gap_is_waived %} hidden{% endif %}>
                <span class="snh-top__label">Delivery</span>
                <span data-free-shipping-message>{{ snh_free_shipping_message }}</span>
              </span>
              {%- if snh_loyalty_href != blank -%}
                {%- capture snh_loyalty_vars -%}--snh-ad: -{{ snh_di | times: snh_slide_seconds }}s;{%- endcapture -%}
                <a class="snh-top__message snh-top__message--loyalty snh-top__slide" href="{{ snh_loyalty_href }}" style="{{ snh_loyalty_vars }}">
                  <span class="snh-top__label">SNH Elite</span>
                  <span>Earn 3–10% back in points</span>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>

        </div>

        {%- if utility_count > 0 -%}
          <nav class="snh-top__utility" aria-label="Utility navigation">
            {%- for block in section.blocks -%}
              {%- if block.type == 'utility_link' and block.settings.text != blank -%}
                <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="snh-main">
    <div class="snh-inner snh-main__inner">
      <button type="button" class="snh-burger" data-mobile-open aria-label="Open menu" aria-expanded="false">
        <span class="snh-burger__lines" aria-hidden="true"><span class="snh-burger__line"></span></span>
      </button>

      <nav class="snh-desktop-nav" aria-label="Main navigation">
        {%- if menu_block_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'menu_item' -%}
              {%- liquid
                assign has_mega = false
                if block.settings.submenu != blank or block.settings.collections != blank or block.settings.image != blank or block.settings.second_image != blank
                  assign has_mega = true
                endif
              -%}

              {%- if has_mega -%}
                <button
                  type="button"
                  class="snh-desktop-nav__link"
                  data-mega-trigger="{{ forloop.index0 }}"
                  aria-expanded="false"
                  aria-controls="snh-mega-{{ section.id }}-{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text | default: 'Shop' }}
                  <span class="snh-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </button>
              {%- else -%}
                <a class="snh-desktop-nav__link" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text | default: 'Link' }}
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif mobile_menu != blank -%}
          {%- for link in mobile_menu.links limit: 5 -%}
            <a class="snh-desktop-nav__link" href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </nav>

      <div class="snh-logo">
        <a href="{{ routes.root_url }}" class="snh-logo__link" aria-label="{{ shop.name | escape }}">
          {%- if section.settings.logo != blank -%}
            <span class="snh-logo__desktop">
              <img
                src="{{ section.settings.logo | image_url: width: 520 }}"
                alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
                width="{{ section.settings.logo_width }}"
                loading="eager"
              >
            </span>
            <span class="snh-logo__mobile">
              {%- if section.settings.logo_mobile != blank -%}
                <img
                  src="{{ section.settings.logo_mobile | image_url: width: 360 }}"
                  alt="{{ section.settings.logo_mobile.alt | default: shop.name | escape }}"
                  width="{{ section.settings.logo_width_mobile }}"
                  loading="eager"
                >
              {%- else -%}
                <img
                  src="{{ section.settings.logo | image_url: width: 360 }}"
                  alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
                  width="{{ section.settings.logo_width_mobile }}"
                  loading="eager"
                >
              {%- endif -%}
            </span>
          {%- else -%}
            <span>{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <div class="snh-actions">
        {%- if section.settings.enable_search -%}
          <div class="snh-desktop-search">
            <button type="button" class="snh-search-trigger" data-search-open aria-label="Open search">
              <span class="snh-search-trigger__label">{{ section.settings.search_placeholder }}</span>
              <span class="snh-search-trigger__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75"/></svg>
              </span>
            </button>
          </div>

          
        {%- endif -%}

        {%- if section.settings.enable_account and shop.customer_accounts_enabled -%}
          <div style="position:relative;">
            <button type="button" class="snh-action snh-action--account" data-account-toggle aria-label="Account" aria-expanded="false">
              <span class="snh-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="7.5" r="3.75" stroke="currentColor" stroke-width="1.75"/><path d="M4.75 20.25a7.25 7.25 0 0 1 14.5 0" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
              </span>
              <span class="snh-action__text">{{ section.settings.account_label }}</span>
            </button>

