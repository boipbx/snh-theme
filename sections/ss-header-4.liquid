                  <span>
                    <strong>{{ link.title | upcase }}</strong>
                  </span>
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="none"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

