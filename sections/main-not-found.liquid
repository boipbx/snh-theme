{%- comment -%}
  404 (Round 11, v2): replaces Impact's 404 (giant outlined "404" and 320px padding) with the v2 page head, a search
  field and shortcuts to the main ranges, so a dead link still leads somewhere useful.
{%- endcomment -%}
<section class="v2 v-section spage nf" aria-labelledby="nf-h">
  <div class="v-wrap spage__in">
    <header class="spage__head">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="v-h1" id="nf-h">{% render 'snh-v2-heading', text: section.settings.heading %}</h1>
      <p class="lead">{{ section.settings.lead | escape }}</p>
    </header>
    <form class="nf__search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" placeholder="Search products, brands, goals…" aria-label="Search">
      <button class="v-btn v-btn--accent" type="submit"><span>Search</span></button>
    </form>
    <div class="nf__links">
      {%- for block in section.blocks -%}
        <a class="v-btn v-btn--line" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span></a>
      {%- else -%}
        <a class="v-btn v-btn--line" href="{{ routes.all_products_collection_url }}"><span>Shop all</span></a>
      {%- endfor -%}
    </div>
    {%- comment -%} Round 14: the shared recommendation engine (assets/snh-cart.js widget) {%- endcomment -%}
    <div class="snh-reco" data-snh-reco="404" data-limit="4" data-heading="Popular right now" hidden></div>
  </div>
</section>
<style>
  .nf__search { display: flex; gap: 8px; max-width: 560px; margin-top: 32px; }
  .nf__search input { flex: 1; min-width: 0; height: 48px; padding: 0 16px; border: 1px solid var(--line, #ddd); border-radius: 999px; font: inherit; font-size: 16px; background: var(--white, #fff); }
  .nf__links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
</style>

{% schema %}
{
  "name": "404",
  "class": "shopify-section--404",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Page not found" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has *moved on.*" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "The link may be old or mistyped. Search for what you need, or jump into a range below." }
  ],
  "blocks": [
    { "type": "link", "name": "Link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Shop all" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "404" }]
}
{% endschema %}
