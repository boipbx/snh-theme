{% comment %}
  SNH – Instagram Feed (Modern)
  Uses Instagram Basic Display API (client-side) with localStorage caching.
  You need a Long-Lived Access Token for @sportsnutritionhub.lk
  Docs: https://developers.facebook.com/docs/instagram-basic-display-api

  SNH pass: Archivo display voice, section frame consistent with the rest of
  the home page (1500px / clamp padding), 8px corners, orange hover accents.
  Fetch / cache / render technique unchanged.
{% endcomment %}


<section
  id="ig-{{ section.id }}"
  class="ig-wrap"
  style="
    --ig-accent: {{ section.settings.accent | default: '#e0521c' }};
    --ig-bg: {{ section.settings.bg }};
    --ig-card: {{ section.settings.card }};
    --ig-text: {{ section.settings.text }};
    --ig-muted: {{ section.settings.muted }};
    --ig-ink: {{ section.settings.heading_color | default: '#141414' }};
    --ig-radius: {{ section.settings.radius }}px;
    --ig-gap: {{ section.settings.gap }}px;
    --ig-shadow: {% if section.settings.shadow %}0 14px 32px rgba(20,20,20,.10){% else %}none{% endif %};
  "
  aria-labelledby="ig-title-{{ section.id }}"
>
  <div class="ig-container">
    {% if section.settings.heading != blank %}
      <header class="ig-heading">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="ig-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          <h2 id="ig-title-{{ section.id }}" class="ig-title">{{ section.settings.heading }}</h2>
        </div>
        {% if section.settings.subheading != blank %}
          <a class="ig-follow" href="{{ section.settings.profile_url | default: 'https://www.instagram.com/sportsnutritionhub.lk/' }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none"/></svg>
            <span>{{ section.settings.subheading | escape }}</span>
            <span class="ig-follow-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {% endif %}
      </header>
    {% endif %}

    <div
      class="ig-grid ig-cols-{{ section.settings.cols_desktop }} ig-cols-m-{{ section.settings.cols_mobile }}"
      data-token="{{ section.settings.token | escape }}"
      data-count="{{ section.settings.count }}"
      data-cache="{{ section.settings.cache_mins }}"
      data-target="{% if section.settings.new_tab %}_blank{% else %}_self{% endif %}"
      data-show-captions="{{ section.settings.show_captions }}"
      data-show-date="{{ section.settings.show_date }}"
    >
      <!-- skeletons while loading -->
      {% for i in (1..6) %}
        <article class="ig-card ig-skeleton" aria-hidden="true">
          <div class="ig-media"></div>
          <div class="ig-meta">
            <div class="ig-line"></div>
            <div class="ig-line short"></div>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="ig-fallback" hidden>
      <p>Can’t load Instagram right now. See more on
        <a href="{{ section.settings.profile_url | default: 'https://www.instagram.com/sportsnutritionhub.lk/' }}" target="_blank" rel="noopener">Instagram</a>.
      </p>
    </div>
  </div>
</section>

<style>
  /* ---- Scoped to this section ---- */
  #ig-{{ section.id }}.ig-wrap {
    background: var(--ig-bg);
    padding-block: clamp(40px, 4.5vw, 76px);
    color: var(--ig-text);
  }
  #ig-{{ section.id }} .ig-container {
    max-width: 1500px;
    margin: 0 auto;
    padding-inline: clamp(18px, 4vw, 64px);
  }

  /* header — SNH voice, heading left / follow pill right */
  #ig-{{ section.id }} .ig-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    margin: 0 0 clamp(18px, 2vw, 28px);
  }
  #ig-{{ section.id }} .ig-eyebrow {
    margin: 0 0 10px;
    color: var(--ig-accent);
    font-family: var(--snh-font-display);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .26em;
    line-height: 1;
    text-transform: uppercase;
  }
  #ig-{{ section.id }} .ig-title {
    margin: 0;
    color: var(--ig-ink);
    font-family: var(--snh-font-display);
    font-size: clamp(28px, 3.4vw, 46px);
    font-weight: 800;
    line-height: .98;
    letter-spacing: -.03em;
    text-transform: uppercase;
  }
  #ig-{{ section.id }} .ig-follow {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    padding: 0 16px;
    border-radius: 6px;
    border: 1px solid rgba(20, 20, 20, .14);
    background: transparent;
    color: var(--ig-ink);
    font-family: var(--snh-font-display);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .04em;
    text-decoration: none;
    transition: color .2s ease, border-color .2s ease, transform .2s ease;
  }
  #ig-{{ section.id }} .ig-follow svg { width: 17px; height: 17px; color: var(--ig-accent); }
  #ig-{{ section.id }} .ig-follow-arrow { transition: transform .2s ease; }
  #ig-{{ section.id }} .ig-follow:hover {
    color: var(--ig-accent);
    border-color: var(--ig-accent);
    transform: translateY(-2px);
  }
  #ig-{{ section.id }} .ig-follow:hover .ig-follow-arrow { transform: translateX(3px); }

  #ig-{{ section.id }} .ig-grid {
    display: grid;
    gap: var(--ig-gap);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  /* desktop columns */
  #ig-{{ section.id }} .ig-cols-3 { grid-template-columns: repeat(3,1fr); }
  #ig-{{ section.id }} .ig-cols-4 { grid-template-columns: repeat(4,1fr); }
  #ig-{{ section.id }} .ig-cols-5 { grid-template-columns: repeat(5,1fr); }
  #ig-{{ section.id }} .ig-cols-6 { grid-template-columns: repeat(6,1fr); }
  /* mobile columns */
  @media (max-width: 900px) {
    #ig-{{ section.id }} .ig-grid { grid-template-columns: repeat(2,1fr); }
    #ig-{{ section.id }} .ig-cols-m-1 { grid-template-columns: 1fr; }
    #ig-{{ section.id }} .ig-cols-m-2 { grid-template-columns: repeat(2,1fr); }
  }

  #ig-{{ section.id }} .ig-card {
    background: var(--ig-card);
    border-radius: var(--ig-radius);
    overflow: clip;
    box-shadow: var(--ig-shadow);
    border: 1px solid rgba(20, 20, 20, .08);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }
  #ig-{{ section.id }} .ig-card:hover {
    transform: translateY(-4px);
    border-color: var(--ig-accent);
    box-shadow: 0 18px 40px rgba(20, 20, 20, .16);
  }

  #ig-{{ section.id }} .ig-media {
    position: relative; aspect-ratio: 1 / 1; background: #17110c;
    display: block; width: 100%; overflow: hidden;
  }
  #ig-{{ section.id }} .ig-media img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .55s cubic-bezier(.22, .61, .21, 1);
  }
  #ig-{{ section.id }} .ig-card:hover .ig-media img { transform: scale(1.05); }
  #ig-{{ section.id }} .ig-media::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--ig-accent), transparent 78%);
    opacity: 0;
    transition: opacity .22s ease;
    pointer-events: none;
  }
  #ig-{{ section.id }} .ig-card:hover .ig-media::after { opacity: 1; }

  #ig-{{ section.id }} .ig-type-badge {
    position: absolute; top: 10px; right: 10px;
    background: rgba(10, 8, 6, .55); color: #fdf6ef;
    font-family: var(--snh-font-display);
    font-size: 9px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase;
    padding: 5px 8px; border-radius: 4px;
    backdrop-filter: blur(6px);
  }

  #ig-{{ section.id }} .ig-meta { padding: 12px 14px 14px; }
  #ig-{{ section.id }} .ig-meta:empty { display: none; }
  #ig-{{ section.id }} .ig-caption {
    margin: 0;
    color: var(--ig-text);
    font-size: 13px; font-weight: 500; line-height: 1.45; letter-spacing: -.01em;
  }
  #ig-{{ section.id }} .ig-date {
    margin-top: 6px;
    color: var(--ig-muted);
    font-family: var(--snh-font-display);
    font-size: 9.5px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase;
  }
  #ig-{{ section.id }} .ig-caption + .ig-date { margin-top: 8px; }

  /* skeleton */
  #ig-{{ section.id }} .ig-skeleton .ig-media { background: linear-gradient(90deg, #1a1d22 25%, #22262c 37%, #1a1d22 63%); background-size: 400% 100%; animation: ig-shine 1.1s infinite; }
  #ig-{{ section.id }} .ig-skeleton .ig-line { height: 10px; background: #23272f; border-radius: 4px; margin: .5rem 0; }
  #ig-{{ section.id }} .ig-skeleton .ig-line.short { width: 60%; }
  @keyframes ig-shine { 0%{background-position: 200% 0;} 100%{background-position: -200% 0;} }

  #ig-{{ section.id }} .ig-fallback {
    text-align: center;
    color: rgba(20, 20, 20, .55);
    margin-top: 16px;
    font-size: 13.5px;
    font-weight: 500;
  }
  #ig-{{ section.id }} .ig-fallback a { color: var(--ig-accent); font-weight: 800; text-decoration: none; }
  #ig-{{ section.id }} .ig-fallback a:hover { text-decoration: underline; }

  @media (max-width: 699px) {
    #ig-{{ section.id }}.ig-wrap { padding-block: 36px 44px; }
    #ig-{{ section.id }} .ig-heading { align-items: flex-start; flex-direction: column; gap: 12px; }
    #ig-{{ section.id }} .ig-follow { min-height: 38px; font-size: 11px; }
    #ig-{{ section.id }} .ig-meta { padding: 10px 12px 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #ig-{{ section.id }} .ig-card,
    #ig-{{ section.id }} .ig-media img,
    #ig-{{ section.id }} .ig-skeleton .ig-media { transition: none !important; animation: none !important; }
  }
</style>

<script>
(function(){
  const root = document.getElementById('ig-{{ section.id }}');
  const grid = root.querySelector('.ig-grid');
  const token = grid.dataset.token.trim();
  const limit = parseInt(grid.dataset.count || '6', 10);
  const cacheMins = parseInt(grid.dataset.cache || '60', 10);
  const target = grid.dataset.target || '_self';
  const showCaptions = grid.dataset.showCaptions === 'true';
  const showDate = grid.dataset.showDate === 'true';

  const CACHE_KEY = 'ig_cache_{{ section.id }}';
  const now = Date.now();

  function fmtDate(ts){
    try {
      const d = new Date(ts);
      return d.toLocaleDateString(undefined, { year:'numeric', month:'short', day:'numeric' });
    } catch(e){ return ''; }
  }
  function truncate(str, n){
    if(!str) return '';
    return str.length > n ? str.slice(0, n-1) + '…' : str;
  }

  async function fetchIG(){
    if(!token){ throw new Error('Missing Instagram Access Token'); }

    // cache
    try{
      const cached = JSON.parse(localStorage.getItem(CACHE_KEY) || 'null');
      if(cached && (now - cached.t) < cacheMins*60*1000){
        return cached.data;
      }
    }catch(e){}

    const fields = 'id,media_type,media_url,thumbnail_url,permalink,caption,timestamp';
    const url = `https://graph.instagram.com/me/media?fields=${fields}&access_token=${encodeURIComponent(token)}&limit=${limit}`;

    const res = await fetch(url);
    if(!res.ok) throw new Error('Instagram API error');
    const json = await res.json();
    try{ localStorage.setItem(CACHE_KEY, JSON.stringify({ t: now, data: json.data })); }catch(e){}
    return json.data;
  }

  function render(items){
    if(!Array.isArray(items)){ throw new Error('Invalid feed'); }
    grid.innerHTML = '';
    items.slice(0, limit).forEach(item => {
      const isVideo = item.media_type === 'VIDEO' || item.media_type === 'REELS';
      const imgSrc = isVideo ? (item.thumbnail_url || item.media_url) : item.media_url;

      const card = document.createElement('article');
      card.className = 'ig-card';

      const a = document.createElement('a');
      a.href = item.permalink;
      a.target = target;
      a.rel = 'noopener';
      a.className = 'ig-media';

      const img = document.createElement('img');
      img.src = imgSrc;
      img.alt = (item.caption || 'Instagram post').replace(/"/g, '');
      img.loading = 'lazy';
      a.appendChild(img);

      const badge = document.createElement('span');
      badge.className = 'ig-type-badge';
      badge.textContent = item.media_type.toLowerCase();
      a.appendChild(badge);

      card.appendChild(a);

      if(showCaptions || showDate){
        const meta = document.createElement('div');
        meta.className = 'ig-meta';

        if(showCaptions){
          const cap = document.createElement('p');
          cap.className = 'ig-caption';
          cap.textContent = truncate(item.caption || '', 120);
          meta.appendChild(cap);
        }
        if(showDate){
          const dt = document.createElement('div');
          dt.className = 'ig-date';
          dt.textContent = fmtDate(item.timestamp);
          meta.appendChild(dt);
        }
        card.appendChild(meta);
      }

      grid.appendChild(card);
    });
  }

  function start(){
    fetchIG()
      .then(render)
      .catch(err => {
        console.warn('IG feed error:', err);
        root.querySelector('.ig-fallback').hidden = false;
      });
  }

  /* the feed sits low on the page: call the API only when it is about to scroll into view */
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(entries => {
      if (!entries.some(e => e.isIntersecting)) return;
      io.disconnect();
      start();
    }, { rootMargin: '600px 0px' });
    io.observe(root);
  } else {
    start();
  }
})();
</script>

{% schema %}
{
  "name": "SNH Instagram Feed",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@sportsnutritionhub.lk" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the Hub" },
    { "type": "text", "id": "subheading", "label": "Follow button text", "default": "Follow on Instagram" },
    { "type": "url", "id": "profile_url", "label": "Instagram profile link", "info": "Defaults to @sportsnutritionhub.lk" },

    { "type": "text", "id": "token", "label": "Instagram Long-Lived Access Token", "info": "Required. Create via Instagram Basic Display API. Consider a proxy if you prefer server-side." },

    { "type": "range", "id": "count", "label": "Posts to load", "min": 3, "max": 18, "step": 1, "default": 8 },
    { "type": "select", "id": "cols_desktop", "label": "Columns (desktop)", "default": "4",
      "options": [
        { "value": "3", "label": "3" }, { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }, { "value": "6", "label": "6" }
      ]
    },
    { "type": "select", "id": "cols_mobile", "label": "Columns (mobile)", "default": "2",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ]
    },
    { "type": "checkbox", "id": "show_captions", "label": "Show captions", "default": false },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "new_tab", "label": "Open in new tab", "default": true },

    { "type": "range", "id": "cache_mins", "label": "Cache (minutes)", "min": 5, "max": 240, "step": 5, "default": 60 },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#E0521C" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F0F0F0" },
    { "type": "color", "id": "heading_color", "label": "Heading text", "default": "#141414" },
    { "type": "color", "id": "card", "label": "Card background", "default": "#151515" },
    { "type": "color", "id": "text", "label": "Card text", "default": "#FFFFFF" },
    { "type": "color", "id": "muted", "label": "Muted text", "default": "#B7BCC3" },
    { "type": "range", "id": "radius", "label": "Card radius (px)", "min": 0, "max": 28, "step": 1, "default": 8 },
    { "type": "range", "id": "gap", "label": "Grid gap (px)", "min": 8, "max": 28, "step": 1, "default": 14 },
    { "type": "checkbox", "id": "shadow", "label": "Enable shadows", "default": true }
  ],
  "presets": [
    { "name": "SNH – Instagram Feed (Modern)" }
  ]
}
{% endschema %}
