        "liquid_WWhLYf": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- if product -%}\n{%- assign wa_message = 'Hello, I want to buy: ' | append: product.title | append: ' ' | append: shop.url | append: product.url | url_encode -%}\n\n<div id=\"wa-order-{{ section.id }}\" class=\"wa-wrap\">\n  <a\n    class=\"wa-btn\"\n    href=\"https://wa.me/{{ settings.snh_whatsapp | remove: '+' | remove: ' ' }}?text={{ wa_message }}\"\n    target=\"_blank\" rel=\"noopener\"\n    aria-label=\"Order on WhatsApp\"\n  >\n    <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\" class=\"wa-icon\">\n      <path d=\"M19.11 17.27c-.23-.12-1.36-.67-1.57-.74-.21-.08-.36-.12-.52.12-.15.23-.6.74-.73.9-.13.15-.27.17-.5.06-.23-.12-.98-.36-1.86-1.14-.69-.61-1.15-1.37-1.29-1.6-.13-.23-.01-.35.1-.46.1-.1.23-.27.35-.4.12-.13.15-.23.23-.38.08-.15.04-.29-.02-.41-.06-.12-.52-1.25-.72-1.72-.19-.46-.39-.4-.52-.4-.13 0-.29-.02-.44-.02s-.41.06-.62.29c-.21.23-.82.8-.82 1.96 0 1.16.84 2.29.96 2.45.12.15 1.64 2.5 3.98 3.5.56.24 1 .38 1.34.49.56.18 1.07.15 1.47.09.45-.07 1.36-.55 1.55-1.08.19-.52.19-.98.13-1.08-.06-.1-.21-.15-.44-.27zM16 3C9.37 3 4 8.37 4 15c0 2.13.57 4.12 1.57 5.83L4 29l8.35-1.53C14.02 28.43 15 28.5 16 28.5 22.63 28.5 28 23.13 28 16.5S22.63 3 16 3zm0 23.5c-.86 0-1.7-.13-2.48-.38l-.49-.16-4.96.91.94-4.83-.17-.5A9.33 9.33 0 0 1 6.5 15C6.5 9.76 10.76 5.5 16 5.5S25.5 9.76 25.5 15 21.24 26.5 16 26.5z\" fill=\"currentColor\"/>\n    </svg>\n    <span>Order on WhatsApp</span>\n  </a>\n</div>\n\n<style>\n  /* Base look (fallbacks); JS below will sync to your ATC button */\n  #wa-order-{{ section.id }} .wa-btn{\n    --wa-green:#25d366;\n    display:inline-flex; align-items:center; justify-content:center; gap:.625rem;\n    width:100%; box-sizing:border-box;\n    min-height:56px; padding:.875rem 1.125rem;   /* safe defaults */\n    background:var(--wa-green); color:#fff; text-decoration:none;\n    border:0; border-radius:9999px; font-weight:700; font-size:16px; line-height:1;\n    transition:background .2s ease, transform .04s ease, box-shadow .2s ease;\n    margin-top:.75rem;\n  }\n  #wa-order-{{ section.id }} .wa-btn:hover{ background:#1ebc57; }\n  #wa-order-{{ section.id }} .wa-btn:active{ transform:translateY(1px); }\n  #wa-order-{{ section.id }} .wa-icon{ width:20px; height:20px; flex:0 0 20px; }\n\n  /* Ensure container stacks like native product buttons */\n  #wa-order-{{ section.id }}{ width:100%; }\n</style>\n\n<script>\n(function(){\n  try{\n    // Scope to this block only\n    const wrap = document.getElementById('wa-order-{{ section.id }}');\n    const waBtn = wrap && wrap.querySelector('.wa-btn');\n    if(!wrap || !waBtn) return;\n\n    // Find the main product action button this should visually match\n    const candidates = [\n      '.product-form__submit',\n      'button[name=\"add\"]',\n      '.product-form [type=\"submit\"]',\n      '.product-form .btn--add-to-cart',\n      '.product-form .button--add-to-cart',\n      '.product__submit__buttons button',\n    ];\n    let atc = null;\n    for (const sel of candidates){\n      const el = wrap.closest('section, form, body').querySelector(sel);\n      if(el){ atc = el; break; }\n    }\n\n    // Sync styles from ATC if found\n    if(atc){\n      const cs = window.getComputedStyle(atc);\n      // Width is inherited by container; sync key visuals:\n      const minH = cs.minHeight !== '0px' ? cs.minHeight : cs.height;\n      waBtn.style.minHeight   = minH;\n      waBtn.style.borderRadius= cs.borderRadius || '9999px';\n      waBtn.style.fontSize    = cs.fontSize || '16px';\n      waBtn.style.fontWeight  = cs.fontWeight || '700';\n      // Compute horizontal padding from ATC to keep label alignment\n      const padX = (parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight)) / 2;\n      if(padX){ waBtn.style.paddingLeft = waBtn.style.paddingRight = padX + 'px'; }\n      // If ATC uses full width, keep it too\n      if(cs.width && cs.width.endsWith('px')) waBtn.style.width = '100%';\n    }\n\n    // Make sure we sit just under the ATC area if this block was moved\n    // (No-op if already placed below)\n    const buttonsArea =\n      wrap.closest('section, form, body').querySelector('.product-form__buttons') ||\n      wrap.closest('section, form, body').querySelector('.product-form') ||\n      null;\n    if(buttonsArea && !buttonsArea.contains(wrap)){\n      buttonsArea.appendChild(wrap);\n    }\n  }catch(e){ /* fail silently; CSS fallbacks keep it looking good */ }\n})();\n</script>\n{%- endif -%}"
