      "blocks": {
        "faq_item_rnjwpK": {
          "type": "faq_item",
          "settings": {
            "question": "How long will it take to get my order?",
            "answer": "<p>Delivery depends on your location and the shipping method selected at checkout.</p><ul><li><strong>Colombo and suburbs:</strong> usually within 24 hours.</li><li><strong>Outside Colombo:</strong> typically 2–4 business days.</li></ul><p>Once your order is dispatched, we’ll share tracking details where available. If you need your order urgently, contact our team and we’ll do our best to help.</p>"
          }
        },
        "faq_item_yPq3HR": {
          "type": "faq_item",
          "settings": {
            "question": "Where can I come visit physically?",
            "answer": "<p><strong>You’re welcome to visit any of our stores during opening hours. SearchSports Nutrition Hub (SNH)on Google Maps and choose the location closest to you.</strong></p>"
          }
        },
        "faq_item_z3bh7P": {
          "type": "faq_item",
          "settings": {
            "question": "⁠I want to know more",
            "answer": "<p>Our team is happy to guide you. Call or WhatsApp us on <a href=\"tel:+94764863359\"><strong>+94 76 486 3359</strong> </a>and we’ll help with product advice, availability, delivery, or store directions.</p>"
          }
        },
        "faq_item_r7gQ9d": {
          "type": "faq_item",
          "settings": {
            "question": "Are your supplements genuine?",
            "answer": "<p><strong>Yes. We only stock genuine products sourced through authorised distributors and trusted international brands. Your health and safety always come first.</strong></p>"
          }
        },
        "faq_item_iY4gHA": {
          "type": "faq_item",
          "settings": {
            "question": "How do I know which supplement is right for me?",
            "answer": "<p><strong>Tell us your fitness goal, diet, training routine, experience level, and any medical conditions or dietary restrictions. We’ll recommend suitable options without pushing products you do not need.</strong></p>"
          }
        },
        "faq_item_kRe4GP": {
          "type": "faq_item",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "<p><strong>We accept card payments, bank transfers, cash on delivery, and Koko.</strong></p>"
          }
        },
        "faq_item_YPp3da": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return or exchange a product?",
            "answer": "<p><strong>We accept returns and exchanges only for products that are unopened, unused, and still in their original sealed condition, subject to our return policy. If your order arrives damaged or incorrect, contact us within 24 hours and we’ll sort it out promptly.</strong></p>"
          }
        }
