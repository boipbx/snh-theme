    "faq_pXHLeA": {
      "type": "faq",
      "blocks": {
        "item_inQjLj": {
          "type": "item",
          "settings": {
            "title": "How long will it take to get my orders?",
            "content": "<p>It depends on your delivery address. </p><p>Colombo Orders: Same Day <br/>Out of Colombo Orders: 2-3 Working Days </p>"
          }
        },
        "item_7pdVtF": {
          "type": "item",
          "settings": {
            "title": "Where can I come visit physically?",
            "content": "<p>We have three stores:</p><p>DEHIWALA, WATTALA, NUGEGODA</p><p>Simply type ‘Sports Nutrition Hub’ on Google Maps and the options will appear.</p>"
          }
        },
        "item_fNj3BX": {
          "type": "item",
          "settings": {
            "title": "I want to know more",
            "content": "<p>The fastest way to get an answer would be to call us or WhatsApp us on +94 76 486 3359</p>"
          }
        },
        "item_pPVapK": {
          "type": "item",
          "settings": {
            "title": "Are your supplements genuine?",
            "content": "<p>Yes. We stock only genuine products sourced directly from authorized distributors and trusted international brands. Your health and safety are our highest priority.</p>"
          }
        },
        "item_kQhBXD": {
          "type": "item",
          "settings": {
            "title": "How do I know which supplement is right for me?",
            "content": "<p>Tell us about your fitness goals, diet, training experience, and any medical conditions or dietary restrictions. Our team will recommend products that best suit your needs—without pushing unnecessary supplements.</p>"
          }
        },
        "item_8TTVmt": {
          "type": "item",
          "settings": {
            "title": "What payment methods do you accept?",
            "content": "<p>We accept card payments, bank transfers, cash on delivery, & Koko.</p>"
          }
        },
        "item_gPkEUa": {
          "type": "item",
          "settings": {
            "title": "Can I return or exchange a product?",
            "content": "<p>Returns and exchanges are accepted only for products that are unopened, unused, and in their original sealed condition, subject to our return policy. If your order arrives damaged or incorrect, contact us within 24 hours and we’ll resolve it promptly.<br/></p>"
          }
        }
      },
