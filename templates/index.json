        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Where can I come visit physically?",
            "answer": "<p>We have three stores: DEHIWALA, WATTALA, NUGEGODA Simply type ‘Sports Nutrition Hub’ on Google Maps and the options will appear.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "I want to know more",
            "answer": "<p>The fastest way to get an answer would be to call us or WhatsApp us on [whatsapp]</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Are your supplements genuine?",
            "answer": "<p>Yes. We stock only genuine products sourced directly from authorized distributors and trusted international brands. Your health and safety are our highest priority.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "How do I know which supplement is right for me?",
            "answer": "<p>Tell us about your fitness goals, diet, training experience, and any medical conditions or dietary restrictions. Our team will recommend products that best suit your needs—without pushing unnecessary supplements.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "<p>We accept card payments, bank transfers, cash on delivery, &amp; Koko.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "Can I return or exchange a product?",
            "answer": "<p>Returns and exchanges are accepted only for products that are unopened, unused, and in their original sealed condition, subject to our return policy. If your order arrives damaged or incorrect, contact us within 24 hours and we’ll resolve it promptly.</p>"
          }
        }
      },
