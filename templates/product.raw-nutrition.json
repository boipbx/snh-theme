elow)\n    const buttonsArea =\n      wrap.closest('section, form, body').querySelector('.product-form__buttons') ||\n      wrap.closest('section, form, body').querySelector('.product-form') ||\n      null;\n    if(buttonsArea && !buttonsArea.contains(wrap)){\n      buttonsArea.appendChild(wrap);\n    }\n  }catch(e){ /* fail silently; CSS fallbacks keep it looking good */ }\n})();\n</script>\n{%- endif -%}"
