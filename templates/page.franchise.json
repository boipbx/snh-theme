          "type": "question",
          "settings": {
            "question": "Which cities are you looking at?",
            "answer": "<p>We are open to strong locations across Sri Lanka outside the areas our own stores already serve. Tell us the city or district you have in mind in the form.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Do I have to find the location myself?",
            "answer": "<p>If you already own or lease a suitable unit, great. If not, we help you assess options so the store opens in the right place.</p>"
          }
        },
