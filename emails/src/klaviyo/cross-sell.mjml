<mjml lang="en"><mj-head>
    <mj-title>Complete your stack and save</mj-title>
    <mj-preview>Bundles cost less than buying each item alone.</mj-preview>
    <mj-raw><meta name="color-scheme" content="light"><meta name="supported-color-schemes" content="light"></mj-raw>
    <mj-attributes>
      <mj-all font-family="Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.5" color="#0E0E0E" padding="0 24px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      a { color: #0E0E0E; }
      .lnk a, a.lnk { color: #BF4512; font-weight: 700; text-decoration: underline; }
      .muted { color: #5C574F; }
      .tbl td { font-family: Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.45; color: #0E0E0E; }
    </mj-style>
    <mj-style>
      :root { color-scheme: light; supported-color-schemes: light; }
      u + .body .gmail-fix { display: none; }
      @media only screen and (max-width: 480px) {
        .h1 div { font-size: 30px !important; line-height: 1.1 !important; }
        .pad-m div { padding-left: 0 !important; padding-right: 0 !important; }
        .stack td { display: block !important; width: 100% !important; }
        .hide-m { display: none !important; max-height: 0 !important; overflow: hidden !important; }
      }
      [data-ogsc] .keep-ink, [data-ogsb] .keep-ink { color: #0E0E0E !important; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F6F4F1" width="600px" css-class="body">
  
  <mj-section background-color="#FFFFFF" padding="20px 24px" border-bottom="3px solid #BF4512">
    <mj-column vertical-align="middle" width="50%"><mj-image src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/sn_o.png?width=360" alt="SNH, Sports Nutrition Hub" width="96px" align="left" href="https://www.sportsnutritionhub.lk/" /></mj-column>
    <mj-column vertical-align="middle" width="50%" css-class="hide-m"><mj-text align="right" font-size="13px" color="#5C574F" padding="0"><a href="https://www.sportsnutritionhub.lk/collections/all" style="color:#5C574F;text-decoration:none;">Shop</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.sportsnutritionhub.lk/pages/snh-elite" style="color:#5C574F;text-decoration:none;">SNH Elite</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.sportsnutritionhub.lk/account" style="color:#5C574F;text-decoration:none;">Account</a></mj-text></mj-column>
  </mj-section>
  
  <mj-section background-color="#FFFFFF" padding="28px 0 8px">
    <mj-column>
      <mj-text font-size="12px" font-weight="700" letter-spacing="2px" color="#BF4512" padding="0 24px 8px">COMPLETE YOUR STACK</mj-text>
      <mj-text css-class="h1" font-size="34px" line-height="1.08" font-weight="700" letter-spacing="-0.5px" padding="0 24px 12px">Save with a <em style="font-family:'Instrument Serif', Georgia, 'Times New Roman', serif;font-style:italic;font-weight:400;">bundle</em></mj-text>
      <mj-text font-size="17px" color="#5C574F" padding="0 24px 8px">{{ first_name|default:'there' }}, our bundles put the essentials together for less.</mj-text>
    </mj-column>
  </mj-section>
<mj-section background-color="#F5F2EC" padding="20px 0"><mj-column>
    <mj-text font-size="12px" font-weight="700" letter-spacing="2px" color="#BF4512" padding="0 24px 6px">BUNDLE OFFER</mj-text>
    <mj-text font-size="22px" font-weight="700" padding="0 24px 6px">{{ person|lookup:'bundle_title'|default:'Build Muscle Stack' }}</mj-text>
    <mj-text color="#5C574F" padding="0 24px 10px">Whey protein, creatine and a shaker, chosen to work together.</mj-text>
    <mj-image src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/khizerinsid.webp?width=1200&format=pjpg" alt="{{ person|lookup:'bundle_title'|default:'Build Muscle Stack' }}" width="552px" padding="0 24px 10px" border-radius="12px" />
    <mj-text padding="0 24px"><span style="font-size:20px;font-weight:800;">{% if person|lookup:'bundle_price' %}Rs {{ person|lookup:'bundle_price' }}{% else %}See the price{% endif %}</span></mj-text>
  </mj-column></mj-section><mj-section background-color="#F5F2EC" padding="12px 0 20px"><mj-column><mj-raw>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tr><td align="left" style="padding:0 24px;">
    <!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ person|lookup:'bundle_url'|default:'https://www.sportsnutritionhub.lk/collections/bundle-offers' }}" style="height:50px;v-text-anchor:middle;width:260px;" arcsize="50%" stroke="f" fillcolor="#0E0E0E"><w:anchorlock/><center style="color:#FFFFFF;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">See the bundle</center></v:roundrect><![endif]-->
    <!--[if !mso]><!--><a href="{{ person|lookup:'bundle_url'|default:'https://www.sportsnutritionhub.lk/collections/bundle-offers' }}" style="display:inline-block;background:#0E0E0E;color:#FFFFFF;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:16px;font-weight:700;line-height:50px;height:50px;padding:0 30px;border-radius:999px;text-decoration:none;mso-hide:all;">See the bundle</a><!--<![endif]-->
    </td></tr></table></mj-raw></mj-column></mj-section>
<mj-section background-color="#0E0E0E" padding="28px 12px 8px">
    <mj-column><mj-image src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/sn_o.png?width=360" alt="SNH" width="80px" align="left" padding="0 12px 14px" />
      <mj-text color="#E9E4DC" font-size="14px" padding="0 12px 10px"><a href="https://www.instagram.com/sportsnutritionhub.lk/" style="color:#E9E4DC;text-decoration:underline;">Instagram</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.facebook.com/sportsnutritionhub.lk/" style="color:#E9E4DC;text-decoration:underline;">Facebook</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.tiktok.com/@sportsnutritionhub.lk" style="color:#E9E4DC;text-decoration:underline;">TikTok</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://wa.me/94764863359" style="color:#E9E4DC;text-decoration:underline;">WhatsApp</a></mj-text>
      <mj-text color="#B9B2A7" font-size="12px" line-height="1.6" padding="0 12px 22px">Sports Nutrition Hub (Pvt) Ltd · 133A Kawdana Road, Dehiwala, Sri Lanka · <a href="https://www.sportsnutritionhub.lk/" style="color:#B9B2A7;">sportsnutritionhub.lk</a><br>You're receiving this because you signed up at sportsnutritionhub.lk. {% unsubscribe 'Unsubscribe' %} · {% manage_preferences 'Manage preferences' %}</mj-text>
    </mj-column></mj-section>
  </mj-body></mjml>