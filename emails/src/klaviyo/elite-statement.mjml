<mjml lang="en"><mj-head>
    <mj-title>Your SNH Elite statement:  points</mj-title>
    <mj-preview>Your balance, your tier and how close your next reward is.</mj-preview>
    <mj-raw><meta name="color-scheme" content="light"><meta name="supported-color-schemes" content="light"></mj-raw>
    <mj-attributes>
      <mj-all font-family="Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.5" color="#0E0E0E" padding="0 24px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      a { color: #0E0E0E; }
      .lnk a, a.lnk { color: #BF4512; font-weight: 700; text-decoration: underline; }
      .muted { color: #5C574F; }
      .tbl td { font-family: Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.45; color: #0E0E0E; }
    </mj-style>
    <mj-style>
      :root { color-scheme: light; supported-color-schemes: light; }
      u + .body .gmail-fix { display: none; }
      @media only screen and (max-width: 480px) {
        .h1 div { font-size: 30px !important; line-height: 1.1 !important; }
        .pad-m div { padding-left: 0 !important; padding-right: 0 !important; }
        .stack td { display: block !important; width: 100% !important; }
        .hide-m { display: none !important; max-height: 0 !important; overflow: hidden !important; }
      }
      [data-ogsc] .keep-ink, [data-ogsb] .keep-ink { color: #0E0E0E !important; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F6F4F1" width="600px" css-class="body">
  
  <mj-section background-color="#FFFFFF" padding="20px 24px" border-bottom="3px solid #BF4512">
    <mj-column vertical-align="middle" width="50%"><mj-image src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/sn_o.png?width=360" alt="SNH, Sports Nutrition Hub" width="96px" align="left" href="https://www.sportsnutritionhub.lk/" /></mj-column>
    <mj-column vertical-align="middle" width="50%" css-class="hide-m"><mj-text align="right" font-size="13px" color="#5C574F" padding="0"><a href="https://www.sportsnutritionhub.lk/collections/all" style="color:#5C574F;text-decoration:none;">Shop</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.sportsnutritionhub.lk/pages/snh-elite" style="color:#5C574F;text-decoration:none;">SNH Elite</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.sportsnutritionhub.lk/account" style="color:#5C574F;text-decoration:none;">Account</a></mj-text></mj-column>
  </mj-section>
  
  <mj-section background-color="#FFFFFF" padding="28px 0 8px">
    <mj-column>
      <mj-text font-size="12px" font-weight="700" letter-spacing="2px" color="#BF4512" padding="0 24px 8px">MONTHLY STATEMENT</mj-text>
      <mj-text css-class="h1" font-size="34px" line-height="1.08" font-weight="700" letter-spacing="-0.5px" padding="0 24px 12px">Your <em style="font-family:'Instrument Serif', Georgia, 'Times New Roman', serif;font-style:italic;font-weight:400;">points</em> this month</mj-text>
      <mj-text font-size="17px" color="#5C574F" padding="0 24px 8px">{{ first_name|default:'there' }}, here's where your SNH Elite membership stands.</mj-text>
    </mj-column>
  </mj-section>
<mj-section background-color="#F6F4F1" padding="20px 24px"><mj-column><mj-raw>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:420px;border-radius:16px;background:#E6EAEF;background-image:linear-gradient(135deg,#E6EAEF,#9AA5B3);" bgcolor="#E6EAEF">
    <tr><td style="padding:20px 22px 6px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;color:#111418;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
        <td style="font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:18px;font-weight:800;color:#111418;letter-spacing:-0.3px;">SNH <em style="font-family:'Instrument Serif', Georgia, 'Times New Roman', serif;font-weight:400;">Elite</em></td>
        <td align="right" style="font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:12px;font-weight:700;letter-spacing:2px;color:#111418;">{{ person|lookup:'loyalty_tier'|default:'Bronze'|upper }}</td></tr></table>
    </td></tr>
    <tr><td style="padding:22px 22px 4px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:12px;font-weight:700;letter-spacing:1.5px;color:#111418;">MEMBER</td></tr>
    <tr><td style="padding:0 22px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;font-weight:700;color:#111418;">{{ first_name|default:'' }} {{ last_name|default:'' }}</td></tr>
    <tr><td style="padding:14px 22px 8px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;color:#111418;"><span style="font-size:28px;font-weight:800;">{{ person|lookup:'loyalty_points'|default:'0' }}</span>&nbsp;<span style="font-size:12px;font-weight:700;letter-spacing:1.5px;">POINTS</span>&nbsp;&nbsp;<span style="font-size:15px;font-weight:600;">·&nbsp;Rs {{ person|lookup:'points_value_rs'|default:'0' }}</span></td></tr>
    <tr><td style="padding:0 22px 20px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-radius:3px;background:rgba(0,0,0,0.18);" bgcolor="#9AA5B3"><tr>
      <td width="{{ person|lookup:'next_tier_progress'|default:'0' }}%" height="5" style="height:5px;line-height:5px;font-size:0;background:#111418;border-radius:3px;" bgcolor="#111418">&nbsp;</td><td height="5" style="height:5px;line-height:5px;font-size:0;">&nbsp;</td></tr></table>
      <div style="font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;font-weight:600;color:#111418;padding-top:8px;">{% if person|lookup:'next_tier' %}Rs {{ person|lookup:'rs_to_next_tier' }} to {{ person|lookup:'next_tier' }}{% else %}Top tier{% endif %}</div></td></tr>
  </table></mj-raw></mj-column></mj-section>
<mj-section background-color="#FFFFFF" padding="8px 0"><mj-column><mj-text>{% if person|lookup:'points_to_reward' > 0 %}You're <strong>{{ person|lookup:'points_to_reward' }} points</strong> from your next reward (redeem from {{ person|lookup:'redeem_from'|default:'2,500' }}).{% else %}<strong>Your reward is ready.</strong> Redeem it before your next order.{% endif %}</mj-text></mj-column></mj-section>
<mj-section background-color="#FFFFFF" padding="12px 0 20px"><mj-column><mj-raw>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tr><td align="left" style="padding:0 24px;">
    <!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://www.sportsnutritionhub.lk/account#rewards" style="height:50px;v-text-anchor:middle;width:260px;" arcsize="50%" stroke="f" fillcolor="#BF4512"><w:anchorlock/><center style="color:#FFFFFF;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">View my rewards</center></v:roundrect><![endif]-->
    <!--[if !mso]><!--><a href="https://www.sportsnutritionhub.lk/account#rewards" style="display:inline-block;background:#BF4512;color:#FFFFFF;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:16px;font-weight:700;line-height:50px;height:50px;padding:0 30px;border-radius:999px;text-decoration:none;mso-hide:all;">View my rewards</a><!--<![endif]-->
    </td></tr></table></mj-raw></mj-column></mj-section>
<mj-section background-color="#0E0E0E" padding="28px 12px 8px">
    <mj-column><mj-image src="https://cdn.shopify.com/s/files/1/0258/9625/5550/files/sn_o.png?width=360" alt="SNH" width="80px" align="left" padding="0 12px 14px" />
      <mj-text color="#E9E4DC" font-size="14px" padding="0 12px 10px"><a href="https://www.instagram.com/sportsnutritionhub.lk/" style="color:#E9E4DC;text-decoration:underline;">Instagram</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.facebook.com/sportsnutritionhub.lk/" style="color:#E9E4DC;text-decoration:underline;">Facebook</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.tiktok.com/@sportsnutritionhub.lk" style="color:#E9E4DC;text-decoration:underline;">TikTok</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://wa.me/94779773359" style="color:#E9E4DC;text-decoration:underline;">WhatsApp</a></mj-text>
      <mj-text color="#B9B2A7" font-size="12px" line-height="1.6" padding="0 12px 22px">Sports Nutrition Hub (Pvt) Ltd · 133A Kawdana Road, Dehiwala, Sri Lanka · <a href="https://www.sportsnutritionhub.lk/" style="color:#B9B2A7;">sportsnutritionhub.lk</a><br>You're receiving this because you signed up at sportsnutritionhub.lk. {% unsubscribe 'Unsubscribe' %} · {% manage_preferences 'Manage preferences' %}</mj-text>
    </mj-column></mj-section>
  </mj-body></mjml>